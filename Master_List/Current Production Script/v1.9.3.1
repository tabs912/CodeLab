function createOrRefreshBaseTemplate_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var baseSheet = ss.getSheetByName("RFF_BASE_TEMPLATE");
  if (!baseSheet) baseSheet = ss.insertSheet("RFF_BASE_TEMPLATE"); else { baseSheet.clear(); baseSheet.clearFormats(); }
  baseSheet.setFrozenRows(4); baseSheet.setFrozenColumns(2);
  resizeSheetGrid_(baseSheet, 100, 50);
  var fullRange = baseSheet.getRange(1, 1, 100, 50);
  fullRange.setFontFamily("Arial").setFontSize(10).setVerticalAlignment("middle").setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP).setNumberFormat("@").setBorder(true, true, true, true, true, true, "#CCCCCC", SpreadsheetApp.BorderStyle.SOLID);
  baseSheet.setRowHeight(1, 25); baseSheet.setRowHeight(2, 25); baseSheet.setRowHeight(3, 10);
  for (var r = 4; r <= 100; r++) baseSheet.setRowHeight(r, 25);
  for (var c = 1; c <= 50; c++) baseSheet.setColumnWidth(c, 105);
  baseSheet.getRange("A1").setFontSize(14).setFontWeight("bold");
  baseSheet.hideSheet();
  return baseSheet;
}

function createTemplateFromBase_(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  deleteSheetIfExists_(ss, targetName);
  const base = ss.getSheetByName("RFF_BASE_TEMPLATE") || createOrRefreshBaseTemplate_();
  const newSheet = base.copyTo(ss).setName(targetName);
  newSheet.showSheet();
  return newSheet;
}

function buildGeneralTemplate_(config) {
  var sysName = config.systemSheetName;
  var templateSheet = createTemplateFromBase_(config.templateName || "Template - " + sysName);
  positionSheetBySectionFRank_(templateSheet);
  var targetCols = Math.max(config.columnCount || 0, config.headers ? config.headers.length : 0, 10);
  resizeSheetGrid_(templateSheet, config.minimumRows || 100, targetCols);
  var theme = config.theme || getTemplateTheme_(sysName);
  
  if (config.usesAlternatingColors !== false && sysName !== "Format Dashboard") applyNativeBandingSafe_(templateSheet, 5, targetCols, config.minimumRows || 100, theme.level4, theme.level5);
  
  var titleCell = templateSheet.getRange("A1");
  titleCell.setValue(config.reportTitle || sysName).setFontSize(14).setFontWeight("bold");
  if (theme.level3) templateSheet.getRange(1, 1, 2, targetCols).setBackground(theme.level3);
  if (theme.titleFontColor) titleCell.setFontColor(theme.titleFontColor);
  
  templateSheet.getRange("A2").setValue(config.sheetType === "DATA" ? "Date" : (sysName === "Index" ? "Last Update" : "Date Created"));
  if (config.sheetType === "DATA") templateSheet.getRange("C2").setValue("to");
  
  if (theme.level1) templateSheet.getRange(3, 1, 1, targetCols).setBackground(theme.level1);
  if (theme.level2) templateSheet.getRange(4, 1, 1, targetCols).setBackground(theme.level2);
  
  if (!config.usesSubheaders && config.headers && config.headers.length > 0) {
    templateSheet.getRange(4, 1, 1, config.headers.length).setValues([config.headers]).setFontWeight("bold");
  } else if (config.usesSubheaders && config.subheaders) {
    applySubheaderBlocks_(templateSheet, config.subheaders, theme, sysName);
  }

  applyColumnWidthsEngine_(templateSheet, config);
  if (theme.level1) templateSheet.setTabColor(theme.level1);
  writeTemplateMetadata_(templateSheet, config, targetCols);
  templateSheet.hideSheet();
  return templateSheet;
}

function applySubheaderBlocks_(sheet, subheaders, theme, sysName) {
  var currentRow = 5; var maxCols = sheet.getMaxColumns();
  var b2Specs = loadDashboardConfig_().subheaderRows || [];
  subheaders.forEach(block => {
    [1, 2, 3, 4, 5, 6].forEach(stepNum => {
      var primarySpec = b2Specs.find(s => Number(s.row) === stepNum);
      currentRow++;
      sheet.setRowHeight(currentRow, primarySpec && primarySpec.height ? Number(primarySpec.height) : 25);
      if (primarySpec && primarySpec.fillLevel && primarySpec.fillLevel.toLowerCase() !== "none") {
        const bg = theme[primarySpec.fillLevel.toLowerCase().replace(/[^a-z0-9]/g, "")];
        if (bg) sheet.getRange(currentRow, 1, 1, maxCols).setBackground(bg);
      }
      if (stepNum === 2) {
        sheet.getRange(currentRow, 1).setValue(block.title).setFontSize(14).setFontWeight("bold");
        if (sysName.indexOf("Timing") !== -1 || sysName.indexOf("Quality") !== -1 || block.stampLastUpdated) {
          sheet.getRange(currentRow, 3).setValue("Last Updated").setFontStyle("italic");
        }
      } else if (stepNum === 4 && block.headers) {
        sheet.getRange(currentRow, 1, 1, block.headers.length).setValues([block.headers]).setFontSize(8).setFontWeight("bold").setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
      } else if (stepNum === 6) {
        sheet.getRange(currentRow, 1).setValue("Insert new data here").setFontWeight("normal");
      }
    });
  });
}

// Column Width Logic: General builds use Section C default width list
function applyColumnWidthsEngine_(sheet, config) {
  if (!sheet) return;
  var targetCols = sheet.getMaxColumns();
  var dashConfig = loadDashboardConfig_();
  var defaultColWidth = Number(dashConfig.globals["Default Column Width"]) || 105;
  var widthSpec = String(config.columnWidths || "").trim();

  if (widthSpec && widthSpec.toUpperCase() !== "FIT_TO_DATA" && widthSpec.toUpperCase() !== "AUTO_EXPAND") {
    var parsedWidths = widthSpec.split(",").map(item => parseInt(item.trim(), 10));
    if (parsedWidths.some(w => !isNaN(w) && w > 0)) {
      for (var i = 0; i < targetCols; i++) {
        var colWidth = (i < parsedWidths.length && !isNaN(parsedWidths[i]) && parsedWidths[i] > 0) ? parsedWidths[i] : defaultColWidth;
        sheet.setColumnWidth(i + 1, colWidth);
      }
      return;
    }
  }
  for (var c = 1; c <= targetCols; c++) sheet.setColumnWidth(c, defaultColWidth);
}

// Column Width Logic: Operational templates apply widths by Header matching from Section F
function applyOperationalFormatting_(templateSheet, systemSheetName) {
  if (!templateSheet) return;
  const config = loadDashboardConfig_();
  const headers = config.sheetHeaders[systemSheetName] || config.sheetHeaders[getStandardSheetKey_(systemSheetName)] || [];
  if (!headers.length) return;

  resizeSheetGrid_(templateSheet, templateSheet.getMaxRows(), headers.length);
  templateSheet.getRange(4, 1, 1, headers.length).setValues([headers]).setFontWeight("bold");

  const colDefs = config.columnDefinitions || {};
  const defaultWidth = Number(config.globals["Default Column Width"]) || 105;

  for (let c = 0; c < headers.length; c++) {
    const colDef = colDefs[headers[c]] || colDefs[headers[c].toLowerCase()] || {};
    templateSheet.setColumnWidth(c + 1, (colDef.width && colDef.width > 0) ? colDef.width : defaultWidth);
    
    if (templateSheet.getMaxRows() >= 5) {
      const colRange = templateSheet.getRange(5, c + 1, templateSheet.getMaxRows() - 4, 1);
      if (colDef.format) colRange.setNumberFormat(colDef.format);
      else if (colDef.dateColumn) colRange.setNumberFormat("mm/dd/yyyy");
      if (colDef.align) colRange.setHorizontalAlignment(colDef.align);
      if (colDef.wrap) colRange.setWrapStrategy(colDef.wrap === "WRAP" ? SpreadsheetApp.WrapStrategy.WRAP : SpreadsheetApp.WrapStrategy.CLIP);
    }
  }
}

function getStandardSheetKey_(sysName) {
  const map = { "Banners": "Banners", "CP Due Date": "CP Due Date", "Unlock CP": "Unlock CP", "Raw Data": "Raw Data", "Refined Data": "Refined Data", "Disenrolled Exclusion": "Disenrolled Exclusion", "Master List": "Master List", "Monthly Change": "Monthly Change" };
  return map[sysName] || sysName;
}

function getTemplateConfigFromDashboard_(systemSheetName) {
  const config = loadDashboardConfig_();
  const targetLower = String(systemSheetName || "").toLowerCase().trim();
  let sheetDef = (config.sheetDefinitions || []).find(d => String(d.systemSheetName || "").toLowerCase().trim() === targetLower || String(d.reportTitle || "").toLowerCase().trim() === targetLower);
  if (!sheetDef) sheetDef = { systemSheetName: systemSheetName, reportTitle: systemSheetName, rank: 999, columnCount: 10, columnWidths: "105", usesSubheaders: targetLower.includes("timing") || targetLower.includes("quality"), usesAlternatingColors: true };
  
  let subheaders = [];
  if (targetLower.includes("timing")) subheaders = [ { title: "SECTION A - PROCESS SUMMARY", headers: ["Process", "Runtime", "Status", "Benchmark", "Variance", "Notes"], stampLastUpdated: true }, { title: "SECTION D - DETAILED TIMING LOG", headers: ["Timestamp", "Process", "Step", "Step Seconds", "Total Seconds", "Severity", "Details"], stampLastUpdated: false } ];
  else if (targetLower.includes("quality")) subheaders = [ { title: "SECTION A - FORMAT DASHBOARD VALIDATION" }, { title: "SECTION B - TEMPLATE VALIDATION" }, { title: "SECTION C - RAW DATA VALIDATION" }, { title: "SECTION D - DEMO P QUALITY VALIDATION" }, { title: "SECTION E - DISENROLLED EXCLUSION VALIDATION" }, { title: "SECTION F - MONTHLY CHANGE VALIDATION" }, { title: "SECTION G - MASTER LIST VALIDATION" }, { title: "SECTION H - SUMMARY" } ];
  
  return {
    systemSheetName: systemSheetName,
    templateName: "Template - " + systemSheetName,
    reportTitle: sheetDef.reportTitle || systemSheetName,
    sheetType: subheaders.length > 0 ? "SYSTEM" : "DATA",
    headers: config.sheetHeaders[systemSheetName] || [],
    columnCount: Math.max(sheetDef.columnCount || 10, (config.sheetHeaders[systemSheetName] || []).length),
    minimumRows: 100, rank: sheetDef.rank || 999, columnWidths: sheetDef.columnWidths || "105",
    usesSubheaders: sheetDef.usesSubheaders, usesAlternatingColors: sheetDef.usesAlternatingColors, subheaders: subheaders
  };
}

function writeTemplateMetadata_(sheet, config, targetCols) {
  if (sheet) sheet.getRange(1, targetCols || sheet.getMaxColumns()).setNote(`Template Mold: ${config.systemSheetName}\nVersion: ${MASTER_LIST_MERGE_ML_VERSION}\nUpdated: ${new Date().toISOString()}`);
