}

function flattenDemoPContactRowsInMemory_(data) {
  const pmrIdx = data.headerMap["Participant PMR#"];
  const priIdx = data.headerMap["Primary PMR Row"];
  if (pmrIdx === undefined || priIdx === undefined) return;
  const grouped = new Map();
  data.values.forEach(row => { const pmr = row[pmrIdx]; if (!grouped.has(pmr)) grouped.set(pmr, []); grouped.get(pmr).push(row); });
  
  const flat = [];
  grouped.forEach(rows => {
    let pri = rows.find(r => isPrimaryPMRRowValue_(r[priIdx])) || rows[0];
    flat.push(pri); // Simplified contact flattening for stable layout
  });
  data.values = flat;
}

