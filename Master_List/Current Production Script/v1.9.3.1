function runDashboardQualityConfigVerificationSections_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const report = ss.getSheetByName("Dashboard Quality Report");
  if (!report) return;
  const db = ss.getSheetByName("Format Dashboard");
  const rows = [ ["Global Settings", db ? "PASS" : "FAIL", "Dashboard Verification"] ];
  writeSubheaderSectionData_(report, "SECTION A - FORMAT DASHBOARD VALIDATION", rows);
}

function writeSubheaderSectionData_(sheet, sectionTitle, dataMatrix) {
  if (!sheet || !dataMatrix.length) return;
  const vals = sheet.getDataRange().getValues();
  let anchor = -1;
  for (let r = 0; r < vals.length; r++) { if (String(vals[r][0]).toUpperCase().includes(sectionTitle.toUpperCase())) { anchor = r + 1; break; } }
  if (anchor === -1) return;
  
  const startRow = anchor + 4;
  sheet.getRange(startRow, 1, 50, 7).clearContent().setBackground(null);
  const out = dataMatrix.map(r => padRowToWidth_(r, 7));
  const rng = sheet.getRange(startRow, 1, out.length, 7);
  rng.setValues(out);
  rng.setBackgrounds(out.map(r => new Array(7).fill(String(r[1]).includes("FAIL") ? "#F8D7DA" : null)));
}
