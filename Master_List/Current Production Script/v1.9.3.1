function showSystemSheets_() { ["Format Dashboard", "Framework Timing Report", "Dashboard Quality Report", "Index"].forEach(n => showSheetIfNeeded_(SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n))); }
