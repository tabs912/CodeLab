function safeSheetName_(value) { return String(value || "").trim().replace(/[\\\/\?\*\[\]:]/g, "-").substring(0, 99); }
function setRequiredSheetName_(sheet, targetName) {
  if (!sheet) return;
  if (sheet.getParent().getSheetByName(targetName)) throw new Error(`Sheet "${targetName}" already exists. Please resolve conflict.`);
  sheet.setName(targetName);
}
function deleteSheetIfExists_(ss, sheetName) {
  const target = ss.getSheetByName(sheetName);
  if (target && ss.getSheets().length > 1) ss.deleteSheet(target);
}
function ensureOutputSheetHasFormattedRows_(sheet, reqMaxRow, colCount) {
  if (!sheet) return;
  if (sheet.getMaxRows() < reqMaxRow) sheet.insertRowsAfter(sheet.getMaxRows(), reqMaxRow - sheet.getMaxRows());
  if (sheet.getMaxColumns() < colCount) sheet.insertColumnsAfter(sheet.getMaxColumns(), colCount - sheet.getMaxColumns());
}
function hideSheetIfNeeded_(sheet, timing, logMsg) {
  if (sheet && !sheet.isSheetHidden()) { activateVisibleSheetBeforeHiding_(sheet); sheet.hideSheet(); if (timing) markFrameworkStep_(timing, logMsg, "Hidden"); }
}
function showSheetIfNeeded_(sheet, timing, logMsg) {
  if (sheet && sheet.isSheetHidden()) { sheet.showSheet(); if (timing) markFrameworkStep_(timing, logMsg, "Shown"); }
}
function activateVisibleSheetBeforeHiding_(sheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss.getActiveSheet().getName() === sheet.getName()) {
    const other = ss.getSheets().find(s => s.getName() !== sheet.getName() && !s.isSheetHidden());
    if (other) ss.setActiveSheet(other);
  }
}
function extractFirstDateFromSheetName_(name) {
  const match = String(name || "").match(/(\d{2})[.\/-](\d{2,4})/);
  if (match) {
    let y = parseInt(match[2], 10);
    return new Date(y < 100 ? y + 2000 : y, parseInt(match[1], 10) - 1, 1);
  }
  return new Date();
}

var ML_TIMING_CACHE_ = { startTime: null, lastStepTime: null, logs: [] };
function logFrameworkTiming_(process, step, severity, details) {
  const now = new Date();
  if (!ML_TIMING_CACHE_.startTime) { ML_TIMING_CACHE_.startTime = now; ML_TIMING_CACHE_.lastStepTime = now; }
  const stepSec = (now.getTime() - ML_TIMING_CACHE_.lastStepTime.getTime()) / 1000;
  const totalSec = (now.getTime() - ML_TIMING_CACHE_.startTime.getTime()) / 1000;
  ML_TIMING_CACHE_.logs.push([Utilities.formatDate(now, Session.getScriptTimeZone(), "MM/dd/yyyy HH:mm"), process, step, Number(stepSec.toFixed(3)), Number(totalSec.toFixed(3)), severity || "INFO", details || ""]);
  ML_TIMING_CACHE_.lastStepTime = now;
}
function markFrameworkStep_(timing, stepName, details) { logFrameworkTiming_("PROCESS", stepName, "INFO", details || ""); }
function runFrameworkTimed_(processName, func) {
  initTimingClock_();
  logFrameworkTiming_(processName, "Start Process", "INFO", processName);
  try {
    const res = func(ML_TIMING_CACHE_);
    logFrameworkTiming_(processName, "End Process", "INFO", processName + " completed");
    flushFrameworkTimingReport_();
    return res;
  } catch (err) {
    logFrameworkTiming_(processName, "Error", "ERROR", err.message);
    flushFrameworkTimingReport_();
    throw err;
  }
}

