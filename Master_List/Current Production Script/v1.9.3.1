}

function loadDashboardConfig_() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Format Dashboard") || SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Default - Format Dashboard");
  const config = { globals: {}, sheetDefinitions: [], columnDefinitions: {}, sheetHeaders: {} };
  if (!sheet) return config;
  const values = sheet.getDataRange().getValues();
  let currentSection = "";
  let headers = [];
  for (let r = 0; r < values.length; r++) {
    const cellA = String(values[r][0]).trim();
    if (cellA.indexOf("SECTION ") === 0) { currentSection = cellA; headers = []; continue; }
    if (!currentSection || !cellA) continue;
    if (headers.length === 0 && values[r].some(v => v !== "")) { headers = values[r].map(v => String(v).trim().toLowerCase()); continue; }
    
    if (currentSection.includes("GLOBAL SETTINGS")) config.globals[cellA] = values[r][1];
    else if (currentSection.includes("SECTION C")) config.sheetDefinitions.push({ systemSheetName: cellA, reportTitle: values[r][2], rank: Number(values[r][3]) || 999, baseColor: values[r][4], columnWidths: values[r][12], usesAlternatingColors: values[r][16] !== false, usesSubheaders: values[r][17] === true });
    else if (currentSection.includes("SECTION F")) config.columnDefinitions[cellA.toLowerCase()] = { width: Number(values[r][1]), dateColumn: values[r][3] === true, wrap: String(values[r][5]).toUpperCase(), align: String(values[r][6]).toLowerCase(), format: values[r][8] };
    else if (currentSection.includes("SECTION G") || currentSection.includes("SECTION H")) {
      if (!config.sheetHeaders[cellA]) config.sheetHeaders[cellA] = [];
      if (values[r][2]) config.sheetHeaders[cellA].push(values[r][2]);
    }
  }
  return config;
}

function hexToHsl_(hex) {
  let c = String(hex || "").replace('#', '').trim(); if (c.length === 3) c = c.split('').map(x => x + x).join('');
  if (c.length !== 6) return { h: 200, s: 50, l: 50 };
  const r = parseInt(c.substring(0, 2), 16) / 255, g = parseInt(c.substring(2, 4), 16) / 255, b = parseInt(c.substring(4, 6), 16) / 255;
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  let h = 0, s = 0, l = (max + min) / 2;
  if (max !== min) {
    const d = max - min; s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    if (max === r) h = (g - b) / d + (g < b ? 6 : 0); else if (max === g) h = (b - r) / d + 2; else h = (r - g) / d + 4; h /= 6;
  }
  return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
}
function hslToHex_(h, s, l) {
  l /= 100; const a = (s * Math.min(l, 1 - l)) / 100;
  const f = n => { const k = (n + h / 30) % 12; return Math.round(255 * (l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1))).toString(16).padStart(2, '0'); };
  return `#${f(0)}${f(8)}${f(4)}`.toUpperCase();
}
function calculateThemeLevels_(baseHex) {
  const hsl = hexToHsl_(baseHex);
  return { base: baseHex, level1: hslToHex_(hsl.h, hsl.s, 60), level2: hslToHex_(hsl.h, hsl.s, 75), level3: hslToHex_(hsl.h, hsl.s, 85), level4: hslToHex_(hsl.h, hsl.s, 97), level5: hslToHex_(hsl.h, hsl.s, 99) };
}
function getTemplateTheme_(sysName) {
  const config = loadDashboardConfig_();
  const def = config.sheetDefinitions.find(d => d.systemSheetName.toLowerCase() === sysName.toLowerCase());
  return calculateThemeLevels_(def && def.baseColor && /^#[0-9A-F]{6}$/i.test(def.baseColor) ? def.baseColor : "#79B5D2");
}
function recalculateDashboardHexCodes_(sheet) {
  const values = sheet.getDataRange().getValues();
  for (let r = 0; r < values.length; r++) {
    const hex = String(values[r][4] || "").trim();
    if (/^#[0-9A-F]{6}$/i.test(hex) && values[r][0] && values[r][0].indexOf("SECTION") === -1) {
      const theme = calculateThemeLevels_(hex);
      sheet.getRange(r+1, 6, 1, 5).setValues([[theme.level1, theme.level2, theme.level3, theme.level4, theme.level5]]);
    }
  }
}

function resizeSheetGrid_(sheet, reqRows, reqCols) {
  if (sheet.getMaxRows() < reqRows) sheet.insertRowsAfter(sheet.getMaxRows(), reqRows - sheet.getMaxRows());
  else if (sheet.getMaxRows() > reqRows) sheet.deleteRows(reqRows + 1, sheet.getMaxRows() - reqRows);
  if (sheet.getMaxColumns() < reqCols) sheet.insertColumnsAfter(sheet.getMaxColumns(), reqCols - sheet.getMaxColumns());
  else if (sheet.getMaxColumns() > reqCols) sheet.deleteColumns(reqCols + 1, sheet.getMaxColumns() - reqCols);
}
function applyNativeBandingSafe_(sheet, startRow, totalCols, totalRows, c1, c2) {
  if (!sheet || totalRows < startRow) return;
  try {
    sheet.getBandings().forEach(b => b.remove());
    var banding = sheet.getRange(startRow, 1, totalRows - startRow + 1, totalCols).applyRowBanding(SpreadsheetApp.BandingTheme.CUSTOM, false, false);
    banding.setFirstRowColor(c1 || "#eff8cf").setSecondRowColor(c2 || "#ffffff");
  } catch (e) {}
}

function createActiveSystemSheets() {
  const timeStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "MM/dd/yyyy HH:mm:ss");
  ["Format Dashboard", "Framework Timing Report", "Dashboard Quality Report", "Index"].forEach(name => {
    let active = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
    if (!active) {
      const template = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Template - " + name) || SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Default - " + name);
      if (template) active = template.copyTo(SpreadsheetApp.getActiveSpreadsheet()).setName(name);
    }
    if (active) {
      active.showSheet();
      if (name !== "Format Dashboard") active.getRange("B2").setValue(timeStr);
      if (name.includes("Timing") || name.includes("Quality")) {
        const vals = active.getDataRange().getValues();
        for (let r = 0; r < vals.length; r++) { if (String(vals[r][0]).indexOf("SECTION ") === 0) { active.getRange(r+2, 3).setValue("Last Updated - " + timeStr); break; } }
      }
    }
  });
}

