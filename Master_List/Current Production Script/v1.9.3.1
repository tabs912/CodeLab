function buildRefinedDataFromScratch() {
  const monthParts = promptForLockedYearReportMonth_("Build Refined Data");
  if (!monthParts) return null;
  return runFrameworkTimed_("Build Refined Data", timing => {
    const rawSheet = getCurrentRawDataSheet_(monthParts);
    if (!rawSheet) throw new Error("Raw Data missing for month.");
    
    const rawData = getDataValues_(rawSheet, 4, 5);
    const headers = loadDashboardConfig_().sheetHeaders["Refined Data"] || [];
    const mapped = mapRowsToHeaders_(rawData.values, rawData.headers, headers);
    
    const data = { headers, headerMap: buildHeaderIndexMap_(headers), values: mapped };
    flattenDemoPContactRowsInMemory_(data);
    
    const demoSheet = ss.getSheetByName("Refined Data") || ss.insertSheet("Refined Data");
    demoSheet.clearContent();
    ensureOutputSheetHasFormattedRows_(demoSheet, 5 + data.values.length, headers.length);
    demoSheet.getRange(4, 1, 1, headers.length).setValues([headers]);
    if (data.values.length) demoSheet.getRange(5, 1, data.values.length, headers.length).setValues(data.values);
    
    notify_(`Refined Data generated! ${data.values.length} profiles.`);
  });
}

function updateRefinedDataMonthlySync() {
