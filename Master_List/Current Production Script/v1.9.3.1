function hideMonthlySheetsBySpecs_(processName, parsedMonth, specs) {
  return runFrameworkTimed_(processName, timing => {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    specs.forEach(spec => {
      findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate).forEach(sheet => hideSheetIfNeeded_(sheet, timing, "Hidden: " + sheet.getName()));
    });
  });
}

function archiveMonthlySheetsBySpecs_(parsedMonth, specs, timing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const archiveSs = openArchiveSpreadsheetOnce_();
  const result = { archived: [], failed: [] };
  if (!archiveSs) { logBestEffortWarning_("Archive Failed: Archive Spreadsheet inaccessible."); return result; }

  specs.forEach(spec => {
    findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate).forEach(sheet => {
      try {
        const copied = sheet.copyTo(archiveSs);
        copied.setName(sheet.getName() + " (Archived " + Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy") + ")");
        deleteSheetSafely_(ss, sheet, "Archived");
        result.archived.push(sheet.getName());
      } catch (err) { result.failed.push(sheet.getName()); }
    });
  });
  return result;
}

function findArchiveMonthlyCandidateSheetsUpToDate_(ss, keywords, cutoffDate) {
  const keywordList = (keywords || []).map(k => String(k).trim().toLowerCase()).filter(Boolean);
  const cutoffKey = cutoffDate ? Number(Utilities.formatDate(cutoffDate, Session.getScriptTimeZone(), "yyyyMM")) : 0;
  return ss.getSheets().filter(sheet => {
    const name = sheet.getName().toLowerCase();
    if (name.indexOf("template") !== -1) return false;
    if (!keywordList.some(k => name.indexOf(k) !== -1)) return false;
    const sheetDate = extractFirstDateFromSheetName_(sheet.getName());
    return Number(Utilities.formatDate(sheetDate, Session.getScriptTimeZone(), "yyyyMM")) <= cutoffKey;
  });
}

function openArchiveSpreadsheetOnce_() {
  try {
    const id = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "1PEEoXzPG-xRFuqDW_ZjPzyqdTUd_5AOwx0nbbzmMwBc";
    return SpreadsheetApp.openById(id);
  } catch(e) { return null; }
}
function deleteSheetSafely_(ss, sheetToDelete, logReason) {
  if (!ss || !sheetToDelete) return;
  try { if (ss.getSheets().length > 1) { activateVisibleSheetBeforeHiding_(sheetToDelete); ss.deleteSheet(sheetToDelete); } } 
  catch (e) { logBestEffortWarning_(`Could not delete sheet '${sheetToDelete.getName()}': ${e.message}`); }
}

function saveActiveLayoutAsRebuildDefault() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const layout = ss.getSheets().map((s, index) => ({ name: s.getName(), index: index + 1, hidden: s.isSheetHidden() }));
  PropertiesService.getDocumentProperties().setProperty("REBUILD_DEFAULT_LAYOUT", JSON.stringify(layout));
  notify_("Active Layout Rules Successfully Saved to Document Properties!");
}

function organizeTabs() { SpreadsheetApp.getActiveSpreadsheet().getSheets().forEach(s => positionSheetBySectionFRank_(s)); notify_("Sheet Tabs Re-organized!"); }
function positionSheetBySectionFRank_(sheet) {
  if (!sheet) return;
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var targetRank = getTargetRankForSheet_(sheet.getName());
    var sheets = ss.getSheets();
    var targetPos = 1;
    for (var i = 0; i < sheets.length; i++) {
      if (sheets[i].getName() === sheet.getName()) continue;
      if (getTargetRankForSheet_(sheets[i].getName()) < targetRank) targetPos++;
    }
    ss.setActiveSheet(sheet);
    ss.moveActiveTab(Math.min(Math.max(1, targetPos), sheets.length));
  } catch (e) {}
}
function getTargetRankForSheet_(sheetName) {
  const cleanName = String(sheetName || "").trim().toLowerCase().replace(/[^a-z0-9]/g, "");
  const rules = [
    { prefix: "index", rank: 1 }, { prefix: "refineddata", rank: 2 }, { prefix: "disenrolled", rank: 10 },
    { prefix: "masterlist", rank: 21 }, { prefix: "monthlychange", rank: 22 }, { prefix: "rawdata", rank: 23 },
    { prefix: "banners", rank: 24 }, { prefix: "cpdue", rank: 25 }, { prefix: "unlockcp", rank: 26 },
    { prefix: "timing", rank: 500 }, { prefix: "quality", rank: 501 }, { prefix: "formatdashboard", rank: 502 }
  ];
  for (let i = 0; i < rules.length; i++) { if (cleanName === rules[i].prefix || cleanName.indexOf(rules[i].prefix) === 0) return rules[i].rank; }
  return sheetName.indexOf("Template") === 0 ? 800 : 999;
}

