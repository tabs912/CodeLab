function buildFormatDashboardTemplate_() {
  const dashSheet = buildGeneralTemplate_({ systemSheetName: "Format Dashboard", templateName: "Default - Format Dashboard", reportTitle: "Format Dashboard", sheetType: "SYSTEM", columnCount: 19, minimumRows: 150, rank: 502, columnWidths: "220, 150, 215, 165, 130, 120, 120, 120, 140, 120, 120, 306, 144, 100, 100, 110, 100" });
  const dashWidth = 19; const dashRows = [ ["Format Dashboard", "- v1.8.9.8.2 -"], ["Date Created", ""] ];
  const appendSection = (title, headers, rows) => {
    dashRows.push(new Array(dashWidth).fill(""), [title].concat(new Array(dashWidth-1).fill("")), new Array(dashWidth).fill(""), headers.concat(new Array(dashWidth-headers.length).fill("")), new Array(dashWidth).fill(""));
    rows.forEach(r => dashRows.push(padRowToWidth_(r, dashWidth)));
  };
  appendSection("SECTION A - GLOBAL SETTINGS", ["Setting", "Value", "Notes"], [["Header Row", 4], ["Data Start Row", 5], ["Default Date Format", "mm/dd/yyyy"], ["Default Column Width", 105], ["Standard Font", "Arial"], ["HSL Level 1 Lightness %", 60], ["HSL Level 2 Lightness %", 75], ["HSL Level 3 Lightness %", 85], ["HSL Level 4 Lightness %", 97], ["HSL Level 5 Lightness %", 99]]);
  appendSection("SECTION C -  Template Structural Specs", ["System Sheet Name", "Group", "Report Title", "Tab Position Rank", "Base Color", "Level 1", "Level 2", "Level 3", "Level 4", "Level 5", "Title Font Color", "Column Count", "Default Column Widths", "Row Mode", "Minimum Rows", "Buffer Rows", "Uses Alternating Colors", "Uses Subheaders"], [["Refined Data", "Core Operational", "Refined Data", 805, "#657FCC", "", "", "", "", "", "#000000", 10, "FIT_TO_DATA", "AUTO_EXPAND", 100, 0, true, false]]);
  appendSection("SECTION F - COLUMN DEFINITIONS", ["Header", "Width", "Header Font Size", "Date Column", "Hide Column", "Data Wrap", "Horizontal Alignment", "Vertical Alignment", "Number Format"], [["Participant Name", 250, 10, false, false, "CLIP", "left", "middle", ""], ["Date of Birth", 90, 10, true, false, "CLIP", "left", "middle", "mm/dd/yyyy"]]);
  appendSection("SECTION G - SHEET HEADERS", ["Sheet Type", "Column Order", "Header", "Source"], [["Refined Data", 1, "Participant Name"], ["Refined Data", 2, "Date of Birth"]]);
  
  dashSheet.getRange(1, 1, dashRows.length, dashWidth).setValues(dashRows);
  recalculateDashboardHexCodes_(dashSheet);
  const theme = getTemplateTheme_("Format Dashboard");
  applyNativeBandingSafe_(dashSheet, 5, dashWidth, dashSheet.getMaxRows(), theme.level4, theme.level5);
  for (let r = 0; r < dashRows.length; r++) {
    if (String(dashRows[r][0]).indexOf("SECTION ") === 0) {
      dashSheet.getRange(r+1, 1, 1, dashWidth).setBackground(theme.level3).setFontWeight("bold");
      dashSheet.getRange(r+3, 1, 1, dashWidth).setBackground(theme.level2).setFontSize(8).setFontWeight("bold");
    }
