function populateActiveIndex() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Index");
  if (!sheet) return;
  
  const rules = [
    { prefix: "index", group: "System", rank: 1 }, { prefix: "refineddata", group: "Core", rank: 2 }, { prefix: "disenrolled", group: "Core", rank: 10 },
    { prefix: "masterlist", group: "Monthly", rank: 21 }, { prefix: "rawdata", group: "Monthly", rank: 23 }
  ];
  
  const activeRows = ss.getSheets().map(s => {
    const n = s.getName();
    if (n === "Index" || n.includes("Template")) return null;
    const cleanName = n.toLowerCase().replace(/[^a-z0-9]/g, "");
    const match = rules.find(r => cleanName.indexOf(r.prefix) === 0) || { group: "Unformatted", rank: 999 };
    return { name: n, group: match.group, rank: match.rank, visibility: s.isSheetHidden() ? "Hidden" : "Visible", link: `=HYPERLINK("#gid=${s.getSheetId()}", "Open Tab")` };
  }).filter(Boolean).sort((a, b) => a.rank !== b.rank ? a.rank - b.rank : a.name.localeCompare(b.name));

  const rawRows = [ ["Active Index", "", "", "", "", "Archive File ID", PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["Group", "Sheet Tab Name", "Link", "Visibility", "", "", "", "", "", ""] ];
  let currentGroup = "";
  const dividers = [];
  
  activeRows.forEach(act => {
    if (act.group !== currentGroup) { currentGroup = act.group; rawRows.push([currentGroup, "", "", "", "", "", "", "", "", ""]); dividers.push(rawRows.length); }
    rawRows.push(["", act.name, act.link, act.visibility, "", "", "", "", "", ""]);
  });

  resizeSheetGrid_(sheet, Math.max(rawRows.length, 20), 10);
  sheet.getRange(1, 1, rawRows.length, 10).setValues(rawRows);
  sheet.getRange(3, 1, 1, 10).setBackground("#A5D0E3").setFontWeight("bold");
  dividers.forEach(r => sheet.getRange(r, 1, 1, 4).setBackground("#C4E2F0").setFontWeight("bold"));
  sheet.setFrozenRows(3);
}

function restoreSheetFromActiveIndexRow() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();
  if (sheet.getName() !== "Index" || sheet.getActiveRange().getRow() < 4) return SpreadsheetApp.getUi().alert("Select a valid sheet row on the Index.");
  const target = ss.getSheetByName(String(sheet.getRange(sheet.getActiveRange().getRow(), 2).getValue()).trim());
  if (target) { target.showSheet(); ss.setActiveSheet(target); } else SpreadsheetApp.getUi().alert("Sheet not found locally. Check Archives.");
}
