function runFormatterPipeline_(routeCodes, processTitle) {
  const monthParts = promptForLockedYearReportMonth_(processTitle || "Format Monthly Sheets");
  if (!monthParts) return null;

  return runFrameworkTimed_("Format " + monthParts.label, timing => {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const archiveSs = openArchiveSpreadsheetOnce_();
    const dashboard = loadDashboardConfig_();
    const completed = [], skipped = [];

    (routeCodes || ["B", "CD", "UC", "RD"]).forEach(code => {
      const route = FORMATTER_ROUTES[code];
      const sourceSheet = ss.getSheetByName(`${route.prefix} ${monthParts.label}`) || ss.getSheetByName(`Source - ${route.prefix} ${monthParts.label}`);
      if (!sourceSheet) { skipped.push(route.prefix); return; }
      
      const out = processSingleSubReport_(ss, sourceSheet, route, monthParts, dashboard, archiveSs, timing);
      if (out) completed.push(route.prefix);
    });
    
    populateActiveIndex();
    notify_(`Format Complete!\nDone: ${completed.join(", ")}\nSkipped: ${skipped.join(", ")}`);
    return { completed, skipped };
  });
}

function processSingleSubReport_(ss, sourceSheet, route, monthParts, dashboard, archiveSs, timing) {
  let template = ss.getSheetByName("Template - " + route.sheetType) || ss.getSheetByName("RFF_BASE_TEMPLATE");
  if (!template) throw new Error("Template missing.");

  const outputName = route.prefix + " " + monthParts.label;
  const rawData = getDataValues_(sourceSheet, 4, 5);
  const targetHeaders = dashboard.sheetHeaders[route.sheetType] || [];
  const outputRows = mapRowsToHeaders_(rawData.values, rawData.headers, targetHeaders);

  deleteSheetIfExists_(ss, outputName);
  const outputSheet = template.copyTo(ss).setName(outputName);
  outputSheet.showSheet();

  if (outputRows.length > 0) {
    ensureOutputSheetHasFormattedRows_(outputSheet, 5 + outputRows.length - 1, targetHeaders.length);
    outputSheet.getRange(5, 1, outputRows.length, Math.max(targetHeaders.length, 1)).setValues(outputRows);
  }

  outputSheet.getRange("A1").setValue(route.sheetType);
  outputSheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("m/d/yyyy");
  outputSheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("m/d/yyyy");

  headers = targetHeaders;
  headers.forEach((h, idx) => {
    const def = dashboard.columnDefinitions[h.toLowerCase()];
    if (def && def.dateColumn) outputSheet.getRange(5, idx + 1, Math.max(outputRows.length, 1), 1).setNumberFormat(def.format || "mm/dd/yyyy");
  });

  // RR-006 Fix: Strict Archive Verification
  let archivedSuccessfully = false;
  if (archiveSs) {
    try {
      const copied = sourceSheet.copyTo(archiveSs);
      copied.setName(`Source - ${outputName} (Archived)`);
      archivedSuccessfully = true;
    } catch(e) { logBestEffortWarning_("Archive failed: " + e.message); }
  }

  if (route.deleteLocal) {
    if (archivedSuccessfully) deleteSheetSafely_(ss, sourceSheet, "Archived and deleted");
    else logBestEffortWarning_(`Skipped deletion of ${sourceSheet.getName()} because archive failed.`);
  }

  return outputSheet;
}

