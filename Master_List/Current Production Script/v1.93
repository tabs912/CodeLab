function appendDashboardSectionRows_(rows, sectionName, headers, dataRows, width) {
  const emptyRow = new Array(width).fill("");
  rows.push(emptyRow);

  const bannerRow = new Array(width).fill("");
  bannerRow[0] = sectionName;
  rows.push(bannerRow);

  rows.push(emptyRow);

  const headerRow = new Array(width).fill("");
  for (let i = 0; i < headers.length; i++) {
    headerRow[i] = headers[i];
  }
  rows.push(headerRow);

  rows.push(emptyRow);
  (dataRows || []).forEach(row => {
    const paddedRow = row.slice(0, width);
    while (paddedRow.length < width) paddedRow.push("");
    rows.push(paddedRow);
  });
}

function createActiveSystemSheets() {
  const timeStr = Utilities.formatDate(new Date(), SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss");

  const dashActive = createActiveSheetFromTemplate_("Default - Format Dashboard", "Format Dashboard") ||
                     createActiveSheetFromTemplate_("Template - Format Dashboard", "Format Dashboard");
  if (dashActive) {
    dashActive.getRange("A2").setValue("Date Created");
    dashActive.getRange("B2").setValue(timeStr);
  }

  const timingActive = createActiveSheetFromTemplate_("Template - Framework Timing Report", "Framework Timing Report") ||
                       createActiveSheetFromTemplate_("Template - Timing", "Framework Timing Report");
  if (timingActive) {
    timingActive.getRange("A2").setValue("Date Created");
    timingActive.getRange("B2").setValue(timeStr);
    stampActiveSubheaderTimestampNote_(timingActive, timeStr);
  }

  const qualityActive = createActiveSheetFromTemplate_("Template - Dashboard Quality Report", "Dashboard Quality Report") ||
                        createActiveSheetFromTemplate_("Template - Quality", "Dashboard Quality Report");
  if (qualityActive) {
    qualityActive.getRange("A2").setValue("Date Created");
    qualityActive.getRange("B2").setValue(timeStr);
    stampActiveSubheaderTimestampNote_(qualityActive, timeStr);
  }

  const indexActive = createActiveSheetFromTemplate_("Template - Index", "Index");
  if (indexActive) {
    indexActive.getRange("A2").setValue("Last Update");
    indexActive.getRange("B2").setValue(timeStr);
  }
}

function stampActiveSubheaderTimestampNote_(sheet, timeStr) {
  if (!sheet) return;
  const values = sheet.getDataRange().getValues();
  for (let r = 0; r < values.length; r++) {
    if (String(values[r][0] || "").indexOf("SECTION ") === 0) {
      const bannerRow = r + 1; 
      sheet.getRange(bannerRow, 3).setValue("Last Updated - " + timeStr);
      break;
    }
  }
}

function createActiveSheetFromTemplate_(templateName, activeName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const template = ss.getSheetByName(templateName);
  if (!template) return null;

  const existingActive = ss.getSheetByName(activeName);
  if (existingActive) {
    ss.deleteSheet(existingActive);
    SpreadsheetApp.flush();
  }

  const activeSheet = template.copyTo(ss);
  activeSheet.setName(activeName);
  activeSheet.showSheet();
  SpreadsheetApp.flush();

  if (typeof positionSheetBySectionFRank_ === "function") {
    positionSheetBySectionFRank_(activeSheet);
  }
  return activeSheet;
}

// ============================================================================
// MODULE 4 v1.93: SYSTEM INDEX FUNCTIONS & PROCESS HANDLERS
// File: 04_Index.gs
// ============================================================================

function updateIndexSheet(archiveSs) {
  if (typeof populateIndexData === "function") {
    populateIndexData("Index");
  } else if (typeof populateActiveIndex === "function") {
    populateActiveIndex();
  }
}

function populateActiveIndex() {
  populateIndexData("Index");
}

function populateIndexData(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = targetName || "Index";
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;

  const timestampStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss");
  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "";

  const sectionFRules = (typeof loadSectionFTabRules_ === "function") ? loadSectionFTabRules_() : [];
  const activeSheets = ss.getSheets();
  const activeRows = [];

  activeSheets.forEach(s => {
    const name = s.getName();
    if (name !== sheetName && name !== "Template - Index") {
      const visibility = s.isSheetHidden() ? "Hidden" : "Visible";
      let match = { group: "Unformatted", rank: 999 };
      if (typeof matchSheetToSectionFRule_ === "function") {
        match = matchSheetToSectionFRule_(name, sectionFRules);
      }
      const link = `=HYPERLINK("#gid=${s.getSheetId()}", "Open Live Tab")`;

      activeRows.push({
        name: name,
        group: match.group,
        rank: match.rank,
        link: link,
        visibility: visibility
      });
    }
  });

  activeRows.sort((a, b) => {
    if (a.rank !== b.rank) return a.rank - b.rank;
    return a.name.localeCompare(b.name);
  });

  const headers = [
    "Section/Month", "Sheet Tab Name", "Workspace Link", "Visibility",
    "", "Archive Month", "Archive Sheet Name", "Link to Sheet", "Restore Action", "Status"
  ];

  const rawRows = [
    ["Active Index", "", "", "", "", "Archive Index", "", "", "", ""],
    ["Generated", timestampStr, "", "", "", "Archive File ID", archiveId, "", "", ""],
    ["", "", "", "", "", "", "", "", "", ""],
    headers
  ];

  let currentGroupDivider = "";
  let activeIdx = 0;
  const dividerRowIndices = [];

  while (activeIdx < activeRows.length) {
    const act = activeRows[activeIdx];

    if (act && act.group !== currentGroupDivider) {
      currentGroupDivider = act.group;
      rawRows.push([currentGroupDivider, "", "", "", "", "", "", "", "", ""]);
      dividerRowIndices.push(rawRows.length);
      continue;
    }

    if (act) {
      rawRows.push(["", act.name, act.link, act.visibility, "", "", "", "", "", ""]);
      activeIdx++;
    }
  }

  if (typeof resizeSheetGrid_ === "function") {
    resizeSheetGrid_(sheet, Math.max(rawRows.length, 20), 10);
  }
  
  sheet.getRange(1, 1, rawRows.length, 10).setValues(rawRows);
  formatIndexSheet_(sheet, dividerRowIndices);
}

function formatIndexSheet_(sheet, dividerRowIndices) {
  if (!sheet) return;  
  const theme = typeof getTemplateTheme_ === "function" ? getTemplateTheme_("Index") : { level3: "#ccc", level1: "#eee", level2: "#ddd", level4: "#fff", level5: "#fafafa"};
  const maxGridRows = sheet.getMaxRows();
  const lastRow = Math.max(sheet.getLastRow(), 4);

  sheet.getRange(1, 1, 1, 4).setBackground(theme.level3).setFontSize(14).setFontWeight("bold");
  sheet.getRange(1, 6, 1, 5).setBackground(theme.level3).setFontSize(14).setFontWeight("bold");
  
  sheet.getRange(2, 1, 1, 4).setBackground(theme.level3).setFontSize(10).setFontWeight("normal");
  sheet.getRange(2, 6, 1, 5).setBackground(theme.level3).setFontSize(10).setFontWeight("normal");

  sheet.getRange(3, 1, 1, 10).setBackground(theme.level1).setFontSize(10).setFontWeight("normal");

  sheet.getRange(4, 1, 1, 4).setBackground(theme.level2).setFontSize(10).setFontWeight("bold");
  sheet.getRange(4, 6, 1, 5).setBackground(theme.level2).setFontSize(10).setFontWeight("bold");

  if (lastRow >= 5 && typeof applyNativeBandingSafe_ === "function") {
    applyNativeBandingSafe_(sheet, 5, 10, lastRow, theme.level4, theme.level5);
  }

  sheet.getRange(1, 5, maxGridRows, 1).setBackground(theme.level1);

  if (dividerRowIndices && dividerRowIndices.length > 0) {
    dividerRowIndices.forEach(rIdx => {
      if (rIdx >= 5 && rIdx <= lastRow) {
        sheet.getRange(rIdx, 1, 1, 4).setBackground(theme.level2);
        sheet.getRange(rIdx, 1).setFontWeight("bold");
      }
    });
  }

  if (typeof applyColumnWidths_ === "function") {
    applyColumnWidths_(sheet, "160, 185, 160, 160, 30, 160, 185, 160, 160, 160");
  }
  sheet.setFrozenRows(4);
  sheet.setFrozenColumns(1);
}

function restoreSheetFromActiveIndexRow() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const activeSheet = ss.getActiveSheet();

  if (activeSheet.getName().indexOf("Index") === -1) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "Please select a row on the Index sheet to navigate or restore.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const activeRow = activeSheet.getActiveRange().getRow();
  if (activeRow < dataStart) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "Please select a valid data row (Row 5 or lower).", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const sheetName = String(activeSheet.getRange(activeRow, 2).getValue() || "").trim();
  if (!sheetName) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "No valid sheet tab name found on the selected row.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const targetSheet = ss.getSheetByName(sheetName);
  if (targetSheet) {
    if (targetSheet.isSheetHidden()) {
      targetSheet.showSheet();
    }
    ss.setActiveSheet(targetSheet);
    ss.toast(`Unhid and navigated to: "${sheetName}"`, "Index Navigation", 3);
  } else {
    SpreadsheetApp.getUi().alert("Sheet Not Found", `Sheet "${sheetName}" was not found in the local spreadsheet. Use the Restore Web App link in Column 9 if it is archived.`, SpreadsheetApp.getUi().ButtonSet.OK);
  }
}

function configureIndexRestoreWebAppUrl() {
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getDocumentProperties();
  const currentUrl = props.getProperty("INDEX_RESTORE_WEB_APP_URL") || "";

  const response = ui.prompt(
    "Configure Restore Web App URL",
    `Current Web App URL: ${currentUrl || "Not Configured"}\n\nEnter published Web App URL for external sheet restores:`,
    ui.ButtonSet.OK_CANCEL
  );

  if (response.getSelectedButton() === ui.Button.OK) {
    const newUrl = response.getResponseText().trim();
    props.setProperty("INDEX_RESTORE_WEB_APP_URL", newUrl);
    ui.alert("Configuration Saved", "Index Restore Web App URL successfully updated.", ui.ButtonSet.OK);
  }
}

function configureArchiveSpreadsheetId() {
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getDocumentProperties();
  const currentId = props.getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || (typeof RFF_ARCHIVE_SPREADSHEET_ID !== "undefined" ? RFF_ARCHIVE_SPREADSHEET_ID : "");

  const response = ui.prompt(
    "Configure Archive Spreadsheet ID",
    `Current Archive File ID: ${currentId || "Not Configured"}\n\nEnter Google Drive File ID for the central archive spreadsheet:`,
    ui.ButtonSet.OK_CANCEL
  );

  if (response.getSelectedButton() === ui.Button.OK) {
    const newId = response.getResponseText().trim();
    if (newId) {
      try {
        SpreadsheetApp.openById(newId);
        props.setProperty("RFF_ARCHIVE_SPREADSHEET_ID", newId);
        ui.alert("Configuration Saved", "Archive Spreadsheet ID verified and saved.", ui.ButtonSet.OK);
      } catch (err) {
        ui.alert("Validation Error", "Could not open spreadsheet with provided ID: " + err.message, ui.ButtonSet.OK);
      }
    }
  }
}

// ============================================================================
// MODULE 5 v1.93: FORMAT MONTHLY SHEETS & SUB-REPORT PIPELINE
// File: 05_Monthly_Format.gs
// Handles: Banners (B), CP Due Date (CD), Unlock CP (UC), & Raw Data (RD)
// ============================================================================

// --- ROUTE CONFIGURATIONS ----------------------------------------------------

const BANNER_PREFIX = typeof BANNER_PREFIX !== "undefined" ? BANNER_PREFIX : "Banners";
const CARE_PLAN_DUE_PREFIX = typeof CARE_PLAN_DUE_PREFIX !== "undefined" ? CARE_PLAN_DUE_PREFIX : "CP Due Date";
const UNLOCKED_PREFIX = typeof UNLOCKED_PREFIX !== "undefined" ? UNLOCKED_PREFIX : "Unlock CP";

const FORMATTER_ROUTES = Object.freeze({
  B:  { code: "B",  sheetType: "Banners",        prefix: BANNER_PREFIX,        deleteLocal: true },
  CD: { code: "CD", sheetType: "CP Due Date",    prefix: CARE_PLAN_DUE_PREFIX, deleteLocal: true },
  UC: { code: "UC", sheetType: "Unlock CP",      prefix: UNLOCKED_PREFIX,      deleteLocal: true },
  RD: { code: "RD", sheetType: "Raw Data",       prefix: "Raw Data",           deleteLocal: false, isRawData: true }
});

// --- SINGLE SHARED PIPELINE ORCHESTRATOR -------------------------------------

/**
 * Main Orchestrator: Prompts for report month, loads cached config,
 * and iterates through selected route codes (B, CD, UC, RD).
 */
function runFormatterPipeline_(routeCodes, processTitle) {
  processTitle = processTitle || "Monthly Sub-Report Formatting";
  
  // Prompt user for report month context
  const monthParts = typeof promptForLockedYearReportMonth_ === "function" 
    ? promptForLockedYearReportMonth_(processTitle)
    : (typeof buildPromptedMonthContext_ === "function" ? buildPromptedMonthContext_(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "MM.yy")) : {label: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "MM.yy")});

  if (!monthParts) return null;

  const monthLabel = monthParts.label || Utilities.formatDate(monthParts.firstDay || new Date(), Session.getScriptTimeZone(), "MM.yy");

  return runFrameworkTimed_(processTitle + " " + monthLabel, function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const archiveSs = typeof openArchiveSpreadsheetOnce_ === "function" ? openArchiveSpreadsheetOnce_() : null;
    const dashboard = (typeof loadDashboardConfig_ === "function") ? loadDashboardConfig_() : null;
    const completed = [];
    const skipped = [];

    (routeCodes || ["B", "CD", "UC", "RD"]).forEach(code => {
      const route = FORMATTER_ROUTES[code];
      if (!route) return;

      // 1. Locate raw imported source tab for target month
      const sourceSheet = typeof findMonthlyImportSheetByMonthOnly_ === "function"
        ? findMonthlyImportSheetByMonthOnly_(ss, route.prefix, monthParts)
        : ss.getSheetByName(`${route.prefix} ${monthLabel}`) || ss.getSheetByName(`Source - ${route.prefix} ${monthLabel}`);

      if (!sourceSheet) {
        skipped.push(route.prefix);
        if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Skipped missing tab: " + route.prefix);
        return;
      }

      // 2. Process, transform, and format sub-report
      const outputSheet = processSingleSubReport_(ss, sourceSheet, route, monthParts, dashboard, archiveSs, timing);
      if (outputSheet) {
        completed.push(route.prefix + " -> " + outputSheet.getName());
      }
    });

    // 3. Refresh Index surface upon completion
    try {
      if (typeof populateActiveIndex === "function") {
        populateActiveIndex();
      } else if (typeof updateIndexSheet === "function") {
        updateIndexSheet(archiveSs);
      }
    } catch (err) {
      if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Index refresh skipped: " + err.message);
    }

    // 4. Send UI Toast/Notification
    const summaryMsg = `${processTitle} Complete (${monthLabel})\nCompleted: ${completed.join(", ") || "None"}\nSkipped: ${skipped.join(", ") || "None"}`;
    if (typeof notify_ === "function") {
      notify_(summaryMsg);
    } else {
      ss.toast(summaryMsg, "Pipeline Complete", 6);
    }

    return { completed, skipped };
  });
}

// --- WORKER PIPELINE ---------------------------------------------------------

/**
 * Formats a single sub-report tab from its template mold, maps raw data,
 * sets date headers, applies Section F column formats, and handles archiving.
 */
function processSingleSubReport_(ss, sourceSheet, route, monthParts, dashboard, archiveSs, timing) {
  if (typeof loadDashboardConfig_ === "function" && !dashboard) {
    dashboard = loadDashboardConfig_();
  }

  // 1. Resolve Template & Output Names
  const templateName = "Template - " + route.sheetType;
  let template = ss.getSheetByName(templateName);
  
  if (!template) {
    // Fallback lookup by prefix if exact template sheet name differs
    template = ss.getSheetByName("Template - " + route.prefix) || ss.getSheetByName("RFF_BASE_TEMPLATE");
  }
  if (!template) throw new Error("Template missing for sheet type: " + route.sheetType);

  const monthText = monthParts.label || Utilities.formatDate(monthParts.firstDay || new Date(), Session.getScriptTimeZone(), "MM.yy");
  const outputName = route.prefix + " " + monthText;

  // 2. Read Raw Source Values & Match to Governed Headers
  const rawDataRange = sourceSheet.getDataRange();
  const rawDataValues = rawDataRange.getValues();
  if (!rawDataValues || rawDataValues.length < 1) return null;

  const targetHeaders = (typeof getHeadersForSheetType_ === "function") ? getHeadersForSheetType_(dashboard, route.sheetType) : [];
  
  const outputRows = typeof mapRowsToHeaders_ === "function"
    ? mapRowsToHeaders_(rawDataValues, rawDataValues[0], targetHeaders)
    : rawDataValues; // Fallback to raw matrix if mapper not loaded

  // 3. Create/Clone Governed Output Sheet at Section C Target Index
  const outputSheet = typeof insertGovernedOutputSheet_ === "function"
    ? insertGovernedOutputSheet_(ss, outputName, template)
    : (typeof createActiveSheetFromTemplate_ === "function" ? createActiveSheetFromTemplate_(template.getName(), outputName) : null);

  if (!outputSheet) throw new Error("Failed to create output sheet: " + outputName);

  // 4. Write Mapped Data Matrix
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  if (outputRows.length > 0) {
    if (typeof ensureOutputSheetHasFormattedRows_ === "function") {
      ensureOutputSheetHasFormattedRows_(outputSheet, dataStart + outputRows.length - 1, targetHeaders.length);
    }
    outputSheet.getRange(dataStart, 1, outputRows.length, Math.max(targetHeaders.length, 1)).setValues(outputRows);
  }

  // 5. Populate Title Block & Date Prompt Ranges
  outputSheet.getRange("A1").setValue(route.sheetType);
  if (monthParts.firstDay) {
    outputSheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("m/d/yyyy");
  }
  if (monthParts.lastDay) {
    outputSheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("m/d/yyyy");
  }

  // 6. Section F: Apply Column Definitions & Date Number Formatting
  applyGovernedDateFormatsFromDashboard_(outputSheet, dashboard, targetHeaders, outputRows.length);

  // 7. Special Raw Data Engine Checks (Primary PMRs & Banner Column Sync)
  if (route.isRawData) {
    if (typeof processRawDataApprovedSyncColumns_ === "function") {
      processRawDataApprovedSyncColumns_(outputSheet, monthParts, timing, markFrameworkStep_);
    }
    if (typeof syncRawDataBannerColumns_ === "function") {
      syncRawDataBannerColumns_(outputSheet, monthParts, timing, markFrameworkStep_);
    }
  }

  // 8. Section D: Enforce Output Visibility Policy
  if (typeof applyOutputVisibilityPolicy_ === "function") {
    applyOutputVisibilityPolicy_(outputSheet, dashboard, route.sheetType, timing);
  }

  // 9. Archiving & Safe Local Source Tab Deletion
  const enableArchive = typeof RFF_ENABLE_AUTO_ARCHIVE_RAW_DATA !== "undefined" ? RFF_ENABLE_AUTO_ARCHIVE_RAW_DATA : true;
  const archiveName = "Source - " + route.prefix + " " + monthText;

  if (enableArchive && archiveSs && typeof archiveRawSourceSheet_ === "function") {
    archiveRawSourceSheet_(sourceSheet, archiveName, timing, "Archive detail", archiveSs);
  }

  if (route.deleteLocal && typeof deleteSheetSafely_ === "function") {
    deleteSheetSafely_(ss, sourceSheet, "Delete local import tab");
  }

  return outputSheet;
}

// --- DASHBOARD-GOVERNED DATE FORMATTER ---------------------------------------

/**
 * Inspects Section F (Column Definitions) from Dashboard config
 * and applies governed date number formats across date columns.
 */
function applyGovernedDateFormatsFromDashboard_(sheet, dashboard, headers, rowCount) {
  if (!sheet || !headers || rowCount < 1) return;
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  
  const colDefs = (dashboard && dashboard.columnDefinitions) || {};
  const globals = (dashboard && dashboard.globals) || {};
  const defaultFormat = globals["Default Date Format"] || "mm/dd/yyyy";

  headers.forEach((header, idx) => {
    const def = colDefs[header] || colDefs[header.toLowerCase()] || {};
    const isDateCol = def.dateColumn || (typeof isDateLikeHeader_ === "function" ? isDateLikeHeader_(header) : false);

    if (isDateCol) {
      const format = def.format || def.numberFormat || defaultFormat;
      try {
        sheet.getRange(dataStart, idx + 1, rowCount, 1).setNumberFormat(format);
      } catch (err) {
        // Soft catch if formatting range is invalid
      }
    }
  });
}

// ============================================================================
// MODULE 6 v1.93: REFINED_AND_DISENROLLED.GS
// Combined Refined Data (Demo P) & Disenrolled Exclusion Workflow Engine
// Format Dashboard v1.8.9.8.2 Governed
// ============================================================================

// ============================================================================
// 1. MODULE CONSTANTS & ENUMS
// ============================================================================

const DEMO_P_PREFIX = "Refined Data";
const DEMO_P_TEMPLATE_SHEET = "Template - Refined Data";
const DEMO_P_ARCHIVE_SHEET = "Archive - Refined Data";

const DISENROLLED_EXCLUSION_SHEET = "Disenrolled Exclusion";
const DISENROLLED_EXCLUSION_ADDED_HEADER = "Added to Disenrolled Exclusion";

const BANNER_SYNC_FIELDS = [
  "Safety - 2 Person", "Wanderer", "Interpreter Needed", 
  "Fall Risk", "DPOA or Guardian Active", "Palliative Care"
];

// ============================================================================
// 2. PUBLIC MENU & WORKFLOW ENTRY POINTS
// ============================================================================

/**
 * Menu Callback: Build Refined Data From Scratch
 * Prompts for the report month, flattens contacts, synthesizes 
 * participant fields, and generates a fresh Refined Data sheet.
 */
function buildRefinedDataFromScratch() {
  const monthParts = typeof promptForLockedYearReportMonth_ === "function"
    ? promptForLockedYearReportMonth_("Build Refined Data (Initialization)")
    : getMonthDateParts_(new Date());

  if (!monthParts) return null;

  return runFrameworkTimed_("Build Refined Data " + formatReportDateLabel_(monthParts.firstDay), function(timing) {
    const rawSheet = getValidatedRawDataSheetForDemoPBuild_(monthParts, timing);
    if (typeof logFrameworkTiming_ === "function") {
      logFrameworkTiming_("REFINED_DATA", "Source Located", "INFO", "Located validated Raw Data source: " + rawSheet.getName());
    }

    const buildResult = createActiveDemoPFromRawData_(rawSheet, DEMO_P_PREFIX, monthParts, timing);
    const demoSheet = buildResult.sheet;
    const flatCount = buildResult.flatCount || Math.max(demoSheet.getLastRow() - DATA_START_ROW + 1, 0);

    enforceDemoPPostFlattenFormatting_(demoSheet);
    
    if (typeof refreshIndexAfterSheetWorkflow_ === "function") {
      refreshIndexAfterSheetWorkflow_("Build Demo P");
    }

    if (typeof logFrameworkTiming_ === "function") {
      logFrameworkTiming_("REFINED_DATA", "Flattening Complete", "INFO", "Flat-record contact compression complete | Retained: " + flatCount);
    }
    
    notify_(`Refined Data generated cleanly! ${flatCount} active participant profiles processed.`);
    return demoSheet;
  });
}

/**
 * Menu Callback: Update Refined Data Monthly Sync
 * Reads the Monthly Change report and updates active Demo P participant records incrementally.
 */
function updateRefinedDataMonthlySync() {
  const monthParts = typeof promptForLockedYearReportMonth_ === "function"
    ? promptForLockedYearReportMonth_("Update Refined Data Monthly Sync")
    : getMonthDateParts_(new Date());

  if (!monthParts) return null;

  return runFrameworkTimed_("Update Refined Data Monthly Sync " + formatReportDateLabel_(monthParts.firstDay), function(timing) {
    return updateDemoPMonthlySyncForMonth_(monthParts, timing, {
      timingPrefix: "Update Demo P Monthly Sync - "
    });
  });
}

/**
 * Menu Callback: Create / Update Disenrolled List
 * Scans active Raw Data for new disenrolled/deceased participants, stamps them,
 * injects them into Disenrolled Exclusion, and runs the 365-day visibility sweep.
 */
function createDisenrolledList() {
  const monthParts = typeof promptForLockedYearReportMonth_ === "function"
    ? promptForLockedYearReportMonth_("Create / Update Disenrolled List")
    : getMonthDateParts_(new Date());

  if (!monthParts) return null;

  return runFrameworkTimed_("Create / Update Disenrolled List " + formatReportDateLabel_(monthParts.firstDay), function(timing) {
    return createDisenrolledListForMonth_(monthParts, timing, {
      timingPrefix: "Create / Update Disenrolled - ",
      refreshIndex: true,
      notify: true
    });
  });
}

// ============================================================================
// 3. REFINED DATA (DEMO P) INITIALIZATION & BUILD ENGINE
// ============================================================================

function getValidatedRawDataSheetForDemoPBuild_(monthParts, timing) {
  const currentRawSheet = getCurrentRawDataSheet_(monthParts);
  if (currentRawSheet) {
    if (typeof logFrameworkTiming_ === "function" && timing) {
      logFrameworkTiming_("REFINED_DATA", "Validation", "INFO", "Validated Raw Data sheet: " + currentRawSheet.getName());
    }
    return currentRawSheet;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const activeSheet = ss.getActiveSheet();
  if (isStrictRawDataSheetCandidateForDemoP_(activeSheet, monthParts)) {
    if (typeof logFrameworkTiming_ === "function" && timing) {
      logFrameworkTiming_("REFINED_DATA", "Validation", "INFO", "Validated active sheet fallback: " + activeSheet.getName());
    }
    return activeSheet;
  }

  throw new Error("Raw Data sheet was not found for the selected month. Format Raw Data first.");
}

function isStrictRawDataSheetCandidateForDemoP_(sheet, monthParts) {
  if (!sheet) return false;
  const sheetName = String(sheet.getName() || "").trim();
  if (!sheetName || sheetName === "Template - Raw Data") return false;
  return /^Raw Data(\b|\s|-|\()/i.test(sheetName);
}

function createActiveDemoPFromRawData_(rawSheet, targetName, monthParts, timing) {
  const rawData = getDataValues_(rawSheet, HEADER_ROW, DATA_START_ROW);
  if (!rawData.values || !rawData.values.length) {
    throw new Error("Raw Data sheet contains no data rows to process.");
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = loadDashboardConfig_();
  const headers = getHeadersForSheetType_(dashboard, "Refined Data");
  const outputRows = mapRowsToHeaders_(rawData.values, rawData.headers, headers);

  const workingData = { headers: headers, headerMap: buildHeaderIndexMap_(headers), values: outputRows, range: null };
  processRefinedDataUnified_(workingData, monthParts, rawSheet.getName(), "Created", timing);
  const flatCount = workingData.values.length;

  let demoSheet = ss.getSheetByName(targetName);
  if (!demoSheet) {
    const template = ss.getSheetByName(DEMO_P_TEMPLATE_SHEET) || ss.getSheetByName("RFF_BASE_TEMPLATE");
    if (template) {
      demoSheet = template.copyTo(ss).setName(targetName);
      if (typeof placeCreatedSheetInConfiguredOrder_ === "function") placeCreatedSheetInConfiguredOrder_(demoSheet);
    } else {
      demoSheet = ss.insertSheet(targetName);
    }
  } else {
    demoSheet.clearContent();
  }

  demoSheet.showSheet();

  const width = Math.max(headers.length, 1);
  const requiredRows = workingData.values.length ? DATA_START_ROW + workingData.values.length - 1 : DATA_START_ROW;
  
  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(demoSheet, requiredRows, width);

  if (workingData.values.length) {
    demoSheet.getRange(DATA_START_ROW, 1, workingData.values.length, width).setValues(workingData.values.map(row => {
      const out = (row || []).slice(0, width);
      while (out.length < width) out.push("");
      return out;
    }));
  }

  const template = ss.getSheetByName(DEMO_P_TEMPLATE_SHEET);
  if (template) {
    try {
      template.getRange(1, 1, DATA_START_ROW - 2, width).copyTo(demoSheet.getRange(1, 1, DATA_START_ROW - 2, width));
      template.getRange(HEADER_ROW, 1, 1, width).copyTo(demoSheet.getRange(HEADER_ROW, 1, 1, width));
      if (workingData.values.length) {
        template.getRange(DATA_START_ROW, 1, 1, width).copyTo(demoSheet.getRange(DATA_START_ROW, 1, workingData.values.length, width), SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
      }
      demoSheet.getRange("A1").setValue(DEMO_P_PREFIX);
    } catch(err) {}
  } else {
    demoSheet.getRange(HEADER_ROW, 1, 1, width).setValues([headers]);
  }

  updateDemoPReportDates_(demoSheet, monthParts);
  removeActiveDemoPPMRsFromDisenrolledExclusion_(demoSheet);

  return { sheet: demoSheet, flatCount: flatCount };
}

// ============================================================================
// 4. IN-MEMORY TRANSFORMATIONS & CONTACT FLATTENING
// ============================================================================

function processRefinedDataUnified_(workingData, monthParts, sourceSheetName, updateStatus, timing) {
  if (!workingData || !workingData.values || !workingData.headerMap) return [];
  const flattenedCount = safeFlattenAndProcessContacts_(workingData, false);
  processDemoPFreshRowsInMemory_(workingData);
  populateDemoPUpdateColumns_(workingData, monthParts, sourceSheetName, updateStatus || "Updated");
  populateUniversalMetadataColumns_(workingData, monthParts, sourceSheetName, "Refined Data", updateStatus || "Updated");
  
  if (typeof logFrameworkTiming_ === "function" && timing) {
    logFrameworkTiming_("REFINED_DATA", "Transform", "INFO", "Refined Data unified transform complete | Rows: " + flattenedCount);
  }
  return workingData.values;
}

function safeFlattenAndProcessContacts_(workingData, preservePrimaryRows) {
  if (!workingData || !workingData.values || !workingData.headerMap) return 0;
  try {
    return flattenDemoPContactRowsInMemory_(workingData, preservePrimaryRows !== false);
  } catch (err) {
    logBestEffortWarning_("Refined Data contact flattening fallback used: " + err.message);
    return workingData.values.length;
  }
}

function flattenDemoPContactRowsInMemory_(data, requireIntegrity) {
  if (!data || !data.values || !data.values.length) return 0;
  const headerMap = data.headerMap || buildHeaderIndexMap_(data.headers || []);
  const width = (data.headers || []).length;
  const pmrIdx = getPMRIndex_(headerMap);
  const primaryIdx = headerMap["Primary PMR Row"];
  if (pmrIdx === -1 || primaryIdx === undefined) throw new Error("Refined Data contact compression requires PMR and Primary PMR Row headers.");

  const contactTargets = ["Contact - 1", "Contact - 2", "Contact - 3", "Contact - 4", "Contact - 5", "Contact - 6", "Contact - 7", "Contact - 8"];
  const contactTargetIndexes = contactTargets.map(header => headerMap[header]).filter(idx => idx !== undefined);
  const summaryIdx = headerMap["Contact - Summary"];
  const grouped = new Map();

  data.values.forEach((row, originalIndex) => {
    const pmr = normalizePMR_(row[pmrIdx]);
    const key = pmr || "__blank_pmr__" + originalIndex;
    if (!grouped.has(key)) grouped.set(key, []);
    grouped.get(key).push({ row: row, originalIndex: originalIndex });
  });

  const flatRows = new Array(grouped.size);
  let outputIndex = 0;

  grouped.forEach((items, pmr) => {
    let primaryItem = items.find(item => isPrimaryPMRRowValue_(item.row[primaryIdx])) || items[0];
    let output = new Array(width).fill("");
    try {
      for (let col = 0; col < width; col++) output[col] = primaryItem.row[col] === undefined ? "" : primaryItem.row[col];
      const summaries = [];
      items.forEach(item => {
        if (item === primaryItem) return;
        const summary = buildDemoPContactSummaryForFlatRecord_(item.row, headerMap);
        if (summary) summaries.push(summary);
      });

      for (let contactIndex = 0; contactIndex < Math.min(summaries.length, contactTargetIndexes.length); contactIndex++) {
        const targetIdx = contactTargetIndexes[contactIndex];
        if (normalizeCompareValue_(output[targetIdx]) === "") output[targetIdx] = summaries[contactIndex];
      }
      if (summaryIdx !== undefined && summaries.length && normalizeCompareValue_(output[summaryIdx]) === "") {
        output[summaryIdx] = summaries.join("\n");
      }
    } catch (err) {
      output = new Array(width).fill("");
      for (let fallbackCol = 0; fallbackCol < width; fallbackCol++) output[fallbackCol] = primaryItem.row[fallbackCol] === undefined ? "" : primaryItem.row[fallbackCol];
      logBestEffortWarning_("Refined Data contact parsing fallback used for PMR " + pmr + ": " + err.message);
    }
    flatRows[outputIndex++] = output;
  });

  sortDemoPFlatRows_(flatRows, headerMap);
  data.values = flatRows;
  return flatRows.length;
}

function buildDemoPContactSummaryForFlatRecord_(row, headerMap) {
  const parts = [
    "Contact - First Name", "Contact - Last Name", "Relationship", "Type of Contact",
    "Contact - Primary Language", "AD1 - Phone", "AD2 - Phone", "AD3 - Phone",
    "Company", "Contact - Notes"
  ].map(header => {
    const idx = headerMap[header];
    return idx === undefined ? "" : String(row[idx] || "").trim();
  }).filter(Boolean);
  return parts.join(" | ");
}

function sortDemoPFlatRows_(rows, headerMap) {
  const lastIdx = headerMap["Last Name"];
  const firstIdx = headerMap["First Name"];
  const nameIdx = headerMap["Name"];
  rows.sort((a, b) => {
    const aKey = String((lastIdx !== undefined ? a[lastIdx] : "") || (nameIdx !== undefined ? a[nameIdx] : "") || "").toLowerCase();
    const bKey = String((lastIdx !== undefined ? b[lastIdx] : "") || (nameIdx !== undefined ? b[nameIdx] : "") || "").toLowerCase();
    if (aKey !== bKey) return aKey.localeCompare(bKey);
    const aFirst = String(firstIdx !== undefined ? a[firstIdx] || "" : "").toLowerCase();
    const bFirst = String(firstIdx !== undefined ? b[firstIdx] || "" : "").toLowerCase();
    return aFirst.localeCompare(bFirst);
  });
}

function processDemoPFreshRowsInMemory_(data) {
  populateParticipantNameData_(data);
  populateDemoPNameData_(data);
  updateBannerColumnDataInMemory_(data);
  combineAddressesDataInMemory_(data);
  handleLanguageDataInMemory_(data);
  splitPhoneNumbersDataInMemory_(data);
  combineNotesSummaryDataInMemory_(data);
}

// ============================================================================
// 5. FIELD SYNTHESIS HELPERS (NAMES, ADDRESSES, PHONES, NOTES, HASHING)
// ============================================================================

function populateParticipantNameData_(data) {
  if (!data || !data.values || !data.headerMap) return;
  const hMap = data.headerMap;
  if (hMap["Participant Name"] === undefined || hMap["First Name"] === undefined || hMap["Last Name"] === undefined) return;

  data.values.forEach(row => {
    if (normalizeCompareValue_(row[hMap["Participant Name"]]) !== "") return;
    const firstName = String(row[hMap["First Name"]] || "").trim();
    const lastName = String(row[hMap["Last Name"]] || "").trim();
    const pref = hMap["Preferred Name"] !== undefined ? String(row[hMap["Preferred Name"]] || "").trim() : "";
    
    if (lastName || firstName) {
      row[hMap["Participant Name"]] = pref ? `${lastName}, ${firstName} (${pref})` : `${lastName}, ${firstName}`;
    }
  });
}

function populateDemoPNameData_(data) {
  if (!data || !data.values || !data.headerMap) return;
  const hMap = data.headerMap;
  if (hMap["Name"] === undefined || hMap["First Name"] === undefined || hMap["Last Name"] === undefined) return;

  data.values.forEach(row => {
    if (normalizeCompareValue_(row[hMap["Name"]]) !== "") return;
    const firstName = String(row[hMap["First Name"]] || "").trim();
    const lastName = String(row[hMap["Last Name"]] || "").trim();
    row[hMap["Name"]] = [firstName, lastName].filter(Boolean).join(" ");
  });
}

function updateBannerColumnDataInMemory_(data) {
  const hMap = data.headerMap;
  const bIdx = hMap["Banner Summary"];
  if (bIdx === undefined) return;

  data.values.forEach(row => {
    const parts = [];
    BANNER_SYNC_FIELDS.forEach(header => {
      const idx = hMap[header];
      if (idx !== undefined) {
        const val = String(row[idx] || "").trim().toUpperCase();
        if (val === "YES" || val === "TRUE" || val === "Y") parts.push(header);
      }
    });
    if (normalizeCompareValue_(row[bIdx]) === "") row[bIdx] = parts.join(" | ");
  });
}

function combineAddressesDataInMemory_(data) {
  const hMap = data.headerMap;
  const a1Idx = hMap["Address Line 1"];
  const targetIdx = hMap["Address 1 - Street"];
  if (a1Idx === undefined || targetIdx === undefined) return;

  data.values.forEach(row => {
    const p1 = String(row[a1Idx] || "").trim();
    const p2 = hMap["Address Line 2"] !== undefined ? String(row[hMap["Address Line 2"]] || "").trim() : "";
    if (normalizeCompareValue_(row[targetIdx]) === "") {
      row[targetIdx] = p1 && p2 ? `${p1}, ${p2}` : (p1 || p2);
    }
  });
}

function handleLanguageDataInMemory_(data) {
  const hMap = data.headerMap;
  if (hMap["Custom Field 1 - Label"] === undefined || hMap["Custom Field 1 - Value"] === undefined || hMap["Primary Language"] === undefined) return;

  data.values.forEach(row => {
    const lang = String(row[hMap["Primary Language"]] || "").trim();
    if (lang && lang.toLowerCase() !== "english") {
      row[hMap["Custom Field 1 - Label"]] = "Language";
      row[hMap["Custom Field 1 - Value"]] = lang;
    } else {
      row[hMap["Custom Field 1 - Label"]] = "";
      row[hMap["Custom Field 1 - Value"]] = "";
    }
  });
}

function splitPhoneNumbersDataInMemory_(data) {
  const hMap = data.headerMap;
  const phoneIdx = hMap["Phone Number"];
  if (phoneIdx === undefined) return;

  data.values.forEach(row => {
    const primaryPhone = String(row[phoneIdx] || "").trim();
    if (hMap["Phone 1 - Label"] !== undefined) row[hMap["Phone 1 - Label"]] = primaryPhone ? "Primary Phone" : "";
    if (hMap["Phone 1 - Value"] !== undefined) row[hMap["Phone 1 - Value"]] = primaryPhone;
  });
}

function combineNotesSummaryDataInMemory_(data) {
  if (!data || !data.values) return;
  const hMap = data.headerMap;
  if (hMap["Notes"] === undefined) return;

  data.values.forEach(row => {
    if (normalizeCompareValue_(row[hMap["Notes"]]) !== "") return;
    const parts = [];
    const bannerSum = hMap["Banner Summary"] !== undefined ? String(row[hMap["Banner Summary"]] || "").trim() : "";
    const contactSum = hMap["Contact - Summary"] !== undefined ? String(row[hMap["Contact - Summary"]] || "").trim() : "";
    const addlInfo = hMap["Additional Important Information"] !== undefined ? String(row[hMap["Additional Important Information"]] || "").trim() : "";

    if (bannerSum) parts.push(`Banners: ${bannerSum}`);
    if (contactSum) parts.push(`Contact: ${contactSum}`);
    if (addlInfo) parts.push(`Info: ${addlInfo}`);

    row[hMap["Notes"]] = parts.join("\n\n");
  });
}

function populateDemoPUpdateColumns_(workingData, monthParts, sourceSheetName, updateStatus) {
  const hMap = workingData.headerMap;
  const dateStr = Utilities.formatDate(monthParts.firstDay || new Date(), Session.getScriptTimeZone(), "MM/dd/yyyy");

  workingData.values.forEach(row => {
    if (hMap["Update Status"] !== undefined) row[hMap["Update Status"]] = updateStatus || "ACTIVE";
    if (hMap["Update Month"] !== undefined) row[hMap["Update Month"]] = dateStr;
    if (hMap["Source Sheet"] !== undefined) row[hMap["Source Sheet"]] = sourceSheetName || "";
  });
}

function populateUniversalMetadataColumns_(data, monthParts, sourceSheetName, sourceWorkflow, status) {
  if (!data || !data.headerMap || !data.values) return;

  const headerMap = data.headerMap;
  const statusIdx = headerMap["Update Status"];
  const monthIdx = headerMap["Update Month"];
  const sourceIdx = headerMap["Source Sheet"];
  const columnsUpdatedIdx = headerMap["Columns Updated"];
  const lastUpdatedAtIdx = headerMap["Last Updated At"];
  const sourceHashIdx = headerMap["Source Hash"];
  const previousSourceHashIdx = headerMap["Previous Source Hash"];
  const workflowIdx = headerMap["Source Workflow"];

  if (statusIdx === undefined && monthIdx === undefined && sourceIdx === undefined &&
      columnsUpdatedIdx === undefined && lastUpdatedAtIdx === undefined &&
      sourceHashIdx === undefined && previousSourceHashIdx === undefined && workflowIdx === undefined) {
    return;
  }

  const monthText = monthParts && monthParts.firstDay
    ? Utilities.formatDate(monthParts.firstDay, Session.getScriptTimeZone(), "MM.yy")
    : "";
  const updatedAt = new Date();
  const pmrIdx = getPMRIndex_(headerMap);
  const hashByPMR = buildSourceHashByPMR_(data, pmrIdx);
  
  const excludedColumns = {
    "Update Status": true, "Update Month": true, "Source Sheet": true,
    "Columns Updated": true, "Last Updated At": true, "Source Hash": true,
    "Previous Source Hash": true, "Source Workflow": true
  };
  const columnList = (data.headers || []).filter(h => h && !excludedColumns[h]).join(", ");

  data.values.forEach(function(row) {
    const pmr = pmrIdx === -1 ? "" : normalizePMR_(row[pmrIdx]);
    const nextHash = pmr && hashByPMR[pmr] ? hashByPMR[pmr] : buildSourceHashForRow_(row, data.headers);
    const previousHash = sourceHashIdx !== undefined ? row[sourceHashIdx] : "";

    if (statusIdx !== undefined) row[statusIdx] = status || "Updated";
    if (monthIdx !== undefined) row[monthIdx] = monthText;
    if (sourceIdx !== undefined) row[sourceIdx] = sourceSheetName || "";
    if (columnsUpdatedIdx !== undefined) row[columnsUpdatedIdx] = columnList;
    if (lastUpdatedAtIdx !== undefined) row[lastUpdatedAtIdx] = updatedAt;
    if (previousSourceHashIdx !== undefined) row[previousSourceHashIdx] = previousHash || "";
    if (sourceHashIdx !== undefined) row[sourceHashIdx] = nextHash;
    if (workflowIdx !== undefined) row[workflowIdx] = sourceWorkflow || "";
  });
}

function buildSourceHashByPMR_(data, pmrIdx) {
  const hashByPMR = {};
  if (!data || !data.values || !data.headers || pmrIdx === -1) return hashByPMR;

  const rowsByPMR = {};
  data.values.forEach(row => {
    const pmr = normalizePMR_(row[pmrIdx]);
    if (!pmr) return;
    if (!rowsByPMR[pmr]) rowsByPMR[pmr] = [];
    rowsByPMR[pmr].push(row);
  });

  Object.keys(rowsByPMR).forEach(pmr => {
    hashByPMR[pmr] = buildSourceHashForRows_(rowsByPMR[pmr], data.headers);
  });
  return hashByPMR;
}

function buildSourceHashForRows_(rows, headers) {
  const excluded = {
    "Update Status": true, "Update Month": true, "Source Sheet": true,
    "Columns Updated": true, "Last Updated At": true, "Source Hash": true,
    "Previous Source Hash": true, "Source Workflow": true
  };
  const normalizedRows = rows.map(row => {
    return headers.map((header, index) => {
      if (excluded[header]) return null;
      let val = row[index];
      if (val === null || val === undefined) return "";
      if (Object.prototype.toString.call(val) === "[object Date]") return Utilities.formatDate(val, Session.getScriptTimeZone(), "yyyy-MM-dd");
      return String(val).trim().replace(/\s+/g, " ");
    });
  });
  return computeStableHash_(JSON.stringify(normalizedRows));
}

function buildSourceHashForRow_(row, headers) {
  return buildSourceHashForRows_([row], headers);
}

function computeStableHash_(text) {
  const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, String(text || ""), Utilities.Charset.UTF_8);
  return digest.map(byte => {
    const value = byte < 0 ? byte + 256 : byte;
    return ("0" + value.toString(16)).slice(-2);
  }).join("");
}

// ============================================================================
// 6. REFINED DATA INCREMENTAL MONTHLY SYNC ENGINE
// ============================================================================

function updateDemoPMonthlySyncForMonth_(monthParts, timing, options) {
  if (!monthParts) return null;
  options = options || {};

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const demoSheet = ss.getSheetByName(DEMO_P_PREFIX) || getLatestSheetByPrefix_(DEMO_P_PREFIX);
  if (!demoSheet) throw new Error("Refined Data sheet was not found. Build Refined Data first.");

  const changedPMRs = getDemoPMonthlySyncChangedPMRs_(monthParts);
  if (!changedPMRs.size) {
    notify_("No participant changes detected for monthly sync.");
    return demoSheet;
  }

  const rawSheet = getCurrentRawDataSheet_(monthParts);
  if (!rawSheet) throw new Error("Raw Data sheet was not found for the selected month.");

  const dashboard = loadDashboardConfig_();
  const headers = getHeadersForSheetType_(dashboard, "Refined Data");
  const data = getDataValues_(demoSheet, HEADER_ROW, DATA_START_ROW);
  const width = Math.max(headers.length, 1);

  const freshRows = buildDemoPFreshRowsForPMRs_(rawSheet, headers, changedPMRs, monthParts, timing);
  const retainedResult = buildDemoPMonthlySyncRetainedRows_(data, changedPMRs, width);
  const outputRows = retainedResult.rows.concat(normalizeRowsToWidth_(freshRows, width));

  appendDemoPArchiveRows_(headers, retainedResult.archiveRows, {
    reason: "Monthly Sync Replacement", workflow: "Monthly Update",
    monthLabel: monthParts.label, sourceSheet: demoSheet.getName()
  }, timing);

  writeDemoPMonthlySyncBody_(demoSheet, outputRows, width);
  removeActiveDemoPPMRsFromDisenrolledExclusion_(demoSheet);
  updateDemoPReportDates_(demoSheet, monthParts);
  enforceDemoPPostFlattenFormatting_(demoSheet);

  notify_(`Refined Data monthly sync complete! Updated ${freshRows.length} changed participant profiles.`);
  return demoSheet;
}

function getDemoPMonthlySyncChangedPMRs_(monthParts) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const set = new Set();
  const mcrSheet = getLatestSheetByPrefix_("Monthly Change");
  if (!mcrSheet) return set;

  const data = getDataValues_(mcrSheet, HEADER_ROW, DATA_START_ROW);
  const pmrIdx = getPMRIndex_(data.headerMap);
  if (pmrIdx === -1) return set;

  data.values.forEach(row => {
    const pmr = normalizePMR_(row[pmrIdx]);
    if (pmr) set.add(pmr);
  });
  return set;
}

function buildDemoPFreshRowsForPMRs_(rawSheet, demoHeaders, changedPMRs, monthParts, timing) {
  const rawData = getDataValues_(rawSheet, HEADER_ROW, DATA_START_ROW);
  const rawPmrIdx = getPMRIndex_(rawData.headerMap);
  if (rawPmrIdx === -1) return [];

  const rawRows = rawData.values.filter(row => changedPMRs.has(normalizePMR_(row[rawPmrIdx])));
  const outputRows = mapRowsToHeaders_(rawRows, rawData.headers, demoHeaders);
  const workingData = { headers: demoHeaders, headerMap: buildHeaderIndexMap_(demoHeaders), values: outputRows, range: null };
  return processRefinedDataUnified_(workingData, monthParts, rawSheet.getName(), "Monthly Sync", timing);
}

function buildDemoPMonthlySyncRetainedRows_(data, changedPMRs, width) {
  const pmrIdx = getPMRIndex_(data.headerMap);
  const primaryIdx = data.headerMap ? data.headerMap["Primary PMR Row"] : undefined;
  const retainedRows = [];
  const archiveRows = [];

  (data.values || []).forEach(row => {
    const pmr = pmrIdx === -1 ? "" : normalizePMR_(row[pmrIdx]);
    if (pmr && changedPMRs.has(pmr)) {
      if (isPrimaryPMRRowValue_(primaryIdx === undefined ? "" : row[primaryIdx])) {
        archiveRows.push(padRowToWidth_(row, width));
      }
      return;
    }
    retainedRows.push(padRowToWidth_(row, width));
  });

  return { rows: retainedRows, archiveRows: archiveRows };
}

function writeDemoPMonthlySyncBody_(demoSheet, rows, width) {
  const normalizedRows = normalizeRowsToWidth_(rows || [], width);
  const oldBodyRows = Math.max(demoSheet.getLastRow() - DATA_START_ROW + 1, 0);
  const rowsToClear = Math.max(oldBodyRows, normalizedRows.length, 1);

  if (typeof ensureOutputSheetHasFormattedRows_ === "function") {
    ensureOutputSheetHasFormattedRows_(demoSheet, DATA_START_ROW + Math.max(normalizedRows.length, 1) - 1, width);
  }

  demoSheet.getRange(DATA_START_ROW, 1, rowsToClear, width).clearContent();
  if (normalizedRows.length) {
    demoSheet.getRange(DATA_START_ROW, 1, normalizedRows.length, width).setValues(normalizedRows);
  }
}

function updateDemoPReportDates_(demoSheet, monthParts) {
  if (!demoSheet || !monthParts) return;
  if (monthParts.firstDay) demoSheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("m/d/yyyy");
  if (monthParts.lastDay) demoSheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("m/d/yyyy");
  demoSheet.getRange("E2").setValue("Last Updated").setFontStyle("italic");
}

function enforceDemoPPostFlattenFormatting_(demoSheet) {
  if (!demoSheet) return;
  const lastRow = demoSheet.getLastRow();
  const lastCol = Math.max(demoSheet.getLastColumn(), 1);
  if (lastRow >= DATA_START_ROW) {
    demoSheet.getRange(DATA_START_ROW, 1, lastRow - DATA_START_ROW + 1, lastCol).setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);
  }
}

// ============================================================================
// 7. DISENROLLED EXCLUSION EXTRACTION & SYNC ENGINE
// ============================================================================

function createDisenrolledListForMonth_(monthParts, timing, options) {
  if (!monthParts) return { rowsCopied: 0, rowsRemoved: 0 };
  options = options || {};
  const prefix = String(options.timingPrefix || "");
  const markStep = function(label, details) {
    if (typeof logFrameworkTiming_ === "function" && timing) {
      logFrameworkTiming_("DISENROLLED_SYNC", prefix + label, "INFO", details || "");
    }
  };

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const rawSheet = getCurrentRawDataSheet_(monthParts);
  if (!rawSheet) throw new Error("Raw Data sheet was not found for the selected month. Format Raw Data first.");

  markStep("Locate Raw Data source sheet: " + rawSheet.getName());

  const exclusionSheet = getOrCreateDisenrolledExclusionSheet_(ss, timing);
  markStep("Disenrolled Exclusion sheet ready: " + exclusionSheet.getName());

  const result = syncDisenrolledExclusionFromRawData_(exclusionSheet, rawSheet, monthParts, timing);
  markStep("Disenrolled Exclusion sync complete | Rows copied: " + result.rowsCopied);

  const hiddenOldCount = hideOldDisenrolledRows_(exclusionSheet);
  if (hiddenOldCount > 0) {
    markStep("365-Day visibility sweep hidden stale disenrolled rows | Rows hidden: " + hiddenOldCount);
  }

  if (options.notify !== false) {
    notify_(`Disenrolled Exclusion list updated!\n\nNew records added: ${result.rowsCopied}\nStale records hidden (>365 days): ${hiddenOldCount}`);
  }

  return result;
}

function syncDisenrolledExclusionFromRawData_(exclusionSheet, rawSheet, monthParts, timing) {
  const dashboard = loadDashboardConfig_();
  const exclusionHeaders = getHeadersForSheetType_(dashboard, "Disenrolled Exclusion");
  const exclusionHeaderMap = buildHeaderIndexMap_(exclusionHeaders);

  const rawData = getDataValues_(rawSheet, HEADER_ROW, DATA_START_ROW);
  const rawPmrIdx = getPMRIndex_(rawData.headerMap);
  if (rawPmrIdx === -1) throw new Error("Raw Data is missing Participant PMR# column.");

  const statusIdx = rawData.headerMap["Enrollment Status"];
  const disenrollEffectiveIdx = findHeaderIndex_(rawData.headerMap, ["Disenrollment Effective Date", "Disenrollment Date", "Date of Death"]);

  if (statusIdx === undefined && disenrollEffectiveIdx === -1) {
    throw new Error("Raw Data requires Enrollment Status or Disenrollment Effective Date columns to identify disenrolled participants.");
  }

  const disenrolledRows = [];
  const rawDisenrolledPMRs = new Set();

  rawData.values.forEach(row => {
    const pmr = normalizePMR_(row[rawPmrIdx]);
    if (!pmr) return;

    const statusText = statusIdx !== undefined ? String(row[statusIdx] || "").trim().toLowerCase() : "";
    const effectiveDate = disenrollEffectiveIdx !== -1 ? row[disenrollEffectiveIdx] : null;
    const isDisenrolledStatus = statusText === "disenrolled" || statusText === "deceased";
    const hasDisenrollmentDate = normalizeCompareValue_(effectiveDate) !== "";

    if (isDisenrolledStatus || hasDisenrollmentDate) {
      disenrolledRows.push(row);
      rawDisenrolledPMRs.add(pmr);
    }
  });

  const existingExclusionData = getDataValues_(exclusionSheet, HEADER_ROW, DATA_START_ROW);
  const existingPmrIdx = existingExclusionData.headerMap ? getPMRIndex_(existingExclusionData.headerMap) : -1;
  const existingPMSet = new Set();

  if (existingPmrIdx !== -1 && existingExclusionData.values.length) {
    existingExclusionData.values.forEach(row => {
      const pmr = normalizePMR_(row[existingPmrIdx]);
      if (pmr) existingPMSet.add(pmr);
    });
  }

  const newDisenrolledRows = disenrolledRows.filter(row => {
    const pmr = normalizePMR_(row[rawPmrIdx]);
    return pmr && !existingPMSet.has(pmr);
  });

  const mappedNewRows = mapRowsToHeaders_(newDisenrolledRows, rawData.headers, exclusionHeaders);
  const auditDateIdx = exclusionHeaderMap[DISENROLLED_EXCLUSION_ADDED_HEADER];
  const auditDate = monthParts && monthParts.firstDay ? monthParts.firstDay : new Date();

  mappedNewRows.forEach(row => {
    if (auditDateIdx !== undefined && normalizeCompareValue_(row[auditDateIdx]) === "") {
      row[auditDateIdx] = auditDate;
    }
  });

  let rowsCopied = 0;
  if (mappedNewRows.length > 0) {
    const startRow = Math.max(exclusionSheet.getLastRow() + 1, DATA_START_ROW);
    if (typeof ensureOutputSheetHasFormattedRows_ === "function") {
      ensureOutputSheetHasFormattedRows_(exclusionSheet, startRow + mappedNewRows.length - 1, exclusionHeaders.length);
    }
    exclusionSheet.getRange(startRow, 1, mappedNewRows.length, exclusionHeaders.length).setValues(mappedNewRows);
    rowsCopied = mappedNewRows.length;
  }

  return { rowsCopied: rowsCopied };
}

// ============================================================================
// 8. RE-ENROLLMENT PURGE & 365-DAY HISTORICAL VISIBILITY SWEEP
// ============================================================================

function removeActiveDemoPPMRsFromDisenrolledExclusion_(demoSheet) {
  if (!demoSheet) return 0;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const exclusionSheet = ss.getSheetByName(DISENROLLED_EXCLUSION_SHEET);
  if (!exclusionSheet || exclusionSheet.getLastRow() < DATA_START_ROW) return 0;

  const demoData = getDataValues_(demoSheet, HEADER_ROW, DATA_START_ROW);
  const demoPmrIdx = getPMRIndex_(demoData.headerMap);
  const statusIdx = demoData.headerMap["Enrollment Status"];
  if (demoPmrIdx === -1) return 0;

  const exclusionData = getDataValues_(exclusionSheet, HEADER_ROW, DATA_START_ROW);
  const exclusionPmrIdx = getPMRIndex_(exclusionData.headerMap);
  if (exclusionPmrIdx === -1 || !exclusionData.values.length) return 0;

  const activePMRs = new Set();
  demoData.values.forEach(row => {
    const pmr = normalizePMR_(row[demoPmrIdx]);
    const statusText = statusIdx !== undefined ? String(row[statusIdx] || "").trim().toLowerCase() : "active";
    if (pmr && (statusText === "active" || statusText === "enrolled" || statusText === "")) {
      activePMRs.add(pmr);
    }
  });

  if (!activePMRs.size) return 0;

  const retainedRows = [];
  let deletedCount = 0;

  exclusionData.values.forEach(row => {
    const pmr = normalizePMR_(row[exclusionPmrIdx]);
    if (pmr && activePMRs.has(pmr)) {
      deletedCount++;
    } else {
      retainedRows.push(row);
    }
  });

  if (deletedCount > 0) {
    const width = Math.max(exclusionSheet.getLastColumn(), 1);
    exclusionSheet.getRange(DATA_START_ROW, 1, exclusionData.values.length, width).clearContent();
    if (retainedRows.length > 0) {
      const normalizedRows = normalizeRowsToWidth_(retainedRows, width);
      exclusionSheet.getRange(DATA_START_ROW, 1, normalizedRows.length, width).setValues(normalizedRows);
    }
    logBestEffortWarning_("Re-Enrollment Engine: Surgically purged " + deletedCount + " re-enrolled PMR records from Disenrolled Exclusion.");
  }
  return deletedCount;
}

function hideOldDisenrolledRows_(sheet) {
  if (!sheet) return 0;
  const data = getDataValues_(sheet, HEADER_ROW, DATA_START_ROW);
  if (!data.values.length) return 0;

  const dateHeaders = ["Disenrollment Effective Date", "Disenrollment Date", "Date of Death"];
  const dateIndexes = dateHeaders.map(header => data.headerMap[header]).filter(idx => idx !== undefined);
  if (!dateIndexes.length) return 0;

  try { sheet.showRows(DATA_START_ROW, data.values.length); } catch (err) {}

  const cutoff = new Date();
  cutoff.setHours(0, 0, 0, 0);
  cutoff.setDate(cutoff.getDate() - 365);
  const rowsToHide = [];

  data.values.forEach((row, index) => {
    const matchedDate = dateIndexes
      .map(dateIdx => normalizeToDateObject_(row[dateIdx]))
      .filter(date => date && !isNaN(date.getTime()))
      .sort((a, b) => b.getTime() - a.getTime())[0];

    if (matchedDate && matchedDate.getTime() < cutoff.getTime()) {
      rowsToHide.push(DATA_START_ROW + index);
    }
  });

  if (rowsToHide.length > 0) {
    hideRowNumberBatches_(sheet, rowsToHide);
  }
  return rowsToHide.length;
}

function hideRowNumberBatches_(sheet, rowNumbers) {
  if (!sheet || !rowNumbers || rowNumbers.length === 0) return 0;
  const uniqueRows = Array.from(new Set(rowNumbers))
    .map(Number)
    .filter(row => !isNaN(row) && row >= DATA_START_ROW)
    .sort((a, b) => a - b);

  if (!uniqueRows.length) return 0;

  let startRow = uniqueRows[0];
  let runLength = 1;

  for (let i = 1; i < uniqueRows.length; i++) {
    if (uniqueRows[i] === startRow + runLength) {
      runLength++;
    } else {
      sheet.hideRows(startRow, runLength);
      startRow = uniqueRows[i];
      runLength = 1;
    }
  }
  sheet.hideRows(startRow, runLength);
  return uniqueRows.length;
}

// ============================================================================
// 9. COLD-STORAGE ARCHIVING ENGINE
// ============================================================================

function appendDemoPArchiveRows_(sourceHeaders, rows, metadata, timing) {
  if (!rows || !rows.length) return 0;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const archiveSheet = getOrCreateDemoPArchiveSheet_(ss, sourceHeaders);
  
  const archiveHeaders = getHeaders_(archiveSheet, HEADER_ROW);
  const archiveWidth = Math.max(archiveHeaders.length, 1);
  const now = new Date();
  const meta = metadata || {};
  const archiveHeaderMap = buildHeaderIndexMap_(archiveHeaders || []);

  const payload = rows.map(row => {
    const output = new Array(archiveWidth).fill("");
    if (archiveHeaderMap["Archived At"] !== undefined) output[archiveHeaderMap["Archived At"]] = now;
    if (archiveHeaderMap["Archive Reason"] !== undefined) output[archiveHeaderMap["Archive Reason"]] = meta.reason || "Demo P Row Archive";
    if (archiveHeaderMap["Source Workflow"] !== undefined) output[archiveHeaderMap["Source Workflow"]] = meta.workflow || "Demo P Workflow";
    if (archiveHeaderMap["Source Month"] !== undefined) output[archiveHeaderMap["Source Month"]] = meta.monthLabel || "";
    if (archiveHeaderMap["Source Sheet"] !== undefined) output[archiveHeaderMap["Source Sheet"]] = meta.sourceSheet || "Demo P";
    
    (sourceHeaders || []).forEach((header, idx) => {
      if (archiveHeaderMap[header] !== undefined) output[archiveHeaderMap[header]] = row[idx];
    });
    return output;
  });

  const insertStartRow = Math.max(archiveSheet.getLastRow() + 1, DATA_START_ROW);
  if (typeof ensureOutputSheetHasFormattedRows_ === "function") {
    ensureOutputSheetHasFormattedRows_(archiveSheet, insertStartRow + payload.length - 1, archiveWidth);
  }
  archiveSheet.getRange(insertStartRow, 1, payload.length, archiveWidth).setValues(payload);
  
  if (typeof hideSheetIfNeeded_ === "function") {
    hideSheetIfNeeded_(archiveSheet, timing, "Archive sheet hidden after write");
  }
  return payload.length;
}

function getOrCreateDemoPArchiveSheet_(ss, sourceHeaders) {
  let sheet = ss.getSheetByName(DEMO_P_ARCHIVE_SHEET);
  const archiveHeaders = getDemoPArchiveHeaders_(sourceHeaders);
  
  if (!sheet) {
    const template = ss.getSheetByName(DEMO_P_TEMPLATE_SHEET);
    if (template) {
      sheet = template.copyTo(ss).setName(DEMO_P_ARCHIVE_SHEET);
      if (typeof placeCreatedSheetInConfiguredOrder_ === "function") placeCreatedSheetInConfiguredOrder_(sheet);
    } else {
      sheet = ss.insertSheet(DEMO_P_ARCHIVE_SHEET);
    }
  }

  sheet.getRange("A1").setValue(DEMO_P_ARCHIVE_SHEET);
  sheet.getRange(HEADER_ROW, 1, 1, archiveHeaders.length).setValues([archiveHeaders]);
  return sheet;
}

function getDemoPArchiveHeaders_(sourceHeaders) {
  const headers = ["Archived At", "Archive Reason", "Source Workflow", "Source Month", "Source Sheet"];
  (sourceHeaders || []).forEach(header => {
    const clean = String(header || "").trim();
    if (clean && headers.indexOf(clean) === -1) headers.push(clean);
  });
  return headers;
}

function getOrCreateDisenrolledExclusionSheet_(ss, timing) {
  let sheet = ss.getSheetByName(DISENROLLED_EXCLUSION_SHEET);
  const dashboard = loadDashboardConfig_();
  const headers = getHeadersForSheetType_(dashboard, "Disenrolled Exclusion");

  if (!sheet) {
    const template = ss.getSheetByName("Template - Disenrolled Exclusion");
    if (template) {
      sheet = template.copyTo(ss).setName(DISENROLLED_EXCLUSION_SHEET);
      if (typeof placeCreatedSheetInConfiguredOrder_ === "function") placeCreatedSheetInConfiguredOrder_(sheet);
    } else {
      sheet = ss.insertSheet(DISENROLLED_EXCLUSION_SHEET);
    }
  }

  sheet.getRange("A1").setValue(DISENROLLED_EXCLUSION_SHEET);
  if (headers.length > 0) {
    if (sheet.getMaxColumns() < headers.length) {
      sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length - sheet.getMaxColumns());
    }
    sheet.getRange(HEADER_ROW, 1, 1, headers.length).setValues([headers]);
  }

  try { sheet.setFrozenRows(HEADER_ROW); } catch (err) {}
  try { sheet.setFrozenColumns(2); } catch (err) {}

  sheet.showSheet();
  return sheet;
}

// ============================================================================
// MODULE 7 v1.93: MASTERLIST_AND_MONTHLYCHANGE.GS
// Combined Master List Synthesis & Monthly Change Delta Engine
// Format Dashboard v1.8.9.8.2 Governed
// ============================================================================

// ============================================================================
// 1. MODULE CONSTANTS & ENUMS
// ============================================================================

const MASTER_LIST_PREFIX = "Master List";
const MONTHLY_CHANGE_REPORT_PREFIX = "Monthly Change";
// (Note: HEADER_ROW, DATA_START_ROW, DEMO_P_PREFIX, and DISENROLLED_EXCLUSION_SHEET 
// are managed globally or defined in their respective modules, but kept here for local reference if needed)

const SHEET_TYPE = Object.freeze({
  BANNERS: "Banners",
  CARE_PLAN_DUE: "CP Due Date",
  UNLOCKED: "Unlock CP",
  RAW_DATA: "Raw Data",
  REFINED_DATA: "Refined Data",
  DISENROLLED_EXCLUSION: "Disenrolled Exclusion",
  MASTER_LIST: "Master List",
  MONTHLY_CHANGE: "Monthly Change"
});

const CARE_PLAN_DUE_SYNC_FIELDS = [
  "Enrollment Date", 
  "Last Care Plan", 
  "Next Care Plan Due", 
  "CP Type"
];

const UNLOCKED_SYNC_FIELDS = [
  "IDT Meeting Date", 
  "Care Plan Start Date"
];

const RAW_DEMO_P_DEMOGRAPHIC_FIELDS = [
  "Last Name", "First Name", "Preferred Name", "Date of Birth", "Participant PMR#", 
  "Phone Number", "Address Line 1", "Address Line 2", "City", "State", "Zip", 
  "Oxygen", "Primary Language", "Residence Type", "Additional Important Information"
];

const RAW_DEMO_P_CONTACT_FIELDS = [
  "Contact - Last Name", "Contact - First Name", "Type of Contact", "Contact - Primary Language", 
  "Relationship", "AD1 - Phone", "AD1 - Phone Valid Dates From", "AD1 - Phone Valid Dates To", 
  "AD2 - Phone", "AD2 - Phone Valid Dates From", "AD2 - Phone Valid Dates To", 
  "AD3 - Phone", "AD3 - Phone Valid Dates From", "AD3 - Phone Valid Dates To", "Company", "Contact - Notes"
];

const RAW_DEMO_P_CASELOAD_FIELDS = [
  "Caseload - Social Work", "Caseload - RN", "Caseload - PCP", "Caseload - HCC", 
  "Caseload - Activities", "Caseload - OT", "Caseload - PT", "Caseload - RD", "Caseload - Supervising MD"
];

const RAW_DEMO_P_BANNER_FIELDS = [
  "Safety - 2 Person", "Wanderer", "Interpreter Needed", "Fall Risk", "DPOA or Guardian Active", "Palliative Care"
];

const RAW_DEMO_P_ENROLLMENT_FIELDS = ["Capitation Date", "Enrollment Status"];
const RAW_DEMO_P_DISENROLLMENT_FIELDS = ["Disenrollment Date", "Disenrollment Effective Date", "Disenrollment Reason", "Date of Death"];

// ============================================================================
// 2. PUBLIC MENU & WORKFLOW ENTRY POINTS
// ============================================================================

/**
 * Menu Callback: Create / Update Master List
 * Synthesizes active Refined Data participants with CP Due and Unlocked CP sheets.
 */
function createMasterList() {
  const monthParts = typeof promptForLockedYearReportMonth_ === "function"
    ? promptForLockedYearReportMonth_("Create Master List")
    : getMonthDateParts_(new Date());

  if (!monthParts) return null;

  return runFrameworkTimed_("Create Master List " + formatReportDateLabel_(monthParts.firstDay), function(timing) {
    return createMasterListForMonth_(monthParts, timing, null);
  });
}

/**
 * Menu Callback: Build Monthly Change Report
 * Compares current vs. previous Raw Data records and logs month-over-month modifications.
 */
function buildMonthlyChangeReport() {
  const monthParts = typeof promptForLockedYearReportMonth_ === "function"
    ? promptForLockedYearReportMonth_("Build Monthly Change Report")
    : getMonthDateParts_(new Date());

  if (!monthParts) return null;

  return runFrameworkTimed_("Build Monthly Change Report " + formatReportDateLabel_(monthParts.firstDay), function(timing) {
    return buildMonthlyChangeReportForMonth_(monthParts, timing, null);
  });
}

// ============================================================================
// 3. MASTER LIST ROSTER SYNTHESIS & STAGING ENGINE
// ============================================================================

function createMasterListForMonth_(monthParts, parentTiming, preflight) {
  if (!monthParts) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const timing = parentTiming || (typeof startFrameworkTiming_ === "function" ? startFrameworkTiming_("Create Master List", monthParts) : null);

  const markStep = function(label, details) {
    if (typeof markFrameworkStep_ === "function") {
      markFrameworkStep_(timing, "Create Master List - " + label, details || "");
    }
  };

  let masterSheet = null;
  let copiedRowCount = 0;

  try {
    markStep("Start");
    const demoSheet = getCurrentDemoPSheet_(monthParts);
    if (!demoSheet) {
      notify_("Refined Data sheet for selected month was not found. Build Refined Data first.");
      markStep("Stopped - missing Refined Data");
      return null;
    }

    const masterName = buildMonthlySheetName_(MASTER_LIST_PREFIX, monthParts.firstDay, monthParts.lastDay);
    const existingMasterSheet = ss.getSheetByName(masterName);

    if (existingMasterSheet) {
      const replacementAlreadyConfirmed = !!(preflight && preflight.masterListExistsAndReplaceConfirmed && preflight.masterListName === masterName);
      if (!replacementAlreadyConfirmed) {
        const ui = SpreadsheetApp.getUi();
        const response = ui.alert("Master List Exists", `${masterName} already exists. Replace it?`, ui.ButtonSet.YES_NO);
        if (response !== ui.Button.YES) {
          notify_("Create Master List cancelled.");
          markStep("Cancelled - existing Master List not replaced");
          return null;
        }
      }
    }

    const masterBuildName = existingMasterSheet ? buildStagedMasterListSheetName_(masterName) : masterName;
    masterSheet = createMasterListSheetFromTemplate_(ss, masterBuildName, monthParts);

    buildMasterListHeadersBeforeDataCopy_(demoSheet, masterSheet);
    markStep("Build Master List headers");

    const dashboard = loadDashboardConfig_();
    const masterHeaders = getHeadersForSheetType_(dashboard, "Master List");
    const masterHeaderMap = buildHeaderIndexMap_(masterHeaders);

    const mappedRows = buildPrimaryDemoPRowsInMemory_(demoSheet, masterHeaders, masterHeaderMap);
    copiedRowCount = mappedRows.length;
    markStep("Mapped Refined Data rows in memory | Rows: " + copiedRowCount);

    if (copiedRowCount === 0) {
      throw new Error("Cannot create Master List: Refined Data contains no participant rows.");
    }

    const inMemoryData = { headers: masterHeaders, headerMap: masterHeaderMap, values: mappedRows, range: null };

    // In-memory sync of Care Plan and Unlocked sub-reports
    syncUnlockedCarePlanSourceIntoData_(inMemoryData, monthParts);
    markStep("Sync Unlocked CP to Master List (in-memory)");

    syncCarePlanDueSourceIntoData_(inMemoryData, monthParts);
    markStep("Sync Care Plan Due to Master List (in-memory)");

    const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
    const requiredMasterRows = dataStart + copiedRowCount - 1;
    if (masterSheet.getMaxRows() < requiredMasterRows) {
      masterSheet.insertRowsAfter(masterSheet.getMaxRows(), requiredMasterRows - masterSheet.getMaxRows());
    }

    masterSheet.getRange(dataStart, 1, copiedRowCount, masterHeaders.length).setValues(inMemoryData.values);
    markStep("Single-pass write complete | Synced rows written: " + copiedRowCount);

    if (existingMasterSheet) {
      masterSheet = promoteStagedMasterListSheet_(ss, masterSheet, existingMasterSheet, masterName, copiedRowCount, timing, markStep);
    } else {
      setRequiredSheetName_(masterSheet, masterName);
      if (typeof placeCreatedSheetInConfiguredOrder_ === "function") placeCreatedSheetInConfiguredOrder_(masterSheet);
      markStep("Set final Master List sheet name and order");
    }

    sortMasterListByParticipantNameAndPMR_(masterSheet);
    notify_(`Master List created successfully with ${copiedRowCount} active participant profiles!`);
    return masterSheet;

  } catch (err) {
    if (masterSheet && isStagedMasterListSheet_(masterSheet, buildMonthlySheetName_(MASTER_LIST_PREFIX, monthParts.firstDay, monthParts.lastDay))) {
      deleteSheetSafely_(ss, masterSheet, "Failed Master List staged build cleanup");
    }
    throw err;
  }
}

function buildPrimaryDemoPRowsInMemory_(demoSheet, masterHeaders, masterHeaderMap) {
  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const demoData = getDataValues_(demoSheet, headRow, dataStart);
  const demoHeaders = demoData.headers;
  const demoHeaderMap = demoData.headerMap;
  const pmrIdx = getPMRIndex_(demoHeaderMap);
  const statusIdx = demoHeaderMap["Enrollment Status"];
  if (pmrIdx === -1) throw new Error("Refined Data is missing Participant PMR# column.");

  const output = [];
  const seenPmrs = new Set();

  demoData.values.forEach(row => {
    const pmr = normalizePMR_(row[pmrIdx]);
    if (!pmr || seenPmrs.has(pmr)) return;

    // Filter out Disenrolled and Deceased participants
    if (statusIdx !== undefined) {
      const status = String(row[statusIdx] || "").trim().toLowerCase();
      if (status.includes("disenrolled") || status.includes("deceased")) return;
    }

    seenPmrs.add(pmr);

    const out = new Array(masterHeaders.length).fill("");
    demoHeaders.forEach((header, sourceIdx) => {
      if (!header) return;
      const targetIdx = masterHeaderMap[header];
      if (targetIdx !== undefined) out[targetIdx] = row[sourceIdx];
    });
    output.push(out);
  });

  return output;
}

// --- SUB-REPORT SOURCE SYNCHRONIZATION --------------------------------------

function syncUnlockedCarePlanSourceIntoData_(data, monthParts) {
  const sourceSheet = getCurrentUnlockedCarePlanSheet_(monthParts);
  if (!sourceSheet) return;

  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const sourceMap = buildSourceMapBySingleKey_(sourceSheet, headRow, dataStart, "Participant Name");
  syncRowsFromSourceMapData_(data, sourceMap, {
    masterKeyHeaders: ["Participant Name"],
    fields: [["IDT Meeting Date", "IDT Meeting Date"], ["Care Plan Start Date", "Care Plan Start Date"]]
  });
}

function syncCarePlanDueSourceIntoData_(data, monthParts) {
  const sourceSheet = getCurrentCarePlanDueSheet_(monthParts);
  if (!sourceSheet) return;

  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const sourceMap = buildSourceMapBySingleKey_(sourceSheet, headRow, dataStart, "Participant Name");
  syncRowsFromSourceMapData_(data, sourceMap, {
    masterKeyHeaders: ["Participant Name"],
    fields: [
      ["Enrollment Date", "Enrollment Date"], 
      ["Last Care Plan", "Last Care Plan"], 
      ["Next Care Plan Due", "Next Care Plan Due"], 
      ["CP Type", "CP Type"]
    ]
  });
}

function syncRowsFromSourceMapData_(data, sourceMap, config) {
  if (!data || !data.values || !data.values.length) return;
  const headerMap = data.headerMap;

  data.values.forEach(row => {
    const key = config.masterKeyHeaders.map(header => normalizeSyncKey_(row[headerMap[header]])).join("|||");
    if (!key || !sourceMap.has(key)) return;

    const source = sourceMap.get(key);
    config.fields.forEach(pair => {
      const destIdx = headerMap[pair[0]];
      if (destIdx !== undefined && source[pair[1]] !== undefined) {
        row[destIdx] = source[pair[1]];
      }
    });
  });
}

function buildSourceMapBySingleKey_(sheet, headerRow, dataStartRow, keyHeader) {
  const headRow = headerRow || ((typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4);
  const dataStart = dataStartRow || ((typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5);
  const data = getDataValues_(sheet, headRow, dataStart);
  const map = new Map();
  if (!data.values.length) return map;

  const keyIdx = data.headerMap[keyHeader];
  if (keyIdx === undefined) return map;

  data.values.forEach(row => {
    const key = normalizeSyncKey_(row[keyIdx]);
    if (!key) return;
    const record = {};
    data.headers.forEach((header, idx) => { if (header) record[header] = row[idx]; });
    map.set(key, record);
  });
  return map;
}

function normalizeSyncKey_(value) {
  if (value === null || value === undefined) return "";
  const text = String(value).trim().toLowerCase();
  if (text.indexOf(",") !== -1) {
    const parts = text.split(",");
    const last = parts[0].trim().replace(/\s+/g, "");
    const first = (parts[1] || "").trim().split(/\s+/)[0].replace(/[^a-z0-9]/g, "");
    return last + first;
  }
  return text.replace(/\s+/g, "");
}

// --- MASTER LIST SORTING & STAGING HELPERS ----------------------------------

function sortMasterListByParticipantNameAndPMR_(sheet) {
  sheet = sheet || SpreadsheetApp.getActiveSheet();
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < dataStart || lastCol < 1) return;

  const headerMap = buildHeaderIndexMap_(getHeaders_(sheet, headRow));
  const nameIdx = headerMap["Participant Name"] !== undefined ? headerMap["Participant Name"] : headerMap["Name"];
  if (nameIdx === undefined) return;

  const range = sheet.getRange(dataStart, 1, lastRow - dataStart + 1, lastCol);
  const values = range.getValues();

  values.sort((a, b) => {
    const nameA = String(a[nameIdx] || "").toLowerCase();
    const nameB = String(b[nameIdx] || "").toLowerCase();
    return nameA.localeCompare(nameB);
  });

  range.setValues(values);
}

function buildStagedMasterListSheetName_(masterName) {
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyyMMddHHmmss");
  return safeSheetName_(masterName + " __STAGED " + timestamp);
}

function isStagedMasterListSheet_(sheet, masterName) {
  if (!sheet) return false;
  return String(sheet.getName() || "").indexOf(masterName + " __STAGED") === 0;
}

function promoteStagedMasterListSheet_(ss, stagedSheet, existingSheet, masterName, copiedRowCount, timing, markStep) {
  if (existingSheet) {
    deleteSheetSafely_(ss, existingSheet, "Master List staged swap");
    if (markStep) markStep("Delete previous Master List");
    stagedSheet.setName(masterName);
    if (typeof placeCreatedSheetInConfiguredOrder_ === "function") placeCreatedSheetInConfiguredOrder_(stagedSheet);
    if (markStep) markStep("Promote staged Master List sheet");
  }
  return stagedSheet;
}

function createMasterListSheetFromTemplate_(ss, masterName, monthParts) {
  const dashboard = loadDashboardConfig_();
  const headers = getHeadersForSheetType_(dashboard, "Master List");
  let sheet = ss.getSheetByName(masterName);
  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;

  if (!sheet) {
    const template = ss.getSheetByName("Template - Master List");
    if (template) {
      sheet = template.copyTo(ss).setName(masterName);
    } else {
      sheet = ss.insertSheet(masterName);
    }
  }

  sheet.getRange("A1").setValue(masterName);
  if (headers.length > 0) {
    if (sheet.getMaxColumns() < headers.length) {
      sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length - sheet.getMaxColumns());
    }
    sheet.getRange(headRow, 1, 1, headers.length).setValues([headers]);
  }

  try { sheet.setFrozenRows(headRow); } catch (err) {}
  try { sheet.setFrozenColumns(2); } catch (err) {}

  sheet.showSheet();
  return sheet;
}

function buildMasterListHeadersBeforeDataCopy_(demoSheet, masterSheet) {
  if (!masterSheet) return;
  const dashboard = loadDashboardConfig_();
  const headers = getHeadersForSheetType_(dashboard, "Master List");
  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  if (!headers.length) return;

  if (masterSheet.getMaxColumns() < headers.length) {
    masterSheet.insertColumnsAfter(masterSheet.getMaxColumns(), headers.length - masterSheet.getMaxColumns());
  }
  masterSheet.getRange(headRow, 1, 1, headers.length).setValues([headers]);
}

// ============================================================================
// 4. MONTHLY CHANGE REPORT DELTA COMPILATION ENGINE
// ============================================================================

function buildMonthlyChangeReportForMonth_(monthParts, timing, options) {
  if (!monthParts) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const currentRaw = getCurrentRawDataSheet_(monthParts);
  const previousRaw = getPreviousRawDataSheet_(monthParts);

  if (!currentRaw || !previousRaw) {
    notify_("Monthly Change Report could not find required Raw Data source sheets for comparison.");
    return null;
  }

  const sectionData = compareRawDataForMonthlyChange_(previousRaw, currentRaw, monthParts);
  
  const totalChanges = sectionData.enrollmentPMRs.size + sectionData.disenrollmentPMRs.size + 
                       sectionData.demographicPMRs.size + sectionData.caseloadPMRs.size + 
                       sectionData.contactPMRs.size + sectionData.bannerPMRs.size + sectionData.otherPMRs.size;
                    
  if (totalChanges === 0) {
    notify_("No Raw Data changes found. Monthly Change Report was not created.");
    return null;
  }

  const reportName = buildMonthlySheetName_(MONTHLY_CHANGE_REPORT_PREFIX, monthParts.firstDay, monthParts.lastDay);
  let reportSheet = ss.getSheetByName(reportName);
  if (reportSheet) {
    ss.deleteSheet(reportSheet);
  }

  const dashboard = loadDashboardConfig_();
  const template = ss.getSheetByName("Template - Monthly Change");
  
  if (template) {
    reportSheet = template.copyTo(ss).setName(reportName);
  } else {
    reportSheet = ss.insertSheet(reportName);
  }

  reportSheet.showSheet();
  buildMonthlyChangeReportSectionLayout_(reportSheet, currentRaw, sectionData.currentData.headers, monthParts);
  populateMonthlyChangeReportSections_(reportSheet, sectionData, monthParts);

  notify_(`Monthly Change Report created.\n\nEnrollments: ${sectionData.enrollmentPMRs.size}\nDisenrollments: ${sectionData.disenrollmentPMRs.size}\nTotal Changed PMRs: ${totalChanges}`);
  return reportSheet;
}

function compareRawDataForMonthlyChange_(previousRaw, currentRaw, monthParts) {
  const previousData = getRawDataForCompare_(previousRaw);
  const currentData = getRawDataForCompare_(currentRaw);

  const enrollmentPMRs = new Set();
  const disenrollmentPMRs = new Set();
  const demographicPMRs = new Set();
  const caseloadPMRs = new Set();
  const contactPMRs = new Set();
  const bannerPMRs = new Set();
  const otherPMRs = new Set();

  const demographicChangedColumnsByPMR = new Map();
  const caseloadChangedColumnsByPMR = new Map();
  const contactChangedColumnsByPMR = new Map();
  const bannerChangedColumnsByPMR = new Map();
  const otherChangedColumnsByPMR = new Map();

  currentData.rowsByPMR.forEach((currentRows, pmr) => {
    const previousRows = previousData.rowsByPMR.get(pmr) || [];

    const isEnrollmentPMR = previousRows.length === 0;
    const isDisenrollmentPMR = currentRows.some(item => {
      const statusText = String(item.values[currentData.headerMap["Enrollment Status"]] || "").toLowerCase();
      return statusText === "disenrolled" || statusText === "deceased";
    });

    if (isEnrollmentPMR) { enrollmentPMRs.add(pmr); return; }
    if (isDisenrollmentPMR) { disenrollmentPMRs.add(pmr); return; }

    // Compare Sections
    const demoDiffs = getChangedColumnsForSectionRows_(currentRows, previousRows, RAW_DEMO_P_DEMOGRAPHIC_FIELDS, currentData.headerMap, previousData.headerMap);
    if (demoDiffs.size > 0) { demographicPMRs.add(pmr); demographicChangedColumnsByPMR.set(pmr, demoDiffs); }

    const caseloadDiffs = getChangedColumnsForSectionRows_(currentRows, previousRows, RAW_DEMO_P_CASELOAD_FIELDS, currentData.headerMap, previousData.headerMap);
    if (caseloadDiffs.size > 0) { caseloadPMRs.add(pmr); caseloadChangedColumnsByPMR.set(pmr, caseloadDiffs); }

    const contactDiffs = getChangedColumnsForSectionRows_(currentRows, previousRows, RAW_DEMO_P_CONTACT_FIELDS, currentData.headerMap, previousData.headerMap);
    if (contactDiffs.size > 0) { contactPMRs.add(pmr); contactChangedColumnsByPMR.set(pmr, contactDiffs); }

    const bannerDiffs = getChangedColumnsForSectionRows_(currentRows, previousRows, RAW_DEMO_P_BANNER_FIELDS, currentData.headerMap, previousData.headerMap);
    if (bannerDiffs.size > 0) { bannerPMRs.add(pmr); bannerChangedColumnsByPMR.set(pmr, bannerDiffs); }
  });

  return {
    previousData, currentData, enrollmentPMRs, disenrollmentPMRs,
    demographicPMRs, caseloadPMRs, contactPMRs, bannerPMRs, otherPMRs,
    demographicChangedColumnsByPMR, caseloadChangedColumnsByPMR,
    contactChangedColumnsByPMR, bannerChangedColumnsByPMR, otherChangedColumnsByPMR
  };
}

function getRawDataForCompare_(sheet) {
  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const data = getDataValues_(sheet, headRow, dataStart);
  const pmrIdx = getPMRIndex_(data.headerMap);
  if (pmrIdx === -1) throw new Error(`${sheet.getName()} is missing Participant PMR# column.`);

  const rowsByPMR = new Map();
  data.values.forEach((row, idx) => {
    const pmr = normalizePMR_(row[pmrIdx]);
    if (!pmr) return;
    if (!rowsByPMR.has(pmr)) rowsByPMR.set(pmr, []);
    rowsByPMR.get(pmr).push({ rowNumber: dataStart + idx, values: row });
  });

  return { sheet, headers: data.headers, headerMap: data.headerMap, values: data.values, rowsByPMR };
}

function getChangedColumnsForSectionRows_(currentItems, previousItems, columnsToCompare, currentHeaderMap, previousHeaderMap) {
  const changed = new Set();
  if (!currentItems || !currentItems.length || !previousItems || !previousItems.length) return changed;

  columnsToCompare.forEach(header => {
    const curIdx = currentHeaderMap[header];
    const prevIdx = previousHeaderMap[header];
    if (curIdx === undefined || prevIdx === undefined) return;

    const curVal = currentItems[0].values[curIdx];
    const prevVal = previousItems[0].values[prevIdx];

    if (!valuesAreEqual_(curVal, prevVal)) {
      changed.add(header);
    }
  });

  return changed;
}

// --- REPORT SECTION & MATRIX ASSEMBLY ---------------------------------------

function populateMonthlyChangeReportSections_(reportSheet, sectionData, monthParts) {
  if (!reportSheet || !sectionData || !sectionData.currentData) return;
  const headRow = (typeof HEADER_ROW !== "undefined") ? HEADER_ROW : 4;
  const currentData = sectionData.currentData;
  const reportHeaders = getMonthlyChangeReportHeaders_(currentData.headers || []);
  const lastCol = Math.max(reportHeaders.length, 1);

  const matrix = { values: [], backgrounds: [] };

  const sectionSpecs = [
    { title: "SECTION A - ENROLLMENTS", pmrSet: sectionData.enrollmentPMRs, changedMap: new Map() },
    { title: "SECTION B - DISENROLLMENTS", pmrSet: sectionData.disenrollmentPMRs, changedMap: new Map() },
    { title: "SECTION C - DEMOGRAPHIC CHANGES", pmrSet: sectionData.demographicPMRs, changedMap: sectionData.demographicChangedColumnsByPMR },
    { title: "SECTION D - CASELOAD CHANGES", pmrSet: sectionData.caseloadPMRs, changedMap: sectionData.caseloadChangedColumnsByPMR },
    { title: "SECTION E - CONTACT CHANGES", pmrSet: sectionData.contactPMRs, changedMap: sectionData.contactChangedColumnsByPMR },
    { title: "SECTION F - BANNER SUMMARY CHANGES", pmrSet: sectionData.bannerPMRs, changedMap: sectionData.bannerChangedColumnsByPMR }
  ];

  sectionSpecs.forEach(spec => {
    appendMonthlyChangeSectionBlock_(matrix, spec, currentData, sectionData.previousData, reportHeaders, lastCol);
  });

  const requiredRows = headRow + matrix.values.length;
  if (reportSheet.getMaxRows() < requiredRows) {
    reportSheet.insertRowsAfter(reportSheet.getMaxRows(), requiredRows - reportSheet.getMaxRows());
  }

  if (matrix.values.length > 0) {
    const writeRange = reportSheet.getRange(headRow + 1, 1, matrix.values.length, lastCol);
    writeRange.setValues(matrix.values);
    writeRange.setBackgrounds(matrix.backgrounds);
  }
}

function appendMonthlyChangeSectionBlock_(matrix, spec, currentData, previousData, reportHeaders, lastCol) {
  // 1. Section Title Banner
  const titleRow = new Array(lastCol).fill("");
  titleRow[0] = spec.title;
  matrix.values.push(titleRow);
  matrix.backgrounds.push(new Array(lastCol).fill("#CCE3EE")); // Level 3 Fill

  // 2. Spacer
  matrix.values.push(new Array(lastCol).fill(""));
  matrix.backgrounds.push(new Array(lastCol).fill("#79B5D2")); // Level 1 Fill

  // 3. Section Headers
  matrix.values.push(reportHeaders);
  matrix.backgrounds.push(new Array(lastCol).fill("#A5D0E3")); // Level 2 Fill

  // 4. Spacer
  matrix.values.push(new Array(lastCol).fill(""));
  matrix.backgrounds.push(new Array(lastCol).fill(null));

  // 5. Data Rows
  if (!spec.pmrSet || spec.pmrSet.size === 0) {
    const emptyRow = new Array(lastCol).fill("");
    emptyRow[0] = "No changes detected for this section.";
    matrix.values.push(emptyRow);
    matrix.backgrounds.push(new Array(lastCol).fill(null));
  } else {
    Array.from(spec.pmrSet).sort().forEach(pmr => {
      const items = currentData.rowsByPMR.get(pmr) || [];
      if (!items.length) return;

      const item = items[0];
      const changedColumns = spec.changedMap.get(pmr) || new Set();
      const rowValues = mapSourceRowToReportHeaders_(item.values, currentData.headers, reportHeaders, changedColumns);

      const backgrounds = new Array(lastCol).fill(null);
      if (changedColumns.size > 0) {
        reportHeaders.forEach((header, index) => {
          if (changedColumns.has(header)) backgrounds[index] = "#F8D7DA"; // Light Red highlight for changed cells
        });
      }

      matrix.values.push(rowValues);
      matrix.backgrounds.push(backgrounds);
    });
  }

  // 6. Section End Spacer
  matrix.values.push(new Array(lastCol).fill(""));
  matrix.backgrounds.push(new Array(lastCol).fill(null));
}

function mapSourceRowToReportHeaders_(sourceRow, sourceHeaders, reportHeaders, changedColumns) {
  const output = reportHeaders.map(targetH => {
    const srcIdx = (sourceHeaders || []).findIndex(h => String(h || "").trim().toLowerCase() === String(targetH || "").trim().toLowerCase());
    return (srcIdx !== -1 && srcIdx < sourceRow.length) ? sourceRow[srcIdx] : "";
  });

  const changeIdx = reportHeaders.indexOf("Columns With Change");
  if (changeIdx !== -1) {
    output[changeIdx] = changedColumns && changedColumns.size > 0 ? Array.from(changedColumns).join(", ") : "";
  }
  return output;
}

function getMonthlyChangeReportHeaders_(sourceHeaders) {
  const headers = (sourceHeaders || []).slice();
  if (headers.indexOf("Columns With Change") === -1) headers.push("Columns With Change");
  return headers;
}

function buildMonthlyChangeReportSectionLayout_(reportSheet, sourceSheet, headers, monthParts) {
  const reportHeaders = getMonthlyChangeReportHeaders_(headers || []);
  const lastCol = Math.max(reportHeaders.length, 1);

  reportSheet.getRange("A1").setValue("Monthly Change Report");
  reportSheet.getRange("A2").setValue("Date");
  if (monthParts) {
    reportSheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("m/d/yyyy");
    reportSheet.getRange("C2").setValue("to");
    reportSheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("m/d/yyyy");
  }

  try { reportSheet.setFrozenRows(4); } catch (e) {}
  try { reportSheet.setFrozenColumns(2); } catch (e) {}
}

function getPreviousRawDataSheet_(monthParts) {
  if (!monthParts || !monthParts.firstDay) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const prevDate = new Date(monthParts.firstDay.getFullYear(), monthParts.firstDay.getMonth() - 1, 1);
  const prevLabel = Utilities.formatDate(prevDate, Session.getScriptTimeZone(), "MM.yy");
  return ss.getSheetByName(`Raw Data ${prevLabel}`) || getLatestSheetByPrefix_("Raw Data");
}
