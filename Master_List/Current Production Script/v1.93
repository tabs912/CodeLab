function hideMonthlyActiveSheets() {
  const monthParts = promptForLockedYearReportMonth_("Hide Active Sheets (Month & Prior)");
  if (!monthParts) return null;
  return hideMonthlySheetsBySpecs_("Hide Monthly Active Sheets", buildPromptedMonthContext_(monthParts), [
    { label: "Raw Data", keywords: ["Raw Data"] },
    { label: "Master List", keywords: ["Master List"] },
    { label: "Monthly Change", keywords: ["Monthly Change"] },
    { label: "Disenrolled Exclusion", keywords: ["Disenrolled Exclusion", "Source - Disenrolled"] }
  ]);
}

function archiveMonthlyActiveSheets() {
  const monthParts = promptForLockedYearReportMonth_("Archive Active Sheets (Month & Prior)");
  if (!monthParts) return null;
  const parsed = buildPromptedMonthContext_(monthParts);

  return runFrameworkTimed_("Archive Monthly Active Sheets " + parsed.monthLabel + " & Prior", function(timing) {
    const result = archiveMonthlySheetsBySpecs_(parsed, [
      { label: "Raw Data", keywords: ["Raw Data", "Source - Raw Data"] },
      { label: "Master List", keywords: ["Master List"] },
      { label: "Monthly Change", keywords: ["Monthly Change"] }
    ], timing);
    
    if (typeof generateArchiveFileIndex_ === "function") {
       try { generateArchiveFileIndex_(); } catch(e) {}
    }
    
    if (typeof populateActiveIndex === "function") populateActiveIndex();
    notifyArchiveMonthlySheetsResult_("Archive Monthly Active Sheets", parsed.monthLabel + " and prior", result);
    return result;
  });
}

// ============================================================================
// 3. TEMPLATES AND SYSTEM SHEETS
// ============================================================================
function hideTemplates_() { return hideReportTemplates(); }
function showTemplates_() { return showReportTemplates(); }

function getDashboardConfigForTemplateVisibility_(dashboardOverride) {
  if (dashboardOverride) return dashboardOverride;
  try {
    return loadDashboardConfig_();
  } catch (err) {
    logBestEffortWarning_("Template visibility config unavailable; using prefix scan: " + err.message);
    return { sheetDefinitions: [] };
  }
}

function hideReportTemplates(dashboardOverride, timing) {
  if (timing) return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), true, timing);
  return runFrameworkTimed_("Hide Report Templates", function(activeTiming) {
    return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), true, activeTiming);
  });
}

function showReportTemplates(dashboardOverride, timing) {
  if (timing) return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), false, timing);
  return runFrameworkTimed_("Show Report Templates", function(activeTiming) {
    return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), false, activeTiming);
  });
}

function setReportTemplateVisibility_(dashboard, hidden, timing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetMap = {};
  
  ss.getSheets().forEach(function(sheet) {
    sheetMap[sheet.getName()] = sheet;
  });

  if (dashboard && dashboard.sheetDefinitions) {
    dashboard.sheetDefinitions.forEach(function(sheetDef) {
      const sheet = sheetMap[sheetDef.templateName];
      if (!sheet || sheetDef.templateName === "RFF_BASE_TEMPLATE") return;
      if (hidden) hideSheetIfNeeded_(sheet, timing, "Hide template: " + sheetDef.templateName);
      else showSheetIfNeeded_(sheet, timing, "Show template: " + sheetDef.templateName);
    });
  }

  Object.keys(sheetMap).forEach(function(sheetName) {
    if (sheetName === "RFF_BASE_TEMPLATE") return;
    if (String(sheetName || "").indexOf("Template - ") !== 0) return;
    
    const sheet = sheetMap[sheetName];
    if (hidden) hideSheetIfNeeded_(sheet, timing, "Hide orphan template: " + sheetName);
    else showSheetIfNeeded_(sheet, timing, "Show orphan template: " + sheetName);
  });
  
  const baseSheet = ss.getSheetByName("RFF_BASE_TEMPLATE");
  if (baseSheet) hideSheetIfNeeded_(baseSheet, null, "Force base template hidden");
  
  if (timing && typeof markFrameworkStep_ === "function") {
    markFrameworkStep_(timing, hidden ? "All templates hidden" : "All templates shown");
  }
}

function hideSystemSheets_() { return hideSystemSheetsNow(); }
function showSystemSheets_() { return showSystemSheetsNow(); }

function hideSystemSheetsNow() {
  return runFrameworkTimed_("Hide System Sheets", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const systemSheets = ["Framework Timing Report", "Dashboard Quality Report", "Archive - Demo P", "Default - Format Dashboard"];
    
    let hiddenCount = 0;
    systemSheets.forEach(function(name) {
      const sheet = ss.getSheetByName(name);
      if (sheet) {
        hideSheetIfNeeded_(sheet, timing, "Hide system sheet: " + name);
        hiddenCount++;
      }
    });
    if (typeof notify_ === "function") notify_("System sheets hidden: " + hiddenCount);
  });
}

function showSystemSheetsNow() {
  return runFrameworkTimed_("Show System Sheets", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const systemSheets = ["Format Dashboard", "Framework Timing Report", "Dashboard Quality Report", "Index"];
    
    let shownCount = 0;
    systemSheets.forEach(function(name) {
      const sheet = ss.getSheetByName(name);
      if (sheet) {
        showSheetIfNeeded_(sheet, timing, "Show system sheet: " + name);
        shownCount++;
      }
    });
    if (typeof notify_ === "function") notify_("System sheets shown: " + shownCount);
  });
}

// ============================================================================
// 4. ARCHIVE/HIDE LOGIC HELPERS
// ============================================================================

function hideMonthlySheetsBySpecs_(processName, parsedMonth, specs) {
  return runFrameworkTimed_(processName + " " + parsedMonth.monthLabel + " & Prior", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const result = { hidden: [], skipped: [] };
    
    specs.forEach(function(spec) {
      const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
      if (!sheets.length) {
        result.skipped.push(spec.label + " not found");
        return;
      }
      sheets.forEach(function(sheet) {
        try {
          if (!sheet.isSheetHidden()) {
            activateVisibleSheetBeforeHiding_(sheet);
            sheet.hideSheet();
          }
          result.hidden.push(sheet.getName());
        } catch (err) {
          result.skipped.push(sheet.getName() + ": " + err.message);
        }
      });
    });
    if (typeof notify_ === "function") notify_(processName + " complete for " + parsedMonth.monthLabel + " and prior. Hidden: " + result.hidden.length + "; Skipped: " + result.skipped.length + ".");
    return result;
  });
}

function archiveMonthlySheetsBySpecs_(parsedMonth, specs, timing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const archiveId = typeof getDocumentPropertiesCached_ === "function" ?
    (getDocumentPropertiesCached_().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "1PEEoXzPG-xRFuqDW_ZjPzyqdTUd_5AOwx0nbbzmMwBc") :
    (PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "1PEEoXzPG-xRFuqDW_ZjPzyqdTUd_5AOwx0nbbzmMwBc");

  const archiveSs = SpreadsheetApp.openById(archiveId);
  const result = { archived: [], skipped: [], failed: [] };
  if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archive workbook connection established for batch", "Archive ID: " + archiveId);

  specs.forEach(function(spec) {
    const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
    if (!sheets.length) {
      logBestEffortWarning_("No local sheet found for " + spec.label + " " + parsedMonth.monthLabel + " or prior");
      result.skipped.push(spec.label);
      return;
    }

    sheets.forEach(function(sheet) {
      const sheetName = sheet.getName();
      try {
        const archiveResult = copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing);
        result.archived.push(sheetName);
        if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archived monthly sheet: " + sheetName, archiveResult.localAction);
      } catch (err) {
        logBestEffortWarning_("Archive monthly sheet failed: " + sheetName + " - " + err.message);
        result.failed.push(sheetName + ": " + err.message);
      }
    });
  });

  return result;
}

function findArchiveMonthlyCandidateSheetsUpToDate_(ss, keywords, cutoffDate) {
  const keywordList = (keywords || []).map(function(keyword) {
    return String(keyword || "").trim().toLowerCase();
  }).filter(Boolean);
  
  const matches = [];
  const seen = new Set();
  const cutoffKey = cutoffDate ? Number(Utilities.formatDate(cutoffDate, Session.getScriptTimeZone(), "yyyyMM")) : 0;

  ss.getSheets().forEach(function(sheet) {
    const name = sheet.getName();
    const lowerName = name.toLowerCase();
    if (lowerName.indexOf("template") !== -1) return;

    const hasKeyword = keywordList.some(function(keyword) { return lowerName.indexOf(keyword) !== -1; });
    if (!hasKeyword) return;
    if (seen.has(name)) return;

    const sheetDate = extractFirstDateFromSheetName_(name);
    if (sheetDate) {
      const sheetKey = Number(Utilities.formatDate(sheetDate, Session.getScriptTimeZone(), "yyyyMM"));
      if (sheetKey <= cutoffKey) {
        seen.add(name);
        matches.push(sheet);
      }
    }
  });

  matches.sort(function(a, b) { return a.getName().localeCompare(b.getName()); });
  return matches;
}

// ============================================================================
// 5. SHEET TAB RANKING & ORGANIZATION
// ============================================================================

function organizeTabs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  sheets.forEach(s => positionSheetBySectionFRank_(s));
  ss.toast("Sheet Tabs Re-organized according to Rank Governance!", "Tab Engine", 4);
}

function positionSheetBySectionFRank_(sheet, rank) {
  if (!sheet) return;
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var currentSheet = ss.getSheetByName(sheet.getName());
    if (!currentSheet) return;

    var targetRank = rank || getTargetRankForSheet_(currentSheet.getName());
    var sheets = ss.getSheets();
    
    var targetPos = 1;
    for (var i = 0; i < sheets.length; i++) {
      if (sheets[i].getName() === currentSheet.getName()) continue;
      var otherRank = getTargetRankForSheet_(sheets[i].getName());
      if (otherRank < targetRank) {
        targetPos++;
      }
    }

    ss.setActiveSheet(currentSheet);
    ss.moveActiveTab(Math.min(Math.max(1, targetPos), sheets.length));
  } catch (e) {}
}

function getTargetRankForSheet_(sheetName) {
  const rules = loadSectionFTabRules_();
  const match = matchSheetToSectionFRule_(sheetName, rules);
  return match.rank;
}

function matchSheetToSectionFRule_(sheetName, rules) {
  const cleanName = String(sheetName || "").trim().toLowerCase().replace(/[^a-z0-9]/g, "");
  for (let i = 0; i < rules.length; i++) {
    const ruleClean = rules[i].prefix.toLowerCase().replace(/[^a-z0-9]/g, "");
    if (cleanName === ruleClean || cleanName.indexOf(ruleClean) === 0) return rules[i];
  }
  if (sheetName.indexOf("Template - ") === 0 || sheetName === "RFF_BASE_TEMPLATE") return { group: "Template", rank: 800 };
  return { group: "Unformatted", rank: 999 };
}

function loadSectionFTabRules_() {
  return [
    { prefix: "Index", group: "System & Configuration", rank: 1 },
    { prefix: "Refined Data", group: "Core Operational", rank: 2 },
    { prefix: "Disenrolled Exclusion", group: "Core Operational", rank: 10 },
    { prefix: "Master List", group: "Monthly Active", rank: 21 },
    { prefix: "Monthly Change", group: "Monthly Active", rank: 22 },
    { prefix: "Raw Data", group: "Monthly Active", rank: 23 },
    { prefix: "Banners", group: "Monthly Sub-Reports", rank: 24 },
    { prefix: "CP Due", group: "Monthly Sub-Reports", rank: 25 },
    { prefix: "Unlock CP", group: "Monthly Sub-Reports", rank: 26 },
    { prefix: "Timing", group: "System & Configuration", rank: 500 },
    { prefix: "Quality", group: "System & Configuration", rank: 501 },
    { prefix: "Format Dashboard", group: "System & Configuration", rank: 502 }
  ];
}

// ============================================================================
// LAYOUT DEPENDENCIES (Internal Helpers)
// ============================================================================

function promptForLockedYearReportMonth_(title) {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt(title, "Enter Report Month (MM.YY or MM/YY, e.g. 05.26):", ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return null;
  const val = res.getResponseText().trim();
  if (!val) return null;
  return val;
}

function buildPromptedMonthContext_(inputStr) {
  let month = 1, year = 2026;
  const clean = String(inputStr || "").replace(/[^0-9.\/]/g, "");
  const parts = clean.split(/[.\/]/);
  if (parts.length >= 2) {
    month = parseInt(parts[0], 10) || 1;
    let y = parseInt(parts[1], 10);
    if (y < 100) y += 2000;
    year = y || 2026;
  } else if (clean.length === 4) {
    month = parseInt(clean.substring(0, 2), 10) || 1;
    year = 2000 + (parseInt(clean.substring(2, 4), 10) || 26);
  }
  const reportDate = new Date(year, month - 1, 1);
  const monthStr = (month < 10 ? "0" : "") + month;
  const yearShort = String(year).substring(2);
  return { monthLabel: monthStr + "." + yearShort, reportDate: reportDate, month: month, year: year, firstDay: reportDate, lastDay: new Date(year, month, 0) };
}

function notifyArchiveMonthlySheetsResult_(title, monthLabel, result) {
  const msg = title + " complete for " + monthLabel + ".\nArchived: " + (result.archived ? result.archived.length : 0) +
              "\nSkipped: " + (result.skipped ? result.skipped.length : 0) +
              "\nFailed: " + (result.failed ? result.failed.length : 0);
  SpreadsheetApp.getActiveSpreadsheet().toast(msg, title, 5);
}

function hideSheetIfNeeded_(sheet, timing, logMsg) {
  if (!sheet) return;
  if (!sheet.isSheetHidden()) {
    activateVisibleSheetBeforeHiding_(sheet);
    sheet.hideSheet();
    if (logMsg && typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, logMsg, "Hidden");
  }
}

function showSheetIfNeeded_(sheet, timing, logMsg) {
  if (!sheet) return;
  if (sheet.isSheetHidden()) {
    sheet.showSheet();
    if (logMsg && typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, logMsg, "Shown");
  }
}

function copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing) {
  const copied = sheet.copyTo(archiveSs);
  copied.setName(sheetName + " (Archived " + Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm") + ")");
  activateVisibleSheetBeforeHiding_(sheet);
  ss.deleteSheet(sheet);
  return { localAction: "Deleted local sheet " + sheetName };
}

function extractFirstDateFromSheetName_(name) {
  const match = String(name || "").match(/(\d{2})[.\/-](\d{2,4})/);
  if (match) {
    let m = parseInt(match[1], 10);
    let y = parseInt(match[2], 10);
    if (y < 100) y += 2000;
    return new Date(y, m - 1, 1);
  }
  return new Date();
}

function activateVisibleSheetBeforeHiding_(sheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss.getActiveSheet().getName() === sheet.getName()) {
    const other = ss.getSheets().find(s => s.getName() !== sheet.getName() && !s.isSheetHidden());
    if (other) ss.setActiveSheet(other);
  }
}

function saveActiveLayoutAsRebuildDefault() {
  SpreadsheetApp.getActiveSpreadsheet().toast("Active Layout Saved as Rebuild Default!", "Layout Engine", 4);
}

// ============================================================================
// MODULE 3 v1.93: FORMATTING, TEMPLATES & SYSTEM SHEETS
// File: 03_Formatting_Templates.gs
// ============================================================================

// ============================================================================
// 1. BASE TEMPLATE & PHASE 1 GENERAL TEMPLATE ENGINE
// ============================================================================

function createOrRefreshBaseTemplate_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var baseSheet = ss.getSheetByName("RFF_BASE_TEMPLATE");
  
  if (!baseSheet) {
    baseSheet = ss.insertSheet("RFF_BASE_TEMPLATE");
  } else {
    baseSheet.clear();
    baseSheet.clearFormats();
  }

  var freezeRows = getDashboardSetting_("Freeze Rows", GLOBAL_DEFAULTS.FREEZE_ROWS);
  var freezeCols = getDashboardSetting_("Freeze Columns", GLOBAL_DEFAULTS.FREEZE_COLS);
  baseSheet.setFrozenRows(freezeRows);
  baseSheet.setFrozenColumns(freezeCols);

  var baseCols = 50;
  if(typeof resizeSheetGrid_ === "function") resizeSheetGrid_(baseSheet, 100, baseCols);

  var fullRange = baseSheet.getRange(1, 1, 100, baseCols);
  fullRange.setFontFamily(getDashboardSetting_("Standard Font", GLOBAL_DEFAULTS.STANDARD_FONT));
  fullRange.setFontSize(getDashboardSetting_("Standard Font Size", GLOBAL_DEFAULTS.STANDARD_FONT_SIZE));
  fullRange.setFontColor(getDashboardSetting_("Standard Font Color", GLOBAL_DEFAULTS.STANDARD_FONT_COLOR));
  fullRange.setHorizontalAlignment("left");
  fullRange.setVerticalAlignment("middle");
  fullRange.setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);
  fullRange.setNumberFormat(GLOBAL_DEFAULTS.DEFAULT_TEXT_FORMAT);
  fullRange.setBorder(true, true, true, true, true, true, GLOBAL_DEFAULTS.BORDER_COLOR, GLOBAL_DEFAULTS.BORDER_STYLE);

  baseSheet.setRowHeight(1, getDashboardSetting_("Row 1 (Title) Height", GLOBAL_DEFAULTS.ROW_HEIGHT_TITLE));
  baseSheet.setRowHeight(2, getDashboardSetting_("Row 2 Height", GLOBAL_DEFAULTS.ROW_HEIGHT_DATE));
  baseSheet.setRowHeight(3, getDashboardSetting_("Row 3 Height", GLOBAL_DEFAULTS.ROW_HEIGHT_SPACER));
  
  var dataRowHeight = getDashboardSetting_("Default Data Row Height", GLOBAL_DEFAULTS.ROW_HEIGHT_DATA);
  for (var r = 4; r <= 100; r++) {
    baseSheet.setRowHeight(r, dataRowHeight);
  }

  var defaultWidth = getDashboardSetting_("Default Column Width", GLOBAL_DEFAULTS.DEFAULT_COL_WIDTH);
  for (var c = 1; c <= baseCols; c++) {
    baseSheet.setColumnWidth(c, defaultWidth);
  }

  var cellA1 = baseSheet.getRange("A1");
  cellA1.setFontSize(getDashboardSetting_("A1 (Title) Font Size", 14));
  cellA1.setFontWeight("bold");
  cellA1.setWrapStrategy(SpreadsheetApp.WrapStrategy.OVERFLOW);

  var cellC1 = baseSheet.getRange("C1");
  cellC1.setFontSize(getDashboardSetting_("C1 (Title) Font Size", 5));
  cellC1.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);

  baseSheet.getRange(4, 1, 1, baseCols).setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);

  baseSheet.hideSheet();
  return baseSheet;
}

function createTemplateFromBase_(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const existing = ss.getSheetByName(targetName);
  
  if (existing) {
    ss.deleteSheet(existing);
    SpreadsheetApp.flush();
  }
  
  const base = ss.getSheetByName("RFF_BASE_TEMPLATE") || createOrRefreshBaseTemplate_();
  const newSheet = base.copyTo(ss);
  newSheet.setName(targetName);
  newSheet.showSheet();
  SpreadsheetApp.flush();
  
  return newSheet;
}

function buildGeneralTemplate_(config) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sysName = config.systemSheetName;
  var templateName = config.templateName || ("Template - " + sysName);

  var templateSheet = createTemplateFromBase_(templateName);

  if(typeof positionSheetBySectionFRank_ === "function") positionSheetBySectionFRank_(templateSheet, config.rank);

  var targetCols = Math.max(
    config.columnCount || 0,
    config.headers ? config.headers.length : 0,
    10
  );
  var targetRows = config.minimumRows || 100;
  if(typeof resizeSheetGrid_ === "function") resizeSheetGrid_(templateSheet, targetRows, targetCols);

  var theme = config.theme || getTemplateTheme_(sysName);

  if (config.usesAlternatingColors !== false && sysName !== "Format Dashboard") {
    if(typeof applyNativeBandingSafe_ === "function") applyNativeBandingSafe_(templateSheet, 5, targetCols, targetRows, theme.level4, theme.level5);
  }

  applyTitleRows_(templateSheet, config, theme);

  if (config.usesSubheaders && config.subheaders && config.subheaders.length > 0) {
    applySubheaderBlocks_(templateSheet, config.subheaders, theme, sysName);
  }

  applyColumnWidthsEngine_(templateSheet, config);

  if (theme.level1) templateSheet.setTabColor(theme.level1);
  writeTemplateMetadata_(templateSheet, config, targetCols);

  templateSheet.hideSheet();
  return templateSheet;
}

function applyTitleRows_(sheet, config, theme) {
  var sysName = config.systemSheetName || "";
  var sheetType = config.sheetType || "DATA";
  var fullGridCols = sheet.getMaxColumns();

  var titleCell = sheet.getRange("A1");
  titleCell.setValue(config.reportTitle || sysName);
  titleCell.setFontSize(14);
  titleCell.setFontWeight("bold");

  if (theme.level3) {
    sheet.getRange(1, 1, 2, fullGridCols).setBackground(theme.level3);
  }
  if (theme.titleFontColor) {
    titleCell.setFontColor(theme.titleFontColor);
  }

  if (sheetType === "DATA") {
    sheet.getRange("A2").setValue("Date");
    sheet.getRange("C2").setValue("to");
  } else if (sysName.indexOf("Timing") !== -1 || sysName.indexOf("Quality") !== -1) {
    sheet.getRange("A2").setValue("Date Created");
  } else if (sysName === "Index") {
    sheet.getRange("A2").setValue("Last Update");
  }

  if (theme.level1) {
    sheet.getRange(3, 1, 1, fullGridCols).setBackground(theme.level1);
  }

  if (theme.level2) {
    sheet.getRange(4, 1, 1, fullGridCols).setBackground(theme.level2);
  }

  if (!config.usesSubheaders && config.headers && config.headers.length > 0) {
    var headerTextRange = sheet.getRange(4, 1, 1, config.headers.length);
    headerTextRange.setValues([config.headers]);
    headerTextRange.setFontWeight("bold");
    headerTextRange.setFontSize(10);
  }
}

function applySubheaderBlocks_(sheet, subheaders, theme, sysName) {
  var currentRow = 5;
  var maxCols = sheet.getMaxColumns();
  var dashConfig = loadDashboardConfig_();
  var b2Specs = dashConfig.subheaderRows || [];

  subheaders.forEach(function(block) {
    var steps = [1, 2, 3, 4, 5, 6];

    steps.forEach(function(stepNum) {
      var stepSpecs = b2Specs.filter(function(s) { return Number(s.row) === stepNum; });
      var primarySpec = stepSpecs.length > 0 ? stepSpecs[0] : null;

      currentRow++;

      var rHeight = (primarySpec && primarySpec.height && !isNaN(primarySpec.height)) ? Number(primarySpec.height) : 25;
      sheet.setRowHeight(currentRow, rHeight);

      if (primarySpec && primarySpec.fillLevel) {
        var fillLevelKey = String(primarySpec.fillLevel || "").toLowerCase().replace(/[^a-z0-9]/g, "");
        var bgColor = (fillLevelKey && fillLevelKey !== "none") ? theme[fillLevelKey] : null;
        if (bgColor) {
          sheet.getRange(currentRow, 1, 1, maxCols).setBackground(bgColor);
        }
      }

      if (stepNum === 1 || stepNum === 5) {
        return; 
      }

      if (stepNum === 2) {
        stepSpecs.forEach(function(spec) {
          var targetColStr = String(spec.targetCell || "").toUpperCase();
          var isTimestamp = String(spec.purpose || "").toUpperCase().indexOf("TIMESTAMP") !== -1 || targetColStr === "C" || targetColStr === "COL C";
          
          if (!isTimestamp) {
            var cellA = sheet.getRange(currentRow, 1);
            cellA.setValue(block.title);
            if (spec.fontSize) cellA.setFontSize(Number(spec.fontSize));
            if (spec.fontWeight) cellA.setFontWeight(spec.fontWeight.toLowerCase() === "bold" ? "bold" : "normal");
            if (spec.wrap) cellA.setWrapStrategy(getWrapStrategyEnum_(spec.wrap));
            if (spec.alignment) cellA.setHorizontalAlignment(spec.alignment.toLowerCase());
          } else {
            if (sysName.indexOf("Timing") !== -1 || sysName.indexOf("Quality") !== -1 || sysName.indexOf("Change") !== -1 || block.stampLastUpdated) {
              var cellC = sheet.getRange(currentRow, 3);
              cellC.setValue("Last Updated"); 
              if (spec.fontSize) cellC.setFontSize(Number(spec.fontSize));
              if (spec.fontWeight) cellC.setFontStyle(spec.fontWeight.toLowerCase() === "italic" ? "italic" : "normal");
              if (spec.wrap) cellC.setWrapStrategy(getWrapStrategyEnum_(spec.wrap));
              if (spec.alignment) cellC.setHorizontalAlignment(spec.alignment.toLowerCase());
            }
          }
        });
        return;
      }

      if (stepNum === 3) {
        return; 
      }

      if (stepNum === 4) {
        var wrapStrat = (primarySpec && primarySpec.wrap) ? getWrapStrategyEnum_(primarySpec.wrap) : SpreadsheetApp.WrapStrategy.WRAP;
        if (block.headers && block.headers.length > 0) {
          var headerTextRange = sheet.getRange(currentRow, 1, 1, block.headers.length);
          headerTextRange.setValues([block.headers]);
          if (primarySpec && primarySpec.fontSize) headerTextRange.setFontSize(Number(primarySpec.fontSize));
          if (primarySpec && primarySpec.fontWeight) headerTextRange.setFontWeight(primarySpec.fontWeight.toLowerCase() === "bold" ? "bold" : "normal");
          if (primarySpec && primarySpec.alignment) headerTextRange.setHorizontalAlignment(primarySpec.alignment.toLowerCase());
          headerTextRange.setWrapStrategy(wrapStrat);
        }
        return;
      }

      if (stepNum === 6) {
        var wrapStrat6 = (primarySpec && primarySpec.wrap) ? getWrapStrategyEnum_(primarySpec.wrap) : SpreadsheetApp.WrapStrategy.CLIP;
        var placeholderCell = sheet.getRange(currentRow, 1);
        placeholderCell.setValue("Insert new data here");
        if (primarySpec && primarySpec.fontSize) placeholderCell.setFontSize(Number(primarySpec.fontSize));
        if (primarySpec && primarySpec.fontWeight) placeholderCell.setFontWeight(primarySpec.fontWeight.toLowerCase() === "bold" ? "bold" : "normal");
        if (primarySpec && primarySpec.alignment) placeholderCell.setHorizontalAlignment(primarySpec.alignment.toLowerCase());
        placeholderCell.setWrapStrategy(wrapStrat6);
        return;
      }
    });
  });
}

function getWrapStrategyEnum_(wrapStr) {
  var w = String(wrapStr || "").toUpperCase();
  if (w === "WRAP") return SpreadsheetApp.WrapStrategy.WRAP;
  if (w === "OVERFLOW") return SpreadsheetApp.WrapStrategy.OVERFLOW;
  return SpreadsheetApp.WrapStrategy.CLIP;
}

function applyColumnWidthsEngine_(sheet, config) {
  if (!sheet) return;
  var targetCols = sheet.getMaxColumns();
  var dashConfig = loadDashboardConfig_();
  var defaultColWidth = Number(dashConfig.globals["Default Column Width"]) || GLOBAL_DEFAULTS.DEFAULT_COL_WIDTH;
  var widthSpec = String(config.columnWidths || "").trim();

  if (widthSpec && widthSpec.toUpperCase() !== "FIT_TO_DATA") {
    var parsedWidths = widthSpec.split(",").map(item => parseInt(item.trim(), 10));
    if (parsedWidths.some(w => !isNaN(w) && w > 0)) {
      if (parsedWidths.length === 1 && !isNaN(parsedWidths[0]) && parsedWidths[0] > 0) {
        for (var col = 1; col <= targetCols; col++) {
          sheet.setColumnWidth(col, parsedWidths[0]);
        }
      } else {
        for (var i = 0; i < targetCols; i++) {
          var colWidth = (i < parsedWidths.length && !isNaN(parsedWidths[i]) && parsedWidths[i] > 0) 
                         ? parsedWidths[i] 
                         : defaultColWidth;
          sheet.setColumnWidth(i + 1, colWidth);
        }
      }
      return;
    }
  }

  for (var c = 1; c <= targetCols; c++) {
    sheet.setColumnWidth(c, defaultColWidth);
  }
}

// ============================================================================
// 2. PHASE 2: OPERATIONAL TEMPLATE SECONDARY BUILDER
// ============================================================================

function applyOperationalFormatting_(templateSheet, systemSheetName) {
  if (!templateSheet) return;
  const config = loadDashboardConfig_();
  
  const headers = config.sheetHeaders[systemSheetName] || 
                  config.sheetHeaders[getStandardSheetKey_(systemSheetName)] || [];
  
  if (!headers || headers.length === 0) return;

  if(typeof resizeSheetGrid_ === "function") resizeSheetGrid_(templateSheet, templateSheet.getMaxRows(), headers.length);
  
  const headerRange = templateSheet.getRange(4, 1, 1, headers.length);
  headerRange.setValues([headers]);
  headerRange.setFontWeight("bold");

  const colDefs = config.columnDefinitions || {};
  const defaultWidth = Number(config.globals["Default Column Width"]) || GLOBAL_DEFAULTS.DEFAULT_COL_WIDTH;
  const maxRows = templateSheet.getMaxRows();

  for (let c = 0; c < headers.length; c++) {
    const headerName = String(headers[c] || "").trim();
    const colDef = colDefs[headerName] || colDefs[headerName.toLowerCase()] || {};
    const colIdx = c + 1;

    if (colDef.width && colDef.width > 0) {
      templateSheet.setColumnWidth(colIdx, colDef.width);
    } else {
      templateSheet.setColumnWidth(colIdx, defaultWidth);
    }

    if (maxRows >= 5) {
      const dataColRange = templateSheet.getRange(5, colIdx, maxRows - 4, 1);
      
      if (colDef.format) {
        dataColRange.setNumberFormat(colDef.format);
      } else if (colDef.dateColumn) {
        dataColRange.setNumberFormat("mm/dd/yyyy");
      }

      if (colDef.align) {
        dataColRange.setHorizontalAlignment(colDef.align);
      }
      if (colDef.vAlign) {
        dataColRange.setVerticalAlignment(colDef.vAlign);
      }
      if (colDef.wrap) {
        dataColRange.setWrapStrategy(
          colDef.wrap === "WRAP" ? SpreadsheetApp.WrapStrategy.WRAP :
          colDef.wrap === "OVERFLOW" ? SpreadsheetApp.WrapStrategy.OVERFLOW :
          SpreadsheetApp.WrapStrategy.CLIP
        );
      }
    }
  }
}

function getStandardSheetKey_(sysName) {
  const map = {
    "Banners": "Banners", "CP Due": "CP Due Date", "Unlock CP": "Unlock CP",
    "Raw Data": "Raw Data", "Refined Data": "Refined Data",
    "Disenrolled": "Disenrolled Exclusion", "Master List": "Master List",
    "Monthly Change": "Monthly Change"
  };
  return map[sysName] || sysName;
}

// ============================================================================
// 3. SYSTEM & OPERATIONAL TEMPLATE BUILDERS
// ============================================================================

function createSystemTemplates() {
  buildFrameworkTimingTemplate_();
  buildDashboardQualityTemplate_();
  if(typeof buildIndexTemplate_ === "function") buildIndexTemplate_();
}

function buildFrameworkTimingTemplate_() { return buildGeneralTemplate_(getTemplateConfigFromDashboard_("Framework Timing Report")); }
function buildDashboardQualityTemplate_() { return buildGeneralTemplate_(getTemplateConfigFromDashboard_("Dashboard Quality Report")); }
function buildIndexTemplate_() { return buildGeneralTemplate_(getTemplateConfigFromDashboard_("Index")); }

function createAllReportTemplates() {
  buildTemplateBannerReport();
  buildTemplateCarePlanDue();
  buildTemplateUnlockedCarePlan();
  buildTemplateRawData();
  buildTemplateRefinedData();
  buildTemplateDisenrolledExclusion();
  buildTemplateMasterList();
  buildTemplateMonthlyChange();
}

function buildOperationalReportTemplate_(systemSheetName) {
  const templateSheet = buildGeneralTemplate_(getTemplateConfigFromDashboard_(systemSheetName));
  applyOperationalFormatting_(templateSheet, systemSheetName);
  return templateSheet;
}

function buildTemplateBannerReport() { return buildOperationalReportTemplate_("Banners"); }
function buildTemplateCarePlanDue() { return buildOperationalReportTemplate_("CP Due Date"); }
function buildTemplateUnlockedCarePlan() { return buildOperationalReportTemplate_("Unlock CP"); }
function buildTemplateRawData() { return buildOperationalReportTemplate_("Raw Data"); }
function buildTemplateRefinedData() { return buildOperationalReportTemplate_("Refined Data"); }
function buildTemplateDisenrolledExclusion() { return buildOperationalReportTemplate_("Disenrolled Exclusion"); }
function buildTemplateMasterList() { return buildOperationalReportTemplate_("Master List"); }
function buildTemplateMonthlyChange() { return buildOperationalReportTemplate_("Monthly Change"); }

// ============================================================================
// 4. FORMAT DASHBOARD BUILDER & CALCULATOR
// ============================================================================

function buildFormatDashboardTemplate_() {
  const dashSheet = buildGeneralTemplate_({
    systemSheetName: "Format Dashboard",
    templateName: "Default - Format Dashboard",
    reportTitle: "Format Dashboard",
    sheetType: "SYSTEM",
    columnCount: 19,
    minimumRows: 100,
    rank: 502,
    columnWidths: "220, 150, 215, 165, 130, 120, 120, 120, 140, 120, 120, 306, 144, 100, 100, 110, 100"
  });

  const dashWidth = 19;
  const dashRows = [];

  dashRows.push(["Format Dashboard", "- v1.8.9.8.2 -", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]);
  dashRows.push(["Date Created", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]);
  dashRows.push(new Array(dashWidth).fill(""));
  dashRows.push(new Array(dashWidth).fill(""));

  appendDashboardSectionRows_(dashRows, "SECTION A - GLOBAL SETTINGS", ["Setting", "Value", "Options / Format Description"], getDefaultGlobalSettingsRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION B - TITLE ROWS", ["Sheet Type", "Row", "Purpose", "Value Source", "Label", "Target Cell", "Height", "Font Size", "Font Weight", "Fill Level", "Alignment", "Wrap", "Notes"], getDefaultTitleRowRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION B2 - SUBHEADER ROWS", ["Sheet Type", "Row", "Purpose", "Value Source", "Label", "Target Cell", "Height", "Font Size", "Font Weight", "Fill Level", "Alignment", "Wrap", "Notes"], getDefaultSubheaderRowRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION C -  Template Structural Specs", ["System Sheet Name", "Group", "Report Title", "Tab Position Rank", "Base Color", "Level 1 ", "Level 2", "Level 3", "Level 4", "Level 5", "Title Font Color", "Column Count", "Default Column Widths", "Row Mode", "Minimum Rows", "Buffer Rows", "Uses Alternating Colors", "Uses Subheaders", "Notes"], getDefaultC1StructuralRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION D -  Active Output & Tab Governance", ["System Sheet Name", "Output Naming Pattern", "Group", "Tab Position Rank", "Special", "Output Visibility", "Remove / Archive", "Use Prompt Date", "End Date Source"], getDefaultC2OutputGovernanceRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION E - Source/Unfomatted", ["System Sheet Name", "Output Naming Pattern", "Group", "Tab Position Rank", "Special", "Output Visibility", "Remove / Archive"], getDefaultC3SourceRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION F - COLUMN DEFINITIONS", ["Header", "Width", "Header Font Size", "Date Column", "Hide Column", "Data Wrap", "Horizontal Alignment", "Vertical Alignment", "Number Format"], getDefaultColumnDefinitionRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION G - SHEET HEADERS", ["Sheet Type", "Column Order", "Header", "Source of Data"], getDefaultSheetHeaderRows_(), dashWidth);

  dashSheet.getRange(1, 1, dashRows.length, dashWidth).setValues(dashRows);

  if (typeof recalculateDashboardHexCodes_ === "function") {
    recalculateDashboardHexCodes_(dashSheet);
  }

  const theme = typeof getTemplateTheme_ === "function" ? getTemplateTheme_("Format Dashboard") : { level3: "#ccc", level1: "#eee", level2: "#ddd", level4: "#fff", level5: "#fafafa" };
  if(typeof applyNativeBandingSafe_ === "function") applyNativeBandingSafe_(dashSheet, 5, dashWidth, dashSheet.getMaxRows(), theme.level4, theme.level5);

  formatDashboardSections_(dashSheet, theme);

  if (dashSheet.getMaxRows() >= 225) {
    var rowsToHide = Math.min(301, dashSheet.getMaxRows() - 224);
    dashSheet.hideRows(225, rowsToHide);
  }

  return dashSheet;
}

function formatDashboardSections_(sheet, theme) {
  if (!sheet) return;
  const maxCols = sheet.getMaxColumns();
  const values = sheet.getDataRange().getValues();

  for (let r = 0; r < values.length; r++) {
    const val = String(values[r][0] || "").trim();
    if (val.indexOf("SECTION ") === 0) {
      const bannerSheetRow = r + 1;
      const spacerSheetRow = r + 2;
      const headerSheetRow = r + 3;

      const bannerRange = sheet.getRange(bannerSheetRow, 1, 1, maxCols);
      bannerRange.setBackground(theme.level3 || "#CCE3EE");
      sheet.getRange(bannerSheetRow, 1).setFontSize(12).setFontWeight("bold");
      sheet.setRowHeight(bannerSheetRow, 25);

      if (spacerSheetRow <= sheet.getMaxRows()) {
        sheet.getRange(spacerSheetRow, 1, 1, maxCols).setBackground(theme.level1 || "#79B5D2");
        sheet.setRowHeight(spacerSheetRow, 10);
      }

      if (headerSheetRow <= sheet.getMaxRows()) {
        const headerRange = sheet.getRange(headerSheetRow, 1, 1, maxCols);
        headerRange.setBackground(theme.level2 || "#A5D0E3");
        headerRange.setFontSize(8);
        headerRange.setFontWeight("bold");
        headerRange.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
        sheet.setRowHeight(headerSheetRow, 25);
      }
    }
  }
}

