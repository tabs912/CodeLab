function menuFormatMonthlySheets() {
  if (typeof runFormatterPipeline_ === "function") {
    runFormatterPipeline_(["B", "CD", "UC", "RD"], "Format Monthly Sheets");
  } else {
    notify_("Formatter pipeline not found.");
  }
}

function menuBuildDashboardTemplate() {
  if (typeof buildFormatDashboardTemplate_ === "function") buildFormatDashboardTemplate_();
  SpreadsheetApp.getActiveSpreadsheet().toast("Format Dashboard Built!", "Dashboard Engine", 3);
}

function notify_(msg) {
  SpreadsheetApp.getActiveSpreadsheet().toast(msg || "System Info", "Master List Engine", 4);
}

// ============================================================================
// 3. QUICK START-UP FUNCTIONS (FAIL-CLOSED)
// ============================================================================

function quickSystemSetup() {
  if (typeof initTimingClock_ === "function") initTimingClock_();
  
  notify_("Quick System Setup [Step 1/4]: Rebuilding Format Dashboard defaults...");
  if (typeof menuBuildDashboardTemplate === "function") menuBuildDashboardTemplate();

  notify_("Quick System Setup [Step 2/4]: Initializing system sheets...");
  if (typeof createActiveSystemSheets === "function") createActiveSystemSheets();

  notify_("Quick System Setup [Step 3/4]: Executing Dashboard Quality start-up verifications...");
  if (typeof runDashboardQualityStartUp === "function") {
    runDashboardQualityStartUp();
  } else {
    throw new Error("Quality Startup Module is missing! Aborting system setup.");
  }

  notify_("Quick System Setup [Step 4/4]: Building centralized Index...");
  if (typeof populateActiveIndex === "function") populateActiveIndex();

  if (typeof flushFrameworkTimingReport_ === "function") flushFrameworkTimingReport_();
  notify_("Quick System Setup complete.");
}

function quickBuildAllTemplates() {
  if (typeof initTimingClock_ === "function") initTimingClock_();

  notify_("Quick Build All Templates: creating/refreshing templates in place...");
  if (typeof createAllReportTemplates === "function") createAllReportTemplates();
  
  notify_("Quick Build All Templates: validating templates...");
  if (typeof runDashboardQualityValidateTemplates === "function") {
    runDashboardQualityValidateTemplates();
  } else {
    throw new Error("Template Validation Module is missing! Aborting template build.");
  }
  
  if (typeof flushFrameworkTimingReport_ === "function") flushFrameworkTimingReport_();
  notify_("Quick Build All Templates complete.");
}

// ============================================================================
// 4. DYNAMIC DASHBOARD ON-EDIT TRIGGERS
// ============================================================================

function handleFormatDashboardValueHighlighting_(e) {
  if (!e || !e.range) return;
  const editedRange = e.range;
  const sheet = editedRange.getSheet();
  
  const startRow = editedRange.getRow();
  const endRow = editedRange.getLastRow();
  const startCol = Math.max(editedRange.getColumn(), 1);
  const endCol = Math.min(editedRange.getLastColumn(), 19); 
  if (startRow > endRow || startCol > endCol) return;

  const targetRange = sheet.getRange(startRow, startCol, endRow - startRow + 1, endCol - startCol + 1);
  const values = targetRange.getValues();
  const backgrounds = values.map(function(row) {
    return row.map(function(value) {
      return String(value === null || value === undefined ? "" : value).trim() === "" ? "#ffffff" : "#fff2cc";
    });
  });
  targetRange.setBackgrounds(backgrounds);
}

function onEdit(e) {
  if (!e || !e.range) return;
  try {
    var sheet = e.range.getSheet();
    var sheetName = sheet.getName();
    if (sheetName === "Format Dashboard" || sheetName === "Default - Format Dashboard") {
      if (typeof recalculateDashboardHexCodes_ === "function") recalculateDashboardHexCodes_(sheet);
      handleFormatDashboardValueHighlighting_(e);
    }
  } catch (err) {}
}

// ============================================================================
// 5. RESTORED SHARED DATA, HEADER, & CONTEXT HELPERS
// ============================================================================

function promptForLockedYearReportMonth_(title) {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt(title, "Enter Report Month (MM.YY or MM/YY, e.g. 05.26):", ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return null;
  const val = res.getResponseText().trim();
  if (!val) return null;
  return buildPromptedMonthContext_(val);
}

// Unified Context API
function buildPromptedMonthContext_(inputStr) {
  let month = 1, year = 2026;
  const clean = String(inputStr || "").replace(/[^0-9.\/]/g, "");
  const parts = clean.split(/[.\/]/);
  if (parts.length >= 2) {
    month = parseInt(parts[0], 10) || 1;
    let y = parseInt(parts[1], 10);
    if (y < 100) y += 2000;
    year = y || 2026;
  } else if (clean.length === 4) {
    month = parseInt(clean.substring(0, 2), 10) || 1;
    year = 2000 + (parseInt(clean.substring(2, 4), 10) || 26);
  } else if (clean.length > 0) {
    month = parseInt(clean, 10) || 1;
  }
  
  const reportDate = new Date(year, month - 1, 1);
  const monthStr = (month < 10 ? "0" : "") + month;
  const yearShort = String(year).substring(2);

  return { 
    monthLabel: monthStr + "." + yearShort, 
    label: monthStr + "." + yearShort, 
    reportDate: reportDate, 
    month: month, 
    year: year, 
    mm: monthStr, 
    yy: yearShort, 
    firstDay: reportDate, 
    lastDay: new Date(year, month, 0) 
  };
}

function getDataValues_(sheet, headerRow = 4, dataStartRow = 5) {
  if (!sheet) return { headers: [], headerMap: {}, values: [] };
  const lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < headerRow || lastCol < 1) return { headers: [], headerMap: {}, values: [] };

  const headers = sheet.getRange(headerRow, 1, 1, lastCol).getValues()[0].map(h => String(h || "").trim());
  const headerMap = {};
  headers.forEach((h, idx) => { if (h && headerMap[h] === undefined) headerMap[h] = idx; });

  if (lastRow < dataStartRow) return { headers: headers, headerMap: headerMap, values: [] };
  const values = sheet.getRange(dataStartRow, 1, lastRow - dataStartRow + 1, lastCol).getValues();
  return { headers: headers, headerMap: headerMap, values: values };
}

function getPMRIndex_(headerMap) {
  if (!headerMap) return -1;
  if (headerMap["Participant PMR#"] !== undefined) return headerMap["Participant PMR#"];
  if (headerMap["PMR #"] !== undefined) return headerMap["PMR #"];
  if (headerMap["PMR"] !== undefined) return headerMap["PMR"];
  return -1;
}

function findHeaderIndex_(headerMap, possibleNames) {
  if (!headerMap) return -1;
  for (let i = 0; i < possibleNames.length; i++) {
    if (headerMap[possibleNames[i]] !== undefined) return headerMap[possibleNames[i]];
  }
  return -1;
}

function isPrimaryPMRRowValue_(val) {
  const str = String(val || "").trim().toUpperCase();
  return str === "YES" || str === "TRUE" || str === "Y" || str === "PRIMARY";
}

function valuesAreEqual_(a, b) {
  return String(a || "").trim().toLowerCase() === String(b || "").trim().toLowerCase();
}

function mapRowsToHeaders_(sourceRows, sourceHeaders, targetHeaders) {
  if (!sourceRows || !sourceRows.length || !targetHeaders) return [];
  const indexMap = targetHeaders.map(targetH => {
    const cleanTarget = String(targetH || "").trim().toLowerCase();
    return (sourceHeaders || []).findIndex(srcH => String(srcH || "").trim().toLowerCase() === cleanTarget);
  });

  return sourceRows.map(row => {
    return indexMap.map(idx => (idx !== -1 && idx < row.length) ? row[idx] : "");
  });
}

function buildHeaderIndexMap_(headers) {
  const map = {};
  (headers || []).forEach((header, idx) => {
    const clean = String(header || "").trim();
    if (clean && map[clean] === undefined) map[clean] = idx;
  });
  return map;
}

function getHeaders_(sheet, headerRow = 4) {
  if (!sheet || sheet.getLastColumn() === 0) return [];
  return sheet.getRange(headerRow, 1, 1, sheet.getLastColumn()).getValues()[0].map(h => String(h || "").trim());
}

function padRowToWidth_(row, targetWidth) {
  const padded = Array.isArray(row) ? row.slice() : [row];
  while (padded.length < targetWidth) padded.push("");
  return padded.slice(0, targetWidth);
}

function normalizeRowsToWidth_(rows, width) {
  return (rows || []).map(row => padRowToWidth_(row, width));
}

function formatReportDateLabel_(dateObj) {
  return Utilities.formatDate(dateObj || new Date(), Session.getScriptTimeZone(), "MM.yy");
}

function buildMonthlySheetName_(prefix, firstDay, lastDay) {
  const label = Utilities.formatDate(firstDay || new Date(), Session.getScriptTimeZone(), "MM.yy");
  return `${prefix} ${label}`;
}

function getLatestSheetByPrefix_(prefix) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  let match = null;
  for (let i = 0; i < sheets.length; i++) {
    const name = sheets[i].getName();
    if (name.indexOf(prefix) === 0 && name.indexOf("Template - ") === -1 && name.indexOf("Source - ") === -1) {
      match = sheets[i];
      break;
    }
  }
  return match;
}

// Strictly Locked Finders
function getCurrentRawDataSheet_(monthParts) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (monthParts && monthParts.mm && monthParts.yy) {
    const exact = ss.getSheetByName(`Raw Data ${monthParts.mm}.${monthParts.yy}`);
    if (exact) return exact;
  }
  return getLatestSheetByPrefix_("Raw Data");
}

function getCurrentDemoPSheet_() {
  return SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Refined Data");
}

function getCurrentCarePlanDueSheet_(monthParts) {
  if (!monthParts || !monthParts.mm || !monthParts.yy) return null;
  return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(`CP Due ${monthParts.mm}.${monthParts.yy}`);
}

function getCurrentUnlockedCarePlanSheet_(monthParts) {
  if (!monthParts || !monthParts.mm || !monthParts.yy) return null;
  return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(`Unlock CP ${monthParts.mm}.${monthParts.yy}`);
}

function setRequiredSheetName_(sheet, targetName) {
  if (!sheet) return;
  const ss = sheet.getParent() || SpreadsheetApp.getActiveSpreadsheet();
  if (ss.getSheetByName(targetName)) {
    throw new Error(`Sheet "${targetName}" already exists. Please resolve conflict.`);
  }
  sheet.setName(targetName);
}

function ensureOutputSheetHasFormattedRows_(sheet, requiredMaxRow, colCount) {
  if (!sheet) return;
  if (sheet.getMaxRows() < requiredMaxRow) {
    sheet.insertRowsAfter(sheet.getMaxRows(), requiredMaxRow - sheet.getMaxRows());
  }
  if (sheet.getMaxColumns() < colCount) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), colCount - sheet.getMaxColumns());
  }
}

// Layout Persister (RR-008)
function saveActiveLayoutAsRebuildDefault() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  const layout = sheets.map((s, index) => ({
    name: s.getName(),
    index: index + 1,
    hidden: s.isSheetHidden()
  }));
  PropertiesService.getDocumentProperties().setProperty("REBUILD_DEFAULT_LAYOUT", JSON.stringify(layout));
  notify_("Active Layout Rules Successfully Saved to Document Properties!");
}



