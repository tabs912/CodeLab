// ============================================================================
// 1. MASTER LIST PIPELINE
// ============================================================================

function createMasterList() {
  const monthParts = promptForLockedYearReportMonth_("Create Master List");
  if (!monthParts) return null;
  return createMasterListForMonth_(monthParts);
}

function createMasterListForMonth_(monthParts) {
  return runFrameworkTimed_("Master List " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Master List process is currently locked.");
    
    try {
      const dashboard = loadDashboardConfig_();
      const sysName = "Master List";
      
      // 1. Fetch all required source sheets
      const sourceSheets = {
        refined: getCurrentDemoPSheet_(),
        banners: getLatestSheetByPrefix_(SYSTEM_SHEETS.SOURCE_PREFIX + "Banners"),
        cpDue: getCurrentCarePlanDueSheet_(monthParts),
        unlockCP: getCurrentUnlockedCarePlanSheet_(monthParts)
      };

      if (!sourceSheets.refined) throw new Error("Refined Data is missing. Please run Update Refined Data first.");

      // 2. Extract and strict-filter blank rows from all sources
      markFrameworkStep_(timing, "Reading Sources", "Extracting and filtering blank rows...");
      const data = {
        refined: filterBlankRows_(getDataValues_(sourceSheets.refined, HEADER_ROW, DATA_START_ROW).values),
        banners: sourceSheets.banners ? filterBlankRows_(getDataValues_(sourceSheets.banners, HEADER_ROW, DATA_START_ROW).values) : [],
        cpDue: sourceSheets.cpDue ? filterBlankRows_(getDataValues_(sourceSheets.cpDue, HEADER_ROW, DATA_START_ROW).values) : [],
        unlockCP: sourceSheets.unlockCP ? filterBlankRows_(getDataValues_(sourceSheets.unlockCP, HEADER_ROW, DATA_START_ROW).values) : []
      };

      const maps = {
        refined: buildHeaderIndexMap_(getHeaders_(sourceSheets.refined, HEADER_ROW)),
        banners: sourceSheets.banners ? buildHeaderIndexMap_(getHeaders_(sourceSheets.banners, HEADER_ROW)) : {},
        cpDue: sourceSheets.cpDue ? buildHeaderIndexMap_(getHeaders_(sourceSheets.cpDue, HEADER_ROW)) : {},
        unlockCP: sourceSheets.unlockCP ? buildHeaderIndexMap_(getHeaders_(sourceSheets.unlockCP, HEADER_ROW)) : {}
      };

      // 3. Resolve Target Headers
      const targetHeaders = getHeadersForSheetType_(dashboard, sysName);
      if (!targetHeaders || targetHeaders.length === 0) throw new Error("Dashboard Section H is missing headers for Master List.");

      // 4. Merge Data Engine
      markFrameworkStep_(timing, "Merging Data", "Synthesizing Master List...");
      const mergedRows = mergeMasterListData_(data, maps, targetHeaders);

      if (mergedRows.length === 0) {
        throw new Error("Master List generation resulted in 0 rows.");
      }

      // 5. Delegate to Universal Factory
      markFrameworkStep_(timing, "Instantiating Sheet", "Writing Master List grid...");
      const finalSheet = createGovernedSheet_(sysName, monthParts, {
        dataRows: mergedRows,
        headers: targetHeaders,
        overwrite: true,
        timing: timing
      });

      // 6. Explicitly Enforce Row Heights
      if (typeof enforceDataRowHeights_ === "function") {
        enforceDataRowHeights_(finalSheet, dashboard, mergedRows.length);
      }

      markFrameworkStep_(timing, "Process Complete", "Master List created successfully.");
      return { success: true, count: mergedRows.length, sheetName: finalSheet.getName() };

    } finally {
      lock.releaseLock();
    }
  });
}

function mergeMasterListData_(data, maps, targetHeaders) {
  const recordMap = new Map();
  const refinedPmrIdx = getPMRIndex_(maps.refined);
  
  if (refinedPmrIdx < 0) throw new Error("Could not find PMR column in Refined Data.");

  // Pre-process Banners, CP Due, and Unlock CP into quick-lookup maps by PMR
  const lookupMaps = {
    banners: buildLookupMap_(data.banners, getPMRIndex_(maps.banners)),
    cpDue: buildLookupMap_(data.cpDue, findHeaderIndex_(maps.cpDue, ["Participant Name", "Name"])), // CP Due often lacks PMR, keyed by Name
    unlockCP: buildLookupMap_(data.unlockCP, getPMRIndex_(maps.unlockCP))
  };

  const nameIdx = findHeaderIndex_(maps.refined, ["Participant Name", "Name"]);

  // Build merged rows mapped directly to target headers
  data.refined.forEach(row => {
    const pmr = String(row[refinedPmrIdx] || "").trim();
    const name = nameIdx >= 0 ? String(row[nameIdx] || "").trim() : "";
    if (!pmr && !name) return;

    const bannerMatch = lookupMaps.banners.get(pmr) || [];
    const unlockMatch = lookupMaps.unlockCP.get(pmr) || [];
    const cpDueMatch = (pmr && lookupMaps.cpDue.has(pmr)) ? lookupMaps.cpDue.get(pmr) : lookupMaps.cpDue.get(name) || [];

    const mergedRow = targetHeaders.map(header => {
      // 1. Check Refined Data First
      let val = getMappedValue_(header, row, maps.refined);
      if (val !== "") return val;

      // 2. Check Banners
      val = getMappedValue_(header, bannerMatch, maps.banners);
      if (val !== "") return val;

      // 3. Check CP Due
      val = getMappedValue_(header, cpDueMatch, maps.cpDue);
      if (val !== "") return val;

      // 4. Check Unlock CP
      val = getMappedValue_(header, unlockMatch, maps.unlockCP);
      return val;
    });

    recordMap.set(pmr || name, mergedRow);
  });

  return Array.from(recordMap.values());
}

function buildLookupMap_(dataArray, keyIdx) {
  const map = new Map();
  if (keyIdx < 0 || !dataArray) return map;
  dataArray.forEach(row => {
    const key = String(row[keyIdx] || "").trim();
    if (key) map.set(key, row);
  });
  return map;
}

function getMappedValue_(targetHeader, sourceRow, sourceMap) {
  if (!sourceRow || sourceRow.length === 0) return "";
  const idx = findHeaderIndex_(sourceMap, [targetHeader]);
  return (idx >= 0 && idx < sourceRow.length) ? sourceRow[idx] : "";
}

// ============================================================================
// 2. MONTHLY CHANGE DELTA ENGINE
// ============================================================================

function buildMonthlyChangeReport() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Change Report");
  if (!monthParts) return null;
  return buildMonthlyChangeReportForMonth_(monthParts);
}

function buildMonthlyChangeReportForMonth_(monthParts) {
  return runFrameworkTimed_("Monthly Change " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Monthly Change process is locked.");
    
    try {
      const dashboard = loadDashboardConfig_();
      const sysName = "Monthly Change";

      // 1. Locate Current & Previous Master Lists
      const prevDate = new Date(monthParts.reportDate);
      prevDate.setMonth(prevDate.getMonth() - 1);
      const prevMonthLabel = Utilities.formatDate(prevDate, Session.getScriptTimeZone(), "MM.yy");

      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const currentMlSheet = ss.getSheetByName("Master List " + monthParts.label);
      const prevMlSheet = ss.getSheetByName("Master List " + prevMonthLabel) || getLatestSheetByPrefix_("Master List");

      if (!currentMlSheet || !prevMlSheet) {
        throw new Error("Requires both current and previous Master Lists to compute changes.");
      }

      markFrameworkStep_(timing, "Reading Data", "Loading current and previous data...");
      
      // Filter out blanks immediately
      const currentData = {
        values: filterBlankRows_(getDataValues_(currentMlSheet, HEADER_ROW, DATA_START_ROW).values),
        map: buildHeaderIndexMap_(getHeaders_(currentMlSheet, HEADER_ROW))
      };
      const prevData = {
        values: filterBlankRows_(getDataValues_(prevMlSheet, HEADER_ROW, DATA_START_ROW).values),
        map: buildHeaderIndexMap_(getHeaders_(prevMlSheet, HEADER_ROW))
      };

      // 2. Compute Deltas (Pass monthParts to enforce date logic)
      markFrameworkStep_(timing, "Computing Deltas", "Analyzing row-by-row date and value changes...");
      const subheaderBlocks = getSubheadersFromDashboardConfig_(sysName);
      const changeResults = computeMonthlyChange_(currentData, prevData, subheaderBlocks, monthParts);

      // 3. Delegate Instantiation to Factory (Strictly copies the pre-formatted template)
      markFrameworkStep_(timing, "Instantiating Sheet", "Cloning Monthly Change Template...");
      const changeSheet = createGovernedSheet_(sysName, monthParts, {
        overwrite: true,
        timing: timing
      });

      // 4. Inject Data strictly into Governed Anchor Points (Row 6 of each block)
      const defaultDataHeight = Number(dashboard.globals["Default Data Row Height"]) || 25;

      subheaderBlocks.forEach(block => {
        const dataForBlock = changeResults[block.title] || [];
        if (dataForBlock.length > 0) {
          // appendDataToSubheaderSection_ handles inserting rows WITHOUT formatting them
          const appendRes = appendDataToSubheaderSection_(changeSheet, block.title, dataForBlock);
          
          // Safely apply row heights ONLY to the newly injected data rows
          if (appendRes && appendRes.rowCount > 0) {
            changeSheet.setRowHeights(appendRes.startRow, appendRes.rowCount, defaultDataHeight);
          }
        }
      });

      markFrameworkStep_(timing, "Process Complete", "Monthly Change Delta Engine finished.");
      return { success: true, sheetName: changeSheet.getName() };

    } finally {
      lock.releaseLock();
    }
  });
}

function computeMonthlyChange_(current, prev, subheaderBlocks, monthParts) {
  const currentPmrIdx = getPMRIndex_(current.map);
  const prevPmrIdx = getPMRIndex_(prev.map);

  if (currentPmrIdx < 0 || prevPmrIdx < 0) throw new Error("Master List is missing PMR column.");

  const currentRecords = buildLookupMap_(current.values, currentPmrIdx);
  const prevRecords = buildLookupMap_(prev.values, prevPmrIdx);

  const results = {};
  subheaderBlocks.forEach(b => results[b.title] = []);

  // Map subheader titles to detect their data targets
  const titleMap = {};
  subheaderBlocks.forEach(b => {
    if (b.title.indexOf("ENROLLMENTS") !== -1 && b.title.indexOf("DISENROLLMENTS") === -1) titleMap.enroll = b;
    if (b.title.indexOf("DISENROLLMENTS") !== -1) titleMap.disenroll = b;
    if (b.title.indexOf("DEMOGRAPHIC") !== -1) titleMap.demo = b;
    if (b.title.indexOf("CASELOAD") !== -1) titleMap.case = b;
    if (b.title.indexOf("CONTACT") !== -1) titleMap.contact = b;
    if (b.title.indexOf("OTHER") !== -1) titleMap.other = b;
  });

  // Calculate strict date boundaries
  const targetEnrollMonth = monthParts.month;
  const targetEnrollYear = monthParts.year;

  // Prior month calculation for Disenrollments
  const priorDate = new Date(monthParts.year, monthParts.month - 2, 1);
  const priorDisenrollMonth = priorDate.getMonth() + 1;
  const priorDisenrollYear = priorDate.getFullYear();

  // Find Indices for Date Checks
  const capDateIdxCurr = findHeaderIndex_(current.map, ["Capitation Date", "Enrollment Date"]);
  const disDateIdxCurr = findHeaderIndex_(current.map, ["Disenrollment Effective Date", "Disenrollment Date"]);
  const disDateIdxPrev = findHeaderIndex_(prev.map, ["Disenrollment Effective Date", "Disenrollment Date"]);

  const processedDisenrollments = new Set();

  // Evaluate Current vs Previous
  currentRecords.forEach((currentRow, pmr) => {
    const prevRow = prevRecords.get(pmr);

    // 1. STRICT ENROLLMENT CHECK (Capitation Date matches prompted month)
    if (capDateIdxCurr >= 0) {
      const capDate = currentRow[capDateIdxCurr];
      if (isTargetMonthAndYear_(capDate, targetEnrollMonth, targetEnrollYear)) {
        if (titleMap.enroll) {
          results[titleMap.enroll.title].push(mapRowsToHeaders_([currentRow], Object.keys(current.map), titleMap.enroll.headers)[0]);
        }
      }
    }

    // 2. STRICT DISENROLLMENT CHECK (Disenrollment Date matches PRIOR month)
    if (disDateIdxCurr >= 0) {
      const disDate = currentRow[disDateIdxCurr];
      if (isTargetMonthAndYear_(disDate, priorDisenrollMonth, priorDisenrollYear)) {
        if (titleMap.disenroll) {
          results[titleMap.disenroll.title].push(mapRowsToHeaders_([currentRow], Object.keys(current.map), titleMap.disenroll.headers)[0]);
          processedDisenrollments.add(pmr);
        }
      }
    }

    // 3. STANDARD DELTAS (Only if record exists in BOTH current and previous)
    if (prevRow) {
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, titleMap.demo, results);
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, titleMap.case, results);
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, titleMap.contact, results);
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, titleMap.other, results);
    }
  });

  // 4. MISSING RECORD CHECK (In Prev but missing from Current - Catch dropped disenrollments)
  prevRecords.forEach((prevRow, pmr) => {
    if (!currentRecords.has(pmr)) {
      if (!processedDisenrollments.has(pmr) && disDateIdxPrev >= 0) {
        const disDate = prevRow[disDateIdxPrev];
        if (isTargetMonthAndYear_(disDate, priorDisenrollMonth, priorDisenrollYear)) {
          if (titleMap.disenroll) {
            results[titleMap.disenroll.title].push(mapRowsToHeaders_([prevRow], Object.keys(prev.map), titleMap.disenroll.headers)[0]);
            processedDisenrollments.add(pmr);
          }
        }
      }
    }
  });

  return results;
}

/**
 * Validates if a given date string/object matches the strict month and year target.
 */
function isTargetMonthAndYear_(dateVal, targetMonth, targetYear) {
  if (!dateVal) return false;
  const d = new Date(dateVal);
  if (isNaN(d.getTime())) return false;
  return (d.getMonth() + 1 === targetMonth) && (d.getFullYear() === targetYear);
}

function checkAndMapDeltas_(currentRow, prevRow, currentMap, prevMap, blockSpec, resultsDict) {
  if (!blockSpec || !blockSpec.headers) return;
  
  let hasChange = false;
  // Ignore base identity columns when checking for changes
  const ignoreCols = ["Participant Name", "Name", "Preferred Name", "Date of Birth"];

  blockSpec.headers.forEach(header => {
    if (ignoreCols.indexOf(header) !== -1) return;
    const currIdx = findHeaderIndex_(currentMap, [header]);
    const prevIdx = findHeaderIndex_(prevMap, [header]);
    
    if (currIdx >= 0 && prevIdx >= 0) {
      if (String(currentRow[currIdx] || "").trim() !== String(prevRow[prevIdx] || "").trim()) {
        hasChange = true;
      }
    }
  });

  if (hasChange) {
    resultsDict[blockSpec.title].push(mapRowsToHeaders_([currentRow], Object.keys(currentMap), blockSpec.headers)[0]);
  }
}

