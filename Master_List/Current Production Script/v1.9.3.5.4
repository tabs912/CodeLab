/**
 * Main entry point for formatting monthly sub-reports (Banners, CP Due, Unlocked CP, Raw Data).
 * Uses the Universal Factory (createGovernedSheet_) to handle all layout, ranking, and lifecycle rules.
 * 
 * @param {Array<string>} reportKeys - e.g., ["B", "CD", "UC", "RD"]
 * @param {string} processName - Logging label
 */
function runFormatterPipeline_(reportKeys, processName) {
  const monthParts = promptForLockedYearReportMonth_(processName);
  if (!monthParts) return null;

  return runFrameworkTimed_(processName + " " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) {
      throw new Error("Another formatting process is running. Please wait.");
    }
    
    try {
      const dashboard = loadDashboardConfig_();
      const results = [];
      let successCount = 0;

      (reportKeys || []).forEach(function(key) {
        try {
          const res = processSingleSubReport_(key, monthParts, dashboard, timing);
          results.push(res);
          if (res.success) successCount++;
        } catch (err) {
          logBestEffortWarning_("Sub-Report failed (" + key + "): " + err.message);
          results.push({ key: key, success: false, error: err.message });
        }
      });

      if (typeof notify_ === "function") {
        notify_(processName + " complete. Successfully processed " + successCount + " of " + reportKeys.length + " reports.");
      }
      return results;
    } finally {
      lock.releaseLock();
    }
  });
}

/**
 * Processes a single sub-report type: finds the source, extracts/maps data, and passes 
 * it to the Universal Factory for instantiation, then renames the raw tab to "Source - ...".
 */
function processSingleSubReport_(key, monthParts, dashboard, timing) {
  const sysMap = {
    "B": "Banners",
    "CD": "CP Due Date",
    "UC": "Unlock CP",
    "RD": "Raw Data"
  };

  const systemSheetName = sysMap[key];
  if (!systemSheetName) throw new Error("Unknown report key: " + key);

  markFrameworkStep_(timing, "Process Start: " + systemSheetName, "Scanning for source sheet...");

  // 1. Locate Unformatted Source Sheet using smart abbreviations
  const sourceSheet = findSourceSheetForSubReport_(systemSheetName, monthParts);
  if (!sourceSheet) {
    throw new Error("Source sheet for " + systemSheetName + " (" + monthParts.monthLabel + ") not found.");
  }

  // 2. Extract Raw Data
  const rawData = getDataValues_(sourceSheet, 1, 2); // Unformatted exports usually have headers on Row 1, data on Row 2
  if (!rawData.values || rawData.values.length === 0) {
    throw new Error("Source sheet is empty.");
  }

  // 3. Resolve Target Headers from Dashboard (Section H)
  const targetHeaders = getHeadersForSheetType_(dashboard, systemSheetName);
  if (!targetHeaders || targetHeaders.length === 0) {
    throw new Error("No headers defined in Dashboard Section H for " + systemSheetName);
  }

  // 4. Map Columns & Filter Blank Rows
  markFrameworkStep_(timing, "Mapping Data", "Mapping raw data to governed headers...");
  const mappedRows = mapRowsToHeaders_(rawData.values, rawData.headers, targetHeaders);
  
  // Filter out completely blank rows or rows missing a primary identifier
  const filteredRows = mappedRows.filter(row => {
    // Assuming the first column (e.g., Last Name, Participant Name) must have a value
    return String(row[0] || "").trim() !== "";
  });

  if (filteredRows.length === 0) {
    throw new Error("No valid data rows remained after filtering blanks.");
  }

  // 5. Delegate Creation to Universal Factory (Module 1)
  markFrameworkStep_(timing, "Instantiating Sheet", "Delegating to Universal Factory...");
  
  let cleanNamePattern = systemSheetName;
  if (dashboard && dashboard.sheetDefinitions) {
    const def = dashboard.sheetDefinitions.find(d => d.systemSheetName === systemSheetName);
    if (def && def.outputNamingPattern) {
      cleanNamePattern = def.outputNamingPattern.replace(/mm\.yy/gi, "").trim();
    }
  }
  
  const finalSheet = createGovernedSheet_(systemSheetName, monthParts, {
    dataRows: filteredRows,
    headers: targetHeaders,
    timing: timing
  });

  // 6. Rename the original unformatted sheet to "Source - [Name] [MM.YY]"
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const standardSourceName = SYSTEM_SHEETS.SOURCE_PREFIX + systemSheetName + " " + monthParts.label;
  
  if (sourceSheet.getName() !== standardSourceName) {
    const existingSource = ss.getSheetByName(standardSourceName);
    if (existingSource && existingSource.getSheetId() !== sourceSheet.getSheetId()) {
      deleteSheetSafely_(ss, existingSource, "Cleanup old source collision");
      SpreadsheetApp.flush();
    }
    sourceSheet.setName(standardSourceName);
  }
  
  // 7. Hide the newly renamed Source Sheet to keep the workspace clean
  hideSheetIfNeeded_(sourceSheet, timing, "Hiding standard source sheet");

  markFrameworkStep_(timing, "Process Complete", "Created: " + finalSheet.getName());

  return { 
    key: key, 
    success: true, 
    sheetName: finalSheet.getName(), 
    rowCount: filteredRows.length 
  };
}

/**
 * Searches for the unformatted raw export tab.
 * Dynamically looks for abbreviations (B, CD, UC, RD) combined with month numbers and names.
 */
function findSourceSheetForSubReport_(systemSheetName, monthParts) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // Define valid abbreviations for each type
  const prefixMap = {
    "Banners": ["B", "Banners", "Banner Report"],
    "CP Due Date": ["CD", "CP Due Date", "CP Due"],
    "Unlock CP": ["UC", "Unlocked CP", "Unlock CP"],
    "Raw Data": ["RD", "Raw Data"]
  };
  
  const prefixes = prefixMap[systemSheetName] || [systemSheetName];
  const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const fullMonth = monthNames[monthParts.month - 1];
  
  let possibleNames = [];
  
  // 1. Prioritize already fully formatted standard source names (if re-running the format process)
  possibleNames.push(SYSTEM_SHEETS.SOURCE_PREFIX + systemSheetName + " " + monthParts.label);
  possibleNames.push(SYSTEM_SHEETS.SOURCE_PREFIX + systemSheetName);
  
  // 2. Generate shorthand combinations 
  // (e.g., "B 04.26", "B April", "B 04", "B 4", "B04", "B")
  prefixes.forEach(p => {
    possibleNames.push(p + " " + monthParts.label);
    possibleNames.push(p + " " + fullMonth);
    possibleNames.push(p + " " + monthParts.mm);
    possibleNames.push(p + " " + monthParts.month);
    possibleNames.push(p + monthParts.mm);
    possibleNames.push(p + monthParts.month);
    possibleNames.push(p);
  });

  // Strip duplicate name combinations
  possibleNames = [...new Set(possibleNames)];

  for (let i = 0; i < possibleNames.length; i++) {
    const sheet = ss.getSheetByName(possibleNames[i]);
    if (sheet) {
      const name = sheet.getName();
      // Ensure we don't accidentally grab a template
      if (name.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) !== -1) continue;
      
      // Safeguard: Ensure we aren't grabbing an already FORMATTED destination output sheet 
      // (The formatted sheets get stamped with their system name or report title in A1)
      const a1Val = String(sheet.getRange("A1").getValue() || "").trim();
      const expectedTitle = configReportTitleCheck_(systemSheetName);
      
      if (a1Val !== systemSheetName && a1Val !== expectedTitle) {
        return sheet;
      }
    }
  }
  return null;
}

function configReportTitleCheck_(sysName) {
  try {
    const dashboard = loadDashboardConfig_();
    const def = dashboard.sheetDefinitions.find(d => d.systemSheetName === sysName);
    return def ? def.reportTitle : sysName;
  } catch(e) {
    return sysName;
  }
}

// ============================================================================
// DATA FORMATTING HELPER (Called by createGovernedSheet_ in Module 1)
// ============================================================================

/**
 * Applies strictly Date and Number formats to the newly injected data grid.
 * Explicitly skips fonts, colors, borders, and row heights since those are inherited 
 * seamlessly from the template mold!
 */
function applyGovernedDateFormatsFromDashboard_(sheet, dashboard, headers, rowCount) {
  if (!sheet || !headers || rowCount < 1) return;
  const colDefs = dashboard.columnDefinitions || {};
  const defaultDateFmt = dashboard.globals["Default Date Format"] || "mm/dd/yyyy";

  headers.forEach((header, index) => {
    const def = colDefs[header] || colDefs[header.toLowerCase()];
    if (def && (def.format || def.dateColumn)) {
      const format = def.format || defaultDateFmt;
      const colIdx = index + 1;
      
      // Data always starts at DATA_START_ROW (Row 5)
      sheet.getRange(DATA_START_ROW, colIdx, rowCount, 1).setNumberFormat(format);
    }
  });
}


