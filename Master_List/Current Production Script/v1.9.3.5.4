// 2. DISENROLLED EXCLUSION PIPELINE
// ============================================================================

function createDisenrolledList() {
  const monthParts = promptForLockedYearReportMonth_("Create Disenrolled Exclusion List");
  if (!monthParts) return null;
  return createDisenrolledListForMonth_(monthParts);
}


function createDisenrolledListForMonth_(monthParts) {
  return runFrameworkTimed_("Disenrolled Exclusion " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Disenrolled Exclusion process is locked.");

    try {
      const dashboard = loadDashboardConfig_();
      const sysName = "Disenrolled Exclusion";

      markFrameworkStep_(timing, "Reading Source", "Extracting Refined Data...");
      const refinedSheet = getCurrentDemoPSheet_();
      if (!refinedSheet) throw new Error("Refined Data sheet is missing. Cannot build Disenrolled list.");

      const refinedData = getDataValues_(refinedSheet, HEADER_ROW, DATA_START_ROW);
      const validRows = filterBlankRows_(refinedData.values);

      const targetHeaders = getHeadersForSheetType_(dashboard, sysName);
      if (!targetHeaders || targetHeaders.length === 0) throw new Error("Dashboard Section H is missing headers for " + sysName);

      // Locate criteria columns (Status & Disenrollment Date)
      const statusIdx = findHeaderIndex_(refinedData.headerMap, ["Enrollment Status", "Status"]);
      const disDateIdx = findHeaderIndex_(refinedData.headerMap, ["Disenrollment Date", "Disenrollment Effective Date", "Disenrolled Date"]);

      markFrameworkStep_(timing, "Filtering Data", "Isolating disenrolled records...");
      
      const disenrolledRaw = validRows.filter(row => {
        const status = statusIdx >= 0 ? String(row[statusIdx] || "").trim().toLowerCase() : "";
        const disDate = disDateIdx >= 0 ? String(row[disDateIdx] || "").trim() : "";
        return status === "disenrolled" || disDate !== "";
      });

      if (disenrolledRaw.length === 0) {
        logBestEffortWarning_("No disenrolled records found in Refined Data.");
      }

      // Map to target headers first
      let finalRows = mapRowsToHeaders_(disenrolledRaw, refinedData.headers, targetHeaders);

      // ----------------------------------------------------------------------
      // NEW SORTING & HIDING LOGIC (Newest First, Max 12 Months)
      // ----------------------------------------------------------------------
      const targetDisDateIdx = targetHeaders.findIndex(h => 
        h.toLowerCase() === "disenrollment date" || 
        h.toLowerCase() === "disenrollment effective date"
      );

      if (targetDisDateIdx >= 0) {
        const oneYearAgo = new Date();
        oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
        oneYearAgo.setHours(0,0,0,0);

        // Filter out > 12 months
        finalRows = finalRows.filter(row => {
          const dateVal = row[targetDisDateIdx];
          if (!dateVal) return true; // Keep if blank (safeguard)
          const dateObj = new Date(dateVal);
          if (isNaN(dateObj.getTime())) return true; // Keep if invalid date string
          return dateObj >= oneYearAgo;
        });

        // Sort: Newest to Oldest
        finalRows.sort((a, b) => {
          const dateA = new Date(a[targetDisDateIdx]).getTime();
          const dateB = new Date(b[targetDisDateIdx]).getTime();
          const valA = isNaN(dateA) ? 0 : dateA;
          const valB = isNaN(dateB) ? 0 : dateB;
          return valB - valA; // Descending (Newest first)
        });
      }
      // ----------------------------------------------------------------------

      // Delegate to Universal Factory
      markFrameworkStep_(timing, "Instantiating Sheet", "Writing Disenrolled grid...");
      const finalSheet = createGovernedSheet_(sysName, null, {
        customName: "Disenrolled Exclusion", 
        dataRows: finalRows,
        headers: targetHeaders,
        overwrite: true,
        timing: timing
      });

      // Explicitly Enforce Row Heights
      if (typeof enforceDataRowHeights_ === "function") {
        enforceDataRowHeights_(finalSheet, dashboard, finalRows.length);
      }

      markFrameworkStep_(timing, "Process Complete", "Disenrolled Exclusion updated.");
      return { success: true, count: finalRows.length };

    } finally {
      lock.releaseLock();
    }
  });
}




// ============================================================================
// 3. GRID & UTILITY HELPERS
// ============================================================================

/**
 * Strips out any completely blank rows from a 2D array.
 * Fixes the issue where Row 5-24 are left empty due to blank rows in raw source exports.
 */
function filterBlankRows_(rows) {
  if (!rows || !rows.length) return [];
  return rows.filter(row => {
    // If every cell in the row is blank/empty, exclude it.
    return row.some(cell => String(cell || "").trim() !== "");
  });
}

/**
 * Explicitly sets the row height of every data row starting from DATA_START_ROW.
 * Ensures that pasted data or template mold glitches don't cause abnormal row heights.
 */
function enforceDataRowHeights_(sheet, dashboard, dataRowCount) {
  if (!sheet || dataRowCount < 1) return;
  
  // Read default data row height from Section A (Global Settings), fallback to 25px
  const defaultHeight = (dashboard && dashboard.globals) 
    ? (Number(dashboard.globals["Default Data Row Height"]) || 25) 
    : 25;

  try {
    // Use the hyper-efficient batch API method: setRowHeights(startRow, numRows, height)
    sheet.setRowHeights(DATA_START_ROW, dataRowCount, defaultHeight);
  } catch (err) {
    logBestEffortWarning_(`Row height enforcement failed on ${sheet.getName()}: ${err.message}`);
  }
}


