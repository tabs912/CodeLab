/**
 * Builds the Format Dashboard template structure and populates all default governed sections.
 */
function buildFormatDashboardTemplate_() {
  const dashSheet = buildGeneralTemplate_({
    systemSheetName: SYSTEM_SHEETS.DASHBOARD,
    templateName: SYSTEM_SHEETS.DASHBOARD_DEFAULT,
    reportTitle: SYSTEM_SHEETS.DASHBOARD,
    sheetType: "SYSTEM",
    columnCount: 19,
    minimumRows: 100,
    rank: 502,
    columnWidths: "220, 150, 215, 165, 130, 120, 120, 120, 140, 120, 120, 306, 144, 100, 100, 110, 100"
  });

  const dashWidth = 19;
  const dashRows = [];

  // Header Title & Timestamp Metadata
  dashRows.push([SYSTEM_SHEETS.DASHBOARD, "- " + MASTER_LIST_MERGE_ML_VERSION + " -", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]);
  dashRows.push(["Date Created", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]);
  dashRows.push(new Array(dashWidth).fill(""));
  dashRows.push(new Array(dashWidth).fill(""));

  // Build Sections A through H
  appendDashboardSectionRows_(dashRows, "SECTION A - GLOBAL SETTINGS", ["Setting", "Value", "Options / Format Description"], getDefaultGlobalSettingsRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION B - SHEET CREATION & LIFECYCLE GOVERNANCE", ["System Sheet Name", "Output Naming Pattern", "Group", "Active Tab Rank", "Special", "Group", "Visibility", "Collision Policy", "Data Row Trimming", "Index Reg.", "Notes"], getDefaultCreationRuleRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION C - TEMPLATE STRUCTURAL SPECS", ["System Sheet Name", "Report Title", "Title Date Format", "Base Color", "Level 1", "Level 2", "Level 3", "Level 4", "Level 5", "Title Font Color", "Column Count", "Default Column Widths", "Row Mode", "Minimum Rows", "Buffer Rows", "Uses Alternating Colors", "Uses Subheaders", "Notes"], getDefaultC1StructuralRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION D - ACTIVE OUTPUT GOVERNANCE", ["System Sheet Name", "Output Naming Pattern", "Special", "End Date Source", "Remove / Archive"], getDefaultC2OutputGovernanceRows_(), dashWidth);
