function runMonthlyStart() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Start");
  if (!monthParts) return null;
  return runFrameworkTimed_("Create Monthly Start " + monthParts.label, function(timing) {
    const refinedResult = processRefinedDataUpdate_("Build Refined Data", monthParts, true);
    const disenrolledResult = createDisenrolledListForMonth_(monthParts);
    const masterSheet = createMasterListForMonth_(monthParts);
    populateActiveIndex();
    notify_("Create Monthly Start complete.\nRefined Data records: " + (refinedResult ? refinedResult.count : 0) + "\nDisenrolled Exclusion list updated\nMaster List: " + (masterSheet ? masterSheet.getName() : "Not created"));
    return { refinedResult: refinedResult, disenrolledResult: disenrolledResult, masterSheet: masterSheet };
  });
}

function runMonthlyUpdate() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Update");
  if (!monthParts) return null;
  return runFrameworkTimed_("Create Monthly Update " + monthParts.label, function(timing) {
    const reportSheet = buildMonthlyChangeReportForMonth_(monthParts);
    const refinedResult = processRefinedDataUpdate_("Sync Refined Data", monthParts, false);
    const disenrolledResult = createDisenrolledListForMonth_(monthParts);
    const masterSheet = createMasterListForMonth_(monthParts);
    populateActiveIndex();
    notify_("Create Monthly Update complete.\nMonthly Change: " + (reportSheet ? reportSheet.getName() : "Not created") + "\nRefined Data updated: " + (refinedResult ? refinedResult.count : 0) + "\nMaster List: " + (masterSheet ? masterSheet.getName() : "Not created"));
    return { reportSheet: reportSheet, refinedResult: refinedResult, disenrolledResult: disenrolledResult, masterSheet: masterSheet };
  });
}

