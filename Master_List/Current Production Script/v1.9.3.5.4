function organizeTabs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  const rules = typeof loadSectionFTabRules_ === "function" ? loadSectionFTabRules_() : [];
  
  const sheetData = sheets.map(sheet => {
    const name = sheet.getName();
    let match = { group: "Unformatted", rank: 999 };
    if (typeof matchSheetToSectionFRule_ === "function") {
      match = matchSheetToSectionFRule_(name, rules);
    }
    
    let dateVal = 0;
    const dateMatch = name.match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        dateVal = new Date(y, m - 1, 1).getTime();
    }

    return { sheet, name, rank: match.rank, dateVal };
  });

  sheetData.sort((a, b) => {
    if (a.rank !== b.rank) return a.rank - b.rank;
    if (a.dateVal !== b.dateVal) return b.dateVal - a.dateVal; 
    return a.name.localeCompare(b.name);
  });

  for (let i = 0; i < sheetData.length; i++) {
    const currentSheet = sheetData[i].sheet;
    if (currentSheet.getIndex() !== (i + 1)) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(i + 1); // FIXED TYPO
    }
  }

  ss.toast("Sheet Tabs Re-organized according to Section B Governance!", "Tab Engine", 4);
}

function positionSheetBySectionFRank_(sheet, rank, spreadsheet) {
  if (!sheet) return;
  try {
    var ss = spreadsheet || SpreadsheetApp.getActiveSpreadsheet();
    var currentSheet = ss.getSheetByName(sheet.getName());
    if (!currentSheet) return;

    var rules = typeof loadSectionFTabRules_ === "function" ? loadSectionFTabRules_() : [];
    var targetRank = (rank !== undefined && rank !== null) ? rank : getTargetRankForSheet_(currentSheet.getName(), rules);
    
    var targetDateVal = 0;
    var dateMatch = currentSheet.getName().match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        targetDateVal = new Date(y, m - 1, 1).getTime();
    }

    var sheets = ss.getSheets();
    var targetPos = 1;

    for (var i = 0; i < sheets.length; i++) {
      if (sheets[i].getName() === currentSheet.getName()) continue;
      
      var otherRank = getTargetRankForSheet_(sheets[i].getName(), rules);
      var otherDateVal = 0;
      var otherMatch = sheets[i].getName().match(/(\d{2})[.\/-](\d{2,4})/);
      if (otherMatch) {
        let m = parseInt(otherMatch[1], 10);
        let y = parseInt(otherMatch[2], 10);
        if (y < 100) y += 2000;
        otherDateVal = new Date(y, m - 1, 1).getTime();
      }

      var placeAfter = false;
      if (otherRank < targetRank) {
        placeAfter = true;
      } else if (otherRank === targetRank) {
        if (otherDateVal > targetDateVal) {
          placeAfter = true;
        } else if (otherDateVal === targetDateVal) {
          if (sheets[i].getName().localeCompare(currentSheet.getName()) < 0) {
            placeAfter = true;
          }
        }
      }

      if (placeAfter) {
        targetPos++;
      }
    }

    if (currentSheet.getIndex() !== targetPos) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(Math.min(Math.max(1, targetPos), sheets.length)); // FIXED TYPO
    }
  } catch (e) { 
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Non-fatal tab position operation failed: " + e.message); 
  }
}

function getTargetRankForSheet_(sheetName, preloadedRules) {
  const rules = preloadedRules || (typeof loadSectionFTabRules_ === "function" ? loadSectionFTabRules_() : []);
  const match = matchSheetToSectionFRule_(sheetName, rules);
  return match.rank;
}

function matchSheetToSectionFRule_(sheetName, rules) {
  const cleanName = String(sheetName || "").trim();
  const cleanLower = cleanName.toLowerCase().replace(/[^a-z0-9]/g, "");
  const isTemplate = cleanName.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) === 0 || cleanName === SYSTEM_SHEETS.BASE_TEMPLATE;

  for (let i = 0; i < rules.length; i++) {
    const rulePrefixClean = rules[i].prefix.toLowerCase().replace(/[^a-z0-9]/g, "");
    
    if (isTemplate) {
      const targetSubName = cleanName.replace(SYSTEM_SHEETS.TEMPLATE_PREFIX, "").toLowerCase().replace(/[^a-z0-9]/g, "");
      if (targetSubName === rulePrefixClean || targetSubName.indexOf(rulePrefixClean) === 0) {
        return { group: rules[i].group, rank: rules[i].templateRank };
      }
    } else {
      if (cleanLower === rulePrefixClean || cleanLower.indexOf(rulePrefixClean) === 0) {
        return { group: rules[i].group, rank: rules[i].activeRank };
      }
    }
  }

  if (isTemplate) return { group: "Template", rank: 800 };
  return { group: "Unformatted", rank: 999 };
}

function loadSectionFTabRules_() {
  try {
    const dashboard = loadDashboardConfig_();
    if (dashboard && dashboard.creationRules && Object.keys(dashboard.creationRules).length) {
      const rules = [];
      Object.keys(dashboard.creationRules).forEach(sysName => {
        const r = dashboard.creationRules[sysName];
        rules.push({
          prefix: r.systemSheetName,
          group: r.group,
          templateRank: r.templateRank,
          activeRank: r.activeRank
        });
      });
      return rules;
    }
  } catch (err) {
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Section B rules dashboard lookup fallback: " + err.message);
  }

  return MASTER_FORMAT_DEFAULTS.creationRules.map(row => {
    return {
      prefix: row[0],
      group: row[2],
      templateRank: row[3],
      activeRank: row[4]
    };
  });
}



