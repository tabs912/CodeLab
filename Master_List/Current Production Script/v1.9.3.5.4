function updateIndexSheet(archiveSs) {
  if (typeof populateIndexData === "function") {
    populateIndexData(SYSTEM_SHEETS.INDEX);
  } else if (typeof populateActiveIndex === "function") {
    populateActiveIndex();
  }

  if (typeof syncArchiveIndexToActiveIndex_ === "function") {
    syncArchiveIndexToActiveIndex_();
  }
}

function populateActiveIndex() {
  populateIndexData(SYSTEM_SHEETS.INDEX);
}

function populateIndexData(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = targetName || SYSTEM_SHEETS.INDEX;
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;

  const timestampStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss");
  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "";

  sheet.getRange("B2").setValue(timestampStr);
  sheet.getRange("G2").setValue(archiveId);

  const sectionFRules = (typeof loadSectionFTabRules_ === "function") ? loadSectionFTabRules_() : [];
  const activeSheets = ss.getSheets();
  const activeSheetMap = new Map();

  activeSheets.forEach(s => {
    const name = s.getName();
    if (name !== sheetName && name !== SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.INDEX) {
      let match = { group: "Unformatted", rank: 999 };
      if (typeof matchSheetToSectionFRule_ === "function") {
        match = matchSheetToSectionFRule_(name, sectionFRules);
      }
      activeSheetMap.set(name, {
        sheet: s,
        group: match.group,
        rank: match.rank,
        visibility: s.isSheetHidden() ? "Hidden" : "Visible",
        link: `=HYPERLINK("#gid=${s.getSheetId()}", "Open Live Tab")`
      });
    }
  });

  const lastRow = Math.max(sheet.getLastRow(), 4);
  let existingActiveMatrix = [];
  if (lastRow >= 5) {
    existingActiveMatrix = sheet.getRange(5, 1, lastRow - 4, 4).getValues();
  }

  const groupMap = new Map();
  let currentGroup = "Unformatted";

  existingActiveMatrix.forEach(row => {
    const colA = String(row[0] || "").trim();
    const colB = String(row[1] || "").trim();

    if (colA !== "") {
      currentGroup = colA;
      if (!groupMap.has(currentGroup)) groupMap.set(currentGroup, []);
    } else if (colB !== "") {
      if (activeSheetMap.has(colB)) {
        const liveInfo = activeSheetMap.get(colB);
        if (!groupMap.has(currentGroup)) groupMap.set(currentGroup, []);
        groupMap.get(currentGroup).push({
          name: colB,
          link: liveInfo.link,
          visibility: liveInfo.visibility,
          rank: liveInfo.rank
        });
        activeSheetMap.delete(colB);
      }
    }
  });

  activeSheetMap.forEach((info, newSheetName) => {
    if (!groupMap.has(info.group)) groupMap.set(info.group, []);
    groupMap.get(info.group).push({
      name: newSheetName,
      link: info.link,
      visibility: info.visibility,
      rank: info.rank
    });
  });

  // Re-sort section groups dynamically by the activeRank defined in Section B
  const sectionRanks = new Map();
  sectionFRules.forEach(r => {
    if (r.group && r.activeRank) sectionRanks.set(r.group, r.activeRank);
  });

  const sortedGroups = Array.from(groupMap.keys()).sort((a, b) => {
    let rankA = sectionRanks.has(a) ? sectionRanks.get(a) : 999;
    let rankB = sectionRanks.has(b) ? sectionRanks.get(b) : 999;
    
    // Explicit overrides for system fallback groups
    if (a === "Template") rankA = 800;
    if (b === "Template") rankB = 800;
    
    // Tie-breaker: Alphabetical group name
    if (rankA === rankB) return a.localeCompare(b);
    return rankA - rankB;
  });

  const finalActiveMatrix = [];

  sortedGroups.forEach(groupName => {
    const items = groupMap.get(groupName);
    if (!items || items.length === 0) return;

    finalActiveMatrix.push([groupName, "", "", ""]);

    items.sort((a, b) => {
      const dateA = typeof extractFirstDateFromSheetName_ === "function" ? extractFirstDateFromSheetName_(a.name).getTime() : 0;
      const dateB = typeof extractFirstDateFromSheetName_ === "function" ? extractFirstDateFromSheetName_(b.name).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return a.name.localeCompare(b.name);
    });

    items.forEach(item => {
      finalActiveMatrix.push(["", item.name, item.link, item.visibility]);
    });
  });

  const targetWriteRows = Math.max(finalActiveMatrix.length, existingActiveMatrix.length);

  if (targetWriteRows > 0) {
    if (typeof resizeSheetGrid_ === "function") {
      resizeSheetGrid_(sheet, Math.max(targetWriteRows + 4, 20), 10);
    }

    sheet.getRange(5, 1, targetWriteRows, 4).clearContent();

    if (finalActiveMatrix.length > 0) {
      sheet.getRange(5, 1, finalActiveMatrix.length, 4).setValues(finalActiveMatrix);
    }
  }
}


function restoreSheetFromActiveIndexRow() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const activeSheet = ss.getActiveSheet();

  if (activeSheet.getName().indexOf(SYSTEM_SHEETS.INDEX) === -1) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "Please select a row on the Index sheet to navigate or restore.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const dataStart = (typeof DATA_START_ROW !== "undefined") ? DATA_START_ROW : 5;
  const activeRow = activeSheet.getActiveRange().getRow();
  if (activeRow < dataStart) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "Please select a valid data row (Row 5 or lower).", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const sheetName = String(activeSheet.getRange(activeRow, 2).getValue() || "").trim();
  if (!sheetName) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "No valid sheet tab name found on the selected row.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const targetSheet = ss.getSheetByName(sheetName);
  if (targetSheet) {
    if (targetSheet.isSheetHidden()) {
      targetSheet.showSheet();
    }
    ss.setActiveSheet(targetSheet);
    ss.toast(`Unhid and navigated to: "${sheetName}"`, "Index Navigation", 3);
  } else {
    const restoreUrl = PropertiesService.getDocumentProperties().getProperty("INDEX_RESTORE_WEB_APP_URL") || "";
    const message = restoreUrl
      ? `Sheet "${sheetName}" was not found locally. It may be in central archive cold storage. Please use the Restore Tool: ${restoreUrl}`
      : `Sheet "${sheetName}" was not found locally. It may be in central archive cold storage. Configure the Restore Web App URL to use the Restore Tool.`;
    SpreadsheetApp.getUi().alert("Sheet Not Found", message, SpreadsheetApp.getUi().ButtonSet.OK);
  }
}

function syncArchiveIndexToActiveIndex_(targetSheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const indexSheet = targetSheet || ss.getSheetByName(SYSTEM_SHEETS.INDEX);
  if (!indexSheet) return;

  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "";
  const restoreUrl = PropertiesService.getDocumentProperties().getProperty("INDEX_RESTORE_WEB_APP_URL") || "";

  indexSheet.getRange("G2").setValue(archiveId);

  if (!archiveId) {
    if (typeof logBestEffortWarning_ === "function") {
      logBestEffortWarning_("Sync skipped: No Archive Spreadsheet ID found in document properties.");
    }
    return;
  }

  let archiveSs;
  try {
    archiveSs = SpreadsheetApp.openById(archiveId);
  } catch (err) {
    if (typeof logBestEffortWarning_ === "function") {
      logBestEffortWarning_("Sync failed: Could not open Archive Spreadsheet ID " + archiveId + ". Error: " + err.message);
    }
    return;
  }

  const archiveIndexSheet = archiveSs.getSheetByName(SYSTEM_SHEETS.INDEX);
  if (!archiveIndexSheet) return;

  const archiveLastRow = Math.max(archiveIndexSheet.getLastRow(), 4);
  const activeLastRow = Math.max(indexSheet.getLastRow(), 4);

  if (activeLastRow >= 5) {
    indexSheet.getRange(5, 6, activeLastRow - 4, 5).clearContent();
  }

  if (archiveLastRow < 5) return;

  const archiveData = archiveIndexSheet.getRange(5, 1, archiveLastRow - 4, 5).getValues();
  const outputMatrix = [];

  archiveData.forEach(row => {
    const month = row[0] || "";         // Col A -> Col F (Archive Month)
    const sheetName = row[2] || "";     // Col C -> Col G (Archive Sheet Name)
    const link = row[3] || "";          // Col D -> Col H (Link to Sheet)
    
    let restoreAction = "";
    if (sheetName) {
      if (restoreUrl) {
        const safeName = encodeURIComponent(String(sheetName).trim());
        restoreAction = `=HYPERLINK("${restoreUrl}?restoreTarget=${safeName}", "Restore to Active Workspace")`;
      } else {
        restoreAction = "Configure Web App URL for 1-Click Restore";
      }
    }

    const status = row[4] || "";        // Col E -> Col J (Status)
    outputMatrix.push([month, sheetName, link, restoreAction, status]);
  });

  if (typeof resizeSheetGrid_ === "function") {
    resizeSheetGrid_(indexSheet, Math.max(outputMatrix.length + 4, 20), 10);
  }

  if (outputMatrix.length > 0) {
    indexSheet.getRange(5, 6, outputMatrix.length, 5).setValues(outputMatrix);
  }
}

function restoreSheetFromArchiveWorkbook(targetSheetName) {
  const mainSpreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const name = String(targetSheetName || "").trim();
  if (!name) throw new Error("Missing archive sheet name to restore.");
  if (mainSpreadsheet.getSheetByName(name)) throw new Error('Sheet "' + name + '" already exists locally.');
  
  const archiveSpreadsheet = openArchiveSpreadsheetOnce_();
  const archiveSheet = archiveSpreadsheet.getSheetByName(name);
  if (!archiveSheet) throw new Error('Sheet "' + name + '" was not found in the archive workbook.');
  
  const restoredSheet = archiveSheet.copyTo(mainSpreadsheet);
  restoredSheet.setName(name);
  
  // FIND-001 Resolved: Directly call the Section F ranking engine
  if (typeof positionSheetBySectionFRank_ === "function") {
    positionSheetBySectionFRank_(restoredSheet, null, mainSpreadsheet);
  }
  
  restoredSheet.showSheet();
  
  // Refresh the Index immediately to show the newly restored tab
  if (typeof populateActiveIndex === "function") {
    populateActiveIndex();
  }
  
  mainSpreadsheet.setActiveSheet(restoredSheet);
  return restoredSheet;
}


function escapeHtml_(text) {
  return String(text == null ? "" : text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function doGet(e) {
  const targetSheetName = e && e.parameter ? String(e.parameter.restoreTarget || "").trim() : "";
  if (!targetSheetName) return HtmlService.createHtmlOutput("<p>Missing recovery sheet routing token.</p>");
  const lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) return HtmlService.createHtmlOutput("<p>Server busy. Try the restore link again.</p>");
  try {
    restoreSheetFromArchiveWorkbook(targetSheetName);
    return HtmlService.createHtmlOutput("<h3>Restoration Complete</h3><p>Restored <b>" + escapeHtml_(targetSheetName) + "</b>.</p>");
  } catch (err) {
    return HtmlService.createHtmlOutput("<h3>Restore Failed</h3><p>" + escapeHtml_(err && err.message ? err.message : err) + "</p>");
  } finally {
    lock.releaseLock();
  }
}

