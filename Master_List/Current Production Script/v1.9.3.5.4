function getDataValues_(sheet, headerRow, dataStartRow) {
  if (!sheet) throw new Error("A source sheet is required.");
  const resolvedHeaderRow = Number(headerRow) || HEADER_ROW;
  const resolvedDataStartRow = Number(dataStartRow) || DATA_START_ROW;
  const lastColumn = sheet.getLastColumn();
  if (lastColumn < 1 || sheet.getLastRow() < resolvedHeaderRow) {
    return { headers: [], headerMap: {}, values: [], range: null };
  }
  const headers = sheet.getRange(resolvedHeaderRow, 1, 1, lastColumn).getValues()[0];
  const headerMap = buildHeaderIndexMap_(headers);
  const rowCount = Math.max(sheet.getLastRow() - resolvedDataStartRow + 1, 0);
  const range = rowCount ? sheet.getRange(resolvedDataStartRow, 1, rowCount, lastColumn) : null;
  return { headers: headers, headerMap: headerMap, values: range ? range.getValues() : [], range: range };
}

function getHeaders_(sheet, headerRow) {
  return getDataValues_(sheet, Number(headerRow) || HEADER_ROW, DATA_START_ROW).headers;
}

function buildHeaderIndexMap_(headers) {
  const map = {};
  (headers || []).forEach(function(header, index) {
    const key = String(header || "").trim();
    if (key && map[key] === undefined) { map[key] = index; map[key.toLowerCase()] = index; }
  });
  return map;
}

function getPMRIndex_(headerMap) { 
  return findHeaderIndex_(headerMap, ["Participant PMR#", "Participant PMR", "PMR#", "PMR"]); 
}

function findHeaderIndex_(headerMap, possibleNames) {
  const map = headerMap || {};
  for (let i = 0; i < (possibleNames || []).length; i++) {
    const name = String(possibleNames[i] || "").trim();
    if (map[name] !== undefined) return map[name];
    if (map[name.toLowerCase()] !== undefined) return map[name.toLowerCase()];
  }
  return -1;
}

function mapRowsToHeaders_(sourceRows, sourceHeaders, targetHeaders) {
  const sourceMap = buildHeaderIndexMap_(sourceHeaders || []);
  return (sourceRows || []).map(function(row) {
    return (targetHeaders || []).map(function(header) {
      const index = findHeaderIndex_(sourceMap, [header]);
      return index >= 0 && index < row.length ? row[index] : "";
    });
  });
}

function padRowToWidth_(row, targetWidth) {
  const width = Math.max(Number(targetWidth) || 0, 0);
  const output = (row || []).slice(0, width);
  while (output.length < width) output.push("");
  return output;
}

function normalizeRowsToWidth_(rows, width) { 
  return (rows || []).map(function(row) { return padRowToWidth_(row, width); }); 
}

function isPrimaryPMRRowValue_(value) {
  const text = String(value == null ? "" : value).trim().toUpperCase();
  return text === "YES" || text === "TRUE" || text === "Y" || text === "PRIMARY" || value === 1;
}

function valuesAreEqual_(left, right) {
  if (left instanceof Date || right instanceof Date) {
    const leftTime = left instanceof Date ? left.getTime() : new Date(left).getTime();
    const rightTime = right instanceof Date ? right.getTime() : new Date(right).getTime();
    return !isNaN(leftTime) && !isNaN(rightTime) && leftTime === rightTime;
  }
  return String(left == null ? "" : left).trim() === String(right == null ? "" : right).trim();
}

function getMonthDateParts_(dateObject) {
  const date = dateObject instanceof Date && !isNaN(dateObject.getTime()) ? dateObject : new Date();
  return buildPromptedMonthContext_(String(date.getMonth() + 1) + "." + String(date.getFullYear()).slice(-2));
}

function formatReportDateLabel_(dateObject) {
  const date = dateObject instanceof Date && !isNaN(dateObject.getTime()) ? dateObject : new Date();
  return Utilities.formatDate(date, Session.getScriptTimeZone(), "MM.yy");
}

function buildMonthlySheetName_(prefix, firstDay, lastDay) {
  return String(prefix || "").trim() + " " + formatReportDateLabel_(firstDay);
}

function getLatestSheetByPrefix_(prefix) {
  const normalizedPrefix = String(prefix || "").trim().toLowerCase();
  const candidates = SpreadsheetApp.getActiveSpreadsheet().getSheets().filter(function(sheet) {
    const name = sheet.getName().toLowerCase();
    return name.indexOf("template") === -1 && name.indexOf(normalizedPrefix) === 0;
  });
  candidates.sort(function(a, b) { 
    return extractFirstDateFromSheetName_(b.getName()).getTime() - extractFirstDateFromSheetName_(a.getName()).getTime(); 
  });
  return candidates[0] || null;
}

function getCurrentRawDataSheet_(monthParts) {
  if (!monthParts || !monthParts.label) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName("Raw Data " + monthParts.label) || ss.getSheetByName(SYSTEM_SHEETS.SOURCE_PREFIX + "Raw Data " + monthParts.label);
}

function getCurrentDemoPSheet_() { 
  return SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Refined Data"); 
}

function getCurrentCarePlanDueSheet_(monthParts) {
  if (!monthParts || !monthParts.label) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName("CP Due " + monthParts.label) || ss.getSheetByName("CP Due Date " + monthParts.label);
}

function getCurrentUnlockedCarePlanSheet_(monthParts) {
  if (!monthParts || !monthParts.label) return null;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName("Unlock CP " + monthParts.label) || ss.getSheetByName("Unlocked CP " + monthParts.label);
}

function setRequiredSheetName_(sheet, targetName) {
  if (!sheet) throw new Error("A sheet is required before assigning its final name.");
  const name = String(targetName || "").trim();
  if (!name) throw new Error("A nonblank target sheet name is required.");
  const existing = sheet.getParent().getSheetByName(name);
  if (existing && existing.getSheetId() !== sheet.getSheetId()) { 
    throw new Error('Sheet "' + name + '" already exists.'); 
  }
  sheet.setName(name);
  return sheet;
}

function ensureOutputSheetHasFormattedRows_(sheet, requiredMaxRow, columnCount) {
  if (!sheet) throw new Error("An output sheet is required.");
  const rows = Math.max(Number(requiredMaxRow) || DATA_START_ROW, DATA_START_ROW);
  const columns = Math.max(Number(columnCount) || 1, 1);
  resizeSheetGrid_(sheet, rows, columns);
}

function resizeSheetGrid_(sheet, rowCount, columnCount) {
  if (!sheet) return;
  const rows = Math.max(Number(rowCount) || 1, 1);
  const columns = Math.max(Number(columnCount) || 1, 1);
  if (sheet.getMaxRows() < rows) sheet.insertRowsAfter(sheet.getMaxRows(), rows - sheet.getMaxRows());
  if (sheet.getMaxColumns() < columns) sheet.insertColumnsAfter(sheet.getMaxColumns(), columns - sheet.getMaxColumns());
}

function trimCreatedSheetToSize_(sheet, requiredRows, contentColumnCount) {
  if (!sheet) throw new Error("A created sheet is required before trimming its grid.");
  const rows = Math.max(Number(requiredRows) || 1, 1);
  let columnsWithBuffer = Math.max(Number(contentColumnCount) || 1, 1) + 1;

  const frozenCols = sheet.getFrozenColumns();
  if (columnsWithBuffer <= frozenCols) columnsWithBuffer = frozenCols + 1;

  resizeSheetGrid_(sheet, rows, columnsWithBuffer);
  if (sheet.getMaxRows() > rows) sheet.deleteRows(rows + 1, sheet.getMaxRows() - rows);
  if (sheet.getMaxColumns() > columnsWithBuffer) sheet.deleteColumns(columnsWithBuffer + 1, sheet.getMaxColumns() - columnsWithBuffer);
  return sheet;
}

function trimCreatedSheetToData_(sheet, minimumRows, minimumContentColumns) {
  if (!sheet) return sheet;
  const requiredRows = Math.max(sheet.getLastRow(), Number(minimumRows) || 1);
  const contentColumns = Math.max(sheet.getLastColumn(), Number(minimumContentColumns) || 1);
  return trimCreatedSheetToSize_(sheet, requiredRows, contentColumns);
}

function applyNativeBandingSafe_(sheet, startRow, totalColumns, totalRows, colorOne, colorTwo) {
  if (!sheet || totalRows < startRow || totalColumns < 1) return null;
  sheet.getBandings().forEach(function(banding) { banding.remove(); });
  const banding = sheet.getRange(startRow, 1, totalRows - startRow + 1, totalColumns).applyRowBanding();
  banding.setFirstRowColor(colorOne || "#ffffff");
  banding.setSecondRowColor(colorTwo || "#f7f7f7");
  banding.setHeaderRowColor(null);
  return banding;
}

function applyColumnWidths_(sheet, widthCsv) {
  String(widthCsv || "").split(",").forEach(function(rawWidth, index) {
    const width = Number(String(rawWidth).trim());
    if (width > 0 && index < sheet.getMaxColumns()) sheet.setColumnWidth(index + 1, width);
  });
}

function openArchiveSpreadsheetOnce_() {
  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID");
  if (!archiveId) {
    throw new Error("RFF_ARCHIVE_SPREADSHEET_ID is not configured. Use the Index menu to set it.");
  }
  return SpreadsheetApp.openById(archiveId);
}

function logBestEffortWarning_(msg) {
  if (typeof Logger !== "undefined") Logger.log("WARNING: " + msg);
  logFrameworkTiming_("WARNING", "BestEffort", "WARN", msg);
}

function notify_(msg) { 
  SpreadsheetApp.getActiveSpreadsheet().toast(msg, "System Info", 4); 
}


function markFrameworkStep_(timing, stepName, details) { logFrameworkTiming_("LAYOUT_MGMT", stepName, "INFO", details || ""); }

function deleteSheetSafely_(ss, sheetToDelete, logReason) {
  if (!ss || !sheetToDelete) return;
  try { if (ss.getSheets().length > 1) { ss.deleteSheet(sheetToDelete); } else { sheetToDelete.hideSheet(); } } catch (e) { logBestEffortWarning_(`Could not delete sheet '${sheetToDelete.getName()}': ${e.message}`); }
}

function promptForLockedYearReportMonth_(title) {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt(title, "Enter Report Month (M, MM, MM.YY, or MM/YY; year defaults to 2026):", ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return null;
  const val = res.getResponseText().trim();
  if (!val) return null;
  try { return buildPromptedMonthContext_(val); } catch (err) { ui.alert("Invalid Report Month", err.message, ui.ButtonSet.OK); return null; }
}

function buildPromptedMonthContext_(inputStr) {
  let month;
  let year = 2026;
  const clean = String(inputStr || "").trim();
  if (!/^\d{1,2}([.\/]\d{2,4})?$/.test(clean)) throw new Error("Use M, MM, MM.YY, or MM/YY.");
  const parts = clean.split(/[.\/]/);
  month = parseInt(parts[0], 10);
  if (parts.length === 2) {
    let y = parseInt(parts[1], 10);
    if (y < 100) y += 2000;
    year = y;
  }
  if (month < 1 || month > 12) throw new Error("Month must be between 1 and 12.");
  if (year !== 2026) throw new Error("This release is locked to reporting year 2026.");
  const reportDate = new Date(year, month - 1, 1);
  const monthStr = (month < 10 ? "0" : "") + month;
  const yearShort = String(year).substring(2);
  return { monthLabel: monthStr + "." + yearShort, label: monthStr + "." + yearShort, reportDate: reportDate, month: month, year: year, mm: monthStr, yy: yearShort, firstDay: reportDate, lastDay: new Date(year, month, 0) };
}

function refreshIndexAfterSheetWorkflow_(label) {
  try { if (typeof populateActiveIndex === "function") populateActiveIndex(); } catch (e) { logBestEffortWarning_("Failed to refresh Index after " + label + ": " + e.message); }
}

function hideSheetIfNeeded_(sheet, timing, logMsg) {
  if (!sheet) return;
  if (!sheet.isSheetHidden()) {
    activateVisibleSheetBeforeHiding_(sheet);
    sheet.hideSheet();
    if (logMsg && typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, logMsg, "Hidden");
  }
}

function showSheetIfNeeded_(sheet, timing, logMsg) {
  if (!sheet) return;
  if (sheet.isSheetHidden()) {
    sheet.showSheet();
    if (logMsg && typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, logMsg, "Shown");
  }
}

function activateVisibleSheetBeforeHiding_(sheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss.getActiveSheet().getName() === sheet.getName()) {
    const other = ss.getSheets().find(s => s.getName() !== sheet.getName() && !s.isSheetHidden());
    if (other) ss.setActiveSheet(other);
  }
}

function extractFirstDateFromSheetName_(name) {
  const match = String(name || "").match(/(\d{2})[.\/-](\d{2,4})/);
  if (match) {
    let m = parseInt(match[1], 10);
    let y = parseInt(match[2], 10);
    if (y < 100) y += 2000;
    return new Date(y, m - 1, 1);
  }
  return new Date();
}

function getUniqueArchiveSheetName_(archiveSpreadsheet, baseName) {
  if (!archiveSpreadsheet || !baseName) return baseName;
  let uniqueName = String(baseName).trim();
  let counter = 1;
  while (archiveSpreadsheet.getSheetByName(uniqueName)) { uniqueName = `${baseName} (${counter})`; counter++; }
  return uniqueName;
}

function archiveRawSourceSheet_(sourceSheet, archiveName, timing, timingLabel, preOpenedArchiveSpreadsheet) {
  if (!sourceSheet) throw new Error("A source sheet is required for archive.");
  const archiveSpreadsheet = preOpenedArchiveSpreadsheet || openArchiveSpreadsheetOnce_();
  const finalArchiveName = getUniqueArchiveSheetName_(archiveSpreadsheet, archiveName);
  const copied = sourceSheet.copyTo(archiveSpreadsheet);
  copied.setName(finalArchiveName);
  if (copied.getMaxRows() !== sourceSheet.getMaxRows() || copied.getMaxColumns() !== sourceSheet.getMaxColumns()) {
    archiveSpreadsheet.deleteSheet(copied);
    throw new Error("Archived source verification failed.");
  }
  markFrameworkStep_(timing, timingLabel || "Archive source", finalArchiveName);
  return { archivedSuccessfully: true, sheet: copied, archiveSpreadsheetId: archiveSpreadsheet.getId(), archivedName: finalArchiveName };
}




