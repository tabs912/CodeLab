  appendDashboardSectionRows_(dashRows, "SECTION F - SUBHEADER ROWS", ["Sheet Type", "Row", "Purpose", "Value Source", "Label", "Target Cell", "Height", "Font Size", "Font Weight", "Fill Level", "Alignment", "Wrap", "Notes"], getDefaultSubheaderRowRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION G - COLUMN DEFINITIONS", ["Header", "Width", "Header Font Size", "Date Column", "Hide Column", "Data Wrap", "Horizontal Alignment", "Vertical Alignment", "Number Format"], getDefaultColumnDefinitionRows_(), dashWidth);
  appendDashboardSectionRows_(dashRows, "SECTION H - SHEET HEADERS", ["Sheet Type", "Column Order", "Header", "Source of Data"], getDefaultSheetHeaderRows_(), dashWidth);

  // Set grid dimensions and inject populated matrix
  resizeSheetGrid_(dashSheet, dashRows.length, dashWidth + 1);
  dashSheet.getRange(1, 1, dashRows.length, dashWidth).setValues(dashRows);
  
  trimCreatedSheetToSize_(dashSheet, dashRows.length, dashWidth);

  // Recalculate HSL hex color outputs in Section C starting at Column E
  if (typeof recalculateDashboardHexCodes_ === "function") {
    recalculateDashboardHexCodes_(dashSheet);
  }

  // Apply Section Banner and Subheader fills
  const theme = typeof getTemplateTheme_ === "function" ? getTemplateTheme_(SYSTEM_SHEETS.DASHBOARD) : { level3: "#ccc", level1: "#eee", level2: "#ddd", level4: "#fff", level5: "#fafafa" };
  if (typeof applyNativeBandingSafe_ === "function") applyNativeBandingSafe_(dashSheet, 5, dashWidth + 1, dashSheet.getMaxRows(), theme.level4, theme.level5);

  formatDashboardSections_(dashSheet, theme);
  return dashSheet;
}


function formatDashboardSections_(sheet, theme) {
  if (!sheet) return;
  const maxCols = sheet.getMaxColumns();
  const values = sheet.getDataRange().getValues();

  for (let r = 0; r < values.length; r++) {
    const val = String(values[r][0] || "").trim();
    if (val.indexOf("SECTION ") === 0) {
      const bannerSheetRow = r + 1;
      const spacerSheetRow = r + 2;
      const headerSheetRow = r + 3;

      const bannerRange = sheet.getRange(bannerSheetRow, 1, 1, maxCols);
      bannerRange.setBackground(theme.level3 || "#CCE3EE");
      sheet.getRange(bannerSheetRow, 1).setFontSize(12).setFontWeight("bold");
      sheet.setRowHeight(bannerSheetRow, 25);

      if (spacerSheetRow <= sheet.getMaxRows()) {
        sheet.getRange(spacerSheetRow, 1, 1, maxCols).setBackground(theme.level1 || "#79B5D2");
        sheet.setRowHeight(spacerSheetRow, 10);
      }

      if (headerSheetRow <= sheet.getMaxRows()) {
        const headerRange = sheet.getRange(headerSheetRow, 1, 1, maxCols);
        headerRange.setBackground(theme.level2 || "#A5D0E3");
        headerRange.setFontSize(8);
        headerRange.setFontWeight("bold");
        headerRange.setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
        sheet.setRowHeight(headerSheetRow, 25);
      }
    }
  }
}

function appendDashboardSectionRows_(rows, sectionName, headers, dataRows, width) {
  const emptyRow = new Array(width).fill("");
  rows.push(emptyRow);

  const bannerRow = new Array(width).fill("");
  bannerRow[0] = sectionName;
  rows.push(bannerRow);

  rows.push(emptyRow);

  const headerRow = new Array(width).fill("");
  for (let i = 0; i < headers.length; i++) { headerRow[i] = headers[i]; }
  rows.push(headerRow);

  rows.push(emptyRow);
  (dataRows || []).forEach(row => {
    const paddedRow = row.slice(0, width);
    while (paddedRow.length < width) paddedRow.push("");
    rows.push(paddedRow);
  });
}

