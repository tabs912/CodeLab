function isFrameworkTimingEnabled_() {
  try {
    return PropertiesService.getDocumentProperties().getProperty("RFF_TIMING_ENABLED") !== "false";
  } catch (err) {
    return true;
  }
}

function toggleFrameworkTiming() {
  const enabled = isFrameworkTimingEnabled_();
  const nextValue = enabled ? "false" : "true";
  PropertiesService.getDocumentProperties().setProperty("RFF_TIMING_ENABLED", nextValue);
  SpreadsheetApp.getActiveSpreadsheet().toast("Timing Engine: " + (nextValue === "true" ? "ON" : "OFF"), "Timing Engine", 3);
  return nextValue === "true";
}

function startRuntimeTiming_(processName, monthParts) {
  const now = new Date().getTime();
  return {
    processName: processName || "Workflow",
    monthParts: monthParts || null,
    startMs: now,
    lastMs: now,
    steps: [],
    warnings: []
  };
}

function markRuntimeStep_(timing, label, details) {
  if (!timing) return;
  if (!Array.isArray(timing.steps)) timing.steps = [];
  if (!Array.isArray(timing.warnings)) timing.warnings = [];
  if (!timing.startMs) timing.startMs = new Date().getTime();
  if (!timing.lastMs) timing.lastMs = timing.startMs;
  if (!timing.processName) timing.processName = "Workflow";

  const now = new Date().getTime();
  const stepSeconds = (now - timing.lastMs) / 1000;
  const totalSeconds = (now - timing.startMs) / 1000;
  const cleanLabel = String(label || "Step");
  const severity = /^ERROR\b/i.test(cleanLabel) ? "CRITICAL" : getRuntimeTimingSeverity_(stepSeconds);
  const cleanDetails = details === undefined || details === null ? "" : String(details);

  timing.steps.push({
    timestamp: new Date(),
    processName: timing.processName,
    stepName: cleanLabel,
    stepSeconds: stepSeconds,
    totalSeconds: totalSeconds,
    severity: severity,
    details: cleanDetails
  });

  if (severity !== "OK") {
    timing.warnings.push(cleanLabel + " - " + severity + " - " + formatSeconds_(stepSeconds));
  }

  timing.lastMs = now;
  logRuntimeTiming_(timing.processName, cleanLabel, stepSeconds, totalSeconds, severity, cleanDetails);
}

function logRuntimeWarning_(processName, message, details) {
  const suffix = details === undefined || details === null || details === "" ? "" : " | " + details;
  if (typeof Logger !== "undefined") {
    Logger.log("[WARNING] " + String(processName || "System") + " | " + String(message || "") + suffix);
  }
}

function logBestEffortWarning_(msg) {
  if (typeof Logger !== "undefined") Logger.log("WARNING: " + msg);
  // Route legacy warnings safely without breaking execution
  if (typeof logRuntimeWarning_ === "function") {
    logRuntimeWarning_("Best Effort", msg, "");
  }
}


// Fallback to prevent any missed calls from crashing the script
function logFrameworkTiming_(process, step, severity, details) {
  if (typeof Logger !== "undefined") {
    Logger.log("[TIMING-LEGACY] " + String(process) + " | " + String(step) + " | " + String(severity) + " | " + String(details));
  }
}

function logRuntimeTiming_(processName, stepName, stepSeconds, totalSeconds, severity, details) {
  const detailText = details ? " | " + details : "";
  if (typeof Logger !== "undefined") {
    Logger.log("[TIMING] " + String(processName) + " | " + String(stepName) + " | step " + formatSeconds_(stepSeconds) + " | total " + formatSeconds_(totalSeconds) + " | " + String(severity) + detailText);
  }
}


function getRuntimeTimingSeverity_(seconds) {
  const value = Number(seconds || 0);
  if (value >= 60) return "CRITICAL";
  if (value >= 30) return "BOTTLENECK";
  if (value >= 10) return "SLOW";
  return "OK";
}

function formatSeconds_(seconds) {
  const value = Number(seconds || 0);
  if (value < 60) return value.toFixed(2) + " sec";
  const minutes = Math.floor(value / 60);
  const remaining = value - (minutes * 60);
  return minutes + " min " + remaining.toFixed(1) + " sec";
}

function writeRuntimeTimingReport_(timing) {
  if (!timing || !timing.steps || timing.steps.length === 0) return false;
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(RFF_TIMING_SHEET) || ss.getSheetByName(SYSTEM_SHEETS.TEMPLATE_PREFIX + RFF_TIMING_SHEET);
    if (!sheet) return false;

    const rows = timing.steps.map(function(step) {
      return [
        step.timestamp || new Date(),
        step.processName || "",
        step.stepName || "",
        Number(step.stepSeconds || 0),
        Number(step.totalSeconds || 0),
        step.severity || "OK",
        step.details || ""
      ];
    });

    const lastRow = Math.max(sheet.getLastRow(), 4);
    sheet.getRange(lastRow + 1, 1, rows.length, rows[0].length).setValues(rows);
    return true;
  } catch (err) {
    logBestEffortWarning_("[WARNING] Framework Timing Report append skipped | " + err.message);
    return false;
  }
}

// ----------------------------------------------------------------------------
// COMPATIBILITY ALIASES (Ensures v1.9.3.5 pipelines don't break)
// ----------------------------------------------------------------------------

function runFrameworkTimed_(processName, func) {
  if (!isFrameworkTimingEnabled_()) {
    return func(null); 
  }
  const timing = startRuntimeTiming_(processName);
  markRuntimeStep_(timing, "Start Process", processName);
  try {
    const res = func(timing);
    markRuntimeStep_(timing, "End Process", processName + " completed");
    writeRuntimeTimingReport_(timing);
    return res;
  } catch (err) {
    markRuntimeStep_(timing, "Error", err.message);
    writeRuntimeTimingReport_(timing);
    throw err;
  }
}

function markFrameworkStep_(timing, stepName, details) { 
  // Map legacy layout logs to the new streamlined runtime step engine
  if (typeof markRuntimeStep_ === "function") {
    markRuntimeStep_(timing, stepName, details || "");
  }
}


// ============================================================================
// EXTRACTED SUBHEADER APPENDER (Required for Monthly Change / Quality Reports)
// ============================================================================

function appendDataToSubheaderSection_(sheet, sectionTitle, rows) {
  if (!sheet || !rows || !rows.length) return null;
  const values = sheet.getDataRange().getValues();
  let titleRow = -1;
  let nextSectionRow = -1;
  
  for (let index = 0; index < values.length; index++) {
    const firstCell = String(values[index][0] || "").trim();
    if (firstCell === sectionTitle) { titleRow = index + 1; continue; }
    if (titleRow > 0 && firstCell.indexOf("SECTION ") === 0) { nextSectionRow = index + 1; break; }
  }
  
  if (titleRow < 0) throw new Error('Template subheader section "' + sectionTitle + '" is missing.');
  
  const firstDataRow = titleRow + 5;
  let appendRow = firstDataRow;
  const boundary = nextSectionRow > 0 ? nextSectionRow - 1 : sheet.getLastRow() + 1;
  
  if (String(sheet.getRange(firstDataRow, 1).getValue() || "").trim() === "Insert new data here" || String(sheet.getRange(firstDataRow, 1).getValue() || "").trim() === "Enter Data here") {
    sheet.getRange(firstDataRow, 1).clearContent();
  }
  
  while (appendRow < boundary && String(sheet.getRange(appendRow, 1).getValue() || "").trim() !== "") { 
    appendRow++; 
  }
  
  if (nextSectionRow > 0 && appendRow + rows.length > boundary) {
    sheet.insertRowsBefore(boundary, appendRow + rows.length - boundary);
  } else if (nextSectionRow <= 0) {
    if (typeof resizeSheetGrid_ === "function") {
      resizeSheetGrid_(sheet, appendRow + rows.length - 1, rows[0].length + 1);
    }
  }
  
  sheet.getRange(appendRow, 1, rows.length, rows[0].length).setValues(rows);
  return { startRow: appendRow, rowCount: rows.length };
}


// ============================================================================
// 8. COLOR LOGIC & HSL HELPERS
// ============================================================================

function isValidHex_(hexStr) { return /^#[0-9A-F]{6}$/i.test(String(hexStr || "").trim()); }

function hexToHsl_(hex) {
  let c = String(hex || "").replace('#', '').trim();
  if (c.length === 3) c = c.split('').map(x => x + x).join('');
  if (c.length !== 6) return { h: 200, s: 50, l: 50 };
  const r = parseInt(c.substring(0, 2), 16) / 255, g = parseInt(c.substring(2, 4), 16) / 255, b = parseInt(c.substring(4, 6), 16) / 255;
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  let h = 0, s = 0, l = (max + min) / 2;
  if (max !== min) {
    const d = max - min; s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) { case r: h = (g - b) / d + (g < b ? 6 : 0); break; case g: h = (b - r) / d + 2; break; case b: h = (r - g) / d + 4; break; }
    h /= 6;
  }
  return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
}

function hslToHex_(h, s, l) {
  l /= 100; const a = (s * Math.min(l, 1 - l)) / 100;
  const f = n => { const k = (n + h / 30) % 12; const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1); return Math.round(255 * color).toString(16).padStart(2, '0'); };
  return `#${f(0)}${f(8)}${f(4)}`.toUpperCase();
}

function calculateThemeLevels_(baseHex, hslPercents) {
  const hsl = hexToHsl_(baseHex);
  return {
    base: baseHex,
    level1: hslToHex_(hsl.h, hsl.s, hslPercents.l1 || 60),
    level2: hslToHex_(hsl.h, hsl.s, hslPercents.l2 || 75),
    level3: hslToHex_(hsl.h, hsl.s, hslPercents.l3 || 85),
    level4: hslToHex_(hsl.h, hsl.s, hslPercents.l4 || 97),
    level5: hslToHex_(hsl.h, hsl.s, hslPercents.l5 || 99)
  };
}

function getHslPercentsFromDashboard_(dashSheet) {
  if (typeof GLOBAL_DEFAULTS !== "undefined" && GLOBAL_DEFAULTS.HSL_LEVELS) {
    return {
      l1: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level1) || 60,
      l2: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level2) || 75,
      l3: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level3) || 85,
      l4: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level4) || 97,
      l5: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level5) || 99
    };
  }
  return { l1: 60, l2: 75, l3: 85, l4: 97, l5: 99 };
}

function getTemplateTheme_(systemSheetName) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var dashSheet = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD) || ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT);
    if (!dashSheet) return getFallbackTheme_();
    var data = dashSheet.getDataRange().getValues();
    var hslPercents = getHslPercentsFromDashboard_(dashSheet);

    for (var i = 0; i < data.length; i++) {
      var sysKey = String(data[i][0] || "").trim();
      if (sysKey === systemSheetName || sysKey.toLowerCase() === String(systemSheetName || "").toLowerCase()) {
        
        // Look in Column D (Index 3) for the Base Color
        var rawBase = String(data[i][3] || "").trim();
        
        // FIX: Only apply and return if it is ACTUALLY a hex code. 
        // This forces the script to ignore the tab ranks in Section B and keep 
        // searching until it hits the actual color definitions in Section C.
        if (isValidHex_(rawBase)) {
          var computed = calculateThemeLevels_(rawBase, hslPercents);
          return {
            baseColor: rawBase,
            level1: computed.level1, 
            level2: computed.level2,
            level3: computed.level3, 
            level4: computed.level4, 
            level5: computed.level5,
            titleFontColor: GLOBAL_DEFAULTS.STANDARD_FONT_COLOR
          };
        }
      }
    }
  } catch (e) { logBestEffortWarning_("Non-fatal operation failed: " + e.message); }
  
  return getFallbackTheme_();
}





function getFallbackTheme_() {
  return { baseColor: "#79B5D2", level1: "#79B5D2", level2: "#A5D0E3", level3: "#C4E2F0", level4: "#eff8cf", level5: "#f3fadd", titleFontColor: "#000000" };
}

function recalculateDashboardHexCodes_(dashboardSheet) {
  if (!dashboardSheet) return;
  const rawDashData = dashboardSheet.getDataRange().getValues();
  const hslPercents = getHslPercentsFromDashboard_(dashboardSheet);

  for (let r = 0; r < rawDashData.length; r++) {
    const firstCell = String(rawDashData[r][0] || "").trim();
    if (!firstCell || firstCell.indexOf("SECTION ") === 0 || firstCell === "System Sheet Name" || firstCell === "Sheet Type") continue;

    // FIX: Look for the Base Color at Index 3 (Column D)
    const potentialHex = String(rawDashData[r][3] || "").trim();
    
    if (isValidHex_(potentialHex)) {
      const theme = calculateThemeLevels_(potentialHex, hslPercents);
      
      // FIX: Level 1 through 5 output columns now start at Column 5 (Column E)
      const targetRange = dashboardSheet.getRange(r + 1, 5, 1, 5); 
      targetRange.clearNote();
      targetRange.setValues([[theme.level1, theme.level2, theme.level3, theme.level4, theme.level5]]);
    }
  }
}



// ============================================================================
// 9. QUALITY & VALIDATION CORE
// ============================================================================

function runDashboardQualityConfigVerificationSections_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD) || ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT);
  if (!dashboard) throw new Error("Format Dashboard is required for Dashboard Quality verification.");
  const values = dashboard.getDataRange().getValues();
  const sections = {};
  let currentSection = "";
  values.forEach(function(row, rowIndex) {
    const firstCell = String(row[0] || "").trim();
    if (firstCell.indexOf("SECTION ") === 0) {
      currentSection = firstCell;
      sections[currentSection] = { titleRow: rowIndex + 1, rows: [] };
    } else if (currentSection) {
      sections[currentSection].rows.push(row);
    }
  });

  const requiredPrefixes = ["SECTION B", "SECTION C", "SECTION D", "SECTION E", "SECTION F", "SECTION G", "SECTION H"];
  const results = requiredPrefixes.map(function(prefix) {
    const title = Object.keys(sections).find(function(name) { return name.indexOf(prefix) === 0; });
    if (!title) return [prefix, "FAIL", "Required section is missing."];
    const meaningfulRows = sections[title].rows.filter(function(row) {
      return row.some(function(value) { return String(value == null ? "" : value).trim() !== ""; });
    });
    return meaningfulRows.length ? [title, "PASS", meaningfulRows.length + " configured row(s) detected."] : [title, "WARNING", "Section exists but has no configured data rows."];
  });
  return results;
}

function writeDashboardQualitySection_(title, headers, rows) {
  const sheet = ensureDashboardQualityReport_();
  const width = Math.max(headers.length, 4);
  const normalizedRows = (rows || []).map(function(row) {
    const output = row.slice(0, width);
    while (output.length < width) output.push("");
    return output;
  });
  const appended = appendDataToSubheaderSection_(sheet, title, normalizedRows);
  if (!appended) return;
  const statusColumn = Math.max(headers.map(function(header) { return String(header).toLowerCase(); }).indexOf("status") + 1, 2);
  normalizedRows.forEach(function(row, index) {
    if (String(row[statusColumn - 1] || "").toUpperCase() === "FAIL") {
      sheet.getRange(appended.startRow + index, statusColumn).setBackground("#F4CCCC");
    }
  });
}

function ensureDashboardQualityReport_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SYSTEM_SHEETS.QUALITY);
  if (sheet) return sheet;
  if (!ss.getSheetByName(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY)) {
    if (!ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT) && !ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD)) {
      if (typeof buildFormatDashboardTemplate_ === "function") buildFormatDashboardTemplate_();
    }
    if (typeof buildGeneralTemplate_ === "function") buildGeneralTemplate_(getTemplateConfigFromDashboard_(SYSTEM_SHEETS.QUALITY));
  }
  sheet = createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.QUALITY);
  if (!sheet) throw new Error("Dashboard Quality Report could not be created from its governed template.");
  return sheet;
}

function runDashboardQualityStartUp() {
  return runFrameworkTimed_("Dashboard Quality Start Up", function(timing) {
    const results = runDashboardQualityConfigVerificationSections_();
    writeDashboardQualitySection_("SECTION A - FORMAT DASHBOARD VALIDATION", ["Section", "Status", "Details"], results);
    markFrameworkStep_(timing, "Format Dashboard Sections B-H audited", results.length + " sections");
    return results;
  });
}

function runDashboardQualityValidateTemplates() {
  return runFrameworkTimed_("Dashboard Quality Validate Templates", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const templateNames = [
      "Template -  Banners", "Template -  CP Due Date", "Template -  Unlock CP",
      "Template -  Raw Data", "Template -  Refined Data", "Template -  Disenrolled Exclusion",
      "Template -  Master List", "Template -  Monthly Change", "Template -  Archive - Refined Data",
      SYSTEM_SHEETS.BASE_TEMPLATE
    ];
    const rows = templateNames.map(function(templateName) {
      const exists = !!ss.getSheetByName(templateName);
      return [templateName, exists ? "PASS" : "FAIL", exists ? "Template found." : "Template is missing."];
    });
    writeDashboardQualitySection_("SECTION B - TEMPLATE VALIDATION", ["Template", "Status", "Details"], rows);
    markFrameworkStep_(timing, "Templates validated", rows.length + " templates");
    return rows;
  });
}

function runDashboardQualityWorkflow() {
  const configResults = runDashboardQualityStartUp();
  const templateResults = runDashboardQualityValidateTemplates();
  const processResults = runDashboardQualityProcessValidationSections_();
  const failed = configResults.concat(templateResults, processResults).filter(function(row) { return row[1] === "FAIL"; });
  if (failed.length) throw new Error("Dashboard Quality Workflow failed " + failed.length + " validation item(s).");
  notify_("Dashboard Quality Workflow complete.");
  return { configResults: configResults, templateResults: templateResults, processResults: processResults };
}

function runDashboardQualityProcessValidationSections_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = loadDashboardConfig_();
  const validations = [
    ["SECTION C - RAW DATA VALIDATION", "Raw Data"],
    ["SECTION D - DEMO P QUALITY VALIDATION", "Refined Data"],
    ["SECTION E - DISENROLLED EXCLUSION VALIDATION", "Disenrolled Exclusion"],
    ["SECTION F - MONTHLY CHANGE VALIDATION", "Monthly Change"],
    ["SECTION G - MASTER LIST VALIDATION", "Master List"]
  ];
  const results = [];
  validations.forEach(function(item) {
    const title = item[0];
    const sheetType = item[1];
    const governedHeaders = getHeadersForSheetType_(dashboard, sheetType);
    const activeSheet = getLatestSheetByPrefix_(sheetType);
    let status = "PASS";
    let details = governedHeaders.length + " governed header(s); active sheet " + (activeSheet ? "found" : "not present (not yet built)") + ".";
    if (!governedHeaders.length) { status = "FAIL"; details = "No governed headers are configured."; } else if (!activeSheet) { status = "WARNING"; }
    const row = [sheetType, status, details];
    writeDashboardQualitySection_(title, ["Process", "Status", "Details"], [row]);
    results.push(row);
  });
  const failedCount = results.filter(function(row) { return row[1] === "FAIL"; }).length;
  const warningCount = results.filter(function(row) { return row[1] === "WARNING"; }).length;
  const summary = [["Dashboard Quality Workflow", failedCount ? "FAIL" : (warningCount ? "WARNING" : "PASS"), results.length + " process section(s); " + failedCount + " failed; " + warningCount + " warning(s)."]];
  writeDashboardQualitySection_("SECTION H - SUMMARY", ["Workflow", "Status", "Details"], summary);
  return results.concat(summary);
}

function runFrameworkSmokeValidation() {
  const requiredFunctions = [
    ["formatMonthlySheets", typeof formatMonthlySheets], ["runMonthlyUpdate", typeof runMonthlyUpdate],
    ["runMonthlyStart", typeof runMonthlyStart], ["updateRefinedDataMonthlySync", typeof updateRefinedDataMonthlySync],
    ["buildRefinedDataFromScratch", typeof buildRefinedDataFromScratch], ["createDisenrolledList", typeof createDisenrolledList],
    ["buildMonthlyChangeReport", typeof buildMonthlyChangeReport], ["createMasterList", typeof createMasterList],
    ["runDashboardQualityWorkflow", typeof runDashboardQualityWorkflow], ["createAllReportTemplates", typeof createAllReportTemplates],
    ["populateActiveIndex", typeof populateActiveIndex]
  ];
  const missingFunctions = requiredFunctions.filter(function(item) { return item[1] !== "function"; }).map(function(item) { return item[0]; });
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const requiredSheets = [SYSTEM_SHEETS.DASHBOARD, SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.INDEX];
  const missingSheets = requiredSheets.filter(function(name) { return !ss.getSheetByName(name); });
  if (missingFunctions.length || missingSheets.length) throw new Error("Framework smoke validation failed. Missing functions: " + (missingFunctions.join(", ") || "None") + "; Missing sheets: " + (missingSheets.join(", ") || "None"));
  notify_("Framework smoke validation passed.");
  return { functionsChecked: requiredFunctions.length, sheetsChecked: requiredSheets.length };
}

function runFullQualityCheck() {
  const smoke = runFrameworkSmokeValidation();
  const quality = runDashboardQualityWorkflow();
  notify_("Full Quality Check complete.");
  return { smoke: smoke, quality: quality };
}

function runFormatDashboardUpdates() {
  const results = runDashboardQualityConfigVerificationSections_();
  writeDashboardQualitySection_("SECTION A - FORMAT DASHBOARD VALIDATION", ["Section", "Status", "Details"], results);
  const failed = results.filter(function(row) { return row[1] === "FAIL"; });
  if (failed.length) throw new Error("Format Dashboard Updates found " + failed.length + " missing required section(s).");
  notify_("Format Dashboard Updates validation complete.");
  return results;
}

