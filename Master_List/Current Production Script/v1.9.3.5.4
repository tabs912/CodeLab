function applyOperationalFormatting_(templateSheet, systemSheetName) {
  if (!templateSheet) return;
  const config = loadDashboardConfig_(true);
  const headers = config.sheetHeaders[systemSheetName] || config.sheetHeaders[getStandardSheetKey_(systemSheetName)] || [];
  if (!headers || headers.length === 0) return;

  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(templateSheet, templateSheet.getMaxRows(), headers.length + 1);

  const headerRange = templateSheet.getRange(4, 1, 1, headers.length);
  headerRange.setValues([headers]);
  headerRange.setFontWeight("bold");

  const colDefs = config.columnDefinitions || {};
  const defaultWidth = Number(config.globals["Default Column Width"]) || GLOBAL_DEFAULTS.DEFAULT_COL_WIDTH;
  const defaultDateFormat = config.globals["Default Date Format"] || "mm/dd/yyyy";
  const defaultWrap = config.globals["Default Data Wrap"] || "CLIP";
  const defaultHAlign = config.globals["Default Horizontal Alignment"] || "left";
  const defaultVAlign = config.globals["Default Vertical Alignment"] || "middle";
  const maxRows = templateSheet.getMaxRows();

  for (let c = 0; c < headers.length; c++) {
    const headerName = String(headers[c] || "").trim();
    const colDef = colDefs[headerName] || colDefs[headerName.toLowerCase()] || {};
    const colIdx = c + 1;

    templateSheet.setColumnWidth(colIdx, (colDef.width && colDef.width > 0) ? colDef.width : defaultWidth);

    if (colDef.fontSize && colDef.fontSize > 0) {
      templateSheet.getRange(4, colIdx).setFontSize(colDef.fontSize);
    }

    if (maxRows >= DATA_START_ROW) {
      const dataColRange = templateSheet.getRange(DATA_START_ROW, colIdx, maxRows - DATA_START_ROW + 1, 1);

      if (colDef.format) {
        dataColRange.setNumberFormat(colDef.format);
      } else if (colDef.dateColumn) {
        dataColRange.setNumberFormat(defaultDateFormat);
      }

      const hAlign = colDef.align || defaultHAlign;
      if (hAlign) dataColRange.setHorizontalAlignment(hAlign.toLowerCase());

      const vAlign = colDef.vAlign || defaultVAlign;
      if (vAlign) dataColRange.setVerticalAlignment(vAlign.toLowerCase());

      const wrapStr = colDef.wrap || defaultWrap;
      if (wrapStr) {
        dataColRange.setWrapStrategy(
          wrapStr.toUpperCase() === "WRAP" ? SpreadsheetApp.WrapStrategy.WRAP :
          wrapStr.toUpperCase() === "OVERFLOW" ? SpreadsheetApp.WrapStrategy.OVERFLOW :
          SpreadsheetApp.WrapStrategy.CLIP
        );
      }
    }
  }

  trimCreatedSheetToSize_(templateSheet, templateSheet.getMaxRows(), headers.length);
}

function writeTemplateMetadata_(sheet, config, targetColumns) {
  if (!sheet || !config) throw new Error("Template metadata requires a sheet and configuration.");
  const column = Math.max(Math.min(Number(targetColumns) || 1, sheet.getMaxColumns()), 1);
  const version = typeof MASTER_LIST_MERGE_ML_VERSION !== "undefined" ? MASTER_LIST_MERGE_ML_VERSION : "v1.9.3.5.4";
  sheet.getRange(1, column).setNote("Template Mold: " + config.systemSheetName + "\nVersion: " + version + "\nUpdated: " + new Date().toISOString());
}

