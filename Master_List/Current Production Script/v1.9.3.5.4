function createActiveSystemSheets(timing) {
  const timeStr = Utilities.formatDate(new Date(), SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss");

  markFrameworkStep_(timing, "Active Dashboard Start", "Creating active Format Dashboard sheet");
  const dashActive = createActiveSheetFromTemplate_(SYSTEM_SHEETS.DASHBOARD_DEFAULT, SYSTEM_SHEETS.DASHBOARD) ||
                     createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.DASHBOARD, SYSTEM_SHEETS.DASHBOARD);
  if (dashActive) {
    dashActive.getRange("A2").setValue("Date Created");
    dashActive.getRange("B2").setValue(timeStr);
  }

  markFrameworkStep_(timing, "Active Timing Start", "Creating active Timing Report sheet");
  const timingActive = createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.TIMING, SYSTEM_SHEETS.TIMING) ||
                       createActiveSheetFromTemplate_("Template - Timing", SYSTEM_SHEETS.TIMING);
  if (timingActive) {
    timingActive.getRange("A2").setValue("Date Created");
    timingActive.getRange("B2").setValue(timeStr);
    stampActiveSubheaderTimestampNote_(timingActive, timeStr);
  }

  markFrameworkStep_(timing, "Active Quality Start", "Creating active Quality Report sheet");
  const qualityActive = createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.QUALITY) ||
                        createActiveSheetFromTemplate_("Template - Quality", SYSTEM_SHEETS.QUALITY);
  if (qualityActive) {
    qualityActive.getRange("A2").setValue("Date Created");
    qualityActive.getRange("B2").setValue(timeStr);
    stampActiveSubheaderTimestampNote_(qualityActive, timeStr);
  }

  markFrameworkStep_(timing, "Active Index Start", "Creating active Index sheet");
  const indexActive = createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.INDEX, SYSTEM_SHEETS.INDEX);
  if (indexActive) {
    indexActive.getRange("A2").setValue("Last Update");
    indexActive.getRange("B2").setValue(timeStr);
  }

  const missing = [
    [SYSTEM_SHEETS.DASHBOARD, dashActive],
    [SYSTEM_SHEETS.TIMING, timingActive],
    [SYSTEM_SHEETS.QUALITY, qualityActive],
    [SYSTEM_SHEETS.INDEX, indexActive]
  ].filter(function(item) { return !item[1]; }).map(function(item) { return item[0]; });
  
  if (missing.length) throw new Error("Active system sheet creation failed: " + missing.join(", ") + ". Run Create System Sheet Templates first.");
  
  markFrameworkStep_(timing, "Active System Sheets Complete", "All active sheets instantiated");
  return { dashboard: dashActive, timing: timingActive, quality: qualityActive, index: indexActive };
}

function createActiveSheetFromTemplate_(templateName, activeName, timing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  markFrameworkStep_(timing, "Clone Sheet: " + activeName, "Locating template: " + templateName);
  const template = ss.getSheetByName(templateName);
  if (!template) return null;

  const existingActive = ss.getSheetByName(activeName);
  if (existingActive) {
    markFrameworkStep_(timing, "Delete Existing: " + activeName, "Clearing old active instance");
    deleteSheetSafely_(ss, existingActive, "Replace active sheet from template");
    SpreadsheetApp.flush();
  }

  markFrameworkStep_(timing, "Copy Template: " + activeName, "Executing template copyTo()");
  const activeSheet = template.copyTo(ss);
  activeSheet.setName(activeName);
  activeSheet.showSheet();
  SpreadsheetApp.flush();

  if (typeof positionSheetBySectionFRank_ === "function") {
    markFrameworkStep_(timing, "Position Sheet: " + activeName, "Ranking sheet position");
    positionSheetBySectionFRank_(activeSheet);
  }
  
  trimCreatedSheetToSize_(activeSheet, template.getMaxRows(), Math.max(template.getMaxColumns() - 1, 1));
  return activeSheet;
}



function stampActiveSubheaderTimestampNote_(sheet, timeStr) {
