// 2.5. MASTER LIST SYNTHESIS
// ============================================================================

function createMasterList() {
  const monthParts = promptForLockedYearReportMonth_("Create Master List");
  if (!monthParts) return null;
  return createMasterListForMonth_(monthParts);
}

function createMasterListForMonth_(monthParts) {
  return runFrameworkTimed_("Master List " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Master List process is currently locked.");

    try {
      const dashboard = loadDashboardConfig_();
      const sysName = "Master List";

      const sourceSheets = {
        refined: getCurrentRefinedDataSheet_(),
        cpDue: getCurrentCarePlanDueSheet_(monthParts),
        unlockCP: getCurrentUnlockedCarePlanSheet_(monthParts)
      };

      if (!sourceSheets.refined) throw new Error("Refined Data is missing. Please run Update Refined Data first.");

      markFrameworkStep_(timing, "Reading Sources", "Extracting and filtering blank rows...");
      const data = {
        refined: filterBlankRows_(getDataValues_(sourceSheets.refined, HEADER_ROW, DATA_START_ROW).values),
        cpDue: sourceSheets.cpDue ? filterBlankRows_(getDataValues_(sourceSheets.cpDue, HEADER_ROW, DATA_START_ROW).values) : [],
        unlockCP: sourceSheets.unlockCP ? filterBlankRows_(getDataValues_(sourceSheets.unlockCP, HEADER_ROW, DATA_START_ROW).values) : []
      };

      const maps = {
        refined: buildHeaderIndexMap_(getHeaders_(sourceSheets.refined, HEADER_ROW)),
        cpDue: sourceSheets.cpDue ? buildHeaderIndexMap_(getHeaders_(sourceSheets.cpDue, HEADER_ROW)) : {},
        unlockCP: sourceSheets.unlockCP ? buildHeaderIndexMap_(getHeaders_(sourceSheets.unlockCP, HEADER_ROW)) : {}
      };

      const targetHeaders = getHeadersForSheetType_(dashboard, sysName);
      if (!targetHeaders || targetHeaders.length === 0) throw new Error("Dashboard Section H is missing headers for Master List.");

      markFrameworkStep_(timing, "Merging Data", "Synthesizing Master List...");
      const mergedRows = mergeMasterListData_(data, maps, targetHeaders);

      if (mergedRows.length === 0) {
        throw new Error("Master List generation resulted in 0 rows.");
      }

      markFrameworkStep_(timing, "Instantiating Sheet", "Writing Master List grid...");
      const finalSheet = createGovernedSheet_(sysName, monthParts, {
        dataRows: mergedRows,
        headers: targetHeaders,
        overwrite: true,
        timing: timing
      });

      markFrameworkStep_(timing, "Process Complete", "Master List created successfully.");
      return { success: true, count: mergedRows.length, sheetName: finalSheet.getName() };

    } finally {
      lock.releaseLock();
    }
  });
}

function mergeMasterListData_(data, maps, targetHeaders) {
  const recordMap = new Map();
  const refinedPmrIdx = getPMRIndex_(maps.refined);

  if (refinedPmrIdx < 0) throw new Error("Could not find PMR column in Refined Data.");

  const lookupMaps = {
    cpDue: buildLookupMap_(data.cpDue, findHeaderIndex_(maps.cpDue, ["Participant Name", "Name"])),
    unlockCP: buildLookupMap_(data.unlockCP, getPMRIndex_(maps.unlockCP))
  };

  const nameIdx = findHeaderIndex_(maps.refined, ["Participant Name", "Name"]);

  data.refined.forEach(row => {
    const pmr = String(row[refinedPmrIdx] || "").trim();
    const name = nameIdx >= 0 ? String(row[nameIdx] || "").trim() : "";
    if (!pmr && !name) return;

    const unlockMatch = lookupMaps.unlockCP.get(pmr) || [];
    const cpDueMatch = (pmr && lookupMaps.cpDue.has(pmr)) ? lookupMaps.cpDue.get(pmr) : lookupMaps.cpDue.get(name) || [];

    const mergedRow = targetHeaders.map(header => {
      let val = getMappedValue_(header, row, maps.refined);
      if (val !== "") return val;

      val = getMappedValue_(header, cpDueMatch, maps.cpDue);
      if (val !== "") return val;

      val = getMappedValue_(header, unlockMatch, maps.unlockCP);
      return val;
    });

    recordMap.set(pmr || name, mergedRow);
  });

  return Array.from(recordMap.values());
}

function getMappedValue_(targetHeader, sourceRow, sourceMap) {
  if (!sourceRow || sourceRow.length === 0) return "";
  const idx = findHeaderIndex_(sourceMap, [targetHeader]);
  return (idx >= 0 && idx < sourceRow.length) ? sourceRow[idx] : "";
}

// ============================================================================
// 2.6. MONTHLY CHANGE DELTA ENGINE
// ============================================================================

function buildMonthlyChangeReport() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Change Report");
  if (!monthParts) return null;
  return buildMonthlyChangeReportForMonth_(monthParts);
}

function buildMonthlyChangeReportForMonth_(monthParts) {
  return runFrameworkTimed_("Monthly Change " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Monthly Change process is locked.");
    try {
      const dashboard = loadDashboardConfig_();
      const previousDate = new Date(monthParts.reportDate);
      previousDate.setMonth(previousDate.getMonth() - 1);
      const previousLabel = Utilities.formatDate(previousDate, Session.getScriptTimeZone(), "MM.yy");
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const currentSheet = ss.getSheetByName("Raw Data " + monthParts.label) || ss.getSheetByName(SYSTEM_SHEETS.SOURCE_PREFIX + "Raw Data " + monthParts.label);
      const previousSheet = ss.getSheetByName("Raw Data " + previousLabel) || ss.getSheetByName(SYSTEM_SHEETS.SOURCE_PREFIX + "Raw Data " + previousLabel);
      if (!currentSheet || !previousSheet) throw new Error("Monthly Change requires current and previous Raw Data sheets: " + monthParts.label + " and " + previousLabel + ".");
      const currentRead = getDataValues_(currentSheet, HEADER_ROW, DATA_START_ROW);
      const previousRead = getDataValues_(previousSheet, HEADER_ROW, DATA_START_ROW);
      const currentData = { values: filterBlankRows_(currentRead.values), map: currentRead.headerMap, headers: currentRead.headers };
      const previousData = { values: filterBlankRows_(previousRead.values), map: previousRead.headerMap, headers: previousRead.headers };
      markFrameworkStep_(timing, "Read Raw Data comparison sources", currentSheet.getName() + " vs " + previousSheet.getName());
      const blocks = getSubheadersFromDashboardConfig_("Monthly Change", dashboard);
      const mcHeaders = getHeadersForSheetType_(dashboard, "Monthly Change");
      if (!mcHeaders.length) throw new Error("Format Dashboard Section H contains no headers for Monthly Change.");
      const changeResults = computeMonthlyChange_(currentData, previousData, blocks, monthParts, mcHeaders);
      const changeSheet = createGovernedSheet_("Monthly Change", monthParts, { overwrite: true, timing: timing });
      applyMonthlyChangeSectionHHeaders_(changeSheet, blocks, mcHeaders);
      blocks.forEach(function(block) {
        const rows = changeResults[block.title] || [];
        if (rows.length) appendMonthlyChangeRowsWithHighlights_(changeSheet, block, rows, mcHeaders);
      });
      markFrameworkStep_(timing, "Monthly Change complete", "Compared Raw Data; output " + changeSheet.getName());
      return { success: true, sheetName: changeSheet.getName() };
    } finally { lock.releaseLock(); }
  });
}

/**
 * Writes the complete governed Section H header list into every Monthly Change
 * subheader block. This also repairs reports copied from an older template.
 * setValues changes content only and intentionally preserves native banding.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sheet Monthly Change output sheet.
 * @param {object[]} blocks Monthly Change subheader definitions.
 * @param {string[]} headers Ordered Section H Monthly Change headers.
 */
function applyMonthlyChangeSectionHHeaders_(sheet, blocks, headers) {
  if (!sheet || !headers || !headers.length) {
    throw new Error("Monthly Change subheader repair requires the complete Section H header list.");
  }
  (blocks || []).forEach(function(block) {
    const bounds = getSubheaderSectionBounds_(sheet, block.title);
    if (!bounds) throw new Error('Monthly Change template subheader section "' + block.title + '" is missing.');
    if (sheet.getMaxColumns() < headers.length) {
      sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length - sheet.getMaxColumns());
    }
    const headerRow = bounds.titleRow + 2;
    const rowValues = new Array(sheet.getMaxColumns()).fill("");
    for (let index = 0; index < headers.length; index++) rowValues[index] = headers[index];
    sheet.getRange(headerRow, 1, 1, rowValues.length).setValues([rowValues]);
  });
}

function computeMonthlyChange_(current, prev, subheaderBlocks, monthParts, targetHeaders) {
  const currentPmrIdx = getPMRIndex_(current.map);
  const prevPmrIdx = getPMRIndex_(prev.map);
  if (currentPmrIdx < 0 || prevPmrIdx < 0) throw new Error("Raw Data comparison is missing a PMR column.");

  const currentGroups = groupMonthlyChangeRowsByPMR_(current.values, currentPmrIdx);
  const previousGroups = groupMonthlyChangeRowsByPMR_(prev.values, prevPmrIdx);
  const results = {};
  subheaderBlocks.forEach(function(block) { results[block.title] = []; });
  const titleMap = {};
  subheaderBlocks.forEach(function(block) {
    const title = String(block.title || "").toUpperCase();
    if (title.indexOf("ENROLLMENTS") !== -1 && title.indexOf("DISENROLLMENTS") === -1) titleMap.enroll = block;
    else if (title.indexOf("DISENROLLMENTS") !== -1) titleMap.disenroll = block;
    else if (title.indexOf("DEMOGRAPHIC") !== -1) titleMap.demographic = block;
    else if (title.indexOf("CASELOAD") !== -1) titleMap.caseload = block;
    else if (title.indexOf("CONTACT") !== -1) titleMap.contact = block;
    else if (title.indexOf("BANNER SUMMARY") !== -1) titleMap.banner = block;
    else if (title.indexOf("OTHER") !== -1) titleMap.other = block;
    else if (title.indexOf("LEVEL OF CARE") !== -1) titleMap.levelOfCare = block;
  });

  const fields = {
    demographic: ["Participant Name", "Name", "Preferred Name", "Date of Birth", "Last Name", "First Name", "Phone Number", "Address Line 1", "Address Line 2", "City", "State", "Zip", "Oxygen", "Primary Language", "Residence Type", "Additional Important Information"],
    caseload: ["Caseload - Social Work", "Caseload - RN", "Caseload - PCP", "Caseload - HCC", "Caseload - Activities", "Caseload - OT", "Caseload - PT", "Caseload - RD", "Caseload - Supervising MD"],
    contact: ["Contact - Last Name", "Contact - First Name", "Type of Contact", "Contact - Primary Language", "Relationship", "AD1 - Phone", "AD1 - Phone Valid Dates From", "AD1 - Phone Valid Dates To", "AD2 - Phone", "AD2 - Phone Valid Dates From", "AD2 - Phone Valid Dates To", "AD3 - Phone", "AD3 - Phone Valid Dates From", "AD3 - Phone Valid Dates To", "Company", "Contact - Notes"],
    banner: ["Banner Summary", "Safety - 2 Person", "Wanderer", "Interpreter Needed", "Fall Risk", "DPOA or Guardian Active", "Palliative Care"]
  };
  const excluded = new Set(["", "Primary PMR Row", "Sort Order", "Update Status", "Update Month", "Source Sheet", "Columns Updated", "Last Updated At", "Source Hash", "Previous Source Hash", "Source Workflow", "Refined Data Update Status", "Refined Data Update Month", "Refined Data Source Sheet"]);
  const known = new Set([].concat(fields.demographic, fields.caseload, fields.contact, fields.banner, ["Capitation Date", "Enrollment Status", "Disenrollment Date", "Disenrollment Effective Date", "Disenrollment Reason", "Date of Death"]));
  fields.other = current.headers.filter(function(header) { return header && !known.has(header) && !excluded.has(header); });

  currentGroups.forEach(function(currentRows, pmr) {
    const previousRows = previousGroups.get(pmr) || [];
    const capitationIndex = findHeaderIndex_(current.map, ["Capitation Date", "Enrollment Date"]);
    const disenrollmentIndex = findHeaderIndex_(current.map, ["Disenrollment Effective Date", "Disenrollment Date"]);
    const enrollment = capitationIndex >= 0 && currentRows.some(function(row) { return isSameReportDate_(row[capitationIndex], monthParts.firstDay); });
    const disenrollment = disenrollmentIndex >= 0 && currentRows.some(function(row) { return isSameReportDate_(row[disenrollmentIndex], monthParts.firstDay); });

    if (enrollment && titleMap.enroll) appendMonthlyChangeGroup_(results, titleMap.enroll, getPrimaryMonthlyChangeRows_(currentRows, current.map), current.headers, targetHeaders, new Set());
    if (disenrollment && titleMap.disenroll) {
      const qualifying = currentRows.filter(function(row) { return isSameReportDate_(row[disenrollmentIndex], monthParts.firstDay); });
      appendMonthlyChangeGroup_(results, titleMap.disenroll, getPrimaryMonthlyChangeRows_(qualifying, current.map), current.headers, targetHeaders, new Set());
    }
    if (enrollment || disenrollment) return;

    ["demographic", "caseload", "contact", "banner", "other"].forEach(function(category) {
      const block = titleMap[category];
      if (!block) return;
      const changedHeaders = getChangedHeadersAcrossAllRows_(currentRows, previousRows, current.map, prev.map, fields[category]);
      if (changedHeaders.size) {
        const reportRows = category === "contact" ? currentRows : getPrimaryMonthlyChangeRows_(currentRows, current.map);
        appendMonthlyChangeGroup_(results, block, reportRows, current.headers, targetHeaders, changedHeaders);
      }
    });

    if (titleMap.levelOfCare) {
      const changed = getChangedHeadersAcrossAllRows_(currentRows, previousRows, current.map, prev.map, ["Residence Type"]);
      if (changed.size) appendMonthlyChangeGroup_(results, titleMap.levelOfCare, getPrimaryMonthlyChangeRows_(currentRows, current.map), current.headers, targetHeaders, changed);
    }
  });
  return results;
}

function getPrimaryMonthlyChangeRows_(rows, headerMap) {
  const primaryIndex = findHeaderIndex_(headerMap, ["Primary PMR Row"]);
  if (primaryIndex < 0) throw new Error("Monthly Change requires the Primary PMR Row header.");
  const primary = (rows || []).find(function(row) { return isPrimaryPMRRowValue_(row[primaryIndex]); });
  return primary ? [primary] : ((rows || []).length ? [rows[0]] : []);
}

function groupMonthlyChangeRowsByPMR_(rows, pmrIndex) {
  const groups = new Map();
  (rows || []).forEach(function(row) {
    const pmr = String(row[pmrIndex] || "").trim().toUpperCase();
    if (!pmr) return;
    if (!groups.has(pmr)) groups.set(pmr, []);
    groups.get(pmr).push(row);
  });
  return groups;
}

function isSameReportDate_(value, expected) {
  const actualDate = value instanceof Date ? value : new Date(value);
  const expectedDate = expected instanceof Date ? expected : new Date(expected);
  return !isNaN(actualDate.getTime()) && !isNaN(expectedDate.getTime()) &&
    actualDate.getFullYear() === expectedDate.getFullYear() && actualDate.getMonth() === expectedDate.getMonth() && actualDate.getDate() === expectedDate.getDate();
}

function getChangedHeadersAcrossAllRows_(currentRows, previousRows, currentMap, previousMap, headers) {
  const changed = new Set();
  (headers || []).forEach(function(header) {
    const currentIndex = findHeaderIndex_(currentMap, [header]);
    const previousIndex = findHeaderIndex_(previousMap, [header]);
    const currentValues = currentIndex < 0 ? [] : currentRows.map(function(row) { return normalizeMonthlyChangeValue_(row[currentIndex]); }).sort();
    const previousValues = previousIndex < 0 ? [] : previousRows.map(function(row) { return normalizeMonthlyChangeValue_(row[previousIndex]); }).sort();
    if (JSON.stringify(currentValues) !== JSON.stringify(previousValues)) changed.add(header);
  });
  return changed;
}

function normalizeMonthlyChangeValue_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return Utilities.formatDate(value, Session.getScriptTimeZone(), "yyyy-MM-dd");
  return String(value == null ? "" : value).trim();
}

function appendMonthlyChangeGroup_(results, block, rows, sourceHeaders, targetHeaders, changedHeaders) {
  const mapped = mapRowsToHeaders_(rows, sourceHeaders, targetHeaders);
  mapped.forEach(function(row) { results[block.title].push({ values: row, changedHeaders: changedHeaders }); });
}

function appendMonthlyChangeRowsWithHighlights_(sheet, block, rowInfos, targetHeaders) {
  if (!rowInfos || !rowInfos.length) return null;
  const rows = rowInfos.map(function(info) { return info.values; });
  const appended = appendDataToSubheaderSection_(sheet, block.title, rows, targetHeaders);
  if (!appended) return null;
  const blockHeaders = block.headers || [];
  const highlightCells = [];
  rowInfos.forEach(function(info, rowOffset) {
    (info.changedHeaders || new Set()).forEach(function(header) {
      const columnIndex = blockHeaders.indexOf(header);
      if (columnIndex >= 0) {
        highlightCells.push(sheet.getRange(appended.startRow + rowOffset, columnIndex + 1).getA1Notation());
      }
    });
  });
  // Highlight only changed cells. Rewriting the full background matrix would
  // replace the native alternating-band colors on every unchanged data cell.
  if (highlightCells.length) sheet.getRangeList(highlightCells).setBackground("#f3ffc7");
  return appended;
}
