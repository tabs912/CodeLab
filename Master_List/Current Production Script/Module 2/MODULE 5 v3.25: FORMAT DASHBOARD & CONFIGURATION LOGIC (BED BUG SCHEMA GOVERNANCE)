function getFallbackDashboardConfig_() {
  const config = {
    globals: {}, baseTemplateGlobals: {}, creationRules: {}, titleRows: [], subheaderRows: [],
    sheetDefinitions: [], outputGovernance: {}, columnDefinitions: {}, sheetHeaders: {}
  };

  function mapFallbackRows(matrix) {
    if (!matrix || matrix.length < 2) return [];
    const headers = [];
    for (let i = 0; i < matrix[0].length; i++) {
      headers.push(String(matrix[0][i] || "").trim().toLowerCase());
    }
    const rows = [];
    for (let i = 1; i < matrix.length; i++) {
      const obj = {};
      for (let cIdx = 0; cIdx < headers.length; cIdx++) {
        obj[headers[cIdx]] = matrix[i][cIdx];
      }
      rows.push(obj);
    }
    return rows;
  }

  const fallbackSections = {};
  FORMAT_DASHBOARD_SECTION_REGISTRY.forEach(function(section) {
    fallbackSections[section.key] = mapFallbackRows(getFormatDashboardDefaultSection_(section.key));
  });

  fallbackSections.sectionA_Globals.forEach(function(row) {
    const key = String(row["setting"] || "").trim();
    if (!key) return;
    config.globals[key] = row["value"];
    if (String(row["base template"] || "").trim().toUpperCase() === "TRUE") {
      config.baseTemplateGlobals[key] = row["value"];
    }
  });

  fallbackSections.sectionB_Creation.forEach(function(row) {
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      const templateRank = Number(row["template tab rank"]);
      const rawActiveRank = String(row["active tab rank"] == null ? "" : row["active tab rank"]).trim();
      const isDynamicRank = rawActiveRank.toUpperCase() === "DYNAMIC RANKING";
      config.creationRules[sysName] = {
        systemSheetName: sysName,
        namingPattern: String(row["output naming pattern"] || "").trim(),
        templateRank: templateRank,
        activeRank: isDynamicRank ? templateRank : Number(rawActiveRank),
        dynamicRankRule: isDynamicRank ? { baseRank: templateRank, monthStride: 22, zeroOffsetMonth: 12 } : null,
        group: String(row["group"] || "").trim(),
        visibility: String(row["visibility"] || "").trim().toUpperCase(),
        collisionPolicy: String(row["collision policy"] || "").trim().toUpperCase(),
        trimmingPolicy: String(row["data row trimming"] || "").trim().toUpperCase(),
        indexRegistration: row["index reg."] !== false && String(row["index reg."]).toUpperCase() !== "FALSE",
        special: String(row["notes"] || row["special"] || "").trim()
      };
    }
  });

  fallbackSections.sectionC_Structural.forEach(function(row) {
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.sheetDefinitions.push({
        systemSheetName: sysName,
        templateName: "Template - " + sysName,
        group: "Template",
        reportTitle: String(row["report title"] || "").trim(),
        titleDateFormat: String(row["title date format"] || "").trim(),
        baseColor: String(row["base color"] || "").trim(),
        columnCount: Number(row["column count"]),
        columnWidths: String(row["default column widths"] || "").trim(),
        usesAlternatingColors: String(row["uses alternating colors"]).toLowerCase() !== "false",
        usesSubheaders: String(row["uses subheaders"]).toLowerCase() === "true"
      });
    }
  });

  fallbackSections.sectionD_OutputGov.forEach(function(row) {
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.outputGovernance[sysName] = {
        namingPattern: String(row["output naming pattern"] || "").trim(),
        group: String(row["group"] || "").trim(),
        endDateSource: String(row["end date source"] || "").trim(),
        rowHeightEnforcement: String(row["row height enforcement"] || "").trim().toUpperCase() === "TRUE"
      };
    }
  });

  fallbackSections.sectionE_TitleRows.forEach(function(row) {
    config.titleRows.push({
      sheetType: String(row["sheet type"] || "").trim(),
      row: Number(row["row"]),
      purpose: String(row["purpose"] || "").trim(),
      height: Number(row["height"]),
      fillLevel: String(row["fill level"] || "").trim(),
      fontSize: String(row["font size"] || "").trim(),
      fontWeight: String(row["font weight"] || "").trim(),
      alignment: String(row["alignment"] || "").trim(),
      wrap: String(row["wrap"] || "").trim()
    });
  });

  fallbackSections.sectionF_Subheaders.forEach(function(row) {
    config.subheaderRows.push({
      sheetType: String(row["sheet type"] || "").trim(),
      row: Number(row["row"]),
      purpose: String(row["purpose"] || "").trim(),
      height: Number(row["height"]),
      fillLevel: String(row["fill level"] || "").trim(),
      fontSize: String(row["font size"] || "").trim(),
      fontWeight: String(row["font weight"] || "").trim(),
      alignment: String(row["alignment"] || "").trim(),
      wrap: String(row["wrap"] || "").trim()
    });
  });

  fallbackSections.sectionG_Columns.forEach(function(row) {
    const header = String(row["header"] || "").trim();
    if (header) {
      const colData = {
        width: Number(row["width"]),
        fontSize: Number(row["header font size"]),
        dateColumn: String(row["date column"]).toLowerCase() === "true",
        hideColumn: String(row["hide column"]).toLowerCase() === "true",
        wrap: String(row["data wrap"] || "").trim().toUpperCase(),
        align: String(row["horizontal alignment"] || "").trim().toLowerCase(),
        vAlign: String(row["vertical alignment"] || "").trim().toLowerCase(),
        format: String(row["number format"] || "").trim()
      };
      config.columnDefinitions[header] = colData;
      config.columnDefinitions[header.toLowerCase()] = colData;
    }
  });

  fallbackSections.sectionH_Headers.forEach(function(row) {
    const sheetType = String(row["sheet type"] || "").trim();
    const columnOrder = Number(row["column order"]);
    const header = String(row["header"] || "").trim();
    if (sheetType && columnOrder > 0) {
      if (!config.sheetHeaders[sheetType]) config.sheetHeaders[sheetType] = [];
      config.sheetHeaders[sheetType][columnOrder - 1] = header;
    }
  });

  return config;
}

function loadDashboardConfig_(isSystemSetup, dashboardSheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = dashboardSheet || ss.getSheetByName("Format Dashboard") || ss.getSheetByName("Default - Format Dashboard");

  if (!sheet) {
    if (isSystemSetup) return getFallbackDashboardConfig_();
    throw new Error("Format Dashboard is missing or unconfigured. Run Setup / Refresh Dashboard first.");
  }

  const values = sheet.getDataRange().getValues();
  const fallbackConfig = getFallbackDashboardConfig_();

  const config = {
    globals: Object.assign({}, fallbackConfig.globals),
    baseTemplateGlobals: Object.assign({}, fallbackConfig.baseTemplateGlobals),
    creationRules: {}, titleRows: [], subheaderRows: [],
    sheetDefinitions: [], outputGovernance: {}, columnDefinitions: {}, sheetHeaders: {}
  };

  const dashIndex = buildDashboardSectionIndex_(sheet);

  function parseSectionRows_(secKey) {
    let matchedKey = null;
    const keys = Object.keys(dashIndex);
    for (let i = 0; i < keys.length; i++) {
      if (keys[i].toLowerCase().indexOf(secKey.toLowerCase()) !== -1) {
        matchedKey = keys[i];
        break;
      }
    }
    if (!matchedKey) return [];

    const secInfo = dashIndex[matchedKey];
    let hdrRow = secInfo.startRow - 1;
    while (hdrRow <= secInfo.endRow) {
      if (values[hdrRow]) {
        let hasValue = false;
        for (let x = 0; x < values[hdrRow].length; x++) {
          if (String(values[hdrRow][x] || "").trim() !== "") {
            hasValue = true; break;
          }
        }
        if (hasValue) {
          const rowStr = values[hdrRow].join(" ").toLowerCase();
          if (rowStr.indexOf("sheet type") !== -1 || rowStr.indexOf("setting") !== -1 || rowStr.indexOf("header") !== -1 || rowStr.indexOf("system sheet name") !== -1) break;
        }
      }
      hdrRow++;
    }
    if (hdrRow > secInfo.endRow) return [];

    const headers = [];
    const colMap = {};
    for (let i = 0; i < values[hdrRow].length; i++) {
      const h = String(values[hdrRow][i] || "").trim().toLowerCase();
      headers.push(h);
      if (h) colMap[h] = i;
    }

    const rows = [];
    for (let r = hdrRow + 1; r <= secInfo.endRow; r++) {
      const rowVal = values[r];
      if (!rowVal) continue;

      let rowHasData = false;
      for (let x = 0; x < rowVal.length; x++) {
        if (String(rowVal[x] || "").trim() !== "") {
          rowHasData = true; break;
        }
      }
      if (!rowHasData) continue;

      const firstCell = String(rowVal[0] || "").trim();
      if (firstCell.indexOf("SECTION ") === 0) break;

      const obj = {};
      const colMapKeys = Object.keys(colMap);
      for (let k = 0; k < colMapKeys.length; k++) {
        const key = colMapKeys[k];
        const cIdx = colMap[key];
        obj[key] = (cIdx < rowVal.length) ? rowVal[cIdx] : "";
      }
      rows.push(obj);
    }
    return rows;
  }

  const aParsed = parseSectionRows_("SECTION A - GLOBAL SETTINGS");
  for (let i = 0; i < aParsed.length; i++) {
    const row = aParsed[i];
    const key = String(row["setting"] || "").trim();
    if (!key) continue;
    config.globals[key] = row["value"];
    if (Object.prototype.hasOwnProperty.call(row, "base template")) {
      if (String(row["base template"] || "").trim().toUpperCase() === "TRUE") {
        config.baseTemplateGlobals[key] = row["value"];
      } else {
        delete config.baseTemplateGlobals[key];
      }
    }
  }

  const bParsed = parseSectionRows_("SECTION B - SHEET CREATION & LIFECYCLE GOVERNANCE");
  for (let i = 0; i < bParsed.length; i++) {
    const row = bParsed[i];
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      const tRank = Number(row["template tab rank"]) || 800;
      const rawActive = String(row["active tab rank"] == null ? "" : row["active tab rank"]).trim();
      const isDynamicRank = rawActive.toUpperCase() === "DYNAMIC RANKING";
      const aRank = (rawActive === "" || isDynamicRank || isNaN(Number(rawActive))) ? tRank : Number(rawActive);

      config.creationRules[sysName] = {
        systemSheetName: sysName,
        namingPattern: String(row["output naming pattern"] || sysName).trim(),
        templateRank: tRank,
        activeRank: aRank,
        dynamicRankRule: isDynamicRank ? { baseRank: tRank, monthStride: 22, zeroOffsetMonth: 12 } : null,
        group: String(row["group"] || "Other").trim(),
        visibility: String(row["visibility"] || "VISIBLE").trim().toUpperCase(),
        collisionPolicy: String(row["collision policy"] || "OVERWRITE").trim().toUpperCase(),
        trimmingPolicy: String(row["data row trimming"] || "TRIM_TO_DATA").trim().toUpperCase(),
        indexRegistration: row["index reg."] !== false && String(row["index reg."]).toUpperCase() !== "FALSE",
        special: String(row["notes"] || row["special"] || "").trim()
      };
    }
  }

  const cParsed = parseSectionRows_("SECTION C - TEMPLATE STRUCTURAL SPECS");
  for (let i = 0; i < cParsed.length; i++) {
    const row = cParsed[i];
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.sheetDefinitions.push({
        systemSheetName: sysName,
        templateName: "Template - " + sysName,
        group: String(row["group"] || "Template").trim(),
        reportTitle: String(row["report title"] || sysName).trim(),
        titleDateFormat: String(row["title date format"] || "").trim(),
        baseColor: String(row["base color"] || "#79B5D2").trim(),
        columnCount: Number(row["column count"]) || 10,
        columnWidths: String(row["default column widths"] || "105").trim(),
        usesAlternatingColors: String(row["uses alternating colors"]).toLowerCase() !== "false",
        usesSubheaders: String(row["uses subheaders"]).toLowerCase() === "true"
      });
    }
  }

  const dParsed = parseSectionRows_("SECTION D - ACTIVE OUTPUT GOVERNANCE");
  for (let i = 0; i < dParsed.length; i++) {
    const row = dParsed[i];
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.outputGovernance[sysName] = {
        namingPattern: String(row["output naming pattern"] || sysName).trim(),
        group: String(row["group"] || "Other").trim(),
        endDateSource: String(row["end date source"] || "").trim(),
        rowHeightEnforcement: String(row["row height enforcement"] || "TRUE").trim().toUpperCase() !== "FALSE"
      };
    }
  }

  const eParsed = parseSectionRows_("SECTION E - TITLE ROWS");
  for (let i = 0; i < eParsed.length; i++) {
    const row = eParsed[i];
    config.titleRows.push({
      sheetType: String(row["sheet type"] || "GLOBAL").trim(),
      row: Number(row["row"]) || 1,
      purpose: String(row["purpose"] || "").trim(),
      height: Number(row["height"]),
      fillLevel: String(row["fill level"] || "").trim(),
      fontSize: String(row["font size"] || "").trim(),
      fontWeight: String(row["font weight"] || "").trim(),
      alignment: String(row["alignment"] || "").trim(),
      wrap: String(row["wrap"] || "").trim()
    });
  }

  const fParsed = parseSectionRows_("SECTION F - SUBHEADER ROWS");
  for (let i = 0; i < fParsed.length; i++) {
    const row = fParsed[i];
    config.subheaderRows.push({
      sheetType: String(row["sheet type"] || "GLOBAL").trim(),
      row: Number(row["row"]) || 1,
      purpose: String(row["purpose"] || "").trim(),
      height: Number(row["height"]),
      fillLevel: String(row["fill level"] || "").trim(),
      fontSize: String(row["font size"] || "").trim(),
      fontWeight: String(row["font weight"] || "").trim(),
      alignment: String(row["alignment"] || "").trim(),
      wrap: String(row["wrap"] || "").trim()
    });
  }

  const gParsed = parseSectionRows_("SECTION G - COLUMN DEFINITIONS");
  for (let i = 0; i < gParsed.length; i++) {
    const row = gParsed[i];
    const header = String(row["header"] || "").trim();
    if (header) {
      const colData = {
        width: Number(row["width"]) || 105,
        fontSize: Number(row["header font size"]) || 10,
        dateColumn: String(row["date column"]).toLowerCase() === "true",
        hideColumn: String(row["hide column"]).toLowerCase() === "true",
        wrap: String(row["data wrap"] || "CLIP").trim().toUpperCase(),
        align: String(row["horizontal alignment"] || "left").trim().toLowerCase(),
        vAlign: String(row["vertical alignment"] || "middle").trim().toLowerCase(),
        format: String(row["number format"] || "").trim()
      };
      config.columnDefinitions[header] = colData;
      config.columnDefinitions[header.toLowerCase()] = colData;
    }
  }

  const hParsed1 = parseSectionRows_("SECTION H - SHEET HEADERS");
  const hParsed = hParsed1 && hParsed1.length > 0 ? hParsed1 : parseSectionRows_("SECTION G - SHEET HEADERS");
  for (let i = 0; i < hParsed.length; i++) {
    const row = hParsed[i];
    const sheetType = String(row["sheet type"] || "").trim();
    const columnOrder = Number(row["column order"]);
    const header = String(row["header"] || "").trim();
    if (sheetType && columnOrder > 0) {
      if (!config.sheetHeaders[sheetType]) config.sheetHeaders[sheetType] = [];
      config.sheetHeaders[sheetType][columnOrder - 1] = header;
    }
  }

  return config;
}

function buildDashboardSectionIndex_(dashboardSheet) {
  const values = dashboardSheet.getDataRange().getValues();
  const index = {};
  let currentSection = null;
  for (let r = 0; r < values.length; r++) {
    const val = String(values[r][0] || "").trim();
    if (val.indexOf("SECTION ") === 0) {
      if (currentSection) index[currentSection].endRow = r - 1;
      currentSection = val;
      index[currentSection] = { startRow: r + 2, endRow: values.length - 1 };
    }
  }
  if (currentSection) index[currentSection].endRow = values.length - 1;
  return index;
}

function getHeadersForSheetType_(dashboardConfig, sheetType) {
  if (dashboardConfig && dashboardConfig.sheetHeaders) {
    if (dashboardConfig.sheetHeaders[sheetType] && dashboardConfig.sheetHeaders[sheetType].length) {
      return dashboardConfig.sheetHeaders[sheetType];
    }
    const keys = Object.keys(dashboardConfig.sheetHeaders);
    for (let i = 0; i < keys.length; i++) {
      if (keys[i].toLowerCase() === String(sheetType).toLowerCase()) {
        if (dashboardConfig.sheetHeaders[keys[i]].length) {
          return dashboardConfig.sheetHeaders[keys[i]];
        }
      }
    }
  }
  return [];
}

function getTemplateConfigFromDashboard_(systemSheetName, dashboardSheet) {
  const dashboard = loadDashboardConfig_(true, dashboardSheet);
  const key = String(systemSheetName || "").trim().toLowerCase();

  let sheetDef = {};
  for (let i = 0; i < (dashboard.sheetDefinitions || []).length; i++) {
    if (String(dashboard.sheetDefinitions[i].systemSheetName || "").trim().toLowerCase() === key) {
      sheetDef = dashboard.sheetDefinitions[i];
      break;
    }
  }

  const creationRule = (dashboard.creationRules && dashboard.creationRules[systemSheetName]) || {};
  const headers = getHeadersForSheetType_(dashboard, systemSheetName);
  const templateName = sheetDef.templateName || "Template - " + systemSheetName;
  const templateCreationRule = (dashboard.creationRules && dashboard.creationRules[templateName]) || creationRule;

  return {
    dashboard: dashboard,
    globals: dashboard.globals,
    baseTemplateGlobals: dashboard.baseTemplateGlobals,
    systemSheetName: systemSheetName,
    templateName: templateName,
    reportTitle: sheetDef.reportTitle || systemSheetName,
    titleDateFormat: sheetDef.titleDateFormat || "",
    sheetType: sheetDef.usesSubheaders ? "SYSTEM" : "DATA",
    headers: headers,
    columnCount: Math.max(Number(sheetDef.columnCount) || 0, headers.length, 1),
    minimumRows: Number(sheetDef.minimumRows) || 100,
    rank: Number(templateCreationRule.templateRank) || 800,
    columnWidths: sheetDef.columnWidths,
    usesSubheaders: sheetDef.usesSubheaders === true,
    usesAlternatingColors: sheetDef.usesAlternatingColors !== false,
    titleRows: getDashboardRowFormattingSpecs_(dashboard.titleRows, systemSheetName),
    subheaderRowSpecs: getDashboardRowFormattingSpecs_(dashboard.subheaderRows, systemSheetName),
    subheaders: getSubheadersFromDashboardConfig_(systemSheetName, dashboard),
    theme: getTemplateTheme_(systemSheetName, dashboardSheet)
  };
}

function getDashboardRowFormattingSpecs_(rows, systemSheetName) {
  const target = String(systemSheetName || "").trim().toLowerCase();
  const results = [];
  for (let i = 0; i < (rows || []).length; i++) {
    const item = rows[i];
    const sheetType = String(item && item.sheetType || "GLOBAL").trim().toLowerCase();
    if (sheetType === "global" || sheetType === target) {
      results.push(item);
    }
  }
  return results;
}

function getSubheadersFromDashboardConfig_(systemSheetName, dashboardConfig) {
  const nameLower = String(systemSheetName || "").toLowerCase();

  if (nameLower === "format dashboard" || nameLower === "default - format dashboard") {
    return FORMAT_DASHBOARD_SECTION_REGISTRY.map(function(section) {
      return {
        title: section.title,
        headers: getFormatDashboardDefaultSection_(section.key)[0],
        stampLastUpdated: false
      };
    });
  }

  if (nameLower.indexOf("timing") !== -1) {
    return [
      { title: "SECTION A - PROCESS SUMMARY", headers: ["Process", "Runtime (Sec)", "Status", "Benchmark", "Variance", "Notes"], stampLastUpdated: true },
      { title: "SECTION B - PERFORMANCE ISSUES", headers: ["Priority", "Process", "Runtime (Sec)", "Threshold", "Issue", "Recommendation"], stampLastUpdated: false },
      { title: "SECTION C - OPTIMIZATION RECOMMENDATIONS", headers: ["Process", "Finding", "Impact", "Recommendation", "Priority", "Status"], stampLastUpdated: false },
      { title: "SECTION D - DETAILED TIMING LOG", headers: ["Timestamp", "Process", "Step", "Step Seconds", "Total Seconds", "Severity", "Details"], stampLastUpdated: false }
    ];
  }
  if (nameLower.indexOf("quality") !== -1) {
    return [
      { title: "SECTION A - FORMAT DASHBOARD VALIDATION", headers: ["Dashboard Section", "Status", "Issue", "Quality Notes"], stampLastUpdated: true },
      { title: "SECTION B - TEMPLATE VALIDATION", headers: ["Template / Sheet Name", "Status", "Issue", "Quality Notes"], stampLastUpdated: false },
      { title: "SECTION C - RAW DATA VALIDATION", headers: ["Validation Item", "Status", "Issue", "Quality Notes"], stampLastUpdated: false },
      { title: "SECTION D - REFINED DATA QUALITY VALIDATION", headers: ["Check Item", "Status", "Issue", "Quality Notes"], stampLastUpdated: false },
      { title: "SECTION E - DISENROLLED EXCLUSION VALIDATION", headers: ["Audit Item", "Status", "Issue", "Quality Notes"], stampLastUpdated: false },
      { title: "SECTION F - MONTHLY CHANGE VALIDATION", headers: ["Layout Item", "Status", "Issue", "Quality Notes"], stampLastUpdated: false },
      { title: "SECTION G - MASTER LIST VALIDATION", headers: ["Audit Item", "Status", "Issue", "Quality Notes"], stampLastUpdated: false },
      { title: "SECTION H - SUMMARY", headers: ["Metric / Action", "Result", "Notes", "Signoff Details"], stampLastUpdated: false }
    ];
  }
  if (nameLower.indexOf("change") !== -1) {
    const dashboard = dashboardConfig || (typeof loadDashboardConfig_ === "function" ? loadDashboardConfig_(true) : null);
    const governedHeaders = dashboard ? getHeadersForSheetType_(dashboard, "Monthly Change") : [];
    if (!governedHeaders.length) {
      throw new Error("Format Dashboard Section H contains no headers for Monthly Change.");
    }
    return [
      "SECTION A - ENROLLMENTS",
      "SECTION B - DISENROLLMENTS",
      "SECTION C - DEMOGRAPHIC CHANGES",
      "SECTION D - CASELOAD CHANGES",
      "SECTION E - CONTACT CHANGES",
      "SECTION F - BANNER SUMMARY CHANGES",
      "SECTION G - OTHER CHANGES",
      "SECTION H - LEVEL OF CARE"
    ].map(function(title) {
      return { title: title, headers: governedHeaders.slice(), stampLastUpdated: false };
    });
  }
  return [];
}

function getStandardSheetKey_(sysName) {
  const map = {
    "Banners": "Banners", "CP Due": "CP Due Date", "Unlock CP": "Unlock CP",
    "Raw Data": "Raw Data", "Refined Data": "Refined Data",
    "Disenrolled": "Disenrolled Exclusion", "Master List": "Master List",
    "Monthly Change": "Monthly Change"
  };
  return map[sysName] || sysName;
}

function normalizeDashboardTargetA1_(targetCell) {
  const target = String(targetCell || "").trim();
  if (!target) return "";
  return target.replace(/\s+/g, "").replace(/-+/g, ":");
}

function configReportTitleCheck_(sysName) {
  try {
    const dashboard = loadDashboardConfig_();
    for (let i = 0; i < dashboard.sheetDefinitions.length; i++) {
      if (dashboard.sheetDefinitions[i].systemSheetName === sysName) {
        return dashboard.sheetDefinitions[i].reportTitle;
      }
    }
  } catch(e) {}
  return sysName;
}

