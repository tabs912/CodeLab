/**
 * Builds Default - Format Dashboard from the governed base template, writes
 * the complete default data matrix, and formats that existing sheet through
 * the general template pipeline without copying or naming it a second time.
 */
function BuildDefaultFormatDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const recoveryConfig = getFallbackDashboardConfig_();
  const hslPercents = {
    l1: Number(recoveryConfig.globals["HSL Level 1 Lightness %"]),
    l2: Number(recoveryConfig.globals["HSL Level 2 Lightness %"]),
    l3: Number(recoveryConfig.globals["HSL Level 3 Lightness %"]),
    l4: Number(recoveryConfig.globals["HSL Level 4 Lightness %"]),
    l5: Number(recoveryConfig.globals["HSL Level 5 Lightness %"])
  };
  const fontColor = String(recoveryConfig.globals["Standard Font Color"] || "").trim();
  if (!fontColor) throw new Error("Format Dashboard recovery data is missing Standard Font Color.");

  // Section C is generated from each row's Base Color and the five HSL
  // percentages stored in Section A.
  const structuralDefaults = getFormatDashboardDefaultSection_("sectionC_Structural");
  const hydratedSectionC = [];
  for (let i = 1; i < structuralDefaults.length; i++) {
    const spec = structuralDefaults[i];
    const baseColor = String(spec[3] || "").trim();
    if (!isValidHex_(baseColor)) {
      throw new Error("Format Dashboard recovery data has an invalid Base Color for " + String(spec[0] || "unknown sheet") + ".");
    }
    const theme = calculateThemeLevels_(baseColor, hslPercents);
    hydratedSectionC.push([
      spec[0], spec[1], spec[2], baseColor,
      theme.level1, theme.level2, theme.level3, theme.level4, theme.level5,
      fontColor
    ].concat(spec.slice(10)));
  }

  const dashboardDefinition = (recoveryConfig.sheetDefinitions || []).find(function(definition) {
    return String(definition.systemSheetName || "").trim().toLowerCase() === "format dashboard";
  });
  const dashWidth = Number(dashboardDefinition && dashboardDefinition.columnCount);
  if (!dashWidth || dashWidth < 1) {
    throw new Error("Format Dashboard recovery data is missing a valid Column Count.");
  }

  const dashRows = [];
  const emptyDashboardRow = new Array(dashWidth).fill("");
  dashRows.push(["Format Dashboard"]);
  dashRows.push(["Date Created", Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "MM/dd/yyyy HH:mm:ss")]);
  // Rows 3-5 remain the governed title spacer, header row, and pre-section
  // buffer. The first six-row subheader block therefore begins on row 6.
  dashRows.push(emptyDashboardRow.slice());
  dashRows.push(emptyDashboardRow.slice());
  dashRows.push(emptyDashboardRow.slice());

  function appendDefaultDashboardSection_(rows, sectionName, headers, dataRows, width) {
    const emptyRow = new Array(width).fill("");
    rows.push(emptyRow.slice()); // Subheader step 1: blank row above title.

    const sectionRow = emptyRow.slice();
    sectionRow[0] = sectionName;
    rows.push(sectionRow); // Subheader step 2: section title.

    rows.push(emptyRow.slice()); // Subheader step 3: visual spacer.

    const headerRow = emptyRow.slice();
    for (let i = 0; i < headers.length; i++) headerRow[i] = headers[i];
    rows.push(headerRow); // Subheader step 4: governed headers.

    rows.push(emptyRow.slice()); // Subheader step 5: data buffer.

    // Data begins in subheader step 6. Unlike the previous writer, no four-row
    // tail is added; the next section's step-1 row supplies the sole separator.
    (dataRows || []).forEach(function(row) {
      const paddedRow = row.slice(0, width);
      while (paddedRow.length < width) paddedRow.push("");
      rows.push(paddedRow);
    });
  }

  FORMAT_DASHBOARD_SECTION_REGISTRY.forEach(function(section) {
    const matrix = getFormatDashboardDefaultSection_(section.key);
    const dataRows = section.key === "sectionC_Structural" ? hydratedSectionC : matrix.slice(1);
    appendDefaultDashboardSection_(dashRows, section.title, matrix[0], dataRows, dashWidth);
  });

  const paddedRows = dashRows.map(function(row) {
    const paddedRow = row.slice(0, dashWidth);
    while (paddedRow.length < dashWidth) paddedRow.push("");
    return paddedRow;
  });

  if (typeof createTemplateFromBase_ !== "function") {
    throw new Error("createTemplateFromBase_ is required to build Default - Format Dashboard.");
  }
  const defaultDashboard = createTemplateFromBase_("Default - Format Dashboard", "Format Dashboard");
  defaultDashboard.clearContents();
  if (typeof resizeSheetGrid_ === "function") {
    resizeSheetGrid_(defaultDashboard, paddedRows.length, dashWidth);
  }
  defaultDashboard.getRange(1, 1, paddedRows.length, dashWidth).setValues(paddedRows);

  // Resolve configuration from the new default dashboard itself. This avoids
  // an older or malformed active Format Dashboard overriding bootstrap data.
  const dashConfig = getTemplateConfigFromDashboard_("Format Dashboard", defaultDashboard);
  dashConfig.templateName = "Default - Format Dashboard";
  dashConfig.sheetType = "SYSTEM";
  const defaultDashboardRule = recoveryConfig.creationRules && recoveryConfig.creationRules["Template - Format Dashboard"];
  dashConfig.rank = Number(defaultDashboardRule && defaultDashboardRule.templateRank);
  if (!dashConfig.rank) throw new Error("Format Dashboard recovery data is missing the default dashboard template rank.");
  dashConfig.minimumRows = paddedRows.length;
  dashConfig.columnCount = dashWidth;
  dashConfig.existingTemplateSheet = defaultDashboard;
  dashConfig.formatExistingSections = true;

  if (typeof buildGeneralTemplate_ !== "function") {
    throw new Error("buildGeneralTemplate_ is required to format Default - Format Dashboard.");
  }
  const formattedDashboard = buildGeneralTemplate_(dashConfig);
  recalculateDashboardHexCodes_(formattedDashboard);
  formattedDashboard.hideSheet();
  return formattedDashboard;
}

function saveActiveLayoutAsRebuildDefault() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Format Dashboard");
  if (!sheet) throw new Error("Format Dashboard sheet is required before saving its rebuild default.");
  const range = sheet.getDataRange();
  const payload = {
    version: MASTER_LIST_MERGE_ML_VERSION,
    savedAt: new Date().toISOString(),
    values: range.getValues(),
    backgrounds: range.getBackgrounds()
  };
  const json = JSON.stringify(payload);
  const props = PropertiesService.getDocumentProperties();
  props.setProperty("RFF_FORMAT_DASHBOARD_DEFAULT_JSON", json);
  if (props.getProperty("RFF_FORMAT_DASHBOARD_DEFAULT_JSON") !== json) {
    throw new Error("Format Dashboard backup verification failed.");
  }
  notify_("Format Dashboard rebuild default saved.");
  return payload;
}

function restoreFormatDashboardFromDefault() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Format Dashboard");
  if (!sheet) throw new Error("Format Dashboard sheet was not found.");
  const raw = PropertiesService.getDocumentProperties().getProperty("RFF_FORMAT_DASHBOARD_DEFAULT_JSON");
  if (!raw) throw new Error("No saved Format Dashboard rebuild default is available.");
  const payload = JSON.parse(raw);
  if (!payload || !Array.isArray(payload.values) || !payload.values.length || !Array.isArray(payload.values[0]) || !payload.values[0].length) {
    throw new Error("Saved Format Dashboard rebuild default is invalid.");
  }
  const width = payload.values[0].length;
  let isRectangular = true;
  for (let i = 0; i < payload.values.length; i++) {
    if (!Array.isArray(payload.values[i]) || payload.values[i].length !== width) {
      isRectangular = false;
      break;
    }
  }
  if (!isRectangular) throw new Error("Saved dashboard values are not rectangular.");

  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(sheet, payload.values.length, width);
  sheet.clear();

  // Clear any stray native banding during restore
  const bandings = sheet.getBandings();
  if (bandings) bandings.forEach(b => b.remove());

  const target = sheet.getRange(1, 1, payload.values.length, width);
  target.setValues(payload.values);

  let validBackgrounds = true;
  if (Array.isArray(payload.backgrounds) && payload.backgrounds.length === payload.values.length) {
    for (let i = 0; i < payload.backgrounds.length; i++) {
      if (!Array.isArray(payload.backgrounds[i]) || payload.backgrounds[i].length !== width) {
        validBackgrounds = false;
        break;
      }
    }
  } else {
    validBackgrounds = false;
  }

  // Format Dashboard surfaces intentionally use explicit fills only; do not restore native banding.
  if (validBackgrounds) {
    target.setBackgrounds(payload.backgrounds);
  }

  recalculateDashboardHexCodes_(sheet);

  notify_("Format Dashboard restored from the saved rebuild default.");
  return sheet;
}

