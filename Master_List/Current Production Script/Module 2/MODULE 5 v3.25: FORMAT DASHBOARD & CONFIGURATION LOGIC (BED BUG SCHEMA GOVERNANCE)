function getFormatDashboardDefaultSection_(key) {
  const matrix = MASTER_FORMAT_DEFAULTS[key];
  if (!Array.isArray(matrix) || matrix.length < 1) {
    throw new Error("Format Dashboard default section is missing: " + key + ".");
  }
  return matrix;
