function archiveMonthlySheetsBySpecs_(parsedMonth, specs, timing) {
  const writeLock = LockService.getDocumentLock();
  if (!writeLock.tryLock(30000)) {
    throw new Error("Another write workflow is already running: archiveMonthlySheetsBySpecs.");
  }
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID");
    if (!archiveId) throw new Error("RFF_ARCHIVE_SPREADSHEET_ID is not configured.");

    const archiveSs = SpreadsheetApp.openById(archiveId);
    const result = { archived: [], skipped: [], failed: [] };
    if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archive workbook connection established for batch", "Archive ID: " + archiveId);

    specs.forEach(function(spec) {
      const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
      if (!sheets.length) {
        logBestEffortWarning_("No local sheet found for " + spec.label + " " + parsedMonth.monthLabel + " or prior");
        result.skipped.push(spec.label);
        return;
      }

      sheets.forEach(function(sheet) {
        const sheetName = sheet.getName();
        try {
          const archiveResult = copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing);
          result.archived.push(sheetName);
          if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archived monthly sheet: " + sheetName, archiveResult.localAction);
        } catch (err) {
          logBestEffortWarning_("Archive monthly sheet failed: " + sheetName + " - " + err.message);
          result.failed.push(sheetName + ": " + err.message);
        }
      });
    });

    pingArchiveIndexUpdate_();

    return result;

  } finally {
    writeLock.releaseLock();
  }
}

function pingArchiveIndexUpdate_() {
  try {
    const archiveWebAppUrl = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_WEB_APP_URL");
    if (archiveWebAppUrl) {
      UrlFetchApp.fetch(archiveWebAppUrl, { muteHttpExceptions: true });
    }
  } catch (err) {
    logBestEffortWarning_("Failed to ping Archive Index Web App: " + err.message);
  }
}

function findArchiveMonthlyCandidateSheetsUpToDate_(ss, keywords, cutoffDate) {
  const keywordList = (keywords || []).map(function(keyword) {
    return String(keyword || "").trim().toLowerCase();
  }).filter(Boolean);

  const matches = [];
  const seen = new Set();
  const cutoffKey = cutoffDate ? Number(Utilities.formatDate(cutoffDate, Session.getScriptTimeZone(), "yyyyMM")) : 0;

  ss.getSheets().forEach(function(sheet) {
    const name = sheet.getName();
    const lowerName = name.toLowerCase();
    if (lowerName.indexOf("template") !== -1) return;

    const hasKeyword = keywordList.some(function(keyword) { return lowerName.indexOf(keyword) !== -1; });
    if (!hasKeyword) return;
    if (seen.has(name)) return;

    const sheetDate = extractFirstDateFromSheetName_(name);
    if (sheetDate) {
      const sheetKey = Number(Utilities.formatDate(sheetDate, Session.getScriptTimeZone(), "yyyyMM"));
      if (sheetKey <= cutoffKey) {
        seen.add(name);
        matches.push(sheet);
      }
    }
  });

  matches.sort(function(a, b) { return a.getName().localeCompare(b.getName()); });
  return matches;
}

function notifyArchiveMonthlySheetsResult_(title, monthLabel, result) {
  const msg = title + " complete for " + monthLabel + ".\nArchived: " + (result.archived ? result.archived.length : 0) +
              "\nSkipped: " + (result.skipped ? result.skipped.length : 0) +
              "\nFailed: " + (result.failed ? result.failed.length : 0);
  SpreadsheetApp.getActiveSpreadsheet().toast(msg, title, 5);
}

function copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing) {
  const archiveResult = archiveRawSourceSheet_(sheet, sheetName, timing, "Archive monthly sheet", archiveSs);
  activateVisibleSheetBeforeHiding_(sheet);
  ss.deleteSheet(sheet);
  return { localAction: "Deleted local sheet " + sheetName, archiveName: archiveResult.archivedName };
}

function archiveRawSourceSheet_(sourceSheet, archiveName, timing, timingLabel, preOpenedArchiveSpreadsheet) {
  if (!sourceSheet) throw new Error("A source sheet is required for archive.");
  const archiveSpreadsheet = preOpenedArchiveSpreadsheet || openArchiveSpreadsheetOnce_();
  const finalArchiveName = getUniqueArchiveSheetName_(archiveSpreadsheet, archiveName);
  const copied = sourceSheet.copyTo(archiveSpreadsheet);
  copied.setName(finalArchiveName);
  if (copied.getMaxRows() !== sourceSheet.getMaxRows() || copied.getMaxColumns() !== sourceSheet.getMaxColumns()) {
    archiveSpreadsheet.deleteSheet(copied);
    throw new Error("Archived source verification failed.");
  }
  if (typeof markFrameworkStep_ === "function") {
    markFrameworkStep_(timing, timingLabel || "Archive source", finalArchiveName);
  }
  return { archivedSuccessfully: true, sheet: copied, archiveSpreadsheetId: archiveSpreadsheet.getId(), archivedName: finalArchiveName };
}


// ============================================================================
// 3.4. SLASH-DELIMITED FORMATTING ENGINE
// ============================================================================

function applyDelimitedProperty_(range, propertyValue, type) {
  if (propertyValue === undefined || propertyValue === null || propertyValue === "") return;
  const strVal = String(propertyValue);

  if (strVal.indexOf('/') === -1) {
    applySingleCellProperty_(range, strVal.trim(), type);
  } else {
    const parts = strVal.split('/');
    const startRow = range.getRow();
    const startCol = range.getColumn();
    const sheet = range.getSheet();
    const maxCols = sheet.getMaxColumns();

    for (let i = 0; i < parts.length; i++) {
      const val = parts[i].trim();
      if (val !== "" && (startCol + i) <= maxCols) {
        const cell = sheet.getRange(startRow, startCol + i, range.getNumRows(), 1);
        applySingleCellProperty_(cell, val, type);
      }
    }
  }
}

function applySingleCellProperty_(range, val, type) {
  if (!val) return;
  if (type === "fontSize" && !isNaN(Number(val))) {
    range.setFontSize(Number(val));
  } else if (type === "fontWeight") {
    const lower = val.toLowerCase();
    range.setFontWeight(lower === "bold" ? "bold" : "normal");
    range.setFontStyle(lower === "italic" ? "italic" : "normal");
  } else if (type === "alignment") {
    range.setHorizontalAlignment(val.toLowerCase());
  } else if (type === "wrap") {
    range.setWrapStrategy(getWrapStrategyEnum_(val));
  } else if (type === "dateFormat") {
    const isDateFormat = /^[mdy\/\-\.\s]+$/i.test(val) && val.toLowerCase().indexOf('m') !== -1;
    if (isDateFormat) {
      range.setNumberFormat(val);
    } else {
      range.setValue(val);
    }
  }
}

function getWrapStrategyEnum_(wrapStr) {
  var w = String(wrapStr || "").toUpperCase();
  if (w === "WRAP") return SpreadsheetApp.WrapStrategy.WRAP;
  if (w === "OVERFLOW") return SpreadsheetApp.WrapStrategy.OVERFLOW;
  if (w === "CLIP") return SpreadsheetApp.WrapStrategy.CLIP;
  throw new Error("Format Dashboard has an invalid wrap strategy: " + wrapStr + ".");
}

function getBorderStyleEnum_(styleName) {
  var key = String(styleName || "").trim().toUpperCase();
  var styles = {
    SOLID: SpreadsheetApp.BorderStyle.SOLID,
    SOLID_MEDIUM: SpreadsheetApp.BorderStyle.SOLID_MEDIUM,
    SOLID_THICK: SpreadsheetApp.BorderStyle.SOLID_THICK,
    DASHED: SpreadsheetApp.BorderStyle.DASHED,
    DOTTED: SpreadsheetApp.BorderStyle.DOTTED,
    DOUBLE: SpreadsheetApp.BorderStyle.DOUBLE
  };
  if (!styles[key]) throw new Error("Format Dashboard has an invalid Global Border Style: " + styleName + ".");
  return styles[key];
}

