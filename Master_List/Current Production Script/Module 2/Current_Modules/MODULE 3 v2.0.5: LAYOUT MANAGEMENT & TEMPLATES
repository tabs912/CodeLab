// ============================================================================
// 3.1. SHEET TAB RANKING & ORGANIZATION ENGINE (HARDCODED FOR RELIABILITY)
// ============================================================================

function organizeTabs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();

  const visibilitySnapshot = new Map();
  sheets.forEach(s => visibilitySnapshot.set(s.getSheetId(), s.isSheetHidden()));

  const sheetData = sheets.map(sheet => {
    const name = sheet.getName();
    let match = { group: "Unformatted", rank: 999 };
    if (typeof matchSheetToSectionFRule_ === "function") {
      match = matchSheetToSectionFRule_(name);
    }

    let dateVal = 0;
    const dateMatch = name.match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        dateVal = new Date(y, m - 1, 1).getTime();
    }

    return { sheet, name, rank: match.rank, dateVal };
  });

  sheetData.sort((a, b) => {
    if (a.rank !== b.rank) return a.rank - b.rank;
    if (a.dateVal !== b.dateVal) return b.dateVal - a.dateVal;
    return a.name.localeCompare(b.name);
  });

  for (let i = 0; i < sheetData.length; i++) {
    const currentSheet = sheetData[i].sheet;
    if (currentSheet.getIndex() !== (i + 1)) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(i + 1);
    }
  }

  ss.getSheets().forEach(s => {
    const wasHidden = visibilitySnapshot.get(s.getSheetId());
    if (wasHidden && !s.isSheetHidden()) s.hideSheet();
    else if (!wasHidden && s.isSheetHidden()) s.showSheet();
  });

  ss.toast("Sheet Tabs Re-organized!", "Tab Engine", 4);
}

function positionSheetBySectionFRank_(sheet, optionalRank, spreadsheet) {
  if (!sheet) return;
  try {
    var ss = spreadsheet || SpreadsheetApp.getActiveSpreadsheet();
    var currentSheet = ss.getSheetByName(sheet.getName());
    if (!currentSheet) return;

    var targetRank = (optionalRank !== undefined && optionalRank !== null) ? optionalRank : getTargetRankForSheet_(currentSheet.getName());

    var targetDateVal = 0;
    var dateMatch = currentSheet.getName().match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        targetDateVal = new Date(y, m - 1, 1).getTime();
    }

    var sheets = ss.getSheets();
    var targetPos = 1;

    for (var i = 0; i < sheets.length; i++) {
      if (sheets[i].getName() === currentSheet.getName()) continue;

      var otherRank = getTargetRankForSheet_(sheets[i].getName());
      var otherDateVal = 0;
      var otherMatch = sheets[i].getName().match(/(\d{2})[.\/-](\d{2,4})/);
      if (otherMatch) {
        let m = parseInt(otherMatch[1], 10);
        let y = parseInt(otherMatch[2], 10);
        if (y < 100) y += 2000;
        otherDateVal = new Date(y, m - 1, 1).getTime();
      }

      var placeAfter = false;
      if (otherRank < targetRank) {
        placeAfter = true;
      } else if (otherRank === targetRank) {
        if (otherDateVal > targetDateVal) {
          placeAfter = true;
        } else if (otherDateVal === targetDateVal) {
          if (sheets[i].getName().localeCompare(currentSheet.getName()) < 0) {
            placeAfter = true;
          }
        }
      }

      if (placeAfter) {
        targetPos++;
      }
    }

    if (currentSheet.getIndex() !== targetPos) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(Math.min(Math.max(1, targetPos), sheets.length));
    }
  } catch (e) {
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Non-fatal tab position operation failed: " + e.message);
  }
}

function getTargetRankForSheet_(sheetName) {
  const name = String(sheetName || "").trim().toLowerCase();

  if (name === "index") return 1;
  if (name === "refined data") return 2;
  if (name.indexOf("disenrolled") === 0) return 10;

  if (name.indexOf("master list") === 0) return 21;
  if (name.indexOf("monthly change") === 0) return 22;
  if (name.indexOf("raw data") === 0) return 23;

  if (name.indexOf("banners") === 0) return 24;
  if (name.indexOf("cp due") === 0 || name.indexOf("care plan due") === 0) return 25;
  if (name.indexOf("unlock cp") === 0 || name.indexOf("unlocked cp") === 0) return 26;

  if (name.indexOf("source - raw data") === 0) return 27;
  if (name.indexOf("source - banners") === 0) return 28;
  if (name.indexOf("source - cp due") === 0) return 29;
  if (name.indexOf("source - unlock cp") === 0 || name.indexOf("source - unlocked cp") === 0) return 30;

  if (name.indexOf("archive - refined data") === 0) return 350;

  if (name.indexOf("framework timing") === 0) return 500;
  if (name.indexOf("dashboard quality") === 0) return 501;
  if (name === "format dashboard") return 502;
  if (name === "default - format dashboard") return 812;

  if (name === "rff_base_template") return 814;
  if (name.indexOf("template - ") === 0) {
    if (name.indexOf("banners") !== -1) return 801;
    if (name.indexOf("cp due") !== -1) return 802;
    if (name.indexOf("unlock") !== -1) return 803;
    if (name.indexOf("raw data") !== -1) return 804;
    if (name.indexOf("refined data") !== -1 && name.indexOf("archive") === -1) return 805;
    if (name.indexOf("disenrolled") !== -1) return 806;
    if (name.indexOf("master list") !== -1) return 807;
    if (name.indexOf("monthly change") !== -1) return 808;
    if (name.indexOf("archive - refined data") !== -1) return 809;
    if (name.indexOf("framework timing") !== -1) return 810;
    if (name.indexOf("dashboard quality") !== -1) return 811;
    return 800;
  }

  return 999;
}

function matchSheetToSectionFRule_(sheetName) {
  const rank = getTargetRankForSheet_(sheetName);
  let group = "Unformatted";

  if (rank === 1 || (rank >= 500 && rank <= 502)) group = "System & Configuration";
  else if (rank === 2 || rank === 10 || rank === 350) group = "Core Operational";
  else if (rank >= 21 && rank <= 23) group = "Monthly Active";
  else if (rank >= 24 && rank <= 26) group = "Monthly Sub-Reports";
  else if (rank >= 27 && rank <= 30) group = "Source Data";
  else if (rank >= 800 && rank <= 814) group = "Template";

  return { group: group, rank: rank };
}

