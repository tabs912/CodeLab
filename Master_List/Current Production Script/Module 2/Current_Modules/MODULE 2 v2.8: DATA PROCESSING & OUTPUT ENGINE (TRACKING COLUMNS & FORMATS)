function createDisenrolledList() {
  const monthParts = promptForLockedYearReportMonth_("Create Disenrolled Exclusion List");
  if (!monthParts) return null;
  return createDisenrolledListForMonth_(monthParts);
}

function createDisenrolledListForMonth_(monthParts) {
  return runFrameworkTimed_("Disenrolled Exclusion " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Disenrolled Exclusion process is locked.");
    try {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const dashboard = loadDashboardConfig_();
      const refinedSheet = getCurrentDemoPSheet_();
      if (!refinedSheet) throw new Error("Refined Data sheet is missing. Cannot build Disenrolled list.");

      const refinedData = getDataValues_(refinedSheet, HEADER_ROW, DATA_START_ROW);
      const targetHeaders = getHeadersForSheetType_(dashboard, "Disenrolled Exclusion");
      if (!targetHeaders.length) throw new Error("Dashboard Section H is missing Disenrolled Exclusion headers.");

      const statusIndex = findHeaderIndex_(refinedData.headerMap, ["Enrollment Status", "Status"]);
      const dateIndex = findHeaderIndex_(refinedData.headerMap, ["Disenrollment Date", "Disenrollment Effective Date", "Disenrolled Date"]);

      // PRESERVE HISTORICAL DATES: Look up existing disenrolled tracking data to preserve original "Added" dates
      const existingDisenrolledSheet = ss.getSheetByName("Disenrolled Exclusion");
      const existingAddedMap = new Map();
      if (existingDisenrolledSheet) {
          const extData = getDataValues_(existingDisenrolledSheet, HEADER_ROW, DATA_START_ROW);
          const extPmrIdx = getPMRIndex_(extData.headerMap);
          const extAddedIdx = extData.headerMap["Added to Disenrolled Exclusion"];
          if (extPmrIdx >= 0 && extAddedIdx !== undefined) {
              extData.values.forEach(r => {
                  const p = String(r[extPmrIdx] || "").trim().toUpperCase();
                  const a = r[extAddedIdx]; // Preserve literal value object
                  if (p && a !== "" && a !== null && a !== undefined) existingAddedMap.set(p, a);
              });
          }
      }

      const allDisenrolled = [];
      const retainedDemoP = [];

      filterBlankRows_(refinedData.values).forEach(function(row) {
        const status = statusIndex >= 0 ? String(row[statusIndex] || "").trim().toLowerCase() : "";
        const hasDate = dateIndex >= 0 && String(row[dateIndex] || "").trim() !== "";
        if (status === "disenrolled" || hasDate) {
            allDisenrolled.push(row);
        } else {
            retainedDemoP.push(row);
        }
      });

      let finalRows = mapRowsToHeaders_(allDisenrolled, refinedData.headers, targetHeaders);

      const targetPmrIdx = getPMRIndex_(buildHeaderIndexMap_(targetHeaders));
      const targetAddedIdx = findHeaderIndex_(buildHeaderIndexMap_(targetHeaders), ["Added to Disenrolled Exclusion"]);

      if (targetPmrIdx >= 0 && targetAddedIdx >= 0) {
          finalRows.forEach(row => {
              const pmr = String(row[targetPmrIdx] || "").trim().toUpperCase();
              if (existingAddedMap.has(pmr)) {
                  row[targetAddedIdx] = existingAddedMap.get(pmr);
              } else {
                  row[targetAddedIdx] = monthParts.firstDay;
              }
          });
      }

      const targetDateIndex = findHeaderIndex_(buildHeaderIndexMap_(targetHeaders), ["Disenrollment Effective Date", "Disenrollment Date"]);
      if (targetDateIndex >= 0) finalRows.sort(function(a, b) {
        const left = new Date(a[targetDateIndex]).getTime(); const right = new Date(b[targetDateIndex]).getTime();
        return (isNaN(right) ? 0 : right) - (isNaN(left) ? 0 : left);
      });
      markFrameworkStep_(timing, "Retain complete disenrollment history", finalRows.length + " disenrolled row(s); no 12-month deletion filter");

      const finalSheet = createGovernedSheet_("Disenrolled Exclusion", null, { customName: "Disenrolled Exclusion", dataRows: finalRows, headers: targetHeaders, overwrite: true, timing: timing });
      const hiddenCount = hideHistoricalDisenrollmentRows_(finalSheet, finalRows, targetDateIndex, monthParts);
      markFrameworkStep_(timing, "Hide historical disenrollment rows", hiddenCount + " row(s) older than 365 days hidden; data retained");

      if (allDisenrolled.length > 0) {
          const demoPHeaders = getHeadersForSheetType_(dashboard, "Refined Data");
          const mappedRetained = mapRowsToHeaders_(retainedDemoP, refinedData.headers, demoPHeaders);
          createGovernedSheet_("Refined Data", null, { customName: refinedSheet.getName(), dataRows: mappedRetained, headers: demoPHeaders, overwrite: true, timing: timing });
          markFrameworkStep_(timing, "Demo P Rewrite", "Removed " + allDisenrolled.length + " disenrolled row(s) from active Refined Data");
      }

      return { success: true, count: finalRows.length, hiddenCount: hiddenCount, sheetName: finalSheet.getName() };
    } finally { lock.releaseLock(); }
  });
}

function hideHistoricalDisenrollmentRows_(sheet, rows, dateIndex, monthParts) {
  if (!sheet || dateIndex < 0 || !rows.length) return 0;
  const cutoff = new Date(monthParts.lastDay);
  cutoff.setDate(cutoff.getDate() - 365);
  const rowNumbers = [];
  rows.forEach(function(row, index) {
    const date = new Date(row[dateIndex]);
    if (!isNaN(date.getTime()) && date < cutoff) rowNumbers.push(DATA_START_ROW + index);
  });
  if (!rowNumbers.length) return 0;
  let start = rowNumbers[0]; let previous = rowNumbers[0];
  for (let index = 1; index <= rowNumbers.length; index++) {
    const current = rowNumbers[index];
    if (current === previous + 1) { previous = current; continue; }
    sheet.hideRows(start, previous - start + 1);
    start = current; previous = current;
  }
  return rowNumbers.length;
}

