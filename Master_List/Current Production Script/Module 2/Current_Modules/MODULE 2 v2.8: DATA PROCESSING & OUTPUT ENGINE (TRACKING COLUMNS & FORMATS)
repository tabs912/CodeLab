function buildMonthlyChangeReport() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Change Report");
  if (!monthParts) return null;
  return buildMonthlyChangeReportForMonth_(monthParts);
}

function buildMonthlyChangeReportForMonth_(monthParts) {
  return runFrameworkTimed_("Monthly Change " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Monthly Change process is locked.");
    try {
      const dashboard = loadDashboardConfig_();
      const previousDate = new Date(monthParts.reportDate);
      previousDate.setMonth(previousDate.getMonth() - 1);
      const previousLabel = Utilities.formatDate(previousDate, Session.getScriptTimeZone(), "MM.yy");
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const currentSheet = ss.getSheetByName("Raw Data " + monthParts.label) || ss.getSheetByName(SYSTEM_SHEETS.SOURCE_PREFIX + "Raw Data " + monthParts.label);
      const previousSheet = ss.getSheetByName("Raw Data " + previousLabel) || ss.getSheetByName(SYSTEM_SHEETS.SOURCE_PREFIX + "Raw Data " + previousLabel);
      if (!currentSheet || !previousSheet) throw new Error("Monthly Change requires current and previous Raw Data sheets: " + monthParts.label + " and " + previousLabel + ".");
      const currentRead = getDataValues_(currentSheet, HEADER_ROW, DATA_START_ROW);
      const previousRead = getDataValues_(previousSheet, HEADER_ROW, DATA_START_ROW);
      const currentData = { values: filterBlankRows_(currentRead.values), map: currentRead.headerMap, headers: currentRead.headers };
      const previousData = { values: filterBlankRows_(previousRead.values), map: previousRead.headerMap, headers: previousRead.headers };
      markFrameworkStep_(timing, "Read Raw Data comparison sources", currentSheet.getName() + " vs " + previousSheet.getName());
      const blocks = getSubheadersFromDashboardConfig_("Monthly Change");
      const mcHeaders = getHeadersForSheetType_(dashboard, "Monthly Change");
      const changeResults = computeMonthlyChange_(currentData, previousData, blocks, monthParts, mcHeaders);
      const changeSheet = createGovernedSheet_("Monthly Change", monthParts, { overwrite: true, timing: timing });
      blocks.forEach(function(block) {
        const rows = changeResults[block.title] || [];
        if (rows.length) appendDataToSubheaderSection_(changeSheet, block.title, rows);
      });
      markFrameworkStep_(timing, "Monthly Change complete", "Compared Raw Data; output " + changeSheet.getName());
      return { success: true, sheetName: changeSheet.getName() };
    } finally { lock.releaseLock(); }
  });
}

function computeMonthlyChange_(current, prev, subheaderBlocks, monthParts, targetHeaders) {
  const currentPmrIdx = getPMRIndex_(current.map);
  const prevPmrIdx = getPMRIndex_(prev.map);

  if (currentPmrIdx < 0 || prevPmrIdx < 0) throw new Error("Raw Data comparison is missing a PMR column.");

  const currentRecords = buildLookupMap_(current.values, currentPmrIdx);
  const prevRecords = buildLookupMap_(prev.values, prevPmrIdx);

  const results = {};
  subheaderBlocks.forEach(b => results[b.title] = []);

  const titleMap = {};
  subheaderBlocks.forEach(b => {
    if (b.title.indexOf("ENROLLMENTS") !== -1 && b.title.indexOf("DISENROLLMENTS") === -1) titleMap.enroll = b;
    if (b.title.indexOf("DISENROLLMENTS") !== -1) titleMap.disenroll = b;
    if (b.title.indexOf("DEMOGRAPHIC") !== -1) titleMap.demo = b;
    if (b.title.indexOf("CASELOAD") !== -1) titleMap.case = b;
    if (b.title.indexOf("CONTACT") !== -1) titleMap.contact = b;
    if (b.title.indexOf("OTHER") !== -1) titleMap.other = b;
    if (b.title.indexOf("LEVEL OF CARE") !== -1) titleMap.loc = b;
  });

  const targetEnrollStart = new Date(monthParts.year, monthParts.month - 1, 1).getTime();
  const priorDisenrollMonth = monthParts.month === 1 ? 12 : monthParts.month - 1;
  const priorDisenrollYear = monthParts.month === 1 ? monthParts.year - 1 : monthParts.year;

  const capDateIdxCurr = findHeaderIndex_(current.map, ["Capitation Date", "Enrollment Date"]);
  const disDateIdxCurr = findHeaderIndex_(current.map, ["Disenrollment Effective Date", "Disenrollment Date"]);
  const disDateIdxPrev = findHeaderIndex_(prev.map, ["Disenrollment Effective Date", "Disenrollment Date"]);

  const processedDisenrollments = new Set();

  currentRecords.forEach((currentRow, pmr) => {
    const prevRow = prevRecords.get(pmr);

    if (capDateIdxCurr >= 0) {
      const capDate = new Date(currentRow[capDateIdxCurr]);
      if (!isNaN(capDate.getTime()) && capDate.getTime() === targetEnrollStart) {
        if (titleMap.enroll) {
          results[titleMap.enroll.title].push(mapRowsToHeaders_([currentRow], current.headers, targetHeaders)[0]);
        }
      }
    }

    if (disDateIdxCurr >= 0) {
      const disDate = new Date(currentRow[disDateIdxCurr]);
      if (!isNaN(disDate.getTime()) && disDate.getMonth() + 1 === priorDisenrollMonth && disDate.getFullYear() === priorDisenrollYear) {
        if (titleMap.disenroll) {
          results[titleMap.disenroll.title].push(mapRowsToHeaders_([currentRow], current.headers, targetHeaders)[0]);
          processedDisenrollments.add(pmr);
        }
      }
    }

    if (prevRow) {
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, current.headers, targetHeaders, titleMap.demo, results);
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, current.headers, targetHeaders, titleMap.case, results);
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, current.headers, targetHeaders, titleMap.contact, results);
      checkAndMapDeltas_(currentRow, prevRow, current.map, prev.map, current.headers, targetHeaders, titleMap.other, results);

      if (titleMap.loc) {
        const resIdxCurr = findHeaderIndex_(current.map, ["Residence Type"]);
        const resIdxPrev = findHeaderIndex_(prev.map, ["Residence Type"]);
        if (resIdxCurr >= 0 && resIdxPrev >= 0) {
          const currVal = String(currentRow[resIdxCurr] || "").trim();
          const prevVal = String(prevRow[resIdxPrev] || "").trim();
          const triggers = ["ALF", "Assisted Living", "Group Home", "Nursing Home"].map(v => v.toLowerCase());
          if (currVal !== prevVal && triggers.includes(currVal.toLowerCase())) {
            results[titleMap.loc.title].push(mapRowsToHeaders_([currentRow], current.headers, targetHeaders)[0]);
          }
        }
      }
    }
  });

  prevRecords.forEach((prevRow, pmr) => {
    if (!currentRecords.has(pmr)) {
      if (!processedDisenrollments.has(pmr) && disDateIdxPrev >= 0) {
        const disDate = new Date(prevRow[disDateIdxPrev]);
        if (!isNaN(disDate.getTime()) && disDate.getMonth() + 1 === priorDisenrollMonth && disDate.getFullYear() === priorDisenrollYear) {
          if (titleMap.disenroll) {
            results[titleMap.disenroll.title].push(mapRowsToHeaders_([prevRow], prev.headers, targetHeaders)[0]);
            processedDisenrollments.add(pmr);
          }
        }
      }
    }
  });

  return results;
}

function checkAndMapDeltas_(currentRow, prevRow, currentMap, prevMap, currentHeaders, targetHeaders, blockSpec, resultsDict) {
  if (!blockSpec || !blockSpec.headers) return;

  let hasChange = false;
  const ignoreCols = ["Participant Name", "Name", "Preferred Name", "Date of Birth"];

  blockSpec.headers.forEach(header => {
    if (ignoreCols.indexOf(header) !== -1) return;
    const currIdx = findHeaderIndex_(currentMap, [header]);
    const prevIdx = findHeaderIndex_(prevMap, [header]);

    if (currIdx >= 0 && prevIdx >= 0) {
      if (String(currentRow[currIdx] || "").trim() !== String(prevRow[prevIdx] || "").trim()) {
        hasChange = true;
      }
    }
  });

  if (hasChange) {
    resultsDict[blockSpec.title].push(mapRowsToHeaders_([currentRow], currentHeaders, targetHeaders)[0]);
  }
}
