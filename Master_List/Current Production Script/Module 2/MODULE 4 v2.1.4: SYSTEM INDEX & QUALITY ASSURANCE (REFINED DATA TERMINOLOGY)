    }

    // 5. Run Section E - Deep Disenrolled Exclusion Audit
    if (typeof runDashboardQualityDisenrolledExclusionValidation_ === "function") {
      runDashboardQualityDisenrolledExclusionValidation_();
    }

    // 6. Run Section F - Deep Monthly Change Delta Audit
    if (typeof runDashboardQualityMonthlyChangeValidation_ === "function") {
