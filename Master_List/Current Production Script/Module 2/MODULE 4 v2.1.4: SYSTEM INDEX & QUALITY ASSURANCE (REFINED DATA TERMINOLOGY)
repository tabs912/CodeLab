function runDashboardQualityConfigVerificationSections_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD) || ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT);
  if (!dashboard) throw new Error("Format Dashboard is required for Dashboard Quality verification.");
  const values = dashboard.getDataRange().getValues();
  const sections = {};
  let currentSection = "";
  values.forEach(function(row, rowIndex) {
    const firstCell = String(row[0] || "").trim();
    if (firstCell.indexOf("SECTION ") === 0) {
      currentSection = firstCell;
      sections[currentSection] = { titleRow: rowIndex + 1, rows: [] };
    } else if (currentSection) {
      sections[currentSection].rows.push(row);
    }
  });

  const requiredPrefixes = ["SECTION B", "SECTION C", "SECTION D", "SECTION E", "SECTION F", "SECTION G", "SECTION H"];
  const results = requiredPrefixes.map(function(prefix) {
    const title = Object.keys(sections).find(function(name) { return name.indexOf(prefix) === 0; });
    if (!title) return [prefix, "FAIL", "Required section is missing."];
    const meaningfulRows = sections[title].rows.filter(function(row) {
      return row.some(function(value) { return String(value == null ? "" : value).trim() !== ""; });
    });
    return meaningfulRows.length ? [title, "PASS", meaningfulRows.length + " configured row(s) detected."] : [title, "WARNING", "Section exists but has no configured data rows."];
  });
  return results;
}

function writeDashboardQualitySection_(title, headers, rows) {
  let sheet;
  if (typeof ensureDashboardQualityReport_ === "function") {
    sheet = ensureDashboardQualityReport_();
  } else {
    sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SYSTEM_SHEETS.QUALITY);
  }
  if (!sheet) return;
  const normalizedRows = (rows || []).map(function(row) { return row.slice(); });
  const appended = appendDataToSubheaderSection_(sheet, title, normalizedRows, headers);
  if (!appended) return;
  const targetHeaders = getSubheaderSectionHeaders_(sheet, title);
  const statusColumn = targetHeaders.map(normalizeSubheaderColumnName_).indexOf("status") + 1;
  const sourceStatusIndex = headers.map(normalizeSubheaderColumnName_).indexOf("status");
  if (statusColumn > 0 && sourceStatusIndex >= 0) {
    normalizedRows.forEach(function(row, index) {
      if (String(row[sourceStatusIndex] || "").toUpperCase() === "FAIL") {
        sheet.getRange(appended.startRow + index, statusColumn).setBackground("#F4CCCC");
      }
    });
  }
}

function ensureDashboardQualityReport_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SYSTEM_SHEETS.QUALITY);
  if (sheet) return sheet;
  if (!ss.getSheetByName(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY)) {
    if (!ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT) && !ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD)) {
      if (typeof buildFormatDashboardTemplate_ === "function") buildFormatDashboardTemplate_();
    }
    if (typeof buildGeneralTemplate_ === "function" && typeof getTemplateConfigFromDashboard_ === "function") {
      buildGeneralTemplate_(getTemplateConfigFromDashboard_(SYSTEM_SHEETS.QUALITY));
    }
  }
  sheet = createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.QUALITY);
  if (!sheet) throw new Error("Dashboard Quality Report could not be created from its governed template.");
  return sheet;
}

function runDashboardQualityStartUp() {
  return runFrameworkTimed_("Dashboard Quality Start Up", function(timing) {
    const results = runDashboardQualityConfigVerificationSections_();
    writeDashboardQualitySection_("SECTION A - FORMAT DASHBOARD VALIDATION", ["Dashboard Section", "Status", "Quality Notes"], results);
    markFrameworkStep_(timing, "Format Dashboard Sections B-H audited", results.length + " sections");
    return results;
  });
}

function runDashboardQualityValidateTemplates() {
  return runFrameworkTimed_("Dashboard Quality Validate Templates", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();

    const templateNames = [
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Banners",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "CP Due Date",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Unlock CP",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Raw Data",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Refined Data",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Disenrolled Exclusion",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Master List",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Monthly Change",
      SYSTEM_SHEETS.TEMPLATE_PREFIX + "Archive - Refined Data",
      SYSTEM_SHEETS.BASE_TEMPLATE
    ];

    // Fuzzy matching to neutralize invisible double-space issues
    const actualSheetNames = ss.getSheets().map(s => s.getName());
    const rows = templateNames.map(function(templateName) {
      let exists = actualSheetNames.includes(templateName);
      if (!exists) {
        const fuzzyTarget = templateName.replace(/\s+/g, ' ').trim().toLowerCase();
        exists = actualSheetNames.some(name => name.replace(/\s+/g, ' ').trim().toLowerCase() === fuzzyTarget);
      }
      return [templateName, exists ? "PASS" : "FAIL", exists ? "Template found." : "Template is missing."];
    });

    writeDashboardQualitySection_("SECTION B - TEMPLATE VALIDATION", ["Template / Sheet Name", "Status", "Quality Notes"], rows);
    markFrameworkStep_(timing, "Templates validated", rows.length + " templates");
    return rows;
  });
}

/**
 * Audits Template - sheets to verify Section G date-column number formats.
 */
function runTemplateDateFormatValidation_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  let config;
  try {
    config = typeof loadDashboardConfig_ === "function" ? loadDashboardConfig_() : null;
    if (!config) throw new Error("loadDashboardConfig_ not found.");
  } catch (err) {
    ui.alert("Validation Error", "Error reading Format Dashboard: " + err.message, ui.ButtonSet.OK);
    return null;
  }

  const dateDefinitions = new Map();
  const columnDefinitions = config.columnDefinitions || {};
  Object.keys(columnDefinitions).forEach(function(header) {
    const definition = columnDefinitions[header];
    const normalizedHeader = String(header || "").trim().toLowerCase();
    const numberFormat = String(definition && definition.format || "").trim();
    if (normalizedHeader && definition && definition.dateColumn === true) {
      dateDefinitions.set(normalizedHeader, numberFormat);
    }
  });
  if (!dateDefinitions.size) {
    ui.alert("Validation Skipped", "No Date Columns are defined in Section G of the Dashboard.", ui.ButtonSet.OK);
    return [];
  }

  const templateSheets = ss.getSheets().filter(function(sheet) {
    return sheet.getName().indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) === 0;
  });
  if (!templateSheets.length) {
    ui.alert("Validation Skipped", "No 'Template - ' sheets found to audit. Build templates first.", ui.ButtonSet.OK);
    return [];
  }

  const headerRow = Number(config.globals && config.globals["Header Row"]) || HEADER_ROW;
  const dataStartRow = Number(config.globals && config.globals["Data Start Row"]) || DATA_START_ROW;
  const findings = [];
  let checkedCount = 0;
  templateSheets.forEach(function(sheet) {
    const lastColumn = sheet.getLastColumn();
    if (lastColumn < 1) return;
    const headers = sheet.getRange(headerRow, 1, 1, lastColumn).getValues()[0];
    headers.forEach(function(header, index) {
      const normalizedHeader = String(header || "").trim().toLowerCase();
      if (!normalizedHeader || !dateDefinitions.has(normalizedHeader)) return;
      const expectedFormat = dateDefinitions.get(normalizedHeader);
      const appliedFormat = sheet.getRange(dataStartRow, index + 1).getNumberFormat();
      const passed = expectedFormat !== "" && appliedFormat === expectedFormat;
      findings.push([sheet.getName() + " | " + header, passed ? "PASS" : "FAIL", passed ? "Section G date format applied: " + appliedFormat : "Expected " + (expectedFormat || "a configured Number Format") + "; found " + (appliedFormat || "General / Plain Text")]);
      checkedCount++;
    });
  });

  writeDashboardQualitySection_("SECTION B - TEMPLATE VALIDATION", ["Template / Sheet Name", "Status", "Quality Notes"], findings);
  const failures = findings.filter(function(row) { return row[1] === "FAIL"; });
  if (!failures.length) {
    ui.alert("Validation Passed: Date Formats", "Checked " + checkedCount + " date columns across all templates. Every template applied the configured Section G date format.", ui.ButtonSet.OK);
  } else {
    ui.alert("Validation Failed: Date Formats", failures.length + " date column(s) are missing or incorrectly formatted. Review Section B of Dashboard Quality Report.", ui.ButtonSet.OK);
  }
  return findings;
}

