function updateIndexSheet(archiveSs) {
  if (typeof populateIndexData === "function") {
    populateIndexData(SYSTEM_SHEETS.INDEX);
  } else if (typeof populateActiveIndex === "function") {
    populateActiveIndex();
  }

  if (typeof syncArchiveIndexToActiveIndex_ === "function") {
    syncArchiveIndexToActiveIndex_();
  }
}

function populateActiveIndex() {
  populateIndexData(SYSTEM_SHEETS.INDEX);
}

function populateIndexData(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = targetName || SYSTEM_SHEETS.INDEX;
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;

  const timestampStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss");
  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "";

  sheet.getRange("B2").setValue(timestampStr);
  sheet.getRange("G2").setValue(archiveId);

  const activeSheets = ss.getSheets();
  const activeSheetMap = new Map();

  activeSheets.forEach(s => {
    const name = s.getName();
    if (name !== sheetName && name !== SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.INDEX) {
      let match = { group: "Unformatted", rank: 999 };
      if (typeof matchSheetToSectionFRule_ === "function") {
        match = matchSheetToSectionFRule_(name);
      }

      const finalGroup = (name.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) === 0 || name === SYSTEM_SHEETS.BASE_TEMPLATE || name === SYSTEM_SHEETS.DASHBOARD_DEFAULT) ? "Template" : match.group;

      activeSheetMap.set(name, {
        sheet: s,
        group: finalGroup,
        rank: match.rank,
        visibility: s.isSheetHidden() ? "Hidden" : "Visible",
        link: `=HYPERLINK("#gid=${s.getSheetId()}", "Open Live Tab")`
      });
    }
  });

  const lastRow = sheet.getLastRow();
  let existingActiveMatrix = [];
  if (lastRow >= 5) {
    existingActiveMatrix = sheet.getRange(5, 1, lastRow - 4, 4).getValues();
  }

  const groupMap = new Map();
  let currentGroup = "Unformatted";

  existingActiveMatrix.forEach(row => {
    const colA = String(row[0] || "").trim();
    const colB = String(row[1] || "").trim();

    if (colA !== "") {
      currentGroup = colA;
      if (!groupMap.has(currentGroup)) groupMap.set(currentGroup, []);
    } else if (colB !== "") {
      if (activeSheetMap.has(colB)) {
        const liveInfo = activeSheetMap.get(colB);
        if (!groupMap.has(currentGroup)) groupMap.set(currentGroup, []);
        groupMap.get(currentGroup).push({
          name: colB, link: liveInfo.link, visibility: liveInfo.visibility, rank: liveInfo.rank
        });
        activeSheetMap.delete(colB);
      }
    }
  });

  activeSheetMap.forEach((info, newSheetName) => {
    if (!groupMap.has(info.group)) groupMap.set(info.group, []);
    groupMap.get(info.group).push({
      name: newSheetName, link: info.link, visibility: info.visibility, rank: info.rank
    });
  });

  const exactGroupOrder = [
    "Core Operational",
    "Monthly Active",
    "Monthly Sub-Reports",
    "System & Configuration",
    "Unformatted",
    "Source Data",
    "Template"
  ];

  const sortedGroups = Array.from(groupMap.keys()).sort((a, b) => {
    let indexA = exactGroupOrder.indexOf(a);
    let indexB = exactGroupOrder.indexOf(b);

    if (indexA === -1) indexA = 99;
    if (indexB === -1) indexB = 99;

    return indexA - indexB;
  });

  const finalActiveMatrix = [];

  sortedGroups.forEach(groupName => {
    const items = groupMap.get(groupName);
    if (!items || items.length === 0) return;

    finalActiveMatrix.push([groupName, "", "", ""]);

    items.sort((a, b) => {
      if (groupName === "Template" || groupName === "Templates") {
        if (a.name === SYSTEM_SHEETS.DASHBOARD_DEFAULT) return -1;
        if (b.name === SYSTEM_SHEETS.DASHBOARD_DEFAULT) return 1;
      }
      const dateA = typeof extractFirstDateFromSheetName_ === "function" ? extractFirstDateFromSheetName_(a.name).getTime() : 0;
      const dateB = typeof extractFirstDateFromSheetName_ === "function" ? extractFirstDateFromSheetName_(b.name).getTime() : 0;

      if (a.rank !== b.rank) return a.rank - b.rank;
      if (dateA !== dateB) return dateB - dateA;
      return a.name.localeCompare(b.name);
    });

    items.forEach(item => {
      finalActiveMatrix.push(["", item.name, item.link, item.visibility]);
    });
  });

  const targetWriteRows = Math.max(finalActiveMatrix.length, existingActiveMatrix.length);

  if (targetWriteRows > 0) {
    if (typeof resizeSheetGrid_ === "function") {
      resizeSheetGrid_(sheet, Math.max(targetWriteRows + 4, 20), 10);
    }
    sheet.getRange(5, 1, targetWriteRows, 4).clearContent();
    if (finalActiveMatrix.length > 0) {
      sheet.getRange(5, 1, finalActiveMatrix.length, 4).setValues(finalActiveMatrix);
    }
  }
}

function syncArchiveIndexToActiveIndex_(targetSheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const indexSheet = targetSheet || ss.getSheetByName(SYSTEM_SHEETS.INDEX);
  if (!indexSheet) return;

  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "";
  const restoreUrl = PropertiesService.getDocumentProperties().getProperty("INDEX_RESTORE_WEB_APP_URL") || "";

  indexSheet.getRange("G2").setValue(archiveId);

  if (!archiveId) {
    if (typeof logBestEffortWarning_ === "function") {
      logBestEffortWarning_("Sync skipped: No Archive Spreadsheet ID found in document properties.");
    }
    return;
  }

  let archiveSs;
  try {
    archiveSs = SpreadsheetApp.openById(archiveId);
  } catch (err) {
    if (typeof logBestEffortWarning_ === "function") {
      logBestEffortWarning_("Sync failed: Could not open Archive Spreadsheet ID " + archiveId + ". Error: " + err.message);
    }
    return;
  }

  const archiveIndexSheet = archiveSs.getSheetByName(SYSTEM_SHEETS.INDEX);
  if (!archiveIndexSheet) return;

  const archiveLastRow = Math.max(archiveIndexSheet.getLastRow(), 4);
  const activeLastRow = Math.max(indexSheet.getLastRow(), 4);

  if (activeLastRow >= 5) {
    indexSheet.getRange(5, 6, activeLastRow - 4, 5).clearContent();
  }

  if (archiveLastRow < 5) return;

  const archiveData = archiveIndexSheet.getRange(5, 1, archiveLastRow - 4, 5).getValues();
  const outputMatrix = [];

  archiveData.forEach(row => {
    const month = row[0] || "";
    const sheetName = row[2] || "";
    const link = row[3] || "";

    let restoreAction = "";
    if (sheetName) {
      if (restoreUrl) {
        const safeName = encodeURIComponent(String(sheetName).trim());
        restoreAction = `=HYPERLINK("${restoreUrl}?restoreTarget=${safeName}", "Restore to Active Workspace")`;
      } else {
        restoreAction = "Configure Web App URL for 1-Click Restore";
      }
    }

    const status = row[4] || "";
    outputMatrix.push([month, sheetName, link, restoreAction, status]);
  });

  if (typeof resizeSheetGrid_ === "function") {
    resizeSheetGrid_(indexSheet, Math.max(outputMatrix.length + 4, 20), 10);
  }

  if (outputMatrix.length > 0) {
    indexSheet.getRange(5, 6, outputMatrix.length, 5).setValues(outputMatrix);
  }
}

function refreshIndexAfterSheetWorkflow_(label) {
  try { if (typeof populateActiveIndex === "function") populateActiveIndex(); } catch (e) { logBestEffortWarning_("Failed to refresh Index after " + label + ": " + e.message); }
}

function checkSheetDeletionAndUpdateIndex_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const currentSheetCount = ss.getSheets().length;
  const props = PropertiesService.getDocumentProperties();
  const previousSheetCount = Number(props.getProperty("RFF_LAST_KNOWN_SHEET_COUNT") || 0);

  if (previousSheetCount > 0 && currentSheetCount < previousSheetCount) {
    if (typeof populateActiveIndex === "function") {
      populateActiveIndex();
    }
    ss.toast("Sheet deletion detected. Index updated!", "Index Engine", 3);
  }

  props.setProperty("RFF_LAST_KNOWN_SHEET_COUNT", String(currentSheetCount));
}

