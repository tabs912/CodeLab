  });

  notify_("Executing Dashboard Quality start-up verifications...");
  if (typeof runDashboardQualityStartUp !== "function") throw new Error("Dashboard Quality start-up is required.");
  runDashboardQualityStartUp();

  runFrameworkTimed_("Quick System Setup [Phase 3]", function(timing) {
    markFrameworkStep_(timing, "Build Index", "Populating centralized Index");
