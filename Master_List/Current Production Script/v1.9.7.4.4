function restoreSheetFromActiveIndexRow() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const activeSheet = ss.getActiveSheet();

  if (activeSheet.getName().indexOf("Index") === -1) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "Please select a row on the Index sheet to navigate or restore.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const dataStart = 5;
  const activeRange = activeSheet.getActiveRange();
  const activeRow = activeRange.getRow();
  const activeCol = activeRange.getColumn();
  
  if (activeRow < dataStart) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "Please select a valid data row (Row 5 or lower).", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  // If clicked on the right side (Archive), look at Col 7. Otherwise, look at Col 2.
  let sheetName = "";
  if (activeCol >= 6) {
    sheetName = String(activeSheet.getRange(activeRow, 7).getValue() || "").trim();
  } else {
    sheetName = String(activeSheet.getRange(activeRow, 2).getValue() || "").trim();
  }

  if (!sheetName) {
    SpreadsheetApp.getUi().alert("Navigation Alert", "No valid sheet tab name found on the selected row.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }

  const targetSheet = ss.getSheetByName(sheetName);
  if (targetSheet) {
    if (targetSheet.isSheetHidden()) {
      targetSheet.showSheet();
    }
    ss.setActiveSheet(targetSheet);
    ss.toast(`Unhid and navigated to: "${sheetName}"`, "Index Navigation", 3);
  } else {
    // --- FIX 2: Trigger Native Restoration Process ---
    const ui = SpreadsheetApp.getUi();
    const response = ui.alert(
      "Restore Archive Sheet", 
      `Sheet "${sheetName}" is currently archived.\n\nWould you like to restore and copy it back into this workbook now?`, 
      ui.ButtonSet.YES_NO
    );

    if (response === ui.Button.YES) {
      ss.toast(`Contacting Archive Database to restore ${sheetName}...`, "Restoring Sheet", 10);
      try {
        if (typeof restoreSheetFromArchiveWorkbook === "function") {
          restoreSheetFromArchiveWorkbook(sheetName);
          ss.toast(`Successfully restored "${sheetName}"!`, "Restore Complete", 4);
        } else {
          ui.alert("System Error", "The restore engine could not be found.", ui.ButtonSet.OK);
        }
      } catch (err) {
        ui.alert("Restore Failed", "Could not restore sheet: " + err.message, ui.ButtonSet.OK);
      }
    }
  }
}


function restoreSheetFromArchiveWorkbook(targetSheetName) {
  const mainSpreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const name = String(targetSheetName || "").trim();
  if (!name) throw new Error("Missing archive sheet name to restore.");
  if (mainSpreadsheet.getSheetByName(name)) throw new Error('Sheet "' + name + '" already exists locally.');

  const archiveSpreadsheet = openArchiveSpreadsheetOnce_();
  const archiveSheet = archiveSpreadsheet.getSheetByName(name);
  if (!archiveSheet) throw new Error('Sheet "' + name + '" was not found in the archive workbook.');

  if (typeof createGovernedSheet_ !== "function" || typeof getGovernedSheetTypeForName_ !== "function") {
    throw new Error("Archive restoration requires the governed output factory.");
  }
  const dashboard = loadDashboardConfig_(true);
  const sheetType = getGovernedSheetTypeForName_(name, dashboard);
  const restoredSheet = createGovernedSheet_(sheetType, null, {
    customName: name,
    sourceSheet: archiveSheet,
    overwrite: false,
    isSystemSetup: true
  });

  restoredSheet.showSheet();

  if (typeof populateActiveIndex === "function") {
    populateActiveIndex();
  }

  mainSpreadsheet.setActiveSheet(restoredSheet);
  return restoredSheet;
}

function escapeHtml_(text) {
  return String(text == null ? "" : text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function doGet(e) {
  const targetSheetName = e && e.parameter ? String(e.parameter.restoreTarget || "").trim() : "";
  if (!targetSheetName) return HtmlService.createHtmlOutput("<p>Missing recovery sheet routing token.</p>");
  const lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) return HtmlService.createHtmlOutput("<p>Server busy. Try the restore link again.</p>");
  try {
    restoreSheetFromArchiveWorkbook(targetSheetName);
    return HtmlService.createHtmlOutput("<h3>Restoration Complete</h3><p>Restored <b>" + escapeHtml_(targetSheetName) + "</b>.</p>");
  } catch (err) {
    return HtmlService.createHtmlOutput("<h3>Restore Failed</h3><p>" + escapeHtml_(err && err.message ? err.message : err) + "</p>");
  } finally {
    lock.releaseLock();
  }
}

