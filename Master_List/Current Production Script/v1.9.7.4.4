  ]);
}

function hideTemplates_() { return hideReportTemplates(); }
function showTemplates_() { return showReportTemplates(); }

function getDashboardConfigForTemplateVisibility_(dashboardOverride) {
  if (dashboardOverride) return dashboardOverride;
  try {
    return loadDashboardConfig_();
  } catch (err) {
    logBestEffortWarning_("Template visibility config unavailable; using prefix scan: " + err.message);
    return { sheetDefinitions: [], creationRules: {} };
  }
}

function hideReportTemplates(dashboardOverride, timing) {
  if (timing) return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), true, timing);
  return runFrameworkTimed_("Hide Report Templates", function(activeTiming) {
    return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), true, activeTiming);
  });
}

function showReportTemplates(dashboardOverride, timing) {
  if (timing) return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), false, timing);
  return runFrameworkTimed_("Show Report Templates", function(activeTiming) {
    return setReportTemplateVisibility_(getDashboardConfigForTemplateVisibility_(dashboardOverride), false, activeTiming);
  });
}

function setReportTemplateVisibility_(dashboard, hidden, timing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetMap = {};

  ss.getSheets().forEach(function(sheet) {
    sheetMap[sheet.getName()] = sheet;
  });

  if (dashboard && dashboard.sheetDefinitions) {
    dashboard.sheetDefinitions.forEach(function(sheetDef) {
      const sheet = sheetMap[sheetDef.templateName];
      if (!sheet || sheetDef.templateName === SYSTEM_SHEETS.BASE_TEMPLATE) return;
      if (hidden) hideSheetIfNeeded_(sheet, timing, "Hide template: " + sheetDef.templateName);
      else showSheetIfNeeded_(sheet, timing, "Show template: " + sheetDef.templateName);
    });
  }

  Object.keys(sheetMap).forEach(function(sheetName) {
    if (sheetName === SYSTEM_SHEETS.BASE_TEMPLATE) return;
    if (String(sheetName || "").indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) !== 0) return;

    const sheet = sheetMap[sheetName];
    if (hidden) hideSheetIfNeeded_(sheet, timing, "Hide orphan template: " + sheetName);
    else showSheetIfNeeded_(sheet, timing, "Show orphan template: " + sheetName);
  });

  const baseSheet = ss.getSheetByName(SYSTEM_SHEETS.BASE_TEMPLATE);
  if (baseSheet) hideSheetIfNeeded_(baseSheet, null, "Force base template hidden");

  if (timing && typeof markFrameworkStep_ === "function") {
    markFrameworkStep_(timing, hidden ? "All templates hidden" : "All templates shown");
  }
}

function hideSystemSheets_() { return hideSystemSheetsNow(); }
function showSystemSheets_() { return showSystemSheetsNow(); }

function hideSystemSheetsNow() {
  return runFrameworkTimed_("Hide System Sheets", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const systemSheets = [SYSTEM_SHEETS.TIMING, SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.DASHBOARD, SYSTEM_SHEETS.INDEX];

    let hiddenCount = 0;
    systemSheets.forEach(function(name) {
      const sheet = ss.getSheetByName(name);
      if (sheet) {
        hideSheetIfNeeded_(sheet, timing, "Hide system sheet: " + name);
        hiddenCount++;
      }
    });
    if (typeof notify_ === "function") notify_("System sheets hidden: " + hiddenCount);
  });
}

function showSystemSheetsNow() {
  return runFrameworkTimed_("Show System Sheets", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const systemSheets = [SYSTEM_SHEETS.DASHBOARD, SYSTEM_SHEETS.TIMING, SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.INDEX];

    let shownCount = 0;
    systemSheets.forEach(function(name) {
      const sheet = ss.getSheetByName(name);
      if (sheet) {
        showSheetIfNeeded_(sheet, timing, "Show system sheet: " + name);
        shownCount++;
      }
    });
    if (typeof notify_ === "function") notify_("System sheets shown: " + shownCount);
  });
}

function hideMonthlySheetsBySpecs_(processName, parsedMonth, specs) {
  return runFrameworkTimed_(processName + " " + parsedMonth.monthLabel + " & Prior", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const result = { hidden: [], skipped: [] };

    specs.forEach(function(spec) {
      const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
      if (!sheets.length) {
        result.skipped.push(spec.label + " not found");
        return;
      }
      sheets.forEach(function(sheet) {
        try {
          if (!sheet.isSheetHidden()) {
            activateVisibleSheetBeforeHiding_(sheet);
            sheet.hideSheet();
          }
          result.hidden.push(sheet.getName());
        } catch (err) {
          result.skipped.push(sheet.getName() + ": " + err.message);
        }
      });
    });
    if (typeof notify_ === "function") notify_(processName + " complete for " + parsedMonth.monthLabel + " and prior. Hidden: " + result.hidden.length + "; Skipped: " + result.skipped.length + ".");
    return result;
  });
}

