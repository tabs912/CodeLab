function archiveMonthlyImportSheets() {
  const monthParts = promptForLockedYearReportMonth_("Archive Monthly Sub-Reports (Month & Prior)");
  if (!monthParts) return null;
  const parsed = monthParts;

  return runFrameworkTimed_("Archive Monthly Sub-Reports " + parsed.monthLabel + " & Prior", function(timing) {
    const result = archiveMonthlySheetsBySpecs_(parsed, [
      { label: "Banners", keywords: ["Banners", "Banner Report", SYSTEM_SHEETS.SOURCE_PREFIX + "Banners"] },
      { label: "CP Due Date", keywords: ["CP Due Date", "CP Due", "Care Plan Due Date Report", "Care Plan Due", SYSTEM_SHEETS.SOURCE_PREFIX + "CP Due"] },
      { label: "Unlocked CP", keywords: ["Unlocked CP", "Unlock CP", "Unlocked Care Plan", SYSTEM_SHEETS.SOURCE_PREFIX + "Unlocked CP"] }
    ], timing);

    if (typeof populateActiveIndex === "function") populateActiveIndex();
    notifyArchiveMonthlySheetsResult_("Archive Monthly Sub-Reports", parsed.monthLabel + " and prior", result);
    return result;
  });
}

function archiveMonthlyActiveSheets() {
  const monthParts = promptForLockedYearReportMonth_("Archive Active Sheets (Month & Prior)");
  if (!monthParts) return null;
  const parsed = monthParts;

  return runFrameworkTimed_("Archive Monthly Active Sheets " + parsed.monthLabel + " & Prior", function(timing) {
    const result = archiveMonthlySheetsBySpecs_(parsed, [
      { label: "Raw Data", keywords: ["Raw Data", SYSTEM_SHEETS.SOURCE_PREFIX + "Raw Data"] },
      { label: "Master List", keywords: ["Master List"] },
      { label: "Monthly Change", keywords: ["Monthly Change"] }
    ], timing);

    if (typeof populateActiveIndex === "function") populateActiveIndex();
    notifyArchiveMonthlySheetsResult_("Archive Monthly Active Sheets", parsed.monthLabel + " and prior", result);
    return result;
  });
}

function archiveMonthlySheetsBySpecs_(parsedMonth, specs, timing) {
  const writeLock = LockService.getDocumentLock();
  if (!writeLock.tryLock(30000)) {
    throw new Error("Another write workflow is already running: archiveMonthlySheetsBySpecs.");
  }
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID");
    if (!archiveId) throw new Error("RFF_ARCHIVE_SPREADSHEET_ID is not configured.");

    const archiveSs = SpreadsheetApp.openById(archiveId);
    const result = { archived: [], skipped: [], failed: [] };
    if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archive workbook connection established for batch", "Archive ID: " + archiveId);

    specs.forEach(function(spec) {
      const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
      if (!sheets.length) {
        logBestEffortWarning_("No local sheet found for " + spec.label + " " + parsedMonth.monthLabel + " or prior");
        result.skipped.push(spec.label);
        return;
      }

      sheets.forEach(function(sheet) {
        const sheetName = sheet.getName();
        try {
          const archiveResult = copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing);
          result.archived.push(sheetName);
          if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archived monthly sheet: " + sheetName, archiveResult.localAction);
        } catch (err) {
          logBestEffortWarning_("Archive monthly sheet failed: " + sheetName + " - " + err.message);
          result.failed.push(sheetName + ": " + err.message);
        }
      });
    });

    pingArchiveIndexUpdate_();

    return result;

  } finally {
    writeLock.releaseLock();
  }
}

function pingArchiveIndexUpdate_() {
  try {
    const archiveWebAppUrl = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_WEB_APP_URL");
    if (archiveWebAppUrl) {
      UrlFetchApp.fetch(archiveWebAppUrl, { muteHttpExceptions: true });
    }
  } catch (err) {
    logBestEffortWarning_("Failed to ping Archive Index Web App: " + err.message);
  }
}

function findArchiveMonthlyCandidateSheetsUpToDate_(ss, keywords, cutoffDate) {
  const keywordList = (keywords || []).map(function(keyword) {
    return String(keyword || "").trim().toLowerCase();
  }).filter(Boolean);

  const matches = [];
  const seen = new Set();
  const cutoffKey = cutoffDate ? Number(Utilities.formatDate(cutoffDate, Session.getScriptTimeZone(), "yyyyMM")) : 0;

  ss.getSheets().forEach(function(sheet) {
    const name = sheet.getName();
    const lowerName = name.toLowerCase();
    if (lowerName.indexOf("template") !== -1) return;

    const hasKeyword = keywordList.some(function(keyword) { return lowerName.indexOf(keyword) !== -1; });
    if (!hasKeyword) return;
    if (seen.has(name)) return;

    const sheetDate = extractFirstDateFromSheetName_(name);
    if (sheetDate) {
      const sheetKey = Number(Utilities.formatDate(sheetDate, Session.getScriptTimeZone(), "yyyyMM"));
      if (sheetKey <= cutoffKey) {
        seen.add(name);
        matches.push(sheet);
      }
    }
  });

  matches.sort(function(a, b) { return a.getName().localeCompare(b.getName()); });
  return matches;
}

function notifyArchiveMonthlySheetsResult_(title, monthLabel, result) {
  const msg = title + " complete for " + monthLabel + ".\nArchived: " + (result.archived ? result.archived.length : 0) +
              "\nSkipped: " + (result.skipped ? result.skipped.length : 0) +
              "\nFailed: " + (result.failed ? result.failed.length : 0);
  SpreadsheetApp.getActiveSpreadsheet().toast(msg, title, 5);
}

function copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing) {
  const archiveResult = archiveRawSourceSheet_(sheet, sheetName, timing, "Archive monthly sheet", archiveSs);
  activateVisibleSheetBeforeHiding_(sheet);
  ss.deleteSheet(sheet);
  return { localAction: "Deleted local sheet " + sheetName, archiveName: archiveResult.archivedName };
}


// ============================================================================
// 3.4. SLASH-DELIMITED FORMATTING ENGINE
// ============================================================================

function applyDelimitedProperty_(range, propertyValue, type) {
  if (propertyValue === undefined || propertyValue === null || propertyValue === "") return;
  const strVal = String(propertyValue);

  if (strVal.indexOf('/') === -1) {
    applySingleCellProperty_(range, strVal.trim(), type);
  } else {
    const parts = strVal.split('/');
    const startRow = range.getRow();
    const startCol = range.getColumn();
    const sheet = range.getSheet();
    const maxCols = sheet.getMaxColumns();

    for (let i = 0; i < parts.length; i++) {
      const val = parts[i].trim();
      if (val !== "" && (startCol + i) <= maxCols) {
        const cell = sheet.getRange(startRow, startCol + i, range.getNumRows(), 1);
        applySingleCellProperty_(cell, val, type);
      }
    }
  }
}

function applySingleCellProperty_(range, val, type) {
  if (!val) return;
  if (type === "fontSize" && !isNaN(Number(val))) {
    range.setFontSize(Number(val));
  } else if (type === "fontWeight") {
    const lower = val.toLowerCase();
    range.setFontWeight(lower === "bold" ? "bold" : "normal");
    range.setFontStyle(lower === "italic" ? "italic" : "normal");
  } else if (type === "alignment") {
    range.setHorizontalAlignment(val.toLowerCase());
  } else if (type === "wrap") {
    range.setWrapStrategy(getWrapStrategyEnum_(val));
  } else if (type === "dateFormat") {
    const isDateFormat = /^[mdy\/\-\.\s]+$/i.test(val) && val.toLowerCase().indexOf('m') !== -1;
    if (isDateFormat) {
      range.setNumberFormat(val);
    } else {
      range.setValue(val);
    }
  }
}

function getWrapStrategyEnum_(wrapStr) {
  var w = String(wrapStr || "").toUpperCase();
  if (w === "WRAP") return SpreadsheetApp.WrapStrategy.WRAP;
  if (w === "OVERFLOW") return SpreadsheetApp.WrapStrategy.OVERFLOW;
  if (w === "CLIP") return SpreadsheetApp.WrapStrategy.CLIP;
  throw new Error("Format Dashboard has an invalid wrap strategy: " + wrapStr + ".");
}

function getBorderStyleEnum_(styleName) {
  var key = String(styleName || "").trim().toUpperCase();
  var styles = {
    SOLID: SpreadsheetApp.BorderStyle.SOLID,
    SOLID_MEDIUM: SpreadsheetApp.BorderStyle.SOLID_MEDIUM,
    SOLID_THICK: SpreadsheetApp.BorderStyle.SOLID_THICK,
    DASHED: SpreadsheetApp.BorderStyle.DASHED,
    DOTTED: SpreadsheetApp.BorderStyle.DOTTED,
    DOUBLE: SpreadsheetApp.BorderStyle.DOUBLE
  };
  if (!styles[key]) throw new Error("Format Dashboard has an invalid Global Border Style: " + styleName + ".");
  return styles[key];
}

// ============================================================================
// 3.5. TEMPLATE BUILDERS
// ============================================================================

function createOrRefreshBaseTemplate_() {
  if (typeof createGovernedSheet_ !== "function") throw new Error("Base-template creation requires the governed output factory.");
  var baseSheet = createGovernedSheet_(SYSTEM_SHEETS.BASE_TEMPLATE, null, {
    isTemplate: true,
    isSystemSetup: true,
    customName: SYSTEM_SHEETS.BASE_TEMPLATE,
    overwrite: true
  });

  if (typeof loadDashboardConfig_ !== "function") throw new Error("Base-template formatting requires Format Dashboard configuration.");
  var dashboard = loadDashboardConfig_(true);
  var globals = dashboard.baseTemplateGlobals;
  if (!globals || !Object.keys(globals).length) {
    throw new Error("Format Dashboard Section A has no settings enabled for Base Template formatting.");
  }

  if (hasDashboardFormattingValue_(globals, "Freeze Rows")) baseSheet.setFrozenRows(Number(globals["Freeze Rows"]));
  if (hasDashboardFormattingValue_(globals, "Freeze Columns")) baseSheet.setFrozenColumns(Number(globals["Freeze Columns"]));

  var baseCols = 80;
  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(baseSheet, 100, baseCols + 1);

  var fullRange = baseSheet.getRange(1, 1, 100, baseCols + 1);
  if (hasDashboardFormattingValue_(globals, "Standard Font")) fullRange.setFontFamily(globals["Standard Font"]);
  if (hasDashboardFormattingValue_(globals, "Standard Font Size")) fullRange.setFontSize(Number(globals["Standard Font Size"]));
  if (hasDashboardFormattingValue_(globals, "Standard Font Color")) fullRange.setFontColor(globals["Standard Font Color"]);
  if (hasDashboardFormattingValue_(globals, "Default Horizontal Alignment")) fullRange.setHorizontalAlignment(String(globals["Default Horizontal Alignment"]).toLowerCase());
  if (hasDashboardFormattingValue_(globals, "Default Vertical Alignment")) fullRange.setVerticalAlignment(String(globals["Default Vertical Alignment"]).toLowerCase());
  if (hasDashboardFormattingValue_(globals, "Default Data Wrap")) fullRange.setWrapStrategy(getWrapStrategyEnum_(globals["Default Data Wrap"]));
  if (hasDashboardFormattingValue_(globals, "Standard Font Weight")) fullRange.setFontWeight(globals["Standard Font Weight"]);
  if (hasDashboardFormattingValue_(globals, "Default Background Color")) fullRange.setBackground(globals["Default Background Color"]);
  if (hasDashboardFormattingValue_(globals, "Default Text Format")) fullRange.setNumberFormat(globals["Default Text Format"]);
  if (hasDashboardFormattingValue_(globals, "Global Borders Enabled")) {
    var bordersEnabled = String(globals["Global Borders Enabled"]).toUpperCase() === "TRUE";
    if (bordersEnabled) {
      fullRange.setBorder(true, true, true, true, true, true,
        requireDashboardFormattingValue_(globals, "Global Border Color", "enabled base-template borders"),
        getBorderStyleEnum_(requireDashboardFormattingValue_(globals, "Global Border Style", "enabled base-template borders")));
    } else {
      fullRange.setBorder(false, false, false, false, false, false);
    }
  }

  if (hasDashboardFormattingValue_(globals, "Row 1 (Title)Height")) baseSheet.setRowHeight(1, Number(globals["Row 1 (Title)Height"]));
  if (hasDashboardFormattingValue_(globals, "Row 2 Height")) baseSheet.setRowHeight(2, Number(globals["Row 2 Height"]));
  if (hasDashboardFormattingValue_(globals, "Row 3 Height")) baseSheet.setRowHeight(3, Number(globals["Row 3 Height"]));
  var headerRow = hasDashboardFormattingValue_(globals, "Header Row") ? Number(globals["Header Row"]) : null;
  var dataStartRow = hasDashboardFormattingValue_(globals, "Data Start Row") ? Number(globals["Data Start Row"]) : null;
  if (headerRow && hasDashboardFormattingValue_(globals, "Row 4 (Header) Height")) baseSheet.setRowHeight(headerRow, Number(globals["Row 4 (Header) Height"]));

  if (dataStartRow && dataStartRow <= 100 && hasDashboardFormattingValue_(globals, "Default Data Row Height")) {
    baseSheet.setRowHeights(dataStartRow, 100 - dataStartRow + 1, Number(globals["Default Data Row Height"]));
  }

  if (hasDashboardFormattingValue_(globals, "Default Column Width")) {
    var defaultWidth = Number(globals["Default Column Width"]);
    for (var c = 1; c <= baseCols + 1; c++) { baseSheet.setColumnWidth(c, defaultWidth); }
  }

  var cellA1 = baseSheet.getRange("A1");
  if (hasDashboardFormattingValue_(globals, "A1 (Title) Font Size")) cellA1.setFontSize(Number(globals["A1 (Title) Font Size"]));
  if (hasDashboardFormattingValue_(globals, "A1 (Title) Font Style")) cellA1.setFontWeight(globals["A1 (Title) Font Style"]);
  if (hasDashboardFormattingValue_(globals, "A1 (Title) Wrap")) cellA1.setWrapStrategy(getWrapStrategyEnum_(globals["A1 (Title) Wrap"]));

  var cellC1 = baseSheet.getRange("C1");
  if (hasDashboardFormattingValue_(globals, "C1 (Title) Font Size")) cellC1.setFontSize(Number(globals["C1 (Title) Font Size"]));
  if (hasDashboardFormattingValue_(globals, "C1 (Title) Wrap")) cellC1.setWrapStrategy(getWrapStrategyEnum_(globals["C1 (Title) Wrap"]));

  if (headerRow && hasDashboardFormattingValue_(globals, "Row 4 (Header) Wrap")) {
    baseSheet.getRange(headerRow, 1, 1, baseCols).setWrapStrategy(getWrapStrategyEnum_(globals["Row 4 (Header) Wrap"]));
  }

  if (typeof trimCreatedSheetToSize_ === "function") trimCreatedSheetToSize_(baseSheet, 100, baseCols);
  if (typeof writeConfiguredSheetGovernanceNote_ === "function") {
    writeConfiguredSheetGovernanceNote_(baseSheet, SYSTEM_SHEETS.BASE_TEMPLATE, true);
  }
  baseSheet.hideSheet();
  return baseSheet;
}

function createTemplateFromBase_(targetName, systemSheetName, timing) {
  if (typeof createGovernedSheet_ !== "function") throw new Error("Template creation requires the governed output factory.");
  const governedType = systemSheetName || (targetName === SYSTEM_SHEETS.DASHBOARD_DEFAULT
    ? SYSTEM_SHEETS.DASHBOARD
    : String(targetName || "").replace(/^Template\s*-\s*/i, "").trim());
  return createGovernedSheet_(governedType, null, {
    isTemplate: true,
    isSystemSetup: true,
    customName: targetName,
    overwrite: true,
    timing: timing
  });
}

function buildGeneralTemplate_(config, timing) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sysName = config.systemSheetName;
  var templateName = config.templateName || (SYSTEM_SHEETS.TEMPLATE_PREFIX + sysName);

  if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Build General Template", "Creating template base for: " + templateName);
  // A caller may provide a newly-created, data-only sheet. This keeps content
  // creation separate from the general formatting pass while preserving the
  // original base-template behavior for every other template.
  var providedSheet = config.existingTemplateSheet || config.unformattedSheet;
  var templateSheet = providedSheet || createTemplateFromBase_(templateName, sysName, timing);
  // An existing template sheet has already been copied from the base and
  // named by its caller. Do not copy or rename it again.
  if (!config.existingTemplateSheet && templateSheet.getName() !== templateName) templateSheet.setName(templateName);
  templateSheet.showSheet();

  if (typeof positionSheetBySectionFRank_ === "function") positionSheetBySectionFRank_(templateSheet, config.rank);

  var contentCols = Math.max(config.columnCount || 0, config.headers ? config.headers.length : 0, 1);
  var targetCols = contentCols + 1;
  var targetRows = Number(config.minimumRows);
  if (!targetRows || targetRows < 1) throw new Error("General template configuration is missing a valid Minimum Rows value from Format Dashboard.");
  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(templateSheet, targetRows, targetCols);

  if (config.unformattedSheet) applyGeneralSheetDefaults_(templateSheet, config, targetRows, targetCols);

  var theme = config.theme;
  validateDashboardFormattingConfig_(config, theme, sysName);

  const isDashboardSurface = sysName === SYSTEM_SHEETS.DASHBOARD || templateName === SYSTEM_SHEETS.DASHBOARD_DEFAULT;
  if (isDashboardSurface) {
    templateSheet.getBandings().forEach(function(banding) { banding.remove(); });
  } else if (config.usesAlternatingColors !== false) {
    if (typeof applyNativeBandingSafe_ === "function") applyNativeBandingSafe_(templateSheet, 5, targetCols, targetRows, theme.level4, theme.level5);
  }

  if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Apply Titles: " + templateName, "Applying title rows");
  applyTitleRows_(templateSheet, config, theme);

  if (!config.formatExistingSections && config.usesSubheaders && config.subheaders && config.subheaders.length > 0) {
    if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Apply Subheaders: " + templateName, "Applying subheader blocks");
    applySubheaderBlocks_(templateSheet, config.subheaders, theme, sysName, config);
  }

  if (config.formatExistingSections) {
    if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Format Existing Sections: " + templateName, "Applying dashboard section headers and subheaders");
    applyExistingSectionFormatting_(templateSheet, config, theme);
  }

  applyColumnWidthsEngine_(templateSheet, config);

  if (theme.level1) templateSheet.setTabColor(theme.level1);
  writeTemplateMetadata_(templateSheet, config, targetCols);
  if (typeof trimCreatedSheetToSize_ === "function") trimCreatedSheetToSize_(templateSheet, targetRows, contentCols);
  if (typeof writeConfiguredSheetGovernanceNote_ === "function") {
    writeConfiguredSheetGovernanceNote_(templateSheet, sysName, true);
    if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Write Template Rank Note: " + templateName, "Governance metadata written to B1 note");
  }

  templateSheet.hideSheet();
  return templateSheet;
}

function applyGeneralSheetDefaults_(sheet, config, rowCount, columnCount) {
  var globals = config.globals;
  var fontFamily = requireDashboardFormattingValue_(globals, "Standard Font", "general sheet defaults");
  var fontSize = Number(requireDashboardFormattingValue_(globals, "Standard Font Size", "general sheet defaults"));
  var fontColor = requireDashboardFormattingValue_(globals, "Standard Font Color", "general sheet defaults");
  var horizontal = String(requireDashboardFormattingValue_(globals, "Default Horizontal Alignment", "general sheet defaults")).toLowerCase();
  var vertical = String(requireDashboardFormattingValue_(globals, "Default Vertical Alignment", "general sheet defaults")).toLowerCase();
  var wrapName = String(requireDashboardFormattingValue_(globals, "Default Data Wrap", "general sheet defaults")).toUpperCase();
  var wrapStrategy = getWrapStrategyEnum_(wrapName);

  sheet.getRange(1, 1, rowCount, columnCount)
    .setFontFamily(fontFamily)
    .setFontSize(fontSize)
    .setFontColor(fontColor)
    .setFontWeight(requireDashboardFormattingValue_(globals, "Standard Font Weight", "general sheet defaults"))
    .setHorizontalAlignment(horizontal)
    .setVerticalAlignment(vertical)
    .setWrapStrategy(wrapStrategy)
    .setNumberFormat(requireDashboardFormattingValue_(globals, "Default Text Format", "general sheet defaults"))
    .setBackground(requireDashboardFormattingValue_(globals, "Default Background Color", "general sheet defaults"));

  var bordersEnabled = String(requireDashboardFormattingValue_(globals, "Global Borders Enabled", "general sheet defaults")).toUpperCase() === "TRUE";
  sheet.getRange(1, 1, rowCount, columnCount).setBorder(
    bordersEnabled, bordersEnabled, bordersEnabled, bordersEnabled, bordersEnabled, bordersEnabled,
    requireDashboardFormattingValue_(globals, "Global Border Color", "general sheet defaults"),
    getBorderStyleEnum_(requireDashboardFormattingValue_(globals, "Global Border Style", "general sheet defaults"))
  );

  var defaultRowHeight = Number(requireDashboardFormattingValue_(globals, "Default Data Row Height", "general sheet defaults"));
  sheet.setRowHeights(1, rowCount, defaultRowHeight);

  sheet.setFrozenRows(Math.max(Number(requireDashboardFormattingValue_(globals, "Freeze Rows", "general sheet defaults")), 0));
  sheet.setFrozenColumns(Math.max(Number(requireDashboardFormattingValue_(globals, "Freeze Columns", "general sheet defaults")), 0));
}

function requireDashboardFormattingValue_(source, key, context) {
  if (!source || source[key] === undefined || source[key] === null || String(source[key]).trim() === "") {
    throw new Error("Format Dashboard is missing '" + key + "' required for " + context + ".");
  }
  return source[key];
}

function hasDashboardFormattingValue_(source, key) {
  return !!source && source[key] !== undefined && source[key] !== null && String(source[key]).trim() !== "";
}

function validateDashboardFormattingConfig_(config, theme, systemSheetName) {
  if (!config || !config.dashboard || !config.globals) {
    throw new Error("General template formatting requires configuration loaded from Default - Format Dashboard or Format Dashboard.");
  }
  ["level1", "level2", "level3", "level4", "level5", "titleFontColor"].forEach(function(level) {
    requireDashboardFormattingValue_(theme, level, "the " + systemSheetName + " theme");
  });
  if (!Array.isArray(config.titleRows) || !config.titleRows.length) {
    throw new Error("Format Dashboard contains no title-row formatting specifications for " + systemSheetName + ".");
  }
  if (config.usesSubheaders && (!Array.isArray(config.subheaderRowSpecs) || !config.subheaderRowSpecs.length)) {
    throw new Error("Format Dashboard contains no subheader-row formatting specifications for " + systemSheetName + ".");
  }
}

/**
 * Resolves row-format specifications from the parsed Format Dashboard section.
 * This prevents callers or legacy defaults from becoming a second formatting
 * authority: title rows always come from Section E and subheaders from Section F.
 *
 * @param {object} config Template configuration containing the parsed dashboard.
 * @param {string} collectionName Dashboard collection (`titleRows` or `subheaderRows`).
 * @param {string} systemSheetName Governed sheet type.
 * @param {string} sectionLabel Human-readable dashboard section for errors.
 * @return {object[]} Applicable GLOBAL and sheet-specific formatting rows.
 */
function getDashboardSectionRowSpecs_(config, collectionName, systemSheetName, sectionLabel) {
  const dashboardRows = config && config.dashboard && config.dashboard[collectionName];
  if (!Array.isArray(dashboardRows) || !dashboardRows.length) {
    throw new Error("Format Dashboard " + sectionLabel + " contains no formatting rows for " + systemSheetName + ".");
  }
  const target = String(systemSheetName || "").trim().toLowerCase();
  const applicable = dashboardRows.filter(function(spec) {
    const sheetType = String(spec && spec.sheetType || "GLOBAL").trim().toLowerCase();
    return sheetType === "global" || sheetType === target;
  });
  if (!applicable.length) {
    throw new Error("Format Dashboard " + sectionLabel + " contains no applicable formatting rows for " + systemSheetName + ".");
  }
  return applicable;
}

/**
 * Applies the general template theme to section banners and their header rows
 * when a caller supplied an already-populated, data-only template sheet.
 */
function applyExistingSectionFormatting_(sheet, config, theme) {
  var values = sheet.getDataRange().getDisplayValues();
  var width = Math.max(Number(config.columnCount) || sheet.getLastColumn(), 1);
  var sectionRows = [];

  for (var rowIndex = 0; rowIndex < values.length; rowIndex++) {
    if (String(values[rowIndex][0] || "").trim().indexOf("SECTION ") !== 0) continue;

    sectionRows.push(rowIndex + 1);
  }

  var specs = getDashboardSectionRowSpecs_(config, "subheaderRows", config.systemSheetName, "Section F");
  var requiredSteps = [1, 2, 3, 4, 5, 6];
  requiredSteps.forEach(function(stepNum) {
    if (!getDashboardRowFormattingSpec_(specs, stepNum)) {
      throw new Error("Format Dashboard must define subheader formatting row " + stepNum + ".");
    }
  });

  sectionRows.forEach(function(sectionRow) {
    requiredSteps.forEach(function(stepNum) {
      var targetRow = sectionRow + stepNum - 2;
      if (targetRow < 1 || targetRow > sheet.getMaxRows()) return;

      var spec = getDashboardRowFormattingSpec_(specs, stepNum);
      applyDashboardRowFormattingSpec_(
        sheet,
        sheet.getRange(targetRow, 1, 1, width),
        spec,
        theme,
        "subheader row " + stepNum
      );
    });
  });
}

function getDashboardRowFormattingSpec_(specs, rowNumber) {
  var matchingSpec = null;
  (specs || []).forEach(function(spec) {
    if (Number(spec.row) === Number(rowNumber)) matchingSpec = spec;
  });
  return matchingSpec;
}

function applyDashboardRowFormattingSpec_(sheet, range, spec, theme, context) {
  var height = Number(requireDashboardFormattingValue_(spec, "height", context));
  var fillLevel = String(requireDashboardFormattingValue_(spec, "fillLevel", context)).toLowerCase().replace(/[^a-z0-9]/g, "");
  sheet.setRowHeight(range.getRow(), height);
  range.setBackground(fillLevel === "none" ? null : requireDashboardFormattingValue_(theme, fillLevel, context + " fill"));
  applyDelimitedProperty_(range, spec.fontSize, "fontSize");
  applyDelimitedProperty_(range, spec.fontWeight, "fontWeight");
  applyDelimitedProperty_(range, requireDashboardFormattingValue_(spec, "alignment", context), "alignment");
  applyDelimitedProperty_(range, requireDashboardFormattingValue_(spec, "wrap", context), "wrap");
}

function applyTitleRows_(sheet, config, theme) {
  var sysName = config.systemSheetName || "";
  var fullGridCols = sheet.getMaxColumns();
  var sectionETitleRows = getDashboardSectionRowSpecs_(config, "titleRows", sysName, "Section E");

  var titleCell = sheet.getRange("A1");
  titleCell.setValue(config.reportTitle || sysName);

  if (!config.usesSubheaders && config.headers && config.headers.length > 0) {
    var headerTextRange = sheet.getRange(4, 1, 1, config.headers.length);
    headerTextRange.setValues([config.headers]);
  }

  if (config.titleDateFormat) {
    applyDelimitedProperty_(sheet.getRange(2, 1, 1, fullGridCols), config.titleDateFormat, "dateFormat");
  }

  sectionETitleRows.forEach(function(spec) {
    const rowNumber = Number(requireDashboardFormattingValue_(spec, "row", "title-row formatting"));
    if (rowNumber > sheet.getMaxRows()) return;

    const rowRange = sheet.getRange(rowNumber, 1, 1, fullGridCols);
    applyDashboardRowFormattingSpec_(sheet, rowRange, spec, theme, "title row " + rowNumber);
    rowRange.setFontColor(requireDashboardFormattingValue_(theme, "titleFontColor", "title-row font color"));
  });
}

function applySubheaderBlocks_(sheet, subheaders, theme, sysName, config) {
  if (!sheet || !subheaders || !subheaders.length) return;
  const maxCols = sheet.getMaxColumns();
  const sectionFSpecs = getDashboardSectionRowSpecs_(config, "subheaderRows", sysName, "Section F");
  
  let startRow = 6;
  const totalRows = subheaders.length * 6;
  
  // Pre-build 2D matrices for values and backgrounds
  const valueMatrix = [];
  const bgMatrix = [];
  const rowHeights = [];

  subheaders.forEach(function(block) {
    [1, 2, 3, 4, 5, 6].forEach(function(stepNum) {
      const spec = getDashboardRowFormattingSpec_(sectionFSpecs, stepNum);
      const height = Number(spec.height || 25);
      rowHeights.push(height);

      const fillLevel = String(spec.fillLevel || "").toLowerCase().replace(/[^a-z0-9]/g, "");
      const bg = (fillLevel === "none" || !fillLevel) ? "#ffffff" : (theme[fillLevel] || "#ffffff");
      
      const rowValues = new Array(maxCols).fill("");
      const rowBgs = new Array(maxCols).fill(bg);

      if (stepNum === 2) {
        rowValues[0] = block.title;
        if (sysName.indexOf("Timing") !== -1 || sysName.indexOf("Quality") !== -1 || (block.stampLastUpdated && sysName.indexOf("Monthly Change") === -1)) {
          rowValues[2] = "Last Updated";
        }
      } else if (stepNum === 4 && block.headers && block.headers.length) {
        for (let i = 0; i < block.headers.length && i < maxCols; i++) {
          rowValues[i] = block.headers[i];
        }
      } else if (stepNum === 6) {
        rowValues[0] = "Insert new data here";
      }

      valueMatrix.push(rowValues);
      bgMatrix.push(rowBgs);
    });
  });

  // Apply in single batch operations
  const targetRange = sheet.getRange(startRow, 1, totalRows, maxCols);
  targetRange.setValues(valueMatrix);
  targetRange.setBackgrounds(bgMatrix);

  // Apply row heights in bulk
  rowHeights.forEach(function(h, idx) {
    sheet.setRowHeight(startRow + idx, h);
  });
}

function applyColumnWidthsEngine_(sheet, config) {
  if (!sheet) return;
  var targetCols = sheet.getMaxColumns();
  var dashConfig = config.dashboard;
  if (!dashConfig) {
    if (typeof loadDashboardConfig_ !== "function") throw new Error("Column-width formatting requires Format Dashboard configuration.");
    dashConfig = loadDashboardConfig_(true);
  }
  var defaultColWidth = Number(requireDashboardFormattingValue_(dashConfig.globals, "Default Column Width", "column-width formatting"));
  var widthSpec = String(config.columnWidths || "").trim();

  if (widthSpec && widthSpec.toUpperCase() !== "FIT_TO_DATA") {
    var widthParts = widthSpec.split('/');
    var parsedWidths = widthParts.map(function(item) {
      var token = item.trim();
      return token === "" ? null : parseInt(token, 10);
    });
    if (parsedWidths.some(function(width) { return width !== null && !isNaN(width) && width > 0; })) {
      if (widthParts.length === 1 && parsedWidths[0] > 0) {
        // BATCH OPTIMIZATION
        sheet.setColumnWidths(1, targetCols, parsedWidths[0]);
      } else {
        for (var i = 0; i < targetCols && i < parsedWidths.length; i++) {
          if (parsedWidths[i] !== null && !isNaN(parsedWidths[i]) && parsedWidths[i] > 0) {
            sheet.setColumnWidth(i + 1, parsedWidths[i]);
          }
        }
      }
      return;
    }
  }
  // BATCH OPTIMIZATION
  sheet.setColumnWidths(1, targetCols, defaultColWidth);
}

function applyOperationalFormatting_(templateSheet, systemSheetName, dashboardConfig) {
  if (!templateSheet) return;
  let config = dashboardConfig;
  if (!config && typeof loadDashboardConfig_ === "function") config = loadDashboardConfig_(true);
  if (!config) throw new Error("Operational formatting requires Format Dashboard configuration.");
  let sysKey = systemSheetName;
  if (typeof getStandardSheetKey_ === "function") sysKey = getStandardSheetKey_(systemSheetName);

  const headers = config.sheetHeaders[systemSheetName] || config.sheetHeaders[sysKey] || [];
  if (!headers || headers.length === 0) return;

  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(templateSheet, templateSheet.getMaxRows(), headers.length + 1);

  const colDefs = config.columnDefinitions || {};
  const defaultWidth = Number(requireDashboardFormattingValue_(config.globals, "Default Column Width", "operational column formatting"));
  const defaultWrap = requireDashboardFormattingValue_(config.globals, "Default Data Wrap", "operational wrap formatting");
  const defaultHAlign = requireDashboardFormattingValue_(config.globals, "Default Horizontal Alignment", "operational horizontal alignment");
  const defaultVAlign = requireDashboardFormattingValue_(config.globals, "Default Vertical Alignment", "operational vertical alignment");
  const headerRowNumber = Number(requireDashboardFormattingValue_(config.globals, "Header Row", "operational header placement"));
  const dataStartRow = Number(requireDashboardFormattingValue_(config.globals, "Data Start Row", "operational data placement"));
  const maxRows = templateSheet.getMaxRows();

  const governedHeaderRange = templateSheet.getRange(headerRowNumber, 1, 1, headers.length);
  governedHeaderRange.setValues([headers]);

  // BATCH OPTIMIZATION
  templateSheet.setColumnWidths(1, headers.length, defaultWidth);

  for (let c = 0; c < headers.length; c++) {
    const headerName = String(headers[c] || "").trim();
    const colDef = colDefs[headerName] || colDefs[headerName.toLowerCase()] || {};
    const colIdx = c + 1;

    // ONLY OVERRIDE IF DIFFERENT FROM DEFAULT
    if (colDef.width && colDef.width > 0 && colDef.width !== defaultWidth) {
      templateSheet.setColumnWidth(colIdx, colDef.width);
    }

    if (colDef.fontSize && colDef.fontSize > 0) {
      templateSheet.getRange(headerRowNumber, colIdx).setFontSize(colDef.fontSize);
    }

    if (maxRows >= dataStartRow) {
      const dataColRange = templateSheet.getRange(dataStartRow, colIdx, maxRows - dataStartRow + 1, 1);

      if (colDef.dateColumn) {
        const dateNumberFormat = requireDashboardFormattingValue_(
          colDef,
          "format",
          "Format Dashboard Section G date column " + headerName
        );
        dataColRange.setNumberFormat(String(dateNumberFormat).trim());
      } else if (colDef.format) {
        dataColRange.setNumberFormat(String(colDef.format).trim());
      }

      const hAlign = colDef.align || defaultHAlign;
      if (hAlign) dataColRange.setHorizontalAlignment(hAlign.toLowerCase());

      const vAlign = colDef.vAlign || defaultVAlign;
      if (vAlign) dataColRange.setVerticalAlignment(vAlign.toLowerCase());

      const wrapStr = colDef.wrap || defaultWrap;
      if (wrapStr) dataColRange.setWrapStrategy(getWrapStrategyEnum_(wrapStr));
    }
  }

  if (typeof trimCreatedSheetToSize_ === "function") trimCreatedSheetToSize_(templateSheet, templateSheet.getMaxRows(), headers.length);
}

function writeTemplateMetadata_(sheet, config, targetColumns) {
  if (!sheet || !config) throw new Error("Template metadata requires a sheet and configuration.");
  const column = Math.max(Math.min(Number(targetColumns) || 1, sheet.getMaxColumns()), 1);
  const version = typeof MASTER_LIST_MERGE_ML_VERSION !== "undefined" ? MASTER_LIST_MERGE_ML_VERSION : "v2.0";
  sheet.getRange(1, column).setNote("Template Mold: " + config.systemSheetName + "\nVersion: " + version + "\nUpdated: " + new Date().toISOString());
}

