  { key: "sectionA_Globals", title: "SECTION A - GLOBAL SETTINGS" },
  { key: "sectionB_Creation", title: "SECTION B - SHEET CREATION & LIFECYCLE GOVERNANCE" },
  { key: "sectionC_Structural", title: "SECTION C - TEMPLATE STRUCTURAL SPECS" },
  { key: "sectionD_OutputGov", title: "SECTION D - ACTIVE OUTPUT GOVERNANCE" },
