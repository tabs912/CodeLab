// ============================================================================
// 3.1. SHEET TAB RANKING & ORGANIZATION ENGINE (HARDCODED FOR RELIABILITY)
// ============================================================================

function organizeTabs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheets = ss.getSheets();

  ss.toast("Organizing tabs... Please wait.", "System Engine", 3);

  // --- SNAPSHOT START ---
  const visibilitySnapshot = {};
  sheets.forEach(s => visibilitySnapshot[s.getName()] = s.isSheetHidden());

  // Temporarily unhide all sheets to avoid moveActiveSheet errors
  sheets.forEach(s => {
    if (s.isSheetHidden()) s.showSheet();
  });
  // --- SNAPSHOT END ---

  // --- SORTING START ---
  sheets = ss.getSheets();
  const sheetData = sheets.map(s => {
    const name = s.getName();
    let rank = 999;

    const note = s.getRange("B1").getNote() || "";
    const matchNote = note.match(/Tab Rank:\s*(\d+)/i);
    if (matchNote) {
      rank = parseInt(matchNote[1], 10);
    } else if (typeof getTargetRankForSheet_ === "function") {
      rank = getTargetRankForSheet_(name);
    }

    let dateVal = 0;
    const dateMatch = name.match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
      let m = parseInt(dateMatch[1], 10);
      let y = parseInt(dateMatch[2], 10);
      if (y < 100) y += 2000;
      dateVal = new Date(y, m - 1, 1).getTime();
    }

    return { 
      sheet: s, 
      name: name, 
      rank: rank, 
      dateVal: dateVal, 
      unformattedSort: typeof getUnformattedSheetSortKey_ === "function" ? getUnformattedSheetSortKey_(name) : { monthValue: 0, reportOrder: 99 } 
    };
  });

  sheetData.sort((a, b) => {
    if (a.rank !== b.rank) return a.rank - b.rank;
    if (a.rank === 999) {
      if (a.unformattedSort.monthValue !== b.unformattedSort.monthValue) return b.unformattedSort.monthValue - a.unformattedSort.monthValue;
      if (a.unformattedSort.reportOrder !== b.unformattedSort.reportOrder) return a.unformattedSort.reportOrder - b.unformattedSort.reportOrder;
    }
    if (a.dateVal !== b.dateVal) return b.dateVal - a.dateVal;
    return a.name.localeCompare(b.name);
  });

  sheetData.forEach((data, i) => {
    const targetPos = i + 1;
    if (data.sheet.getIndex() !== targetPos) {
      ss.setActiveSheet(data.sheet);
      ss.moveActiveSheet(targetPos);
    }
  });
  // --- SORTING END ---

  // --- RESTORE VISIBILITY START ---
  sheetData.forEach(data => {
    let shouldHide = false;
    const note = data.sheet.getRange("B1").getNote() || "";

    if (note.indexOf("Visibility: HIDDEN") !== -1 || data.name.indexOf("Template -") === 0 || data.name === "RFF_BASE_TEMPLATE") {
      shouldHide = true;
    } else if (visibilitySnapshot.hasOwnProperty(data.name)) {
      shouldHide = visibilitySnapshot[data.name];
    }

    if (shouldHide) {
      // Use the built-in system function to safely select another tab before hiding
      if (typeof hideSheetIfNeeded_ === "function") {
         hideSheetIfNeeded_(data.sheet);
      } else {
         data.sheet.hideSheet();
      }
    }
  });
  // --- RESTORE VISIBILITY END ---

  ss.toast("Tabs organized and visibility perfectly restored!", "Success", 4);
}

function getUnformattedSheetSortKey_(sheetName) {
  const name = String(sheetName || "").trim();
  const lower = name.toLowerCase();
  
  // 1. Maintain precise order: RD=0, B=1, CD=2, UC=3
  const reportOrder = lower.indexOf("raw data") !== -1 || /(?:^|[^a-z])rd(?:[^a-z]|$)/i.test(name) ? 0
    : lower.indexOf("banner") !== -1 || /(?:^|[^a-z])b(?:[^a-z]|$)/i.test(name) ? 1
    : lower.indexOf("cp due") !== -1 || lower.indexOf("care plan due") !== -1 || /(?:^|[^a-z])cd(?:[^a-z]|$)/i.test(name) ? 2
    : lower.indexOf("unlock") !== -1 || /(?:^|[^a-z])uc(?:[^a-z]|$)/i.test(name) ? 3 : 99;
    
  let month = 0;
  let year = 0;

  // 2. Check for standard MM.YY, MM/YY, MM-YY format
  const numeric = name.match(/(?:^|[^0-9])(0?[1-9]|1[0-2])[.\/-](20\d{2}|\d{2})(?:[^0-9]|$)/);
  if (numeric) {
    month = Number(numeric[1]);
    year = Number(numeric[2]);
    if (year > 0 && year < 100) year += 2000;
  } else {
    // 3. Check for full spelled-out Month name
    const monthNames = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"];
    for (let i = 0; i < monthNames.length; i++) {
      if (new RegExp("(?:^|[^a-z])" + monthNames[i] + "(?:[^a-z]|$)", "i").test(lower)) {
        month = i + 1;
        break;
      }
    }
    
    // 4. Check for standalone MM format (e.g. "RD 04" or "B 4")
    if (!month) {
      const standaloneMonth = name.match(/(?:^|\s)(0?[1-9]|1[0-2])(?:\s|$)/);
      if (standaloneMonth) {
        month = Number(standaloneMonth[1]);
      }
    }
    
    const yearMatch = name.match(/(?:^|[^0-9])(20\d{2})(?:[^0-9]|$)/);
    if (yearMatch) year = Number(yearMatch[1]);
  }

  return { monthValue: month ? ((year || 0) * 12 + month) : 0, reportOrder: reportOrder };
}

function positionSheetBySectionFRank_(sheet, optionalRank, spreadsheet) {
  if (!sheet) return;
  try {
    var ss = spreadsheet || SpreadsheetApp.getActiveSpreadsheet();
    var currentSheet = ss.getSheetByName(sheet.getName());
    if (!currentSheet) return;

    var wasHidden = currentSheet.isSheetHidden();

    var targetRank = (optionalRank !== undefined && optionalRank !== null) ? optionalRank : getTargetRankForSheet_(currentSheet.getName());

    var targetDateVal = 0;
    var dateMatch = currentSheet.getName().match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        targetDateVal = new Date(y, m - 1, 1).getTime();
    }

    var sheets = ss.getSheets();
    var targetPos = 1;

    for (var i = 0; i < sheets.length; i++) {
      if (sheets[i].getName() === currentSheet.getName()) continue;

      var otherRank = getTargetRankForSheet_(sheets[i].getName());
      var otherDateVal = 0;
      var otherMatch = sheets[i].getName().match(/(\d{2})[.\/-](\d{2,4})/);
      if (otherMatch) {
        let m = parseInt(otherMatch[1], 10);
        let y = parseInt(otherMatch[2], 10);
        if (y < 100) y += 2000;
        otherDateVal = new Date(y, m - 1, 1).getTime();
      }

      var placeAfter = false;
      if (otherRank < targetRank) {
        placeAfter = true;
      } else if (otherRank === targetRank) {
        if (otherDateVal > targetDateVal) {
          placeAfter = true;
        } else if (otherDateVal === targetDateVal) {
          if (sheets[i].getName().localeCompare(currentSheet.getName()) < 0) placeAfter = true;
        }
      }
      if (placeAfter) targetPos++;
    }

    if (currentSheet.getIndex() !== targetPos) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(Math.min(Math.max(1, targetPos), sheets.length));
      
      // RESTORE VISIBILITY AFTER MOVING
      if (wasHidden) {
        var otherVisible = ss.getSheets().find(function(s) { return s.getName() !== currentSheet.getName() && !s.isSheetHidden(); });
        if (otherVisible) {
          ss.setActiveSheet(otherVisible);
          currentSheet.hideSheet();
        }
      }
    }
  } catch (e) {
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Non-fatal tab position operation failed: " + e.message);
  }
}


function getTargetRankForSheet_(sheetName) {
  const name = String(sheetName || "").trim().toLowerCase();

  if (name.indexOf("template - ") !== 0) {
    let monthlyBaseRank = null;
    if (name.indexOf("source - raw data") === 0) monthlyBaseRank = 27;
    else if (name.indexOf("source - banners") === 0) monthlyBaseRank = 28;
    else if (name.indexOf("source - cp due") === 0) monthlyBaseRank = 29;
    else if (name.indexOf("source - unlock cp") === 0 || name.indexOf("source - unlocked cp") === 0) monthlyBaseRank = 30;
    else if (name.indexOf("master list") === 0) monthlyBaseRank = 21;
    else if (name.indexOf("monthly change") === 0) monthlyBaseRank = 22;
    else if (name.indexOf("raw data") === 0) monthlyBaseRank = 23;
    else if (name.indexOf("banners") === 0) monthlyBaseRank = 24;
    else if (name.indexOf("cp due") === 0 || name.indexOf("care plan due") === 0) monthlyBaseRank = 25;
    else if (name.indexOf("unlock cp") === 0 || name.indexOf("unlocked cp") === 0) monthlyBaseRank = 26;

    const monthMatch = name.match(/(?:^|\s)(0[1-9]|1[0-2])\.\d{2,4}(?:\s+v\d+)?$/i);
    if (monthlyBaseRank !== null && monthMatch) {
      const monthNumber = Number(monthMatch[1]);
      return monthlyBaseRank + ((12 - monthNumber) * 22);
    }
  }

  if (name === "index") return 1;
  if (name === "refined data") return 2;
  if (name.indexOf("disenrolled") === 0) return 10;

  if (name.indexOf("master list") === 0) return 21;
  if (name.indexOf("monthly change") === 0) return 22;
  if (name.indexOf("raw data") === 0) return 23;

  if (name.indexOf("banners") === 0) return 24;
  if (name.indexOf("cp due") === 0 || name.indexOf("care plan due") === 0) return 25;
  if (name.indexOf("unlock cp") === 0 || name.indexOf("unlocked cp") === 0) return 26;

  if (name.indexOf("source - raw data") === 0) return 27;
  if (name.indexOf("source - banners") === 0) return 28;
  if (name.indexOf("source - cp due") === 0) return 29;
  if (name.indexOf("source - unlock cp") === 0 || name.indexOf("source - unlocked cp") === 0) return 30;

  if (name.indexOf("archive - refined data") === 0) return 350;

  if (name.indexOf("framework timing") === 0) return 500;
  if (name.indexOf("dashboard quality") === 0) return 501;
  if (name === "format dashboard") return 502;
  if (name === "default - format dashboard") return 812;

  if (name === "rff_base_template") return 814;
  if (name.indexOf("template - ") === 0) {
    if (name.indexOf("banners") !== -1) return 801;
    if (name.indexOf("cp due") !== -1) return 802;
    if (name.indexOf("unlock") !== -1) return 803;
    if (name.indexOf("raw data") !== -1) return 804;
    if (name.indexOf("refined data") !== -1 && name.indexOf("archive") === -1) return 805;
    if (name.indexOf("disenrolled") !== -1) return 806;
    if (name.indexOf("master list") !== -1) return 807;
    if (name.indexOf("monthly change") !== -1) return 808;
    if (name.indexOf("archive - refined data") !== -1) return 809;
    if (name.indexOf("framework timing") !== -1) return 810;
    if (name.indexOf("dashboard quality") !== -1) return 811;
    return 800;
  }

  return 999;
}

function matchSheetToSectionFRule_(sheetName) {
  const rank = getTargetRankForSheet_(sheetName);
  let group = "Unformatted";

  if (rank === 1 || (rank >= 500 && rank <= 502)) group = "System & Configuration";
  else if (rank === 2 || rank === 10 || rank === 350) group = "Core Operational";
  else if (rank >= 21 && rank <= 23) group = "Monthly Active";
  else if (rank >= 24 && rank <= 26) group = "Monthly Sub-Reports";
  else if (rank >= 27 && rank <= 30) group = "Source Data";
  else if (rank >= 800 && rank <= 814) group = "Template";

  return { group: group, rank: rank };
}

