function updateIndexSheet() {
  if (typeof populateIndexData === "function") {
    populateIndexData(SYSTEM_SHEETS.INDEX);
  } else if (typeof populateActiveIndex === "function") {
    populateActiveIndex();
  }

  if (typeof syncArchiveIndexToActiveIndex_ === "function") {
    syncArchiveIndexToActiveIndex_();
  }
}

function populateActiveIndex() {
  populateIndexData(SYSTEM_SHEETS.INDEX);
}

function populateIndexData(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = targetName || SYSTEM_SHEETS.INDEX;
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;

  // ---> Dynamically adds the Restore button if it is missing <---
  ensureRestoreButtonOnIndex_(sheet);

  const timestampStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss");
  const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "";

  sheet.getRange("B2").setValue(timestampStr);
  sheet.getRange("G2").setValue(archiveId);

  const activeSheets = ss.getSheets();
  const activeSheetMap = new Map();

  // Load Dashboard Config ONCE into memory (Zero extra API calls)
  let dashboardConfig = null;
  try {
    if (typeof loadDashboardConfig_ === "function") dashboardConfig = loadDashboardConfig_();
  } catch(e) {}

  activeSheets.forEach(s => {
    const name = s.getName();
    if (name !== sheetName && name !== SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.INDEX) {
      
      let match = { group: "Unformatted", rank: 999 };
      if (typeof matchSheetToSectionFRule_ === "function") {
        match = matchSheetToSectionFRule_(name);
      }

      // Determine group entirely from memory (0 API calls!)
      let groupFromMemory = "";
      const isTemplate = (name.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) === 0 || name === SYSTEM_SHEETS.BASE_TEMPLATE || name === SYSTEM_SHEETS.DASHBOARD_DEFAULT);

      // Scan Section B of the Format Dashboard completely in memory
      if (dashboardConfig && dashboardConfig.creationRules) {
         if (dashboardConfig.creationRules[name] && dashboardConfig.creationRules[name].group) {
             groupFromMemory = dashboardConfig.creationRules[name].group;
         } else if (isTemplate) {
             groupFromMemory = "Template";
         } else {
             const normalizedName = name.replace(/^Template\s*-\s*/i, "").trim();
             const keys = Object.keys(dashboardConfig.creationRules);
             for(let i = 0; i < keys.length; i++) {
               const rule = dashboardConfig.creationRules[keys[i]];
               const prefix = String(rule.namingPattern || keys[i]).split(/\bmm[.\/-]?yy\b/i)[0].trim();
               if (normalizedName === keys[i] || normalizedName.indexOf(keys[i] + " ") === 0 || (prefix && normalizedName.indexOf(prefix) === 0)) {
                 groupFromMemory = rule.group;
                 break;
               }
             }
         }
      }

      let finalGroup = groupFromMemory || match.group;
      
      if (isTemplate) {
         const standardActiveGroups = ["Core Operational", "Monthly Active", "Monthly Sub-Reports", "System & Configuration", "Source Data", "Unformatted"];
         if (standardActiveGroups.includes(finalGroup)) {
             finalGroup = "Template";
         }
      }

      activeSheetMap.set(name, {
        sheet: s,
        group: finalGroup,
        rank: match.rank,
        visibility: s.isSheetHidden() ? "Hidden" : "Visible",
        link: `=HYPERLINK("#gid=${s.getSheetId()}", "Open Live Tab")`
      });
    }
  });

  const lastRow = sheet.getLastRow();
  let existingActiveMatrix = [];
  if (lastRow >= 5) {
    existingActiveMatrix = sheet.getRange(5, 1, lastRow - 4, 4).getValues();
  }

  const groupMap = new Map();
  let currentGroup = "Unformatted";

  existingActiveMatrix.forEach(row => {
    const colA = String(row[0] || "").trim();
    const colB = String(row[1] || "").trim();

    if (colA !== "") {
      currentGroup = colA;
      if (!groupMap.has(currentGroup)) groupMap.set(currentGroup, []);
    } else if (colB !== "") {
      if (activeSheetMap.has(colB)) {
        const liveInfo = activeSheetMap.get(colB);
        if (!groupMap.has(currentGroup)) groupMap.set(currentGroup, []);
        groupMap.get(currentGroup).push({
          name: colB, link: liveInfo.link, visibility: liveInfo.visibility, rank: liveInfo.rank
        });
        activeSheetMap.delete(colB);
      }
    }
  });

  activeSheetMap.forEach((info, newSheetName) => {
    if (!groupMap.has(info.group)) groupMap.set(info.group, []);
    groupMap.get(info.group).push({
      name: newSheetName, link: info.link, visibility: info.visibility, rank: info.rank
    });
  });

  const standardGroupOrder = [
    "Core Operational",
    "Monthly Active",
    "Monthly Sub-Reports",
    "System & Configuration",
    "Source Data"
  ];

  const sortedGroups = Array.from(groupMap.keys()).sort((a, b) => {
    if (a === "Unformatted") return 1;
    if (b === "Unformatted") return -1;
    if (a === "Template" || a === "Templates") return 1;
    if (b === "Template" || b === "Templates") return -1;

    let indexA = standardGroupOrder.indexOf(a);
    let indexB = standardGroupOrder.indexOf(b);

    if (indexA === -1 && indexB === -1) return a.localeCompare(b);
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;

    return indexA - indexB;
  });

  const finalActiveMatrix = [];

  sortedGroups.forEach(groupName => {
    const items = groupMap.get(groupName);
    if (!items || items.length === 0) return;

    finalActiveMatrix.push([groupName, "", "", ""]);

    items.sort((a, b) => {
      if (groupName === "Template" || groupName === "Templates") {
        if (a.name === SYSTEM_SHEETS.DASHBOARD_DEFAULT) return -1;
        if (b.name === SYSTEM_SHEETS.DASHBOARD_DEFAULT) return 1;
      }
      const dateA = typeof extractFirstDateFromSheetName_ === "function" ? extractFirstDateFromSheetName_(a.name).getTime() : 0;
      const dateB = typeof extractFirstDateFromSheetName_ === "function" ? extractFirstDateFromSheetName_(b.name).getTime() : 0;

      if (groupName === "Unformatted" && typeof getUnformattedSheetSortKey_ === "function") {
        const sortA = getUnformattedSheetSortKey_(a.name);
        const sortB = getUnformattedSheetSortKey_(b.name);
        if (sortA.monthValue !== sortB.monthValue) return sortB.monthValue - sortA.monthValue;
        if (sortA.reportOrder !== sortB.reportOrder) return sortA.reportOrder - sortB.reportOrder;
      }
      if (a.rank !== b.rank) return a.rank - b.rank;
      if (dateA !== dateB) return dateB - dateA;
      return a.name.localeCompare(b.name);
    });

    items.forEach(item => {
      finalActiveMatrix.push(["", item.name, item.link, item.visibility]);
    });
  });

  const targetWriteRows = Math.max(finalActiveMatrix.length, existingActiveMatrix.length);

  if (targetWriteRows > 0) {
    if (typeof resizeSheetGrid_ === "function") {
      resizeSheetGrid_(sheet, Math.max(targetWriteRows + 4, 20), 10);
    }
    sheet.getRange(5, 1, targetWriteRows, 4).clearContent();
    if (finalActiveMatrix.length > 0) {
      sheet.getRange(5, 1, finalActiveMatrix.length, 4).setValues(finalActiveMatrix);
    }
  }
}

function ensureRestoreButtonOnIndex_(sheet) {
  if (!sheet) return;
  try {
    const images = sheet.getImages();
    for (let i = 0; i < images.length; i++) {
      // --- FIX ML19741-001: Correctly use getScript() ---
      if (images[i].getScript() === "restoreSheetFromActiveIndexRow") {
        return; 
      }
    }
    
    const iconUrl = "https://cdn-icons-png.flaticon.com/512/2889/2889708.png"; 
    const response = UrlFetchApp.fetch(iconUrl);
    
    const image = sheet.insertImage(response.getBlob(), 8, 2); 
    image.setWidth(40);
    image.setHeight(40);
    image.assignScript("restoreSheetFromActiveIndexRow");
  } catch(e) {
    if (typeof logBestEffortWarning_ === "function") {
      logBestEffortWarning_("Could not ensure restore button on Index: " + e.message);
    }
  }
}

function applyIndexGroupDividerRules_(sheet, level2Override) {
  if (!sheet) return;
  
  let level2 = String(level2Override || "").trim();
  if (!level2 && typeof getTemplateTheme_ === "function") {
    level2 = getTemplateTheme_(SYSTEM_SHEETS.INDEX).level2;
  }
  if (!level2) throw new Error("Index group dividers require the governed Index Level 2 fill color.");

  const maxRows = Math.max(sheet.getMaxRows() - 4, 1);
  
  const activeDataRange = sheet.getRange(5, 1, maxRows, 4);
  const archiveDataRange = sheet.getRange(5, 6, maxRows, 5); 

  const retainedRules = sheet.getConditionalFormatRules().filter(function(rule) {
    const condition = rule.getBooleanCondition();
    if (!condition) return true;
    return condition.getCriteriaType() !== SpreadsheetApp.BooleanCriteria.CUSTOM_FORMULA;
  });

  const activeDividerRule = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=AND($A5<>"", $B5="")')
    .setBackground(level2)
    .setBold(true)
    .setRanges([activeDataRange])
    .build();

  const archiveDividerRule = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=AND($F5<>"", $G5="", REGEXMATCH($F5, "(?i)January|February|March|April|May|June|July|August|September|October|November|December"))')
    .setBackground(level2)
    .setBold(true)
    .setRanges([archiveDataRange])
    .build();

  sheet.setConditionalFormatRules(retainedRules.concat([activeDividerRule, archiveDividerRule]));
}

function syncArchiveIndexToActiveIndex_(targetSheet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  const indexSheet = (targetSheet && typeof targetSheet.getRange === "function") 
    ? targetSheet 
    : ss.getSheetByName(SYSTEM_SHEETS.INDEX);
    
  if (!indexSheet) return;

  const props = PropertiesService.getDocumentProperties();
  let archiveId = props.getProperty("RFF_ARCHIVE_SPREADSHEET_ID") || "1PEEoXzPG-xRFuqDW_ZjPzyqdTUd_5AOwx0nbbzmMwBc";
  props.setProperty("RFF_ARCHIVE_SPREADSHEET_ID", archiveId);

  indexSheet.getRange("G2").setValue(archiveId);

  let archiveSs;
  try {
    archiveSs = SpreadsheetApp.openById(archiveId);
  } catch (err) {
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Archive Sync failed: " + err.message);
    return;
  }

  const archiveIndexSheet = archiveSs.getSheetByName(SYSTEM_SHEETS.INDEX);
  if (!archiveIndexSheet) return;

  const archiveLastRow = Math.max(archiveIndexSheet.getLastRow(), 4);
  const activeMaxCols = indexSheet.getMaxColumns();
  const archiveMaxCols = archiveIndexSheet.getMaxColumns();

  const activeHeaders = indexSheet.getRange(4, 1, 1, activeMaxCols).getValues()[0].map(function(h) { return String(h || "").trim(); });
  const archiveHeaders = archiveIndexSheet.getRange(4, 1, 1, archiveMaxCols).getValues()[0].map(function(h) { return String(h || "").trim(); });

  let rightSideStartIdx = 5; 
  for (let i = 0; i < activeHeaders.length; i++) {
     const lower = activeHeaders[i].toLowerCase();
     if (lower.indexOf("archive") !== -1 || lower.indexOf("restore") !== -1 || (lower === "status" && i > 4)) {
         rightSideStartIdx = i;
         break;
     }
  }
  
  const numRightCols = activeHeaders.length - rightSideStartIdx;
  if (numRightCols <= 0) return;

  const maxRowsToClear = Math.max(indexSheet.getLastRow() - 4, 1);
  indexSheet.getRange(5, rightSideStartIdx + 1, maxRowsToClear, numRightCols).clearContent();

  if (archiveLastRow < 5) return;

  const archiveData = archiveIndexSheet.getRange(5, 1, archiveLastRow - 4, archiveMaxCols).getValues();
  const archiveFormulas = archiveIndexSheet.getRange(5, 1, archiveLastRow - 4, archiveMaxCols).getFormulas();
  const outputMatrix = [];

  const archHeadersLower = archiveHeaders.map(function(h) { return h.toLowerCase(); });
  const idxMonth = archHeadersLower.findIndex(function(h) { return h.indexOf("month") !== -1; });
  const idxName = archHeadersLower.findIndex(function(h) { return h.indexOf("sheet name") !== -1; });
  const idxLink = archHeadersLower.findIndex(function(h) { return h.indexOf("link") !== -1; });
  const idxStatus = archHeadersLower.findIndex(function(h) { return h === "status" || h === "visibility"; });

  archiveData.forEach(function(row, rIdx) {
    const formulaRow = archiveFormulas[rIdx];
    
    const colMonth = idxMonth !== -1 ? String(row[idxMonth] || "").trim() : "";
    const colName = idxName !== -1 ? String(row[idxName] || "").trim() : "";
    const colStatus = idxStatus !== -1 ? String(row[idxStatus] || "").trim() : "";
    
    let colLink = "";
    if (idxLink !== -1) {
       colLink = String(formulaRow[idxLink] || "").trim();
       if (!colLink) colLink = String(row[idxLink] || "").trim(); 
       
       if (colLink.indexOf("#gid=") !== -1) {
           colLink = colLink.replace("#gid=", "https://docs.google.com/spreadsheets/d/" + archiveId + "/edit#gid=");
       }
    }

    if (!colMonth && !colName) return;

    const mappedRow = new Array(numRightCols).fill("");

    if (colMonth && !colName) {
       for (let i = 0; i < numRightCols; i++) {
         if (activeHeaders[rightSideStartIdx + i].toLowerCase().indexOf("month") !== -1) {
            mappedRow[i] = colMonth;
         }
       }
       outputMatrix.push(mappedRow);
       return; 
    }

    for (let i = 0; i < numRightCols; i++) {
       const activeHeaderLower = activeHeaders[rightSideStartIdx + i].toLowerCase();
       if (!activeHeaderLower) continue;

       if (activeHeaderLower.indexOf("restore") !== -1) {
           mappedRow[i] = "Use Menu: Index > Restore Selected"; 
       } else if (activeHeaderLower.indexOf("sheet name") !== -1) {
           mappedRow[i] = colName;
       } else if (activeHeaderLower.indexOf("month") !== -1) {
           mappedRow[i] = colMonth;
       } else if (activeHeaderLower.indexOf("link") !== -1 || activeHeaderLower.indexOf("url") !== -1) {
           mappedRow[i] = colLink;
       } else if (activeHeaderLower === "status" || activeHeaderLower === "visibility") {
           mappedRow[i] = colStatus;
       }
    }

    outputMatrix.push(mappedRow);
  });

  if (typeof resizeSheetGrid_ === "function") {
    resizeSheetGrid_(indexSheet, Math.max(outputMatrix.length + 4, 20), activeMaxCols);
  }

  if (outputMatrix.length > 0) {
    indexSheet.getRange(5, rightSideStartIdx + 1, outputMatrix.length, numRightCols).setValues(outputMatrix);
  }
}


function checkSheetDeletionAndUpdateIndex_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const currentSheetCount = ss.getSheets().length;
  const props = PropertiesService.getDocumentProperties();
  const previousSheetCount = Number(props.getProperty("RFF_LAST_KNOWN_SHEET_COUNT") || 0);

  if (previousSheetCount > 0 && currentSheetCount < previousSheetCount) {
    if (typeof populateActiveIndex === "function") {
      populateActiveIndex();
    }
    ss.toast("Sheet deletion detected. Index updated!", "Index Engine", 3);
  }

  props.setProperty("RFF_LAST_KNOWN_SHEET_COUNT", String(currentSheetCount));
}

