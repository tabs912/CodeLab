// ============================================================================
// 2.1. UNIVERSAL GOVERNED SHEET FACTORY
// ============================================================================

/**
 * PRE-FLIGHT GATEWAY: Evaluates collision, rank, grouping, color, and visibility.
 * Returns the exact blueprint required to construct and position a sheet safely.
 *
 * @param {string} baseName Requested sheet name.
 * @param {object} ruleNode Configuration object from Dashboard Section B.
 * @param {boolean} isTemplate True when building a Template mold.
 * @return {object} Governance blueprint.
 */
function resolveSheetGovernance_(baseName, ruleNode, isTemplate) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const protectedSystemTabs = new Set(["format dashboard", "rff_base_template"]);
  const cleanName = String(baseName == null ? "" : baseName).replace(/[\\/?:*\[\]]/g, "").trim().substring(0, 100);

  if (!cleanName) return { abort: true, reason: "Sheet creation halted: The governed sheet name is blank after sanitization." };

  ruleNode = ruleNode || {};
  const collisionPolicy = String(ruleNode.collisionPolicy || "OVERWRITE").trim().toUpperCase();
  const isVisible = isTemplate ? false : String(ruleNode.visibility || "VISIBLE").trim().toUpperCase() !== "HIDDEN";
  const tabColor = ruleNode.tabColor || null;
  const groupName = String(ruleNode.group || "General").trim() || "General";
  let evaluatedRank = isTemplate ? Number(ruleNode.templateRank || 999) : Number(ruleNode.activeRank || 500);
  let isDynamic = false;

  if (!isTemplate && typeof ruleNode.getDynamicRank === "function") {
    evaluatedRank = Number(ruleNode.getDynamicRank(cleanName, ss));
    isDynamic = true;
  } else if (!isTemplate && ruleNode.dynamicRankRule) {
    evaluatedRank = calculateDynamicRank_(ruleNode, cleanName, ss);
    isDynamic = true;
  }
  if (!isFinite(evaluatedRank)) evaluatedRank = isTemplate ? 999 : 500;

  if (protectedSystemTabs.has(cleanName.toLowerCase()) && collisionPolicy === "OVERWRITE" && ruleNode.allowProtectedOverwrite !== true) {
    return { abort: true, reason: `Safety Guardrail: Cannot overwrite protected system tab "${cleanName}".` };
  }

  let finalName = cleanName;
  const targetSheet = ss.getSheetByName(finalName);
  let overwriteRequired = false;
  let existingTargetSheet = null;

  if (targetSheet) {
    if (collisionPolicy === "OVERWRITE") {
      if (ss.getSheets().length <= 1) {
        return { abort: true, reason: `Safety Guardrail: Cannot overwrite the only sheet in the workbook ("${cleanName}").` };
      }
      // --- FIX: Flag for overwrite, do NOT delete yet ---
      overwriteRequired = true;
      existingTargetSheet = targetSheet;
    } else if (collisionPolicy === "INCREMENT") {
      let counter = 1;
      while (ss.getSheetByName(cleanName + " v" + counter)) counter++;
      finalName = cleanName + " v" + counter;
    } else if (collisionPolicy === "ABORT" || collisionPolicy === "FAIL") {
      return { abort: true, reason: `Sheet "${finalName}" already exists and Collision Policy is set to ${collisionPolicy}.` };
    } else {
      return { abort: true, reason: `Sheet creation halted: Unsupported Collision Policy "${collisionPolicy}".` };
    }
  }

  const activeSheets = ss.getSheets();
  let insertIndex = activeSheets.length;
  let cachedConfig = null;
  try { cachedConfig = typeof loadDashboardConfig_ === "function" ? loadDashboardConfig_() : null; } catch (e) {}

  for (let i = 0; i < activeSheets.length; i++) {
    const currentSheetName = activeSheets[i].getName();
    const currentRank = getRankForSheetName_(currentSheetName, isTemplate, cachedConfig);
    if (evaluatedRank < currentRank || (evaluatedRank === currentRank && finalName.localeCompare(currentSheetName) < 0)) {
      insertIndex = i;
      break;
    }
  }

  return {
    finalName: finalName,
    insertIndex: insertIndex,
    isVisible: isVisible,
    targetRank: evaluatedRank,
    isDynamicRank: isDynamic,
    tabColor: tabColor,
    groupName: groupName,
    overwriteRequired: overwriteRequired,
    existingTargetSheet: existingTargetSheet,
    abort: false,
    reason: "Governance resolved successfully."
  };
}

/**
 * Retrieves the configured Section B rank for an existing sheet.
 *
 * @param {string} sheetName Existing sheet name.
 * @param {boolean} asTemplate Whether template rank should be used.
 * @return {number} Resolved rank or safe fallback.
 */
function getRankForSheetName_(sheetName, asTemplate, cachedConfig) {
  let config = cachedConfig;
  if (!config) {
    try { config = typeof loadDashboardConfig_ === "function" ? loadDashboardConfig_() : null; } catch (e) {}
  }
  if (!config) return 999;

  const creationRules = config.creationRules || {};
  const definitions = config.sheetDefinitions || {};
  const exactName = String(sheetName || "").trim();
  const lookupName = exactName.replace(/^Template\s*-\s*/i, "").trim();

  let rule = (asTemplate ? getTemplateCreationRule_(creationRules, exactName) : null) ||
    creationRules[exactName] || definitions[exactName] ||
    creationRules[lookupName] || definitions[lookupName] || null;

  if (!rule) {
    const keys = Object.keys(creationRules);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      const candidate = creationRules[key] || {};
      const patternPrefix = String(candidate.namingPattern || key).split(/\bmm[.\/-]?yy\b/i)[0].trim();
      if (lookupName === key || lookupName.indexOf(key + " ") === 0 ||
          (patternPrefix && lookupName.indexOf(patternPrefix) === 0)) {
        rule = candidate;
        break;
      }
    }
  }

  if (!rule) return 999;
  if (!asTemplate && rule.dynamicRankRule) return calculateDynamicRank_(rule, sheetName, SpreadsheetApp.getActiveSpreadsheet());
  const rank = asTemplate ? Number(rule.templateRank) : Number(rule.activeRank);
  return isFinite(rank) ? rank : (asTemplate ? 999 : 500);
}

/**
 * Finds the dedicated Section B row for a template name or naming pattern.
 *
 * @param {object} creationRules Parsed Section B creation rules.
 * @param {string} templateName Actual template tab name.
 * @return {?object} Exact template rule, or null when none is configured.
 */
function getTemplateCreationRule_(creationRules, templateName) {
  const rules = creationRules || {};
  const exactName = String(templateName || "").trim();
  if (rules[exactName]) return rules[exactName];

  const keys = Object.keys(rules);
  for (let i = 0; i < keys.length; i++) {
    const candidate = rules[keys[i]] || {};
    if (String(candidate.group || "").trim().toLowerCase() !== "template") continue;
    if (String(candidate.namingPattern || "").trim() === exactName) return candidate;
  }
  return null;
}

/**
 * Resolves an optional dynamic rank without requiring a global evaluator.
 *
 * @param {object} ruleNode Section B rule.
 * @param {string} cleanName Sanitized target name.
 * @param {GoogleAppsScript.Spreadsheet.Spreadsheet} ss Active spreadsheet.
 * @return {number} Evaluated rank.
 */
function calculateDynamicRank_(ruleNode, cleanName, ss) {
  void ss;
  const dynamicRule = ruleNode && ruleNode.dynamicRankRule;
  const baseRank = Number(dynamicRule && dynamicRule.baseRank != null ? dynamicRule.baseRank : ruleNode && ruleNode.templateRank);
  const monthStride = Number(dynamicRule && dynamicRule.monthStride != null ? dynamicRule.monthStride : 22);
  const zeroOffsetMonth = Number(dynamicRule && dynamicRule.zeroOffsetMonth != null ? dynamicRule.zeroOffsetMonth : 12);
  const month = extractDynamicRankMonth_(cleanName);
  if (isFinite(baseRank) && isFinite(monthStride) && isFinite(zeroOffsetMonth) && month >= 1 && month <= 12) {
    return baseRank + ((zeroOffsetMonth - month) * monthStride);
  }
  const fallback = Number(ruleNode && ruleNode.activeRank);
  return isFinite(fallback) ? fallback : (isFinite(baseRank) ? baseRank : 500);
}

/**
 * Reads the final mm.yy month token used by monthly governed sheet names.
 * December is month 12 and therefore receives the zero-month offset.
 *
 * @param {string} sheetName Governed sheet name.
 * @return {number} Month 1-12, or -1 when no governed month token exists.
 */
function extractDynamicRankMonth_(sheetName) {
  const match = String(sheetName || "").trim().match(/(?:^|\s)(0[1-9]|1[0-2])\.\d{2,4}(?:\s+v\d+)?$/i);
  return match ? Number(match[1]) : -1;
}

/**
 * Writes resolved sheet governance metadata to the B1 note.
 * Existing non-governance note text is preserved.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sheet Governed sheet.
 * @param {object} governance Resolved governance blueprint.
 */
function writeSheetGovernanceNote_(sheet, governance) {
  if (!sheet || !governance) return;
  const requiredColumn = 2;
  if (sheet.getMaxColumns() < requiredColumn) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), requiredColumn - sheet.getMaxColumns());
  }

  const marker = "[Sheet Governance]";
  if (sheet.getMaxColumns() >= 6) {
    const legacyRange = sheet.getRange("F1");
    const legacyNote = String(legacyRange.getNote() || "");
    const legacyMarkerIndex = legacyNote.indexOf(marker);
    if (legacyMarkerIndex !== -1) legacyRange.setNote(legacyNote.substring(0, legacyMarkerIndex).trim());
  }

  const range = sheet.getRange("B1");
  const existingNote = String(range.getNote() || "");
  const markerIndex = existingNote.indexOf(marker);
  const preservedNote = (markerIndex === -1 ? existingNote : existingNote.substring(0, markerIndex)).trim();
  
  const governanceNote = [
    marker,
    "Tab Rank: " + governance.targetRank,
    "Group: " + governance.groupName,
    "Visibility: " + (governance.isVisible ? "VISIBLE" : "HIDDEN"),
    "Dynamic Rank: " + (governance.isDynamicRank ? "YES" : "NO")
  ].join("\n");

  range.setNote((preservedNote ? preservedNote + "\n\n" : "") + governanceNote);
}

/**
 * Applies a non-destructive governance note to an existing system sheet or template.
 *
 * @param {string} sheetName Existing sheet name.
 * @param {object} dashboardConfig Loaded dashboard schema.
 * @return {string} Matched system sheet name.
 */
function getGovernedSheetTypeForName_(sheetName, dashboardConfig) {
  const config = dashboardConfig || (typeof loadDashboardConfig_ === "function" ? loadDashboardConfig_(true) : null);
  const rules = config && config.creationRules ? config.creationRules : {};
  const normalizedName = String(sheetName || "").replace(/^Template\s*-\s*/i, "").trim();
  const keys = Object.keys(rules);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const rule = rules[key] || {};
    const patternPrefix = String(rule.namingPattern || key).split(/\bmm[.\/-]?yy\b/i)[0].trim();
    if (normalizedName === key || normalizedName.indexOf(key + " ") === 0 ||
        (patternPrefix && normalizedName.indexOf(patternPrefix) === 0)) return key;
  }
  return normalizedName;
}

function writeConfiguredSheetGovernanceNote_(sheet, sheetType, isTemplate) {
  if (!sheet) return null;
  const config = typeof loadDashboardConfig_ === "function" ? loadDashboardConfig_(true) : null;
  const rules = config && config.creationRules ? config.creationRules : {};
  const rule = (isTemplate && getTemplateCreationRule_(rules, sheet.getName())) || rules[sheetType] || null;
  if (!rule) return null;
  const dynamic = !isTemplate && !!rule.dynamicRankRule;
  const targetRank = isTemplate
    ? Number(rule.templateRank || 999)
    : (dynamic ? calculateDynamicRank_(rule, sheet.getName(), sheet.getParent()) : Number(rule.activeRank || rule.templateRank || 500));
  const sheets = sheet.getParent().getSheets();
  let insertIndex = sheets.length - 1;
  for (let i = 0; i < sheets.length; i++) {
    if (sheets[i].getSheetId() === sheet.getSheetId()) { insertIndex = i; break; }
  }
  const governance = {
    targetRank: isFinite(targetRank) ? targetRank : (isTemplate ? 999 : 500),
    groupName: String(rule.group || "General"),
    isVisible: isTemplate ? false : String(rule.visibility || "VISIBLE").toUpperCase() !== "HIDDEN",
    isDynamicRank: dynamic,
    insertIndex: insertIndex
  };
  writeSheetGovernanceNote_(sheet, governance);
  return governance;
}

function createGovernedSheet_(sheetType, monthParts, options) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  options = options || {};

  const allowFallback = options.isTemplate === true || options.isSystemSetup === true;
  const dashboard = (typeof loadDashboardConfig_ === "function") ? loadDashboardConfig_(allowFallback) : getFallbackDashboardConfig_();

  const rule = (dashboard.creationRules && dashboard.creationRules[sheetType]) || {
    namingPattern: sheetType + " mm.yy", group: "Other", templateRank: 800, activeRank: 999,
    visibility: "VISIBLE", collisionPolicy: "OVERWRITE", trimmingPolicy: "TRIM_TO_DATA", indexRegistration: true, special: ""
  };

  const outGov = (dashboard.outputGovernance && dashboard.outputGovernance[sheetType]) || {};
  const enforceHeight = outGov.rowHeightEnforcement !== false;
  const isTemplateBuild = options.isTemplate === true;
  const templateSpec = (dashboard.sheetDefinitions && dashboard.sheetDefinitions[sheetType]) || {};

  let targetName = options.customName || (isTemplateBuild ? templateSpec.templateName || (SYSTEM_SHEETS.TEMPLATE_PREFIX + sheetType) : (monthParts ? buildMonthlySheetName_(rule.namingPattern, monthParts.firstDay, monthParts.lastDay) : sheetType));

  const templateRule = isTemplateBuild && dashboard.creationRules ? getTemplateCreationRule_(dashboard.creationRules, targetName) : null;
  const effectiveRule = Object.assign({}, templateRule || rule);
  if (isTemplateBuild || options.overwrite === true) effectiveRule.collisionPolicy = "OVERWRITE";
  effectiveRule.allowProtectedOverwrite = options.isSystemSetup === true;
  if (options.overwrite === false && String(effectiveRule.collisionPolicy || "").toUpperCase() === "OVERWRITE") {
    effectiveRule.collisionPolicy = "ABORT";
  }

  let template = null;
  if (!isTemplateBuild && !options.sourceSheet) {
    const templateName = options.templateName || templateSpec.templateName || (SYSTEM_SHEETS.TEMPLATE_PREFIX + sheetType);
    template = ss.getSheetByName(templateName);
    if (!template) throw new Error(`Template mold "${templateName}" not found. Build templates first.`);
  }

  const governance = resolveSheetGovernance_(targetName, effectiveRule, isTemplateBuild);
  if (governance.abort) throw new Error(governance.reason);
  if (typeof markFrameworkStep_ === "function") markFrameworkStep_(options.timing, "Factory - Governance preflight passed", governance.finalName);

  // --- FIX ML19743-002: Generate unique bounded temp and backup names ---
  const safeBaseName = governance.finalName.substring(0, 80);
  const uniqueId = new Date().getTime().toString().slice(-6);
  const tempName = governance.overwriteRequired ? safeBaseName + "_TMP_" + uniqueId : governance.finalName;
  const backupName = governance.overwriteRequired ? safeBaseName + "_BAK_" + uniqueId : "";

  let sheet = null;

  // --- FIX ML19743-002: Move copy/name setup inside the cleanup-protected try block ---
  try {
    if (options.sourceSheet) {
      sheet = options.sourceSheet.copyTo(ss);
    } else if (!isTemplateBuild) {
      sheet = template.copyTo(ss);
    } else {
      const base = ss.getSheetByName(SYSTEM_SHEETS.BASE_TEMPLATE);
      sheet = base ? base.copyTo(ss) : ss.insertSheet();
    }
    
    sheet.setName(tempName);
    SpreadsheetApp.flush();

    if (monthParts && !isTemplateBuild) {
      try {
        sheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("MM/dd/yyyy");
        sheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("MM/dd/yyyy");
      } catch (e) { logBestEffortWarning_("Could not apply dates to B2/D2: " + e.message); }
    }

    if (governance.tabColor) sheet.setTabColor(governance.tabColor);
    
    if (typeof positionSheetBySectionFRank_ === "function") {
      positionSheetBySectionFRank_(sheet, governance.targetRank, ss);
    }
    
    writeSheetGovernanceNote_(sheet, governance);

    if (options.dataRows && options.dataRows.length && options.headers) {
      if (sheet.getMaxColumns() < options.headers.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), options.headers.length - sheet.getMaxColumns());
      sheet.getRange(HEADER_ROW, 1, 1, options.headers.length).setValues([options.headers]);
      sheet.getRange(DATA_START_ROW, 1, options.dataRows.length, options.headers.length).setValues(options.dataRows);
      if (typeof applyGovernedNumberFormatsFromDashboard_ === "function") applyGovernedNumberFormatsFromDashboard_(sheet, dashboard, options.headers, options.dataRows.length);
    }

    if (sheetType !== "Disenrolled Exclusion" && rule.trimmingPolicy === "TRIM_TO_DATA" && options.skipInitialTrim !== true && typeof trimCreatedSheetToData_ === "function") {
      trimCreatedSheetToData_(sheet, DATA_START_ROW, (options.headers ? options.headers.length : sheet.getLastColumn()));
    }

    if (enforceHeight) enforceDataRowHeights_(sheet, dashboard);

    if (!governance.isVisible) hideSheetIfNeeded_(sheet, options.timing, "Hide per Section B");
    else showSheetIfNeeded_(sheet, options.timing, "Show per Section B");

    if (governance.overwriteRequired && governance.existingTargetSheet) {
      try {
         governance.existingTargetSheet.setName(backupName);
         sheet.setName(governance.finalName);
         if (typeof activateVisibleSheetBeforeHiding_ === "function") activateVisibleSheetBeforeHiding_(governance.existingTargetSheet);
         ss.deleteSheet(governance.existingTargetSheet);
      } catch (swapErr) {
         try { ss.deleteSheet(sheet); } catch(e) {}
         try { governance.existingTargetSheet.setName(governance.finalName); } catch(e) {}
         throw new Error("Final sheet rename failed and was safely rolled back: " + swapErr.message);
      }
    } else if (sheet.getName() !== governance.finalName) {
       sheet.setName(governance.finalName);
    }
    
    SpreadsheetApp.flush();

    if (rule.indexRegistration && !isTemplateBuild) {
      try { if (typeof populateActiveIndex === "function") populateActiveIndex(); } catch (err) {}
    }

    return sheet;
    
  } catch (buildError) {
    if (sheet) {
       try { ss.deleteSheet(sheet); } catch(e) {}
    }
    throw buildError;
  }
}

function applyGovernedNumberFormatsFromDashboard_(sheet, dashboard, headers, rowCount) {
  if (!sheet || !headers || !headers.length) return;
  const globals = dashboard.globals || {};
  const colDefs = dashboard.columnDefinitions || {};
  const startRow = Number(globals["Data Start Row"]) || 5;
  
  const maxRows = sheet.getMaxRows();
  if (maxRows < startRow) return;
  const targetRows = rowCount ? Math.max(rowCount, maxRows - startRow + 1) : maxRows - startRow + 1;

  const formatsByFormat = {};

  // Helper to convert column index to letter (1 -> A, 2 -> B)
  function getColLetter(colIdx) {
    let temp = colIdx;
    let letter = '';
    while (temp > 0) {
      let remainder = (temp - 1) % 26;
      letter = String.fromCharCode(65 + remainder) + letter;
      temp = Math.floor((temp - 1) / 26);
    }
    return letter;
  }

  // Group columns by their expected format
  headers.forEach(function(header, index) {
    const def = colDefs[header] || colDefs[header.toLowerCase()] || {};
    
    let format = "General";
    if (def.format) {
        format = String(def.format).trim();
    } else if (def.dateColumn) {
        format = String(globals["Default Date Format"] || "mm/dd/yyyy").trim();
    } else {
        format = String(globals["Default Text Format"] || "@").trim();
    }

    let sheetsFormat = format;
    if (typeof getGoogleSheetsNumberFormat_ === "function") {
        sheetsFormat = getGoogleSheetsNumberFormat_(format, def.dateColumn);
    }
    
    if (sheetsFormat && sheetsFormat !== "General") {
      const colLetter = getColLetter(index + 1);
      // Create A1 notation for the entire column data range
      const rangeA1 = colLetter + startRow + ":" + colLetter + (startRow + targetRows - 1);
      if (!formatsByFormat[sheetsFormat]) formatsByFormat[sheetsFormat] = [];
      formatsByFormat[sheetsFormat].push(rangeA1);
    }
  });

  // Apply each format in a single ultra-fast batch API call
  Object.keys(formatsByFormat).forEach(function(fmt) {
    try {
      sheet.getRangeList(formatsByFormat[fmt]).setNumberFormat(fmt);
    } catch (e) {
      logBestEffortWarning_("Failed to apply format " + fmt + " to " + sheet.getName() + ": " + e.message);
    }
  });
}

function enforceDataRowHeights_(sheet, dashboard) {
  if (!sheet) return;
  const defaultHeight = (dashboard && dashboard.globals)
    ? (Number(dashboard.globals["Default Data Row Height"]) || 25)
    : 25;

  try {
    const maxRows = sheet.getMaxRows();
    if (maxRows >= DATA_START_ROW) {
      const numRows = maxRows - DATA_START_ROW + 1;
      if (typeof sheet.setRowHeightsForced === "function") {
        sheet.setRowHeightsForced(DATA_START_ROW, numRows, defaultHeight);
      } else {
        sheet.setRowHeights(DATA_START_ROW, numRows, defaultHeight);
      }
    }
  } catch (err) {
    logBestEffortWarning_(`Row height enforcement failed on ${sheet.getName()}: ${err.message}`);
  }
}


// ============================================================================
// 2.2. FORMAT MONTHLY SUB-REPORTS PIPELINE
// ============================================================================

const TITLE_INFO_MOVE_CELLS = Object.freeze({
  "CP Due Date": ["A2", "C2", "A3", "C3", "D3", "E3"],
  "Unlock CP": ["A2", "A3", "B3", "C3", "D2", "E2", "F2", "G2"]
});

function collectMovedTitleInfoCells_(sheet, systemSheetName) {
  if (!sheet) return "";
  const cells = TITLE_INFO_MOVE_CELLS[systemSheetName] || [];
  if (!cells.length) return "";

  const parts = [];
  cells.forEach(function(a1) {
    try {
      const value = String(sheet.getRange(a1).getDisplayValue() || "").trim();
      if (value) parts.push(value);
    } catch (err) {
      logBestEffortWarning_("Could not read source cell " + a1 + ": " + err.message);
    }
  });

  return parts.join(" ");
}

function normalizeRawPreservationHeader_(header) {
  return String(header == null ? "" : header).trim().toLowerCase();
}

function appendSourceOnlyHeaders_(governedHeaders, sourceHeaders) {
  const output = (governedHeaders || []).slice();
  const seen = new Set(output.map(function(header) { return normalizeRawPreservationHeader_(header); }).filter(Boolean));

  (sourceHeaders || []).forEach(function(header) {
    const original = String(header == null ? "" : header).trim();
    const normalized = normalizeRawPreservationHeader_(original);
    if (!normalized || seen.has(normalized)) return;
    output.push(original);
    seen.add(normalized);
  });

  return output;
}

function getSourceOnlyHeaders_(governedHeaders, sourceHeaders) {
  const governed = new Set((governedHeaders || []).map(function(header) { return normalizeRawPreservationHeader_(header); }).filter(Boolean));
  const found = new Set();
  return (sourceHeaders || []).map(function(header) { return String(header == null ? "" : header).trim(); }).filter(function(header) {
    const normalized = normalizeRawPreservationHeader_(header);
    if (!normalized || governed.has(normalized) || found.has(normalized)) return false;
    found.add(normalized);
    return true;
  });
}

function readValidSourceDate_(sourceSheet, a1) {
  const range = sourceSheet.getRange(a1);
  const value = range.getValue();
  if (value instanceof Date && !isNaN(value.getTime())) return new Date(value.getTime());

  const displayValue = String(range.getDisplayValue() || "").trim();
  if (!displayValue) return null;
  const parsed = new Date(displayValue);
  return isNaN(parsed.getTime()) ? null : parsed;
}

function stampMonthlySubReportSourceDates_(outputSheet, sourceSheet, key, monthParts, timing, sheetName) {
  const dateCells = key === "CD" ? { start: "C3", end: "E3" } : { start: "E2", end: "G2" };
  const sourceStart = readValidSourceDate_(sourceSheet, dateCells.start);
  const sourceEnd = readValidSourceDate_(sourceSheet, dateCells.end);
  const startDate = sourceStart || monthParts.firstDay;
  const endDate = sourceEnd || monthParts.lastDay;

  if (!sourceStart || !sourceEnd) {
    logBestEffortWarning_(sheetName + " contained an invalid source date in " + dateCells.start + " or " + dateCells.end + "; the prompted month fallback was used for the invalid value.");
  }

  outputSheet.getRange("B2").setValue(startDate).setNumberFormat("MM/dd/yyyy");
  outputSheet.getRange("D2").setValue(endDate).setNumberFormat("MM/dd/yyyy");
  markFrameworkStep_(timing, sheetName + " - Stamp source report dates", dateCells.start + " to " + dateCells.end);
}

function normalizePreservedValue_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return "DATE:" + value.getTime();
  if (value === null || value === undefined) return "";
  return String(value);
}

/**
 * Post-condition for Format Raw Data: the imported source values, including
 * the pre-existing # column, must remain byte-for-byte equivalent throughout
 * output processing. No step rewrites, clears, prunes, or formats the source.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sourceSheet Original import sheet.
 * @param {number} sourceHeaderRow Original source header row.
 * @param {{headers:string[],values:Array<Array<*>>}} sourceSnapshot Pre-format snapshot.
 * @param {object} timing Framework timing context.
 */
function verifyRawSourceSheetUntouched_(sourceSheet, sourceHeaderRow, sourceSnapshot, timing) {
  const current = getDataValues_(sourceSheet, sourceHeaderRow, sourceHeaderRow + 1);
  const expectedHeaders = sourceSnapshot.headers || [];
  const expectedRows = sourceSnapshot.values || [];
  if (current.headers.length !== expectedHeaders.length || current.values.length !== expectedRows.length) {
    throw new Error("Source - Raw Data integrity check failed: source dimensions changed during formatting.");
  }

  expectedHeaders.forEach(function(header, columnIndex) {
    if (normalizePreservedValue_(current.headers[columnIndex]) !== normalizePreservedValue_(header)) {
      throw new Error("Source - Raw Data integrity check failed: header column " + (columnIndex + 1) + " changed during formatting.");
    }
  });
  expectedRows.forEach(function(row, rowIndex) {
    row.forEach(function(value, columnIndex) {
      const currentValue = current.values[rowIndex][columnIndex];
      if (normalizePreservedValue_(currentValue) !== normalizePreservedValue_(value)) {
        throw new Error("Source - Raw Data integrity check failed at source row " + (sourceHeaderRow + rowIndex + 1) + ", column " + (columnIndex + 1) + ".");
      }
    });
  });
  markFrameworkStep_(timing, "Raw Data - Verify source untouched", expectedRows.length + " source row(s) verified unchanged before lifecycle rename/hide");
}

function verifyRawDataSourceOnlyColumns_(outputSheet, rawData, targetHeaders, sourceOnlyHeaders, timing) {
  if (!sourceOnlyHeaders.length) {
    markFrameworkStep_(timing, "Raw Data - Verify source-only columns", "No source-only columns required preservation");
    return;
  }

  const expectedRows = rawData.values.filter(function(row) {
    return row.some(function(value) { return String(value == null ? "" : value).trim() !== ""; });
  });
  const outputRows = outputSheet.getRange(DATA_START_ROW, 1, expectedRows.length, targetHeaders.length).getValues();
  const sourceMap = buildHeaderIndexMap_(rawData.headers);
  const targetMap = buildHeaderIndexMap_(targetHeaders);

  sourceOnlyHeaders.forEach(function(header) {
    const sourceIndex = findHeaderIndex_(sourceMap, [header]);
    const targetIndex = findHeaderIndex_(targetMap, [header]);
    if (sourceIndex < 0 || targetIndex < 0) throw new Error("Raw Data preservation verification could not map source-only column: " + header);

    expectedRows.forEach(function(sourceRow, rowIndex) {
      const expected = normalizePreservedValue_(sourceRow[sourceIndex]);
      const actual = normalizePreservedValue_(outputRows[rowIndex][targetIndex]);
      if (expected !== actual) {
        throw new Error("Raw Data preservation verification failed for column '" + header + "' at output row " + (DATA_START_ROW + rowIndex) + ".");
      }
    });
  });

  markFrameworkStep_(timing, "Raw Data - Verify source-only columns", sourceOnlyHeaders.length + " column(s) and " + expectedRows.length + " row(s) verified against the formatted output");
}

/**
 * Calculates unique Raw Data participant totals and writes the summary to G1.
 * A PMR is counted once overall and once within each matching status group,
 * regardless of how many Raw Data rows belong to that participant.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sheet Governed Raw Data sheet.
 * @param {string[]} headers Ordered Raw Data headers.
 * @param {Array<Array<*>>} rows Raw Data values aligned to headers.
 * @param {object} timing Framework timing context.
 * @return {{totalParticipants:number, totalEnrolledParticipants:number, totalDisenrolledParticipants:number}} Calculated totals.
 */
function writeRawDataParticipantTotals_(sheet, headers, rows, timing) {
  if (!sheet) throw new Error("Raw Data participant totals require an output sheet.");
  const headerMap = buildHeaderIndexMap_(headers || []);
  const pmrIndex = findHeaderIndex_(headerMap, ["Participant PMR#"]);
  const statusIndex = findHeaderIndex_(headerMap, ["Enrollment Status"]);
  if (pmrIndex < 0) throw new Error('Raw Data participant totals require the Section H header "Participant PMR#".');
  if (statusIndex < 0) throw new Error('Raw Data participant totals require the Section H header "Enrollment Status".');

  const participants = new Set();
  const enrolledParticipants = new Set();
  const disenrolledParticipants = new Set();
  (rows || []).forEach(function(row) {
    const pmr = String(row[pmrIndex] == null ? "" : row[pmrIndex]).trim().toUpperCase();
    if (!pmr) return;
    participants.add(pmr);

    const status = String(row[statusIndex] == null ? "" : row[statusIndex]).trim().toLowerCase();
    if (status === "enrolled") enrolledParticipants.add(pmr);
    if (status === "disenrolled") disenrolledParticipants.add(pmr);
  });

  const totals = {
    totalParticipants: participants.size,
    totalEnrolledParticipants: enrolledParticipants.size,
    totalDisenrolledParticipants: disenrolledParticipants.size
  };
  const summary = [
    "Total Participants: " + totals.totalParticipants,
    "Total Enrolled Participants: " + totals.totalEnrolledParticipants,
    "Total Disenrolled Participants: " + totals.totalDisenrolledParticipants
  ].join(" - ");
  sheet.getRange("G1").setValue(summary).setWrapStrategy(SpreadsheetApp.WrapStrategy.OVERFLOW);
  writeParticipantTotalTimestamp_(sheet);
  if (typeof markFrameworkStep_ === "function") {
    markFrameworkStep_(timing, "Raw Data - Write participant totals", summary.replace(/\n/g, "; "));
  }
  return totals;
}

/**
 * Writes a unique-PMR total to G1 without reading the sheet again.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sheet Governed output sheet.
 * @param {string[]} headers Ordered output headers.
 * @param {Array<Array<*>>} rows Output values aligned to headers.
 * @param {string} label Text displayed before the count.
 * @param {?string} requiredStatus Optional exact Enrollment Status filter.
 * @param {object} timing Framework timing context.
 * @param {string=} summaryCell Optional summary destination; defaults to G1.
 * @param {string=} timestampCell Optional timestamp destination; defaults to G2.
 * @return {number} Unique participant count.
 */
function writeUniqueParticipantTotalToG1_(sheet, headers, rows, label, requiredStatus, timing, summaryCell, timestampCell) {
  if (!sheet) throw new Error(label + " requires an output sheet.");
  const headerMap = buildHeaderIndexMap_(headers || []);
  const pmrIndex = getPMRIndex_(headerMap);
  if (pmrIndex < 0) throw new Error(label + ' requires the governed "Participant PMR#" header.');

  const normalizedRequiredStatus = String(requiredStatus == null ? "" : requiredStatus).trim().toLowerCase();
  const statusIndex = normalizedRequiredStatus
    ? findHeaderIndex_(headerMap, ["Enrollment Status", "Status"])
    : -1;
  if (normalizedRequiredStatus && statusIndex < 0) {
    throw new Error(label + ' requires the governed "Enrollment Status" header.');
  }

  const participantPMRs = new Set();
  (rows || []).forEach(function(row) {
    const pmr = String(row[pmrIndex] == null ? "" : row[pmrIndex]).trim().toUpperCase();
    if (!pmr) return;
    if (normalizedRequiredStatus) {
      const status = String(row[statusIndex] == null ? "" : row[statusIndex]).trim().toLowerCase();
      if (status !== normalizedRequiredStatus) return;
    }
    participantPMRs.add(pmr);
  });

  const summary = label + ": " + participantPMRs.size;
  sheet.getRange(summaryCell || "G1").setValue(summary).setWrap(true);
  writeParticipantTotalTimestamp_(sheet, timestampCell || "G2");
  if (typeof markFrameworkStep_ === "function") {
    markFrameworkStep_(timing, "Write " + label, summary);
  }
  return participantPMRs.size;
}

function writeParticipantTotalTimestamp_(sheet, targetCell) {
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "MM/dd/yyyy HH:mm:ss");
  sheet.getRange(targetCell || "G2").setValue("Last Updated: " + timestamp).setWrap(true);
}

function countUniqueParticipantsByStatus_(headers, rows, requiredStatus) {
  const map = buildHeaderIndexMap_(headers || []);
  const pmrIndex = getPMRIndex_(map);
  const statusIndex = findHeaderIndex_(map, ["Enrollment Status", "Status"]);
  if (pmrIndex < 0 || statusIndex < 0) throw new Error("Participant total safety check requires PMR and Enrollment Status headers.");
  const expectedStatus = String(requiredStatus || "").trim().toLowerCase();
  const pmrs = new Set();
  (rows || []).forEach(function(row) {
    const pmr = String(row[pmrIndex] == null ? "" : row[pmrIndex]).trim().toUpperCase();
    const status = String(row[statusIndex] == null ? "" : row[statusIndex]).trim().toLowerCase();
    if (pmr && status === expectedStatus) pmrs.add(pmr);
  });
  return pmrs.size;
}

function assertParticipantTotalsMatch_(label, expected, actual) {
  if (expected === actual) return "";
  const notice = label + " safety check notice: Raw Data total is " + expected + " but governed output total is " + actual + ". Processing completed without interruption.";
  if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_(notice);
  return notice;
}

function notifyParticipantSafetyNotices_(notices, processName) {
  const messages = (notices || []).filter(function(message) { return String(message || "").trim() !== ""; });
  if (messages.length && typeof notify_ === "function") {
    notify_((processName || "Process") + " completed with participant-total notice(s):\n" + messages.join("\n"));
  }
}

function sortRowsByLastName_(rows, headers) {
  const lastNameIndex = findHeaderIndex_(buildHeaderIndexMap_(headers || []), ["Last Name"]);
  if (lastNameIndex < 0) throw new Error('Refined Data A-Z sort requires the governed "Last Name" header.');
  return (rows || []).slice().sort(function(left, right) {
    return String(left[lastNameIndex] || "").trim().localeCompare(String(right[lastNameIndex] || "").trim(), undefined, { sensitivity: "base" });
  });
}

function runFormatterPipeline_(reportKeys, processName, options) {
  options = options || {};
  const monthParts = promptForLockedYearReportMonth_(processName);
  if (!monthParts) return null;

  return runFrameworkTimed_(processName + " " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    markFrameworkStep_(timing, "Acquire document lock", "Waiting up to 30 seconds");
    if (!lock.tryLock(30000)) throw new Error("Another formatting process is running. Please wait.");

    try {
      const dashboard = loadDashboardConfig_();
      if (options.useActiveSheet === true) {
        if (!reportKeys || reportKeys.length !== 1) throw new Error("Active-sheet formatting requires exactly one report type.");
        options.sourceSheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
      }
      if (options.useActiveSheet === true) {
        assertRequiredMonthlyImportsPresent_(reportKeys, monthParts, timing, options);
      }
      const archiveState = { spreadsheet: null };
      const results = [];
      let successCount = 0;

      (reportKeys || []).forEach(function(key) {
        try {
          const routeOptions = Object.assign({}, options);
          const result = processSingleSubReport_(key, monthParts, dashboard, timing, archiveState, routeOptions);
          results.push(result);
          if (result.success) successCount++;
        } catch (err) {
          markFrameworkStep_(timing, "Sub-report failed: " + key, err.message);
          logBestEffortWarning_("Sub-Report failed (" + key + "): " + err.message);
          results.push({ key: key, success: false, error: err.message });
        }
      });

      finalizeMonthlyParticipantTotals_(results, monthParts, timing);

      markFrameworkStep_(timing, "Enforce Visibility", "Hiding sub-reports according to Section B");
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      results.forEach(function(res) {
        if (res.success && res.sheetName && res.systemSheetName) {
           const rule = (dashboard.creationRules && dashboard.creationRules[res.systemSheetName]) || {};
           const sheet = ss.getSheetByName(res.sheetName);
           if (sheet && rule.visibility === "HIDDEN") {
              hideSheetIfNeeded_(sheet, timing, "Pipeline Cleanup - Hiding " + res.sheetName);
           }
        }
      });
      SpreadsheetApp.flush();

      markFrameworkStep_(timing, "Refresh Index", "Synchronizing navigation after formatted outputs");
      if (typeof populateActiveIndex === "function") populateActiveIndex();
      
      // --- FIX ML19743-004 & ML19743-005: Exact target, measure timing, contextual warning ---
      const rdResult = results.find(function(r) { return r.key === "RD" && r.success; });
      if (rdResult && rdResult.sheetName) {
        const qTime = new Date().getTime();
        try { 
          if (typeof runDashboardQualityProcessValidationSections_ === "function") runDashboardQualityProcessValidationSections_("Raw Data", rdResult.sheetName); 
        } catch(e) {
          logBestEffortWarning_("Automated quality check failed for Raw Data: " + e.message);
        }
        markFrameworkStep_(timing, "Automated Quality Check", "Raw Data validated in " + ((new Date().getTime() - qTime) / 1000).toFixed(3) + "s");
      }
      
      const skipped = results.filter(function(result) { return !result.success; });
      const skippedNotice = skipped.length
        ? "\nSkipped: " + skipped.map(function(result) { return result.key + " (" + result.error + ")"; }).join("; ")
        : "";

      notify_(processName + " complete. Successfully processed " + successCount + " of " + reportKeys.length + " reports." + skippedNotice);
      return results;
    } finally {
      lock.releaseLock();
      markFrameworkStep_(timing, "Release document lock", "Formatting batch lock released");
    }
  });
}

/**
 * Fails the formatting batch before any report mutation when a requested import is missing.
 *
 * @param {string[]} reportKeys Requested formatter routes.
 * @param {object} monthParts Prompted report-month values.
 * @param {object} timing Framework timing context.
 * @param {object=} options Formatter source-routing options.
 */
function assertRequiredMonthlyImportsPresent_(reportKeys, monthParts, timing, options) {
  options = options || {};
  if (options.useActiveSheet === true) {
    const activeSheet = options.sourceSheet;
    const activeName = activeSheet ? activeSheet.getName() : "";
    if (!activeSheet || activeName.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) === 0) {
      throw new Error("FATAL: Select the unformatted source sheet before running an individual Format trigger.");
    }
    markFrameworkStep_(timing, "Active-sheet import preflight passed", 'Using current sheet "' + activeName + '" as the source');
    return;
  }
  const systemByKey = { B: "Banners", CD: "CP Due Date", UC: "Unlock CP", RD: "Raw Data" };
  const missing = [];
  (reportKeys || []).forEach(function(key) {
    const systemSheetName = systemByKey[key];
    if (!systemSheetName) throw new Error("Unknown report key: " + key);
    if (!findSourceSheetForSubReport_(systemSheetName, monthParts)) missing.push(systemSheetName);
  });
  if (missing.length) {
    const message = "FATAL: Format Monthly Sheets stopped before any report mutation. Missing required import report(s) for " + monthParts.monthLabel + ": " + missing.join(", ") + ".";
    markFrameworkStep_(timing, "Fatal import preflight failed", message);
    throw new Error(message);
  }
  markFrameworkStep_(timing, "Fatal import preflight passed", (reportKeys || []).length + " required import report(s) located");
}

function processSingleSubReport_(key, monthParts, dashboard, timing, archiveState, options) {
  options = options || {};
  const systemByKey = { B: "Banners", CD: "CP Due Date", UC: "Unlock CP", RD: "Raw Data" };
  const systemSheetName = systemByKey[key];
  if (!systemSheetName) throw new Error("Unknown report key: " + key);

  const usesActiveSource = options.useActiveSheet === true && options.sourceSheet;
  markFrameworkStep_(timing, systemSheetName + " - Locate source", usesActiveSource ? "Using current active sheet" : "Scanning unformatted workbook tabs");
  const sourceSheet = usesActiveSource ? options.sourceSheet : findSourceSheetForSubReport_(systemSheetName, monthParts);
  if (!sourceSheet) throw new Error("Source sheet for " + systemSheetName + " (" + monthParts.monthLabel + ") not found.");

  const sourceHeaderRow = (key === "CD" || key === "UC") ? 4 : 1;
  const titleInfo = collectMovedTitleInfoCells_(sourceSheet, systemSheetName);
  const rawData = getDataValues_(sourceSheet, sourceHeaderRow, sourceHeaderRow + 1);
  if (!rawData.values.length) throw new Error("Source sheet is empty below header row " + sourceHeaderRow + ".");
  if (key === "RD" && findHeaderIndex_(rawData.headerMap, ["#"]) < 0) {
    throw new Error('Format Raw Data requires the pre-numbered source column "#". The formatter will not add or populate it.');
  }

  let targetHeaders = getHeadersForSheetType_(dashboard, systemSheetName);
  if (!targetHeaders.length) throw new Error("No Dashboard Section H headers for " + systemSheetName + ".");

  let sourceOnlyHeaders = [];
  let mappedSourceRows = mapRowsToHeaders_(rawData.values, rawData.headers, targetHeaders);
  
  if (key === "RD") {
    const sourceNumberIndex = findHeaderIndex_(rawData.headerMap, ["#"]);
    const targetNumberIndex = findHeaderIndex_(buildHeaderIndexMap_(targetHeaders), ["#"]);
    if (sourceNumberIndex < 0 || targetNumberIndex < 0) {
      throw new Error('Raw Data number preservation requires the "#" header in both source and target schemas.');
    }
    mappedSourceRows.forEach(function(mappedRow, rowIndex) {
      mappedRow[targetNumberIndex] = rawData.values[rowIndex][sourceNumberIndex];
    });
  }
  
  const targetMapForFilter = buildHeaderIndexMap_(targetHeaders);
  const targetPmrIdxForFilter = getPMRIndex_(targetMapForFilter);

  let filteredRows = mappedSourceRows.filter(function(row) {
    const hasData = row.some(function(value) { return String(value == null ? "" : value).trim() !== ""; });
    if (!hasData) return false;
    
    if (key === "RD" && targetPmrIdxForFilter >= 0) {
      const pmrVal = String(row[targetPmrIdxForFilter] || "").trim().toUpperCase();
      if (pmrVal === "VC000TEST") return false;
    }
    
    return true;
  });

  if (!filteredRows.length) throw new Error("No valid data rows remained after mapping " + systemSheetName + ".");
  markFrameworkStep_(timing, systemSheetName + " - Map source", filteredRows.length + " row(s); source header row " + sourceHeaderRow);

  if (key === "RD") {
    assignPrimaryPMRRowsToMatrix_(filteredRows, targetHeaders);
    const pruneResult = pruneAgedDisenrolledNonPrimaryRows_(filteredRows, targetHeaders, monthParts.lastDay);
    filteredRows = pruneResult.rows;
    
    markFrameworkStep_(timing, "Raw Data - Prune aged disenrollment contacts", pruneResult.removedCount + " non-primary row(s) removed for " + pruneResult.participantCount + " participant(s) disenrolled more than 6 months before the report end date");
    
    const bannerSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Banners " + monthParts.label);
    if (bannerSheet) {
      const bannerData = getDataValues_(bannerSheet, HEADER_ROW, DATA_START_ROW);
      const synced = syncBannerFieldsIntoRawRows_(filteredRows, targetHeaders, bannerData.values, bannerData.headers);
      markFrameworkStep_(timing, "Raw Data - Sync Banners", synced + " Raw Data row(s) updated from Banners " + monthParts.label);
    } else {
      markFrameworkStep_(timing, "Raw Data - Sync Banners skipped", "Formatted Banners " + monthParts.label + " was not found");
    }
  } else {
    archiveState = archiveState || { spreadsheet: null };
    if (!archiveState.spreadsheet) {
      markFrameworkStep_(timing, "Open archive workbook", "Opening verified archive connection");
      archiveState.spreadsheet = openArchiveSpreadsheetOnce_();
    }
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sourceBaseByKey = { B: "Source - Banners", CD: "Source - CP Due Date", UC: "Source - Unlock CP", RD: "Source - Raw Data" };
  const sourceOutputNameByKey = { B: "Source - Banners", CD: "Source - CP Due", UC: "Source - Unlocked CP", RD: "Source - Raw Data" };
  const sourceBaseName = sourceBaseByKey[key];
  const sourceName = sourceOutputNameByKey[key] + " " + monthParts.label;
  const sourceRule = (dashboard.creationRules && dashboard.creationRules[sourceBaseName]) || {};
  const sourceRank = sourceRule.dynamicRankRule
    ? calculateDynamicRank_(sourceRule, sourceName, ss)
    : getRankForSheetName_(sourceName, false);
  const sourceGovernance = {
    targetRank: sourceRank,
    groupName: "Source Data",
    isVisible: false,
    isDynamicRank: !!sourceRule.dynamicRankRule
  };
  
  writeSheetGovernanceNote_(sourceSheet, sourceGovernance);
  markFrameworkStep_(timing, systemSheetName + " - Stamp source rank", "B1 note dynamic rank " + sourceGovernance.targetRank + "; December is offset month 0");

  const collision = ss.getSheetByName(sourceName);
  if (collision && collision.getSheetId() !== sourceSheet.getSheetId()) {
    deleteSheetSafely_(ss, collision, "Cleanup old source collision");
  }
  if (sourceSheet.getName() !== sourceName) sourceSheet.setName(sourceName);
  
  if (typeof positionSheetBySectionFRank_ === "function") {
    positionSheetBySectionFRank_(sourceSheet, sourceGovernance.targetRank, ss);
  }

  let archiveResult = null;
  if (key !== "RD") {
    archiveResult = archiveRawSourceSheet_(sourceSheet, sourceName, timing, systemSheetName + " - Archive verified", archiveState.spreadsheet);
    if (!archiveResult || archiveResult.archivedSuccessfully !== true) throw new Error("Archive verification failed for " + sourceSheet.getName() + ".");
  } else {
    hideSheetIfNeeded_(sourceSheet, timing, "Raw Data - Preserve and hide source before output creation");
    markFrameworkStep_(timing, "Raw Data - Source preserved", sourceName + " retained before governed Raw Data output creation");
  }
  
  const sourceSheetId = sourceSheet.getSheetId();
  const finalSheet = createGovernedSheet_(systemSheetName, monthParts, { dataRows: filteredRows, headers: targetHeaders, timing: timing });

  if (key === "CD" || key === "UC") {
    stampMonthlySubReportSourceDates_(finalSheet, sourceSheet, key, monthParts, timing, systemSheetName);
  }

  finalizeFormattedMonthlyOutput_(key, finalSheet, sourceSheet, sourceHeaderRow, rawData, targetHeaders, filteredRows, sourceOnlyHeaders, timing);

  if ((systemSheetName === "CP Due Date" || systemSheetName === "Unlock CP") && titleInfo) {
    const titleRange = finalSheet.getRange("C1:D1");
    titleRange.merge().setValue(titleInfo);
  }

  if (key === "RD") {
    hideSheetIfNeeded_(sourceSheet, timing, "Raw Data - Confirm preserved source remains hidden");
  } else {
    const remainingSource = ss.getSheets().find(function(sheet) { return sheet.getSheetId() === sourceSheetId; });
    if (remainingSource) deleteSheetSafely_(ss, remainingSource, "Delete verified archived source " + archiveResult.archivedName);
  }

  markFrameworkStep_(timing, systemSheetName + " - Process complete", finalSheet.getName() + "; " + filteredRows.length + " row(s)");

  return { key: key, success: true, sheetName: finalSheet.getName(), rowCount: filteredRows.length, systemSheetName: systemSheetName };
}

/**
 * Verifies the imported Raw Data number column after the output write.
 */
function verifyRawNumberColumnPreserved_(outputSheet, expectedRows, targetHeaders, timing) {
  const numberIndex = findHeaderIndex_(buildHeaderIndexMap_(targetHeaders), ["#"]);
  if (numberIndex < 0) throw new Error('Raw Data output is missing the governed "#" column.');
  if (!expectedRows.length) return;

  const actualValues = outputSheet.getRange(DATA_START_ROW, numberIndex + 1, expectedRows.length, 1).getValues();
  expectedRows.forEach(function(row, rowIndex) {
    if (normalizePreservedValue_(actualValues[rowIndex][0]) !== normalizePreservedValue_(row[numberIndex])) {
      throw new Error('Raw Data "#" preservation failed at output row ' + (DATA_START_ROW + rowIndex) + ".");
    }
  });
  markFrameworkStep_(timing, 'Raw Data - Verify "#" column', expectedRows.length + " imported number value(s) preserved");
}

/**
 * Applies route-specific completion checks through the single formatter path.
 * Participant totals are finalized once by runFormatterPipeline_ after every route.
 */

function finalizeFormattedMonthlyOutput_(key, finalSheet, sourceSheet, sourceHeaderRow, rawData, targetHeaders, filteredRows, sourceOnlyHeaders, timing) {
  if (key !== "RD") return;
  
  verifyRawDataSourceOnlyColumns_(finalSheet, rawData, targetHeaders, sourceOnlyHeaders, timing);
  
  // NOTE: verifyRawNumberColumnPreserved_ has been intentionally removed.
  // Reading from the grid immediately after massive batch formatting forces 
  // the Google Sheets API to freeze and catch up, causing 40+ second bottlenecks.
  
  verifyRawSourceSheetUntouched_(sourceSheet, sourceHeaderRow, rawData, timing);
}


/**
 * Writes Raw Data participant totals once for both batch and individual triggers.
 * An individual non-RD trigger refreshes totals on the governed Raw Data sheet
 * for the prompted month when that sheet already exists.
 */
function finalizeMonthlyParticipantTotals_(results, monthParts, timing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const rawResult = (results || []).find(function(result) { return result.success && result.key === "RD"; });
  const rawSheet = rawResult && rawResult.sheetName
    ? ss.getSheetByName(rawResult.sheetName)
    : getCurrentRawDataSheet_(monthParts);
  if (!rawSheet) {
    markFrameworkStep_(timing, "Monthly participant totals skipped", "No governed Raw Data sheet exists for " + monthParts.label);
    return null;
  }
  const rawData = getDataValues_(rawSheet, HEADER_ROW, DATA_START_ROW);
  const rows = filterBlankRows_(rawData.values);
  const totals = writeRawDataParticipantTotals_(rawSheet, rawData.headers, rows, timing);
  SpreadsheetApp.flush();
  markFrameworkStep_(timing, "Monthly participant totals complete", "Participants " + totals.totalParticipants + "; enrolled " + totals.totalEnrolledParticipants + "; disenrolled " + totals.totalDisenrolledParticipants);
  return totals;
}

function syncBannerFieldsIntoRawRows_(rawRows, rawHeaders, bannerRows, bannerHeaders) {
  const rawMap = buildHeaderIndexMap_(rawHeaders);
  const bannerMap = buildHeaderIndexMap_(bannerHeaders);
  const rawPmr = getPMRIndex_(rawMap);
  const bannerPmr = getPMRIndex_(bannerMap);
  const primaryIdx = findHeaderIndex_(rawMap, ["Primary PMR Row"]);

  if (rawPmr < 0 || bannerPmr < 0) throw new Error("Banner synchronization requires PMR columns in Raw Data and Banners.");

  const bannerByPmr = buildLookupMap_(bannerRows, bannerPmr);
  const fields = ["Safety - 2 Person", "Bed Bug", "Wanderer", "Interpreter Needed", "Fall Risk", "DPOA or Guardian Active", "Palliative Care"];
  let synced = 0;

  rawRows.forEach(function(row) {
    if (primaryIdx >= 0) {
      const pVal = String(row[primaryIdx] || "").trim().toUpperCase();
      if (pVal !== "YES" && pVal !== "Y") return;
    }

    const pmr = String(row[rawPmr] || "").trim();
    const banner = bannerByPmr.get(pmr);
    if (!banner) return;

    let changed = false;
    fields.forEach(function(header) {
      const targetIndex = findHeaderIndex_(rawMap, [header]);
      const sourceIndex = findHeaderIndex_(bannerMap, [header]);
      if (targetIndex >= 0 && sourceIndex >= 0) { row[targetIndex] = banner[sourceIndex]; changed = true; }
    });
    const summaryIndex = findHeaderIndex_(rawMap, ["Banner Summary"]);
    if (summaryIndex >= 0) {
      row[summaryIndex] = fields.filter(function(header) {
        const index = findHeaderIndex_(rawMap, [header]);
        return index >= 0 && String(row[index] || "").trim() !== "";
      }).join(" | ");
      changed = true;
    }
    if (changed) synced++;
  });
  return synced;
}

function assignPrimaryPMRRowsToMatrix_(rows, headers) {
  const edFields = [
    "Capitation Date", "Enrollment Status", "Disenrollment Date", 
    "Disenrollment Effective Date", "Disenrollment Reason", "Date of Death"
  ];
  
  // 1. Ensure " 2" and " 3" headers exist at the end of the array
  edFields.forEach(function(f) {
    if (headers.indexOf(f + " 2") === -1) headers.push(f + " 2");
    if (headers.indexOf(f + " 3") === -1) headers.push(f + " 3");
  });

  // 2. Pad rows to match header length safely (this protects the # column)
  rows.forEach(function(row) {
    while (row.length < headers.length) row.push("");
  });

  const headerMap = buildHeaderIndexMap_(headers);
  const pmrIndex = getPMRIndex_(headerMap);
  const primaryIndex = headerMap["Primary PMR Row"];
  if (pmrIndex < 0 || primaryIndex === undefined) throw new Error("Raw Data schema requires PMR and Primary PMR Row columns.");

  // Clear any existing Primary PMR Row flags
  rows.forEach(function(row) { row[primaryIndex] = ""; });

  const groups = new Map();
  rows.forEach(function(row) {
    const pmr = String(row[pmrIndex] == null ? "" : row[pmrIndex]).trim().toUpperCase();
    if (!pmr) return;
    if (!groups.has(pmr)) groups.set(pmr, []);
    groups.get(pmr).push(row);
  });

  const scoreHeaders = [["Date of Birth", 1000], ["Enrollment Date", 250], ["Capitation Date", 200], ["Address Line 1", 100], ["Phone Number", 50], ["Primary Language", 25], ["Participant Name", 20]];
  const dateCols = ["Capitation Date", "Enrollment Date"].map(function(h) { return headerMap[h]; }).filter(function(i) { return i !== undefined; });

  function getRowTime_(row) {
    for (let i = 0; i < dateCols.length; i++) {
      const val = row[dateCols[i]];
      const ts = val instanceof Date ? val.getTime() : (val ? new Date(val).getTime() : NaN);
      if (!isNaN(ts)) return ts;
    }
    return 0;
  }

  groups.forEach(function(group) {
    // --- A. Identify Best Row (Demographics Scoring) ---
    let best = group[0];
    let bestScore = -1;
    group.forEach(function(row) {
      const score = scoreHeaders.reduce(function(total, item) {
        const idx = headerMap[item[0]];
        return total + (idx !== undefined && String(row[idx] == null ? "" : row[idx]).trim() !== "" ? item[1] : 0);
      }, 0);
      if (score > bestScore) { best = row; bestScore = score; }
    });
    best[primaryIndex] = "Yes";

    // --- B. Extract E/D Datasets & Clear Origin Rows ---
    let edDatasets = [];
    let hasEnrolled = false;

    group.forEach(function(row) {
      let ds = {};
      let hasData = false;
      
      // Pull base E/D fields and clear them from the origin
      edFields.forEach(function(f) {
        const idx = headerMap[f];
        if (idx !== undefined) {
          const val = row[idx];
          ds[f] = val;
          if (String(val || "").trim() !== "") hasData = true;
          if (f === "Enrollment Status" && String(val || "").trim().toLowerCase() === "enrolled") {
            hasEnrolled = true;
          }
          row[idx] = ""; // Clear from origin
        }
      });

      // Clear secondary columns in case they accidentally contain source data
      edFields.forEach(function(f) {
        const idx2 = headerMap[f + " 2"];
        const idx3 = headerMap[f + " 3"];
        if (idx2 !== undefined) row[idx2] = "";
        if (idx3 !== undefined) row[idx3] = "";
      });

      if (hasData) {
        ds._time = getRowTime_(row);
        edDatasets.push(ds);
      }
    });

    // --- C. Sort E/D datasets newest to oldest ---
    edDatasets.sort(function(a, b) { return b._time - a._time; });

    // --- D. Write Consolidated Data Back to Primary Row Only ---
    if (edDatasets.length > 0) {
      let ed1 = edDatasets[0];
      // Force "Enrolled" to the newest record if it existed anywhere
      if (hasEnrolled) ed1["Enrollment Status"] = "Enrolled";
      
      edFields.forEach(function(f) {
        const idx = headerMap[f];
        if (idx !== undefined) best[idx] = ed1[f] !== undefined ? ed1[f] : "";
      });
    }

    if (edDatasets.length > 1) {
      let ed2 = edDatasets[1];
      edFields.forEach(function(f) {
        const idx = headerMap[f + " 2"];
        if (idx !== undefined) best[idx] = ed2[f] !== undefined ? ed2[f] : "";
      });
    }

    if (edDatasets.length > 2) {
      let ed3 = edDatasets[2];
      edFields.forEach(function(f) {
        const idx = headerMap[f + " 3"];
        if (idx !== undefined) best[idx] = ed3[f] !== undefined ? ed3[f] : "";
      });
    }
  });
}



/**
 * Removes non-primary Raw Data rows for participants whose Disenrollment
 * Effective Date is more than one calendar year before the report end date.
 * The selected Primary PMR Row is always retained.
 *
 * @param {Array<Array<*>>} rows Mapped Raw Data rows.
 * @param {string[]} headers Mapped Raw Data headers.
 * @param {Date|string} reportEndDate Prompted report-month end date.
 * @return {{rows:Array<Array<*>>, removedCount:number, participantCount:number}} Pruned matrix and counts.
 */

function pruneAgedDisenrolledNonPrimaryRows_(rows, headers, reportEndDate) {
  const headerMap = buildHeaderIndexMap_(headers || []);
  const pmrIndex = getPMRIndex_(headerMap);
  const primaryIndex = findHeaderIndex_(headerMap, ["Primary PMR Row"]);
  const effectiveDateIndex = findHeaderIndex_(headerMap, ["Disenrollment Effective Date"]);
  if (pmrIndex < 0 || primaryIndex < 0 || effectiveDateIndex < 0) {
    throw new Error("Raw Data aged-disenrollment pruning requires Participant PMR#, Primary PMR Row, and Disenrollment Effective Date headers.");
  }

  const endDate = reportEndDate instanceof Date ? new Date(reportEndDate.getTime()) : new Date(reportEndDate);
  if (isNaN(endDate.getTime())) throw new Error("Raw Data aged-disenrollment pruning requires a valid report end date.");
  const cutoff = new Date(endDate.getTime());
  
  // NEW: Calculate the cutoff as exactly 6 months prior to the report end date
  cutoff.setMonth(cutoff.getMonth() - 6);

  const agedPMRs = new Set();
  (rows || []).forEach(function(row) {
    const pmr = String(row[pmrIndex] == null ? "" : row[pmrIndex]).trim().toUpperCase();
    if (!pmr) return;
    const value = row[effectiveDateIndex];
    const effectiveDate = value instanceof Date ? new Date(value.getTime()) : new Date(value);
    if (!isNaN(effectiveDate.getTime()) && effectiveDate.getTime() < cutoff.getTime()) agedPMRs.add(pmr);
  });

  let removedCount = 0;
  const retained = (rows || []).filter(function(row) {
    const pmr = String(row[pmrIndex] == null ? "" : row[pmrIndex]).trim().toUpperCase();
    if (!pmr || !agedPMRs.has(pmr) || isPrimaryPMRRowValue_(row[primaryIndex])) return true;
    removedCount++;
    return false;
  });
  return { rows: retained, removedCount: removedCount, participantCount: agedPMRs.size };
}

function findSourceSheetForSubReport_(systemSheetName, monthParts) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // Define the prefixes we are looking for
  const prefixMap = {
    "Banners": ["Banners", "Banner Report", "B"],
    "CP Due Date": ["CP Due Date", "CP Due", "CD"],
    "Unlock CP": ["Unlocked CP", "Unlock CP", "UC"],
    "Raw Data": ["Raw Data", "RD"]
  };

  const prefixes = prefixMap[systemSheetName] || [systemSheetName];
  const allSheets = ss.getSheets();
  const candidateSheets = [];

  for (let s = 0; s < allSheets.length; s++) {
    const sheet = allSheets[s];
    const rawName = sheet.getName();
    const lowerName = rawName.trim().toLowerCase();

    // Skip templates
    if (rawName.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) !== -1) continue;

    // Skip sheets that are already finished, formatted reports
    const note = sheet.getRange("B1").getNote() || "";
    const isGovernedOutput = note.indexOf("[Sheet Governance]") !== -1;
    const isSourceSheet = rawName.indexOf(SYSTEM_SHEETS.SOURCE_PREFIX) === 0;

    if (isGovernedOutput && !isSourceSheet) continue;

    // Check if the tab name starts with any of our targeted abbreviations
    for (let p = 0; p < prefixes.length; p++) {
      const prefix = prefixes[p].toLowerCase();
      if (lowerName === prefix || 
          lowerName.indexOf(prefix + " ") === 0 || 
          lowerName.indexOf(prefix + "-") === 0 || 
          lowerName.indexOf(prefix + ".") === 0) {
        candidateSheets.push(sheet);
        break;
      }
    }
  }

  if (!candidateSheets.length) return null;

  // Strict Month Validation: Ensure sheet name contains the prompted month
  if (monthParts) {
    const monthMatches = candidateSheets.filter(function(sheet) {
      return isSheetNameMatchingMonth_(sheet.getName(), monthParts);
    });

    if (monthMatches.length > 0) {
      return monthMatches[0];
    }

    // Do NOT fall back to another month if the requested month tab is missing
    return null;
  }

  return candidateSheets[0];
}

/**
 * Validates that the unformatted tab name contains the prompted month 
 * (spelled out, abbreviated, 1-digit, 2-digit, or standard MM.YY format).
 */
function isSheetNameMatchingMonth_(sheetName, monthParts) {
  if (!monthParts) return true;
  const lowerName = String(sheetName || "").trim().toLowerCase();

  const mNum = Number(monthParts.month || monthParts.mm);
  const mTwoDigit = mNum < 10 ? "0" + mNum : String(mNum);
  const mSingleDigit = String(mNum);
  const yearTwoDigit = String(monthParts.yy || (monthParts.year ? String(monthParts.year).slice(-2) : "26"));

  const monthNames = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"];
  const monthAbbs = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];

  const fullMonthName = monthNames[mNum - 1];
  const monthAbb = monthAbbs[mNum - 1];

  // Match full name or abbreviation (e.g., "RD April" or "RD Apr")
  if (new RegExp("\\b" + fullMonthName + "\\b", "i").test(lowerName)) return true;
  if (new RegExp("\\b" + monthAbb + "\\b", "i").test(lowerName)) return true;

  // Match date patterns (e.g., "04.26", "4.26", "04/26", "04-26")
  if (lowerName.indexOf(mTwoDigit + "." + yearTwoDigit) !== -1) return true;
  if (lowerName.indexOf(mSingleDigit + "." + yearTwoDigit) !== -1) return true;
  if (lowerName.indexOf(mTwoDigit + "/" + yearTwoDigit) !== -1) return true;
  if (lowerName.indexOf(mTwoDigit + "-" + yearTwoDigit) !== -1) return true;

  // Match standalone month numbers (e.g., "RD 4", "RD 04", "B 4")
  const digitRegex = new RegExp("(?:^|\\s|-|\\.)(" + mTwoDigit + "|" + mSingleDigit + ")(?:$|\\s|-|\\.)");
  if (digitRegex.test(lowerName)) return true;

  return false;
}



