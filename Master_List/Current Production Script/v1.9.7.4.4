function runMonthlyStart() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Start");
  if (!monthParts) return null;
  return runFrameworkTimed_("Create Monthly Start " + monthParts.label, function(timing) {
    
    markFrameworkStep_(timing, "Monthly Start - Build Refined Data", "Starting governed Refined Data build");
    const refinedResult = processRefinedDataUpdate_("Build Refined Data", monthParts, true);

    // Route to the shared finalization pipeline
    return finalizeSharedMonthlyWorkflow_(monthParts, timing, "Monthly Start", refinedResult, null);
  });
}

function assertMonthlyUpdateStageComplete_(stageName, result) {
  if (!result || result.success !== true) {
    const detail = result && result.error ? ": " + result.error : "";
    throw new Error("Create Monthly Update stopped because " + stageName + " did not complete successfully" + detail + ".");
  }
  return result;
}

function runMonthlyUpdate() {
  const monthParts = promptForLockedYearReportMonth_("Create Monthly Update");
  if (!monthParts) return null;
  return runFrameworkTimed_("Create Monthly Update " + monthParts.label, function(timing) {
    
    markFrameworkStep_(timing, "Monthly Update - Build Change Report", "Starting Monthly Change comparison");
    const reportResult = buildMonthlyChangeReportForMonth_(monthParts);
    assertMonthlyUpdateStageComplete_("Monthly Change", reportResult);
    markFrameworkStep_(timing, "Monthly Update - Change Report Complete", "Monthly Change finished before Refined Data begins");

    markFrameworkStep_(timing, "Monthly Update - Sync Refined Data", "Starting governed Refined Data sync");
    const refinedResult = processRefinedDataUpdate_("Sync Refined Data", monthParts, false);
    assertMonthlyUpdateStageComplete_("Refined Data update and Refined Data functions", refinedResult);
    markFrameworkStep_(timing, "Monthly Update - Refined Data Complete", "Refined Data updates and functions finished before disenrollment begins");

    // Route to the shared finalization pipeline
    return finalizeSharedMonthlyWorkflow_(monthParts, timing, "Monthly Update", refinedResult, reportResult);
  });
}

/**
 * NEW: Unified Pipeline for Disenrollment, Master List, and Index
 * Guarantees identical execution for both Monthly Start and Monthly Update
 */

function finalizeSharedMonthlyWorkflow_(monthParts, timing, processPrefix, refinedResult, reportResult) {
  
  markFrameworkStep_(timing, processPrefix + " - Update Disenrollment", "Starting Disenrolled Exclusion update");
  let disenrolledResult = createDisenrolledListForMonth_(monthParts);
  
  if (processPrefix === "Monthly Update") {
    assertMonthlyUpdateStageComplete_("Disenrolled Exclusion update", disenrolledResult);
  }

  // Shared Safety Check
  const enrollmentSafetyFailed = !!(refinedResult && refinedResult.safetyNotices && refinedResult.safetyNotices.length);
  const disenrollmentSafetyFailed = !!(disenrolledResult && disenrolledResult.safetyNotices && disenrolledResult.safetyNotices.length);
  
  if (enrollmentSafetyFailed || disenrollmentSafetyFailed) {
    markFrameworkStep_(timing, processPrefix + " - Repeat Disenrollment", "Repeating automatically after enrollment/disenrollment safety notice");
    disenrolledResult = createDisenrolledListForMonth_(monthParts);
    if (processPrefix === "Monthly Update") {
      assertMonthlyUpdateStageComplete_("Repeated Disenrolled Exclusion update", disenrolledResult);
    }
  }
  markFrameworkStep_(timing, processPrefix + " - Disenrollment Complete", "Disenrolled participants removed from Refined Data and added to Disenrolled Exclusion");

  markFrameworkStep_(timing, processPrefix + " - Create Master List", "Starting Master List creation");
  const masterResult = createMasterListForMonth_(monthParts);

  const masterName = masterResult && typeof masterResult.getName === "function" 
    ? masterResult.getName() 
    : (masterResult && masterResult.sheetName ? masterResult.sheetName : "Not created");
    
  const reportName = reportResult && typeof reportResult.getName === "function" 
    ? reportResult.getName() 
    : (reportResult && reportResult.sheetName ? reportResult.sheetName : "");

  // OPTIMIZATION: Force Google's servers to physically commit the Master List & Disenrollment 
  // data writes right now. This assigns the server processing time accurately to the Master List step 
  // instead of falsely making the "Refresh Index" step look like a 25-second bottleneck.
  SpreadsheetApp.flush();

  markFrameworkStep_(timing, processPrefix + " - Refresh Index", "Refreshing local workbook navigation");
  if (typeof populateActiveIndex === "function") populateActiveIndex();

  let completeMsg = processPrefix + " complete.";
  if (reportName) completeMsg += "\nMonthly Change: " + reportName;
  completeMsg += "\nRefined Data records: " + (refinedResult ? refinedResult.count : 0);
  completeMsg += "\nDisenrolled participants removed: " + (disenrolledResult ? disenrolledResult.rowsRemovedFromRefinedData : 0);
  completeMsg += "\nMaster List: " + masterName;

  notify_(completeMsg);
  
  return { 
    reportResult: reportResult, 
    refinedResult: refinedResult, 
    disenrolledResult: disenrolledResult, 
    masterResult: masterResult 
  };
}

