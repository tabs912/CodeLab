function buildRefinedDataFromScratch() {
  const monthParts = promptForLockedYearReportMonth_("Build Refined Data from Scratch");
  if (!monthParts) return null;
  return processRefinedDataUpdate_("Build Refined Data", monthParts, true);
}

function updateRefinedDataMonthlySync() {
  const monthParts = promptForLockedYearReportMonth_("Update Refined Data (Monthly Sync)");
  if (!monthParts) return null;
  return processRefinedDataUpdate_("Sync Refined Data", monthParts, false);
}

function processRefinedDataUpdate_(processName, monthParts, isScratchBuild) {
  return runFrameworkTimed_(processName + " " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Refined Data process is currently locked by another operation.");

    try {
      const safetyNotices = [];
      const dashboard = loadDashboardConfig_();
      const sysName = "Refined Data";
      const rawDataSheet = getCurrentRawDataSheet_(monthParts);
      if (!rawDataSheet) throw new Error("Could not find Raw Data for " + monthParts.monthLabel + ". Please run 'Format Monthly Sheets' first.");

      const rawData = getDataValues_(rawDataSheet, HEADER_ROW, DATA_START_ROW);
      const validRawRows = filterBlankRows_(rawData.values);
      if (!validRawRows.length) throw new Error("Raw Data sheet contains no valid records.");
      const targetHeaders = getHeadersForSheetType_(dashboard, sysName);
      if (!targetHeaders.length) throw new Error("Dashboard Section H is missing headers for " + sysName);

      let finalRows;
      let replacedRowsToArchive = [];
      if (isScratchBuild) {
        finalRows = mapRowsToHeaders_(validRawRows, rawData.headers, targetHeaders);
        finalRows = stampRefinedTrackingFields_(finalRows, targetHeaders, "Added", monthParts);
      } else {
        const refinedSheet = getCurrentRefinedDataSheet_();
        if (!refinedSheet) throw new Error("Existing Refined Data sheet not found for sync. Run 'Build from Scratch' instead.");
        const changeMap = getMonthlyChangeSectionMap_(monthParts);
        markFrameworkStep_(timing, "Monthly Change sections loaded", changeMap.size + " PMR(s)");
        if (!changeMap.size) {
          const unchangedData = getDataValues_(refinedSheet, HEADER_ROW, DATA_START_ROW);
          const refinedTotal = writeUniqueParticipantTotalToG1_(refinedSheet, unchangedData.headers, unchangedData.values, "Total Enrollments", "Enrolled", timing);
          const rawTotal = countUniqueParticipantsByStatus_(rawData.headers, validRawRows, "Enrolled");
          safetyNotices.push(assertParticipantTotalsMatch_("Refined Data enrollment", rawTotal, refinedTotal));
          refinedSheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("MM/dd/yyyy");
          refinedSheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("MM/dd/yyyy");
          notifyParticipantSafetyNotices_(safetyNotices, processName);
          return { success: true, count: unchangedData.values.length, unchanged: true, safetyNotices: safetyNotices.filter(String) };
        }

        const existingData = getDataValues_(refinedSheet, HEADER_ROW, DATA_START_ROW);
        const mergeResult = replaceChangedRefinedDataPMRs_(
          filterBlankRows_(existingData.values), existingData.headers,
          validRawRows, rawData.headers, targetHeaders, changeMap, monthParts, timing
        );
        finalRows = mergeResult.merged;
        replacedRowsToArchive = mergeResult.replaced;
      }

      if (isScratchBuild) finalRows = applyRefinedDataProcesses_(finalRows, targetHeaders, timing);
      if (!isScratchBuild) {
        appendRefinedDataArchiveRows_(replacedRowsToArchive, targetHeaders, {
          reason: "Monthly Sync Replacement",
          workflow: "Create Monthly Update",
          month: monthParts.firstDay,
          sourceSheet: "Refined Data"
        }, timing);
      }

      finalRows = sortRowsByLastName_(finalRows, targetHeaders);

      const finalSheet = createGovernedSheet_(sysName, monthParts, {
        customName: "Refined Data", dataRows: finalRows, headers: targetHeaders, overwrite: true, timing: timing
      });
      const refinedEnrollmentTotal = writeUniqueParticipantTotalToG1_(finalSheet, targetHeaders, finalRows, "Total Enrollments", "Enrolled", timing);
      const rawEnrollmentTotal = countUniqueParticipantsByStatus_(rawData.headers, validRawRows, "Enrolled");
      safetyNotices.push(assertParticipantTotalsMatch_("Refined Data enrollment", rawEnrollmentTotal, refinedEnrollmentTotal));
      
      markFrameworkStep_(timing, "Refined Data - Process complete", finalRows.length + " participant row(s)");
      notifyParticipantSafetyNotices_(safetyNotices, processName);
      
      const qTime = new Date().getTime();
      try { 
        if (typeof runDashboardQualityProcessValidationSections_ === "function") runDashboardQualityProcessValidationSections_("Refined Data", finalSheet.getName()); 
      } catch(e) {
        logBestEffortWarning_("Automated quality check failed for Refined Data: " + e.message);
      }
      markFrameworkStep_(timing, "Automated Quality Check", "Refined Data validated in " + ((new Date().getTime() - qTime) / 1000).toFixed(3) + "s");
      
      return { success: true, count: finalRows.length, sheetName: finalSheet.getName(), safetyNotices: safetyNotices.filter(String) };
    } finally { lock.releaseLock(); }
  });
}

const REFINED_CHANGE_SECTION_RULES = Object.freeze({
  "Enrollments": ["Capitation Date"],
  "Disenrollments": ["Enrollment Status", "Disenrollment Date", "Disenrollment Effective Date", "Disenrollment Reason", "Date of Death"],
  "Level of Care": ["Residence Type"],
  "Demographics": ["Last Name", "First Name", "Preferred Name", "Date of Birth", "Participant PMR#", "Phone Number", "Address Line 1", "Address Line 2", "City", "State", "Zip", "Oxygen", "Primary Language"],
  "Caseload Changes": ["Caseload - Social Work", "Caseload - RN", "Caseload - PCP", "Caseload - HCC", "Caseload - Activities", "Caseload - OT", "Caseload - PT", "Caseload - RD", "Caseload - Supervising MD"],
  "Banner Changes": ["Safety - 2 Person", "Bed Bug", "Wanderer", "Interpreter Needed", "Fall Risk", "DPOA or Guardian Active", "Palliative Care", "Banner Summary"],
  "Contact Changes": ["Contact - Last Name", "Contact - First Name", "Type of Contact", "Contact - Primary Language", "Relationship", "AD1 - Phone", "AD1 - Phone Valid Dates From", "AD1 - Phone Valid Dates To", "AD2 - Phone", "AD2 - Phone Valid Dates From", "AD2 - Phone Valid Dates To", "AD3 - Phone", "AD3 - Phone Valid Dates From", "AD3 - Phone Valid Dates To", "Company", "Contact - Notes"]
});

function normalizeMonthlyChangeSectionName_(title) {
  const name = String(title || "").toUpperCase();
  if (name.indexOf("ENROLLMENTS") !== -1 && name.indexOf("DISENROLLMENTS") === -1) return "Enrollments";
  if (name.indexOf("DISENROLLMENTS") !== -1) return "Disenrollments";
  if (name.indexOf("LEVEL OF CARE") !== -1) return "Level of Care";
  if (name.indexOf("DEMOGRAPHIC") !== -1) return "Demographics";
  if (name.indexOf("CASELOAD") !== -1) return "Caseload Changes";
  if (name.indexOf("BANNER") !== -1) return "Banner Changes";
  if (name.indexOf("CONTACT") !== -1) return "Contact Changes";
  return "";
}

function getMonthlyChangeSectionMap_(monthParts) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const expectedName = buildMonthlySheetName_("Monthly Change mm.yy", monthParts.firstDay, monthParts.lastDay);
  const sheet = ss.getSheetByName(expectedName) || ss.getSheetByName("Monthly Change " + monthParts.label);
  if (!sheet) throw new Error("Refined Data update requires the governed Monthly Change report for " + monthParts.label + ".");
  const values = sheet.getDataRange().getDisplayValues();
  const changes = new Map();
  for (let rowIndex = 0; rowIndex < values.length; rowIndex++) {
    const section = normalizeMonthlyChangeSectionName_(values[rowIndex][0]);
    if (!section) continue;
    const headerRowIndex = rowIndex + 2;
    const dataStartIndex = rowIndex + 4;
    const headers = values[headerRowIndex] || [];
    const pmrIndex = headers.findIndex(function(header) {
      const normalized = normalizeRawPreservationHeader_(header);
      return normalized === "participant pmr#" || normalized === "pmr #" || normalized === "pmr";
    });
    if (pmrIndex < 0) throw new Error("Monthly Change section " + section + " is missing Participant PMR#.");
    for (let dataIndex = dataStartIndex; dataIndex < values.length; dataIndex++) {
      if (String(values[dataIndex][0] || "").trim().toUpperCase().indexOf("SECTION ") === 0) break;
      const pmr = String(values[dataIndex][pmrIndex] || "").trim().toUpperCase();
      if (!pmr || pmr === "INSERT NEW DATA HERE" || pmr === "ENTER DATA HERE") continue;
      if (!changes.has(pmr)) changes.set(pmr, new Set());
      changes.get(pmr).add(section);
    }
  }
  return changes;
}

function replaceChangedRefinedDataPMRs_(existingRows, existingHeaders, rawRows, rawHeaders, targetHeaders, changeMap, monthParts, timing) {
  const existingPmrIdx = getPMRIndex_(buildHeaderIndexMap_(existingHeaders));
  const rawMap = buildHeaderIndexMap_(rawHeaders);
  const rawPmrIdx = getPMRIndex_(rawMap);
  const rawPrimaryIdx = findHeaderIndex_(rawMap, ["Primary PMR Row"]);
  const targetMap = buildHeaderIndexMap_(targetHeaders);
  const targetPmrIdx = getPMRIndex_(targetMap);
  if (existingPmrIdx < 0 || rawPmrIdx < 0 || targetPmrIdx < 0) throw new Error("Refined Data update requires PMR columns in existing, Raw Data, and target schemas.");

  const existingByPmr = new Map();
  existingRows.forEach(function(row) {
    const pmr = String(row[existingPmrIdx] || "").trim().toUpperCase();
    if (!existingByPmr.has(pmr)) existingByPmr.set(pmr, []);
    existingByPmr.get(pmr).push(mapRowsToHeaders_([row], existingHeaders, targetHeaders)[0]);
  });
  const rawByPmr = new Map();
  rawRows.forEach(function(row) {
    const pmr = String(row[rawPmrIdx] || "").trim().toUpperCase();
    if (!rawByPmr.has(pmr)) rawByPmr.set(pmr, []);
    rawByPmr.get(pmr).push(row);
  });

  const output = [];
  const archived = [];
  existingByPmr.forEach(function(rows, pmr) { if (!changeMap.has(pmr)) output.push.apply(output, rows); });

  // Arrays to hold the batched rows for processing
  const batchedAdded = [];
  const batchedUpdated = [];

changeMap.forEach(function(sections, pmr) {
    const rawGroup = rawByPmr.get(pmr) || [];
    if (!rawGroup.length) throw new Error("Raw Data has no rows for changed PMR " + pmr + ".");
    const existingGroup = existingByPmr.get(pmr) || [];
    
    // FAILSAFE: If the PMR is missing from Refined Data entirely, force an "Add"
    const isCompletelyNew = existingGroup.length === 0;
    const replaceAll = sections.has("Contact Changes") || sections.has("Enrollments") || isCompletelyNew;

    if (replaceAll) {
      if (sections.has("Contact Changes")) existingGroup.forEach(function(row) { archived.push({ row: row.slice(), sectionChanged: "Contact Changes" }); });
      let mappedAdded = mapRowsToHeaders_(rawGroup, rawHeaders, targetHeaders);
      batchedAdded.push.apply(batchedAdded, mappedAdded);
      return;
    }

    if (!existingGroup.length) throw new Error("Refined Data has no existing row for updated PMR " + pmr + ".");

    const rawPrimary = rawGroup.find(function(row) { return rawPrimaryIdx >= 0 && isPrimaryPMRRowValue_(row[rawPrimaryIdx]); }) || rawGroup[0];
    const mappedRawPrimary = mapRowsToHeaders_([rawPrimary], rawHeaders, targetHeaders)[0];
    const updated = existingGroup[0].slice();

    sections.forEach(function(section) {
      archived.push({ row: existingGroup[0].slice(), sectionChanged: section });
      (REFINED_CHANGE_SECTION_RULES[section] || []).forEach(function(header) {
        const index = findHeaderIndex_(targetMap, [header]);
        if (index >= 0) updated[index] = mappedRawPrimary[index];
      });
    });

    batchedUpdated.push(updated);
  });

  // BATCH PROCESS: Run the formatting and tracking stamps on the entire groups exactly once
  if (batchedAdded.length > 0) {
    stampRefinedTrackingFields_(batchedAdded, targetHeaders, "Added", monthParts);
    const processedAdded = applyRefinedDataProcesses_(batchedAdded, targetHeaders, timing, { runContactFunctions: true });
    output.push.apply(output, processedAdded);
  }

  if (batchedUpdated.length > 0) {
    stampRefinedTrackingFields_(batchedUpdated, targetHeaders, "Updated", monthParts);
    const processedUpdated = applyRefinedDataProcesses_(batchedUpdated, targetHeaders, timing, { runContactFunctions: false });
    output.push.apply(output, processedUpdated);
  }

  markFrameworkStep_(timing, "Section-aware Refined Data changes applied", changeMap.size + " PMR(s) batched and processed");
  return { merged: output, replaced: archived };
}

function appendRefinedDataArchiveRows_(rows, sourceHeaders, metadata, timing) {
  if (!rows || !rows.length) return 0;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const metadataHeaders = ["Archived At", "Archive Reason", "Section Changed", "Source Workflow", "Source Month", "Source Sheet"];
  const archiveHeaders = metadataHeaders.concat(sourceHeaders.filter(function(header) { return metadataHeaders.indexOf(header) === -1; }));
  let sheet = ss.getSheetByName("Archive - Refined Data");
  if (!sheet) sheet = createGovernedSheet_("Archive - Refined Data", null, { customName: "Archive - Refined Data", headers: archiveHeaders, overwrite: false, timing: timing });
  if (sheet.getMaxColumns() < archiveHeaders.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), archiveHeaders.length - sheet.getMaxColumns());
  sheet.getRange(HEADER_ROW, 1, 1, archiveHeaders.length).setValues([archiveHeaders]);

  const now = new Date();
  const meta = metadata || {};
  const sourceMap = buildHeaderIndexMap_(sourceHeaders);
  const payload = rows.map(function(item) {
    const row = item && item.row ? item.row : item;
    return archiveHeaders.map(function(header) {
      if (header === "Archived At") return now;
      if (header === "Archive Reason") return meta.reason || "Monthly Sync Replacement";
      if (header === "Section Changed") return item && item.sectionChanged ? item.sectionChanged : (meta.sectionChanged || "");
      if (header === "Source Workflow") return meta.workflow || "Create Monthly Update";
      if (header === "Source Month") return meta.month || "";
      if (header === "Source Sheet") return meta.sourceSheet || "Refined Data";
      const index = findHeaderIndex_(sourceMap, [header]);
      return index < 0 ? "" : row[index];
    });
  });
  const startRow = Math.max(sheet.getLastRow() + 1, DATA_START_ROW);
  sheet.getRange(startRow, 1, payload.length, archiveHeaders.length).setValues(payload);
  markFrameworkStep_(timing, "Archive removed Refined Data rows", payload.length + " row(s) with reason/workflow/month/source metadata");
  return payload.length;
}


function stampRefinedTrackingFields_(rows, headers, status, monthParts) {
  const map = buildHeaderIndexMap_(headers);
  const statusIdx = map["Refined Data Update Status"];
  const monthIdx = map["Refined Data Update Month"];
  const sourceIdx = map["Refined Data Source Sheet"];

  const newMonth = monthParts.firstDay;
  const newSource = "Raw Data " + monthParts.label;

  rows.forEach(row => {
    if (statusIdx !== undefined) row[statusIdx] = status;
    if (monthIdx !== undefined) row[monthIdx] = newMonth;
    if (sourceIdx !== undefined) row[sourceIdx] = newSource;
  });
  return rows;
}

function applyRefinedDataProcesses_(rows, headers, timing, options) {
  options = options || {};
  const headerMap = buildHeaderIndexMap_(headers);
  const getIndex = function(name) { return headerMap[name]; };
  const setIfPresent = function(row, name, value) { const index = getIndex(name); if (index !== undefined) row[index] = value; };
  let workingRows = rows || [];

  // Contact functions run first and only for caller-approved Added records.
  if (options.runContactFunctions !== false) {
    const pmrIndex = getPMRIndex_(headerMap);
    const primaryIndex = getIndex("Primary PMR Row");
    if (pmrIndex < 0 || primaryIndex === undefined) throw new Error("Refined Data contact processing requires PMR and Primary PMR Row columns.");
    const contactTargets = ["Contact - 1", "Contact - 2", "Contact - 3", "Contact - 4", "Contact - 5", "Contact - 6", "Contact - 7", "Contact - 8"];
    const contactFields = ["Contact - Last Name", "Contact - First Name", "Type of Contact", "Contact - Primary Language", "Relationship", "AD1 - Phone", "AD1 - Phone Valid Dates From", "AD1 - Phone Valid Dates To", "AD2 - Phone", "AD2 - Phone Valid Dates From", "AD2 - Phone Valid Dates To", "AD3 - Phone", "AD3 - Phone Valid Dates From", "AD3 - Phone Valid Dates To", "Company", "Contact - Notes"];
    const grouped = new Map();
    workingRows.forEach(function(row) {
      const pmr = String(row[pmrIndex] || "").trim().toUpperCase();
      if (!pmr) return;
      if (!grouped.has(pmr)) grouped.set(pmr, []);
      grouped.get(pmr).push(row);
    });
    const flattened = [];
    grouped.forEach(function(group) {
      const primary = group.find(function(row) { return isPrimaryPMRRowValue_(row[primaryIndex]); }) || group[0];
      const output = primary.slice();
      const summaries = group.filter(function(row) { return row !== primary; }).map(function(row) {
        return contactFields.map(function(header) {
          const index = getIndex(header);
          return index === undefined ? "" : String(row[index] || "").trim();
        }).filter(Boolean).join(" | ");
      }).filter(Boolean);
      contactTargets.forEach(function(target) { setIfPresent(output, target, ""); });
      summaries.slice(0, contactTargets.length).forEach(function(summary, index) { setIfPresent(output, contactTargets[index], summary); });
      setIfPresent(output, "Contact - Summary", summaries.join("\n"));
      flattened.push(output);
    });
    workingRows = flattened;
    markFrameworkStep_(timing, "Refined Data - Contact functions", rows.length + " Added source row(s) compressed to " + workingRows.length + " participant row(s)");
  }

  // Remaining functions run after contacts for Added and Updated records.
  workingRows.forEach(function(row) {
    const first = getIndex("First Name") === undefined ? "" : String(row[getIndex("First Name")] || "").trim();
    const last = getIndex("Last Name") === undefined ? "" : String(row[getIndex("Last Name")] || "").trim();
    const participantName = [last, first].filter(Boolean).join(", ");
    if (participantName) {
      setIfPresent(row, "Participant Name", participantName);
      setIfPresent(row, "Name", [first, last].filter(Boolean).join(" "));
    }

    const phoneIndex = getIndex("Phone Number");
    const phoneText = phoneIndex === undefined ? "" : String(row[phoneIndex] || "").trim();
    [1, 2, 3, 4].forEach(function(number) {
      setIfPresent(row, "Phone " + number + " - Label", "");
      setIfPresent(row, "Phone " + number + " - Value", "");
    });
    phoneText.split("_").map(function(value) { return value.trim(); }).filter(Boolean).slice(0, 4).forEach(function(phone, index) {
      setIfPresent(row, "Phone " + (index + 1) + " - Label", ["Home", "Mobile", "Other", "Other"][index]);
      setIfPresent(row, "Phone " + (index + 1) + " - Value", phone);
    });

    const addressParts = ["Address Line 1", "Address Line 2"].map(function(header) {
      const index = getIndex(header); return index === undefined ? "" : String(row[index] || "").trim();
    }).filter(Boolean);
    const cityStateZip = ["City", "State", "Zip"].map(function(header) {
      const index = getIndex(header); return index === undefined ? "" : String(row[index] || "").trim();
    }).filter(Boolean);
    if (cityStateZip.length) addressParts.push(cityStateZip.join(", "));
    setIfPresent(row, "Address 1 - Street", addressParts.join(" "));

    const languageIndex = getIndex("Primary Language");
    const language = languageIndex === undefined ? "" : String(row[languageIndex] || "").trim();
    setIfPresent(row, "Custom Field 1 - Label", language && language.toLowerCase() !== "english" ? "Language" : "");
    setIfPresent(row, "Custom Field 1 - Value", language && language.toLowerCase() !== "english" ? language : "");

    const bannerHeaders = ["Safety - 2 Person", "Bed Bug", "Wanderer", "Interpreter Needed", "Fall Risk", "DPOA or Guardian Active", "Palliative Care"];
    const bannerSummary = bannerHeaders.map(function(header) {
      const index = getIndex(header); const value = index === undefined ? "" : String(row[index] || "").trim();
      return value ? header : "";
    }).filter(Boolean).join(" | ");
    setIfPresent(row, "Banner Summary", bannerSummary);
  });
  combineRefinedDataNotesSummary_(workingRows, headers);
  markFrameworkStep_(timing, "Refined Data - Remaining functions", workingRows.length + " Added/Updated participant row(s) processed");
  return workingRows;
}

function combineRefinedDataNotesSummary_(rows, headers) {
  const headerMap = buildHeaderIndexMap_(headers || []);
  const notesIdx = findHeaderIndex_(headerMap, ["Notes"]);
  if (notesIdx < 0) return;

  (rows || []).forEach(function(row) {
    if (String(row[notesIdx] == null ? "" : row[notesIdx]).trim() !== "") return;
    const parts = [];
    ["Banner Summary", "Contact - Summary"].forEach(function(header) {
      const idx = findHeaderIndex_(headerMap, [header]);
      const value = idx < 0 ? "" : String(row[idx] || "").trim();
      if (value) parts.push(value);
    });

    const caseload = ["Caseload - PCP", "Caseload - RN", "Caseload - Social Work"].map(function(header) {
      const idx = findHeaderIndex_(headerMap, [header]);
      return idx < 0 ? "" : String(row[idx] || "").trim();
    }).filter(Boolean);
    if (caseload.length) parts.push(caseload.join(" | "));

    const additionalIdx = findHeaderIndex_(headerMap, ["Additional Important Information"]);
    const additional = additionalIdx < 0 ? "" : String(row[additionalIdx] || "").trim();
    if (additional) parts.push(additional);
    row[notesIdx] = parts.join("\n\n");
  });
}

// ============================================================================
// 2.4. DISENROLLED EXCLUSION PIPELINE
// ============================================================================

function createDisenrolledList() {
  const monthParts = promptForLockedYearReportMonth_("Create Disenrolled Exclusion List");
  if (!monthParts) return null;
  return createDisenrolledListForMonth_(monthParts);
}

function createDisenrolledListForMonth_(monthParts) {
  return runFrameworkTimed_("Disenrolled Exclusion " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Disenrolled Exclusion process is locked.");
    try {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const dashboard = loadDashboardConfig_();
      const refinedSheet = getCurrentRefinedDataSheet_();
      if (!refinedSheet) throw new Error("Refined Data sheet is missing. Cannot build Disenrolled list.");

      const refinedData = getDataValues_(refinedSheet, HEADER_ROW, DATA_START_ROW);
      const targetHeaders = getHeadersForSheetType_(dashboard, "Disenrolled Exclusion");
      if (!targetHeaders.length) throw new Error("Dashboard Section H is missing Disenrolled Exclusion headers.");

      const statusIndex = findHeaderIndex_(refinedData.headerMap, ["Enrollment Status", "Status"]);
      const dateIndex = findHeaderIndex_(refinedData.headerMap, ["Disenrollment Effective Date", "Disenrollment Date", "Disenrolled Date", "Date of Death"]);
      const refinedPmrIndex = getPMRIndex_(refinedData.headerMap);
      
      if (refinedPmrIndex < 0 || dateIndex < 0) throw new Error("Refined Data is missing PMR or disenrollment-date columns.");

      let exclusionSheet = ss.getSheetByName("Disenrolled Exclusion");
      if (!exclusionSheet) {
        exclusionSheet = createGovernedSheet_("Disenrolled Exclusion", null, {
          customName: "Disenrolled Exclusion", headers: targetHeaders, overwrite: false, skipInitialTrim: true, timing: timing
        });
      }
      
      const exclusionData = getDataValues_(exclusionSheet, HEADER_ROW, DATA_START_ROW);
      const exclusionPmrIndex = getPMRIndex_(exclusionData.headerMap);
      
      const targetMap = buildHeaderIndexMap_(targetHeaders);
      const targetPmrIndex = getPMRIndex_(targetMap);
      
      // --- FIX ML19741-004: Missing Exclusion PMR Schema Fails Open ---
      if (exclusionPmrIndex < 0 && exclusionData.values.length > 0) {
        throw new Error("Disenrolled Exclusion sheet has data but is missing a valid PMR column. Halting to prevent history loss.");
      }
      if (targetPmrIndex < 0) {
        throw new Error("Target Disenrolled Exclusion headers are missing a valid PMR column.");
      }

      exclusionSheet.getRange("B2").setValue(monthParts.firstDay).setNumberFormat("MM/dd/yyyy");
      exclusionSheet.getRange("D2").setValue(monthParts.lastDay).setNumberFormat("MM/dd/yyyy");

      // --- IN-MEMORY PROCESSING START ---
      const activeReenrolledPMRs = new Set();
      const disenrolledRows = [];
      const retainedRefinedRows = [];

      filterBlankRows_(refinedData.values).forEach(function(row) {
        const pmr = String(row[refinedPmrIndex] || "").trim().toUpperCase();
        if (!pmr) return;
        const status = statusIndex < 0 ? "" : String(row[statusIndex] || "").trim().toLowerCase();
        const hasDate = String(row[dateIndex] == null ? "" : row[dateIndex]).trim() !== "";
        
        if (status === "active" || status === "enrolled" || !hasDate) {
          activeReenrolledPMRs.add(pmr);
          retainedRefinedRows.push(row);
        } else {
          disenrolledRows.push(row);
        }
      });

      const existingPMRs = new Set();
      let reactivatedRowsRemoved = 0;
      const retainedExclusionRows = [];

      if (exclusionPmrIndex >= 0 && exclusionData.values.length > 0) {
        exclusionData.values.forEach(function(row) {
          const pmr = String(row[exclusionPmrIndex] || "").trim().toUpperCase();
          if (pmr && activeReenrolledPMRs.has(pmr)) {
            reactivatedRowsRemoved++;
          } else {
            retainedExclusionRows.push(row);
            if (pmr) existingPMRs.add(pmr);
          }
        });
      }

      const targetAddedIndex = findHeaderIndex_(targetMap, ["Added to Disenrolled Exclusion"]);
      const targetDateIndex = findHeaderIndex_(targetMap, ["Disenrollment Effective Date", "Disenrollment Date", "Date of Death"]);
      
      const mappedDisenrolledRows = mapRowsToHeaders_(disenrolledRows, refinedData.headers, targetHeaders);
      const newExclusionRows = [];
      let alreadyDurableRows = 0;

      mappedDisenrolledRows.forEach(function(row) {
        const pmr = String(row[targetPmrIndex] || "").trim().toUpperCase();
        if (pmr && existingPMRs.has(pmr)) {
          alreadyDurableRows++;
          return;
        }
        if (targetAddedIndex >= 0) row[targetAddedIndex] = monthParts.firstDay;
        newExclusionRows.push(row);
        if (pmr) existingPMRs.add(pmr);
      });

      const finalExclusionMatrix = retainedExclusionRows.concat(newExclusionRows);
      
      if (targetDateIndex >= 0) {
        finalExclusionMatrix.sort(function(a, b) {
          const left = new Date(a[targetDateIndex]).getTime();
          const right = new Date(b[targetDateIndex]).getTime();
          return (isNaN(right) ? 0 : right) - (isNaN(left) ? 0 : left);
        });
      }
      
      // Refined Data processing
      const refinedHeaders = getHeadersForSheetType_(dashboard, "Refined Data");
      const mappedRetainedRefined = mapRowsToHeaders_(retainedRefinedRows, refinedData.headers, refinedHeaders);

      // --- FIX ML19741-003: Refined Data Range-Width Mismatch ---
      const exclusionWidth = Math.max(targetHeaders.length, exclusionSheet.getMaxColumns());
      const refinedWidth = Math.max(refinedHeaders.length, refinedSheet.getMaxColumns());
      
      const normalizedExclusionMatrix = normalizeRowsToWidth_(finalExclusionMatrix, exclusionWidth);
      const normalizedRefinedMatrix = normalizeRowsToWidth_(mappedRetainedRefined, refinedWidth);
      // --- IN-MEMORY PROCESSING COMPLETE ---

      // --- FIX ML19743-001: Cross-Sheet Dual Recovery Boundary ---
      const maxExclusionDataRows = Math.max(exclusionSheet.getLastRow() - DATA_START_ROW + 1, 1);
      const maxRefinedDataRows = Math.max(refinedSheet.getLastRow() - DATA_START_ROW + 1, 1);
      
      try {
        // 1. Write to Exclusion Sheet
        const requiredExclusionRows = Math.max(normalizedExclusionMatrix.length, 1);
        if (exclusionSheet.getMaxRows() < DATA_START_ROW + requiredExclusionRows - 1) {
          exclusionSheet.insertRowsAfter(exclusionSheet.getMaxRows(), (DATA_START_ROW + requiredExclusionRows - 1) - exclusionSheet.getMaxRows());
        }
        
        exclusionSheet.getRange(DATA_START_ROW, 1, maxExclusionDataRows, exclusionWidth).clearContent();
        if (normalizedExclusionMatrix.length > 0) {
          exclusionSheet.getRange(DATA_START_ROW, 1, normalizedExclusionMatrix.length, exclusionWidth).setValues(normalizedExclusionMatrix);
        }

        // 2. Write to Refined Data
        refinedSheet.getRange(DATA_START_ROW, 1, maxRefinedDataRows, refinedWidth).clearContent();
        if (normalizedRefinedMatrix.length > 0) {
           refinedSheet.getRange(DATA_START_ROW, 1, normalizedRefinedMatrix.length, refinedWidth).setValues(normalizedRefinedMatrix);
        }

      } catch (writeErr) {
        // ROLLBACK BOTH SHEETS IF EITHER FAILS
        logBestEffortWarning_("Commit failed during disenrollment. Attempting dual rollback. Error: " + writeErr.message);
        let rollbackExclusionSuccess = false;
        let rollbackRefinedSuccess = false;

        try {
          exclusionSheet.getRange(DATA_START_ROW, 1, Math.max(exclusionSheet.getLastRow() - DATA_START_ROW + 1, 1), exclusionWidth).clearContent();
          if (exclusionData.values && exclusionData.values.length > 0) {
             const rollbackExclusionMatrix = normalizeRowsToWidth_(exclusionData.values, exclusionWidth);
             exclusionSheet.getRange(DATA_START_ROW, 1, rollbackExclusionMatrix.length, exclusionWidth).setValues(rollbackExclusionMatrix);
          }
          rollbackExclusionSuccess = true;
        } catch (e) {
          logBestEffortWarning_("CRITICAL: Failed to rollback Disenrolled Exclusion: " + e.message);
        }

        try {
          refinedSheet.getRange(DATA_START_ROW, 1, Math.max(refinedSheet.getLastRow() - DATA_START_ROW + 1, 1), refinedWidth).clearContent();
          if (refinedData.values && refinedData.values.length > 0) {
             const rollbackRefinedMatrix = normalizeRowsToWidth_(refinedData.values, refinedWidth);
             refinedSheet.getRange(DATA_START_ROW, 1, rollbackRefinedMatrix.length, refinedWidth).setValues(rollbackRefinedMatrix);
          }
          rollbackRefinedSuccess = true;
        } catch (e) {
          logBestEffortWarning_("CRITICAL: Failed to rollback Refined Data: " + e.message);
        }

        if (rollbackExclusionSuccess && rollbackRefinedSuccess) {
          throw new Error("Disenrollment aborted and safely rolled back both sheets due to write error: " + writeErr.message);
        } else {
          throw new Error("CRITICAL: Disenrollment write failed (" + writeErr.message + ") AND dual-sheet recovery failed. Data may be inconsistent!");
        }
      }
      // --- COMMIT BOUNDARY SUCCESS ---

      if (typeof trimCreatedSheetToData_ === "function") {
        trimCreatedSheetToData_(refinedSheet, DATA_START_ROW, refinedHeaders.length);
        trimCreatedSheetToData_(exclusionSheet, DATA_START_ROW, targetHeaders.length);
      }

      // --- POST-WRITE METADATA & SAFETY CHECKS ---
      writeUniqueParticipantTotalToG1_(refinedSheet, refinedHeaders, mappedRetainedRefined, "Total Enrollments", "Enrolled", timing);
      const exclusionTotal = writeUniqueParticipantTotalToG1_(exclusionSheet, targetHeaders, finalExclusionMatrix, "Total Disenrollments", null, timing, "E1", "E2");
      
      const rawDataSheet = getCurrentRawDataSheet_(monthParts);
      const disenrollmentSafetyNotices = [];
      if (!rawDataSheet) {
        disenrollmentSafetyNotices.push("Disenrolled Exclusion safety check notice: Raw Data " + monthParts.label + " was not found, so totals were not compared. Processing completed without interruption.");
      } else {
        const rawDataForSafety = getDataValues_(rawDataSheet, HEADER_ROW, DATA_START_ROW);
        const rawDisenrollmentTotal = countUniqueParticipantsByStatus_(rawDataForSafety.headers, rawDataForSafety.values, "Disenrolled");
        disenrollmentSafetyNotices.push(assertParticipantTotalsMatch_("Disenrolled Exclusion", rawDisenrollmentTotal, exclusionTotal));
      }
      
      const hiddenCount = hideHistoricalDisenrollmentRows_(exclusionSheet, finalExclusionMatrix, targetDateIndex, monthParts);
      notifyParticipantSafetyNotices_(disenrollmentSafetyNotices, "Disenrolled Exclusion");
      
      const qTime = new Date().getTime();
      try { 
        if (typeof runDashboardQualityProcessValidationSections_ === "function") runDashboardQualityProcessValidationSections_("Disenrolled Exclusion", exclusionSheet.getName()); 
      } catch(e) {
        logBestEffortWarning_("Automated quality check failed for Disenrolled Exclusion: " + e.message);
      }
      markFrameworkStep_(timing, "Automated Quality Check", "Disenrolled Exclusion validated in " + ((new Date().getTime() - qTime) / 1000).toFixed(3) + "s");
      
      return {
        success: true,
        count: finalExclusionMatrix.length,
        rowsAppended: newExclusionRows.length,
        rowsRemovedFromRefinedData: disenrolledRows.length,
        reactivatedRowsRemoved: reactivatedRowsRemoved,
        hiddenCount: hiddenCount,
        safetyNotices: disenrollmentSafetyNotices.filter(String),
        sheetName: exclusionSheet.getName()
      };
    } finally { lock.releaseLock(); }
  });
}


function hideHistoricalDisenrollmentRows_(sheet, rows, dateIndex, monthParts) {
  if (!sheet || dateIndex < 0 || !rows.length) return 0;
  const cutoff = new Date(monthParts.lastDay);
  cutoff.setDate(cutoff.getDate() - 365);
  const rowNumbers = [];
  rows.forEach(function(row, index) {
    const date = new Date(row[dateIndex]);
    if (!isNaN(date.getTime()) && date < cutoff) rowNumbers.push(DATA_START_ROW + index);
  });
  if (!rowNumbers.length) return 0;
  let start = rowNumbers[0]; let previous = rowNumbers[0];
  for (let index = 1; index <= rowNumbers.length; index++) {
    const current = rowNumbers[index];
    if (current === previous + 1) { previous = current; continue; }
    sheet.hideRows(start, previous - start + 1);
    start = current; previous = current;
  }
  return rowNumbers.length;
}

