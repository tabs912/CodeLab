function createMasterList() {
  const monthParts = promptForLockedYearReportMonth_("Create Master List");
  if (!monthParts) return null;
  return createMasterListForMonth_(monthParts);
}

function createMasterListForMonth_(monthParts) {
  return runFrameworkTimed_("Master List " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Master List process is currently locked.");

    try {
      const dashboard = loadDashboardConfig_();
      const sysName = "Master List";

      const sourceSheets = {
        refined: getCurrentRefinedDataSheet_(),
        cpDue: getCurrentCarePlanDueSheet_(monthParts),
        unlockCP: getCurrentUnlockedCarePlanSheet_(monthParts)
      };

      if (!sourceSheets.refined) throw new Error("Refined Data is missing. Please run Update Refined Data first.");

      markFrameworkStep_(timing, "Reading Sources", "Extracting and filtering blank rows...");
      const data = {
        refined: filterBlankRows_(getDataValues_(sourceSheets.refined, HEADER_ROW, DATA_START_ROW).values),
        cpDue: sourceSheets.cpDue ? filterBlankRows_(getDataValues_(sourceSheets.cpDue, HEADER_ROW, DATA_START_ROW).values) : [],
        unlockCP: sourceSheets.unlockCP ? filterBlankRows_(getDataValues_(sourceSheets.unlockCP, HEADER_ROW, DATA_START_ROW).values) : []
      };

      const maps = {
        refined: buildHeaderIndexMap_(getHeaders_(sourceSheets.refined, HEADER_ROW)),
        cpDue: sourceSheets.cpDue ? buildHeaderIndexMap_(getHeaders_(sourceSheets.cpDue, HEADER_ROW)) : {},
        unlockCP: sourceSheets.unlockCP ? buildHeaderIndexMap_(getHeaders_(sourceSheets.unlockCP, HEADER_ROW)) : {}
      };

      const targetHeaders = getHeadersForSheetType_(dashboard, sysName);
      if (!targetHeaders || targetHeaders.length === 0) throw new Error("Dashboard Section H is missing headers for Master List.");

      markFrameworkStep_(timing, "Merging Data", "Synthesizing Master List...");
      const mergedRows = mergeMasterListData_(data, maps, targetHeaders);

      if (mergedRows.length === 0) {
        throw new Error("Master List generation resulted in 0 rows.");
      }

      markFrameworkStep_(timing, "Instantiating Sheet", "Writing Master List grid...");
      const finalSheet = createGovernedSheet_(sysName, monthParts, {
        dataRows: mergedRows,
        headers: targetHeaders,
        overwrite: true,
        timing: timing
      });

      markFrameworkStep_(timing, "Process Complete", "Master List created successfully.");
      
      const qTime = new Date().getTime();
      try { 
        if (typeof runDashboardQualityProcessValidationSections_ === "function") runDashboardQualityProcessValidationSections_("Master List", finalSheet.getName()); 
      } catch(e) {
        logBestEffortWarning_("Automated quality check failed for Master List: " + e.message);
      }
      markFrameworkStep_(timing, "Automated Quality Check", "Master List validated in " + ((new Date().getTime() - qTime) / 1000).toFixed(3) + "s");
      
      return { success: true, count: mergedRows.length, sheetName: finalSheet.getName() };

    } finally {
      lock.releaseLock();
    }
  });
}

function normalizeNameKey_(val) {
  if (!val) return "";
  return String(val).toLowerCase().replace(/[^a-z0-9]/g, "");
}

function buildNameKeyVariants_(nameStr) {
  const variants = new Set();
  const raw = String(nameStr || "").trim();
  if (!raw) return variants;

  const norm = normalizeNameKey_(raw);
  if (norm) variants.add(norm);

  let first = "";
  let last = "";

  if (raw.indexOf(",") !== -1) {
    const parts = raw.split(",");
    last = parts[0].trim();
    first = parts[1] ? parts[1].trim() : "";
  } else {
    const parts = raw.split(/\s+/);
    if (parts.length >= 2) {
      first = parts[0];
      last = parts.slice(1).join(" ");
    } else {
      return variants;
    }
  }

  // Add full combinations (ignores commas and extra spaces)
  variants.add(normalizeNameKey_(first + last));
  variants.add(normalizeNameKey_(last + first));

  // Ultra-Aggressive Fallback: First word of First Name + Last word of Last Name
  // This successfully matches "Jane Doe" to "Doe, Jane P." by stripping the middle initial
  const pureFirst = first.split(/\s+/)[0];
  const pureLast = last.split(/\s+/).pop();
  
  if (pureFirst && pureLast) {
    variants.add(normalizeNameKey_(pureFirst + pureLast));
    variants.add(normalizeNameKey_(pureLast + pureFirst));
  }

  return variants;
}

function buildCPDueLookupMap_(cpDueRows, cpDueHeaderMap) {
  const map = new Map();
  const nameIdx = findHeaderIndex_(cpDueHeaderMap, ["Participant Name", "Name"]);
  if (nameIdx < 0 || !cpDueRows) return map;

  cpDueRows.forEach(row => {
    const nameVal = row[nameIdx];
    if (!nameVal) return;
    const variants = buildNameKeyVariants_(nameVal);
    variants.forEach(variant => {
      if (!map.has(variant)) map.set(variant, row);
    });
  });
  return map;
}

function buildUnlockCPLookupMap_(unlockRows, unlockHeaderMap) {
  const pmrMap = new Map();
  const nameMap = new Map();
  const pmrIdx = getPMRIndex_(unlockHeaderMap);
  const nameIdx = findHeaderIndex_(unlockHeaderMap, ["Participant Name", "Name"]);
  
  if (!unlockRows) return { pmrMap, nameMap };

  unlockRows.forEach(row => {
    if (pmrIdx >= 0) {
      // Safe call for normalizePMR_ in case it is ever missing
      const pmrVal = typeof normalizePMR_ === "function" ? normalizePMR_(row[pmrIdx]) : String(row[pmrIdx]||"").trim().toUpperCase();
      if (pmrVal && !pmrMap.has(pmrVal)) pmrMap.set(pmrVal, row);
    }
    if (nameIdx >= 0) {
      const nameVal = row[nameIdx];
      if (nameVal) {
        const variants = buildNameKeyVariants_(nameVal);
        variants.forEach(variant => {
          if (!nameMap.has(variant)) nameMap.set(variant, row);
        });
      }
    }
  });
  return { pmrMap, nameMap };
}

function getMappedValue_(targetHeader, sourceRow, sourceMap) {
  if (!sourceRow || sourceRow.length === 0) return "";
  const idx = findHeaderIndex_(sourceMap, [targetHeader]);
  return (idx >= 0 && idx < sourceRow.length) ? sourceRow[idx] : "";
}

function mergeMasterListData_(data, maps, targetHeaders) {
  const recordMap = new Map();
  const refinedPmrIdx = getPMRIndex_(maps.refined);
  if (refinedPmrIdx < 0) throw new Error("Could not find PMR column in Refined Data.");

  const cpDueMap = buildCPDueLookupMap_(data.cpDue, maps.cpDue);
  const unlockCPMap = buildUnlockCPLookupMap_(data.unlockCP, maps.unlockCP);

  const partNameIdx = findHeaderIndex_(maps.refined, ["Participant Name"]);
  const nameIdx = findHeaderIndex_(maps.refined, ["Name"]);
  const lastNameIdx = findHeaderIndex_(maps.refined, ["Last Name"]);
  const firstNameIdx = findHeaderIndex_(maps.refined, ["First Name"]);

  data.refined.forEach(row => {
    const pmr = typeof normalizePMR_ === "function" ? normalizePMR_(row[refinedPmrIdx]) : String(row[refinedPmrIdx]||"").trim().toUpperCase();
    const partName = partNameIdx >= 0 ? String(row[partNameIdx] || "").trim() : "";
    const name = nameIdx >= 0 ? String(row[nameIdx] || "").trim() : "";
    const lastName = lastNameIdx >= 0 ? String(row[lastNameIdx] || "").trim() : "";
    const firstName = firstNameIdx >= 0 ? String(row[firstNameIdx] || "").trim() : "";

    if (!pmr && !partName && !name) return;

    // 1. Unlock CP Match by PMR
    let unlockMatch = pmr ? unlockCPMap.pmrMap.get(pmr) : null;

    // 2. CP Due / Unlock Match by Name Variants
    let cpDueMatch = null;
    const candidateNames = [partName, name, lastName && firstName ? lastName + ", " + firstName : ""].filter(Boolean);
    
    for (let i = 0; i < candidateNames.length; i++) {
      const variants = buildNameKeyVariants_(candidateNames[i]);
      for (const variant of variants) {
        if (!cpDueMatch && cpDueMap.has(variant)) cpDueMatch = cpDueMap.get(variant);
        if (!unlockMatch && unlockCPMap.nameMap.has(variant)) unlockMatch = unlockCPMap.nameMap.get(variant);
      }
      if (cpDueMatch && unlockMatch) break;
    }

    const mergedRow = targetHeaders.map(header => {
      let val = getMappedValue_(header, row, maps.refined);
      if (val !== "" && val !== null && val !== undefined) return val;

      if (cpDueMatch) {
        val = getMappedValue_(header, cpDueMatch, maps.cpDue);
        if (val !== "" && val !== null && val !== undefined) return val;
      }

      if (unlockMatch) {
        val = getMappedValue_(header, unlockMatch, maps.unlockCP);
        if (val !== "" && val !== null && val !== undefined) return val;
      }

      return "";
    });

    recordMap.set(pmr || partName || name, mergedRow);
  });

  return Array.from(recordMap.values());
}

