  const builders = [
    ["Base Template", function() { createOrRefreshBaseTemplate_(); }],
    ["Banners", function() { buildTemplateBannerReport(masterDashboardConfig); }],
    ["CP Due Date", function() { buildTemplateCarePlanDue(masterDashboardConfig); }],
