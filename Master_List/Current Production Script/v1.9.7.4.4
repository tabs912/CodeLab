    const results = runDashboardQualityProcessValidationSections_();
    markFrameworkStep_(timing, "Dashboard Quality Sections C-H complete", results.length + " validation result(s)");
    ss.toast("Quality Diagnostics Complete! Check Sections C - H.", "QA Engine", 5);
    return results;
  });
}

function getExpectedNumberFormat_(def, globals) {
  if (!def) return "General";
  if (def.format) return String(def.format).trim();
  if (def.dateColumn) return String((globals && globals["Default Date Format"]) || "mm/dd/yyyy").trim();
  return "General";
}

function getGoogleSheetsNumberFormat_(format, isDateColumn) {
  const text = String(format || "").trim();
  if (!text) return "General";
  const lower = text.toLowerCase().replace(/\s+/g, "");
  if (isDateColumn || lower.indexOf("d") !== -1 || lower.indexOf("y") !== -1) {
    if (lower === "mm/dd/yyyy" || lower === "m/d/yyyy") return "m/d/yyyy";
    if (lower === "mm/dd/yy" || lower === "m/d/yy") return "m/d/yy";
    if (lower === "mm.dd.yy" || lower === "m.d.yy") return "m.d.yy";
    if (lower === "mm.dd.yyyy" || lower === "m.d.yyyy") return "m.d.yyyy";
  }
  return text;
}

function numberFormatsMatch_(actual, expected) {
  if (!actual && (!expected || expected === "General")) return true;
  const normA = String(actual || "").trim().toLowerCase().replace(/\s+/g, "");
  const normE = String(expected || "").trim().toLowerCase().replace(/\s+/g, "");
  if (normA === normE) return true;
  const isDateA = /^[mdy\/\.\-]+$/.test(normA);
  const isDateE = /^[mdy\/\.\-]+$/.test(normE);
  if (isDateA && isDateE) return true;
  return false;
}

function runDashboardQualityProcessValidationSections_(targetSheetType, exactSheetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = loadDashboardConfig_();
  const allValidations = [
    ["SECTION C - RAW DATA VALIDATION", "Raw Data"],
    ["SECTION D - REFINED DATA QUALITY VALIDATION", "Refined Data"],
    ["SECTION E - DISENROLLED EXCLUSION VALIDATION", "Disenrolled Exclusion"],
    ["SECTION F - MONTHLY CHANGE VALIDATION", "Monthly Change"],
    ["SECTION G - MASTER LIST VALIDATION", "Master List"]
  ];
  
  const validations = targetSheetType 
    ? allValidations.filter(function(item) { return item[1] === targetSheetType; })
    : allValidations;
    
  if (validations.length === 0) return [];
  
  const allResults = [];
  const summaryRows = [];
  let totalFailed = 0;
  let totalWarnings = 0;

  validations.forEach(function(item) {
    const title = item[0];
    const sheetType = item[1];
    
    const sectionResults = [];
    const governedHeaders = getHeadersForSheetType_(dashboard, sheetType);
    
    if (!governedHeaders.length) {
      sectionResults.push(["Governed Headers", "FAIL", "No governed headers configured in Format Dashboard."]);
    } else {
      sectionResults.push(["Governed Headers", "PASS", governedHeaders.length + " governed header(s) configured."]);
    }

    // --- FIX ML19743-004: Validate the exact output sheet rather than rescanning by latest prefix ---
    let activeSheet = null;
    if (exactSheetName) {
      activeSheet = ss.getSheetByName(exactSheetName);
    } else if (typeof getLatestSheetByPrefix_ === "function") {
      activeSheet = getLatestSheetByPrefix_(sheetType);
    }
    
    if (!activeSheet) {
      sectionResults.push(["Active Sheet Presence", "WARNING", "Active sheet not present (not yet built)."]);
    } else {
      sectionResults.push(["Active Sheet Presence", "PASS", "Active sheet found: " + activeSheet.getName()]);
      
      if (governedHeaders.length > 0) {
         try {
             const headerRow = Number((dashboard.globals && dashboard.globals["Header Row"]) || 4);
             const actualHeaders = activeSheet.getRange(headerRow, 1, 1, governedHeaders.length).getValues()[0].map(function(h) { return String(h || "").trim(); });
             const mismatches = [];
             governedHeaders.forEach(function(expected, i) {
                 if (expected !== actualHeaders[i]) mismatches.push("Col " + (i+1) + " (Expected: " + expected + ", Found: " + actualHeaders[i] + ")");
             });
             if (mismatches.length > 0) {
                 sectionResults.push(["Header Alignment", "FAIL", mismatches.length + " mismatch(es): " + mismatches.join(" | ")]);
             } else {
                 sectionResults.push(["Header Alignment", "PASS", "All headers match governance exactly."]);
             }
         } catch(e) {
             sectionResults.push(["Header Alignment", "WARNING", "Could not verify headers: " + e.message]);
         }
      }

      if (governedHeaders.length > 0) {
         try {
             const dataStartRow = Number((dashboard.globals && dashboard.globals["Data Start Row"]) || 5);
             const lastRow = activeSheet.getLastRow();
             if (lastRow >= dataStartRow) {
                 const sampleRows = Math.min(10, lastRow - dataStartRow + 1);
                 const allFormats = activeSheet.getRange(dataStartRow, 1, sampleRows, governedHeaders.length).getNumberFormats();
                 const formatMismatches = [];
                 
                 governedHeaders.forEach(function(header, index) {
                     const def = (dashboard.columnDefinitions || {})[header] || (dashboard.columnDefinitions || {})[header.toLowerCase()] || {};
                     const expectedFormat = getExpectedNumberFormat_(def, dashboard.globals);
                     if (!expectedFormat || expectedFormat === "General") return;
                     
                     const expectedSheetsFormat = getGoogleSheetsNumberFormat_(expectedFormat, def.dateColumn);
                     let colMismatches = [];
                     allFormats.forEach(function(row) {
                         const actualFormat = row[index];
                         if (!numberFormatsMatch_(actualFormat, expectedSheetsFormat)) {
                             if (colMismatches.indexOf(actualFormat) === -1) colMismatches.push(actualFormat);
                         }
                     });
                     if (colMismatches.length > 0) {
                         formatMismatches.push(header + " (Expected: " + expectedFormat + ", Found: " + colMismatches.join(", ") + ")");
                     }
                 });
                 
                 if (formatMismatches.length > 0) {
                     sectionResults.push(["Data Formats", "FAIL", formatMismatches.length + " format mismatch(es): " + formatMismatches.join(" | ")]);
                 } else {
                     sectionResults.push(["Data Formats", "PASS", "All configured date/number formats match exactly."]);
                 }
             } else {
                 sectionResults.push(["Data Formats", "INFO", "No data rows present to check formats."]);
             }
         } catch(e) {
             sectionResults.push(["Data Formats", "WARNING", "Could not verify data formats: " + e.message]);
         }
      }

      try {
        const lastRow = activeSheet.getLastRow();
        if (lastRow >= 5) {
          const sheetHeaders = activeSheet.getRange(4, 1, 1, activeSheet.getLastColumn()).getValues()[0].map(function(h) { return String(h || "").trim(); });
          const hMap = {};
          sheetHeaders.forEach(function(h, i) { if (h) hMap[h] = i; });

          if (sheetType === "Master List") {
            const cpTypeIdx = hMap["CP Type"];
            const nextCpIdx = hMap["Next Care Plan Due"];
            const idtIdx = hMap["IDT Meeting Date"];
            const dataVals = activeSheet.getRange(5, 1, lastRow - 4, activeSheet.getLastColumn()).getValues();
            
            let cpSyncCount = 0;
            let unlockSyncCount = 0;
            dataVals.forEach(function(r) {
              if ((cpTypeIdx !== undefined && String(r[cpTypeIdx] || "").trim()) || (nextCpIdx !== undefined && String(r[nextCpIdx] || "").trim())) {
                cpSyncCount++;
              }
              if (idtIdx !== undefined && String(r[idtIdx] || "").trim()) {
                unlockSyncCount++;
              }
            });

            sectionResults.push(["Care Plan Due Sync Audit", cpSyncCount > 0 ? "PASS" : "WARNING", cpSyncCount + " of " + dataVals.length + " Master List row(s) populated with Care Plan Due data."]);
            sectionResults.push(["Unlocked CP Sync Audit", unlockSyncCount > 0 ? "PASS" : "WARNING", unlockSyncCount + " of " + dataVals.length + " Master List row(s) populated with Unlocked CP data."]);
          }

          if (sheetType === "Refined Data") {
            const bannerIdx = hMap["Banner Summary"];
            const dataVals = activeSheet.getRange(5, 1, lastRow - 4, activeSheet.getLastColumn()).getValues();
            let bannerCount = 0;
            dataVals.forEach(function(r) {
              if (bannerIdx !== undefined && String(r[bannerIdx] || "").trim()) bannerCount++;
            });
            sectionResults.push(["Banner Sync Audit", bannerCount > 0 ? "PASS" : "INFO", bannerCount + " of " + dataVals.length + " Refined Data row(s) populated with Banner Summaries."]);
          }
        }
      } catch(syncErr) {
        sectionResults.push(["Sync Verification Audit", "WARNING", "Could not complete sync audit: " + syncErr.message]);
      }
    }
    
    writeDashboardQualitySection_(title, ["Validation Item", "Status", "Quality Notes"], sectionResults);
    
    const secFails = sectionResults.filter(function(r) { return r[1] === "FAIL"; }).length;
    const secWarns = sectionResults.filter(function(r) { return r[1] === "WARNING"; }).length;
    totalFailed += secFails;
    totalWarnings += secWarns;
    
    allResults.push.apply(allResults, sectionResults);
    summaryRows.push([sheetType + " Health", secFails ? "FAIL" : (secWarns ? "WARNING" : "PASS"), sectionResults.length + " item(s) checked; " + secFails + " failed."]);
  });
  
  if (!targetSheetType) {
    const finalStatus = totalFailed ? "FAIL" : (totalWarnings ? "WARNING" : "PASS");
    const summary = [["Dashboard Quality Workflow", finalStatus, validations.length + " section(s); " + totalFailed + " total failed; " + totalWarnings + " total warning(s)."]].concat(summaryRows);
    
    writeDashboardQualitySection_("SECTION H - SUMMARY", ["Metric / Action", "Result", "Notes"], summary);
    return allResults.concat(summary);
  }
  
  return allResults;
}

/**
 * Executes a comprehensive diagnostic smoke validation.
 * Verifies key workflow functions, trigger entry points, and required system sheets.
 */
/**
 * Executes a comprehensive diagnostic smoke validation.
 * Verifies key workflow functions, trigger entry points, safe API dependencies, and required schemas.
 */
function runFrameworkSmokeValidation() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const errors = [];
  let checkedItems = 0;

  // 1. Symbol & Hook Validations
  const functionProbes = [
    // --- Startup & Trigger Entry Points ---
    ["onOpen", typeof onOpen],
    ["onEdit", typeof onEdit],
    ["syncArchiveIndexToActiveIndex_", typeof syncArchiveIndexToActiveIndex_],
    ["checkSheetDeletionAndUpdateIndex_", typeof checkSheetDeletionAndUpdateIndex_],
    ["setupArchiveSyncTrigger", typeof setupArchiveSyncTrigger],
    
    // --- Core Processing Workflows ---
    ["formatMonthlySheets", typeof formatMonthlySheets],
    ["runMonthlyUpdate", typeof runMonthlyUpdate],
    ["runMonthlyStart", typeof runMonthlyStart],
    ["updateRefinedDataMonthlySync", typeof updateRefinedDataMonthlySync],
    ["buildRefinedDataFromScratch", typeof buildRefinedDataFromScratch],
    ["createDisenrolledList", typeof createDisenrolledList],
    ["buildMonthlyChangeReport", typeof buildMonthlyChangeReport],
    ["createMasterList", typeof createMasterList],
    
    // --- Factory & System Operations ---
    ["createGovernedSheet_", typeof createGovernedSheet_],
    ["resolveSheetGovernance_", typeof resolveSheetGovernance_],
    ["runDashboardQualityWorkflow", typeof runDashboardQualityWorkflow],
    ["createAllReportTemplates", typeof createAllReportTemplates],
    ["populateActiveIndex", typeof populateActiveIndex]
  ];

  const missingFunctions = functionProbes
    .filter(function(item) { return item[1] !== "function"; })
    .map(function(item) { return item[0]; });

  if (missingFunctions.length) errors.push("Missing functions: " + missingFunctions.join(", "));
  checkedItems += functionProbes.length;

  // 2. System Sheets
  const requiredSheets = [SYSTEM_SHEETS.DASHBOARD, SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.INDEX];
  const missingSheets = requiredSheets.filter(function(name) { return !ss.getSheetByName(name); });
  if (missingSheets.length) errors.push("Missing system sheets: " + missingSheets.join(", "));
  checkedItems += requiredSheets.length;

  // 3. Dependency & API Probes (Fixes ML19741-006 & ML19741-001 regression)
  try {
    const indexSheet = ss.getSheetByName(SYSTEM_SHEETS.INDEX);
    if (indexSheet) {
      const images = indexSheet.getImages();
      if (images.length > 0) {
         if (typeof images[0].getScript !== "function") {
            errors.push("Google Apps Script Image API changed: getScript() is not supported.");
         }
         checkedItems++;
      }
    }
  } catch (e) {
    errors.push("Image API probe failed: " + e.message);
  }

  // 4. Schema Probes (Fixes ML19741-004 dependency check)
  try {
    let dashboard = null;
    if (typeof loadDashboardConfig_ === "function") dashboard = loadDashboardConfig_();
    
    if (dashboard) {
      const exclusionHeaders = getHeadersForSheetType_(dashboard, "Disenrolled Exclusion") || [];
      const refinedHeaders = getHeadersForSheetType_(dashboard, "Refined Data") || [];
      
      const checkPMR = function(headers, label) {
         const map = buildHeaderIndexMap_(headers);
         if (getPMRIndex_(map) < 0) {
            errors.push("Schema Error: " + label + " is missing a configured PMR header.");
         }
         checkedItems++;
      };
      
      if (exclusionHeaders.length) checkPMR(exclusionHeaders, "Disenrolled Exclusion");
      if (refinedHeaders.length) checkPMR(refinedHeaders, "Refined Data");
    }
  } catch (e) {
    errors.push("Schema probe failed: " + e.message);
  }

  // 5. Final Output & Assertion
  if (errors.length) {
    throw new Error("Framework smoke validation failed. " + errors.join(" | "));
  }

  const successMessage = "Framework smoke validation passed: " + checkedItems + " executable dependencies, APIs, and schemas verified.";
  if (typeof notify_ === "function") notify_(successMessage);

  return { 
    itemsChecked: checkedItems, 
    status: "PASS"
  };
}

function runFullQualityCheck() {
  let smoke, quality;
  if (typeof runFrameworkSmokeValidation === "function") smoke = runFrameworkSmokeValidation();
  if (typeof runDashboardQualityWorkflow === "function") quality = runDashboardQualityWorkflow();
  notify_("Full Quality Check complete.");
  return { smoke: smoke, quality: quality };
}

function runFormatDashboardUpdates() {
  const results = runDashboardQualityConfigVerificationSections_();
  writeDashboardQualitySection_("SECTION A - FORMAT DASHBOARD VALIDATION", ["Dashboard Section", "Status", "Quality Notes"], results);
  const failed = results.filter(function(row) { return row[1] === "FAIL"; });
  if (failed.length) throw new Error("Format Dashboard Updates found " + failed.length + " missing required section(s).");
  notify_("Format Dashboard Updates validation complete.");
  return results;
}


