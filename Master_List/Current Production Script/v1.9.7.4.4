function buildOperationalReportTemplate_(systemSheetName, cachedDashboardConfig) {
  if (typeof getTemplateConfigFromDashboard_ !== "function") throw new Error("Operational template creation requires Format Dashboard configuration.");
  const templateConfig = getTemplateConfigFromDashboard_(systemSheetName, null, cachedDashboardConfig);
  const templateSheet = buildGeneralTemplate_(templateConfig);
  applyOperationalFormatting_(templateSheet, systemSheetName, templateConfig.dashboard);
  // Operational column formatting applies alignment and wrapping from row 5
  // downward. Reapply governed Section F rows after that pass.
  if (templateConfig.usesSubheaders) {
    applyExistingSectionFormatting_(templateSheet, templateConfig, templateConfig.theme);
  }
  applyOperationalTemplateSort_(templateSheet);
  return templateSheet;
}

function applyOperationalTemplateSort_(sheet) {
  if (!sheet) return;
  const existingFilter = sheet.getFilter();
  if (existingFilter) existingFilter.remove();

  // Extend the filter to the absolute edge of the sheet to hide the vertical boundary line.
  const columnCount = sheet.getMaxColumns();
  const rowCount = Math.max(sheet.getMaxRows() - HEADER_ROW + 1, 2);

  sheet.getRange(HEADER_ROW, 1, rowCount, columnCount).createFilter();
}

function buildTemplateArchiveRefinedData(cachedDashboardConfig) {
