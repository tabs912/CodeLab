function isFrameworkTimingEnabled_() {
  try {
    return PropertiesService.getDocumentProperties().getProperty("RFF_TIMING_ENABLED") !== "false";
  } catch (err) {
    return true;
  }
}

function toggleFrameworkTiming() {
