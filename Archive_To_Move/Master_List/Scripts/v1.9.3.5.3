// ============================================================================
// 3. UNIVERSAL GOVERNED SHEET FACTORY (createGovernedSheet_)
// ============================================================================

/**
 * Universal Governed Sheet Factory.
 * Instantiates sheets from template molds or base templates, maps and injects data,
 * applies governed column date/number formats, sorts tab ranks, and enforces
 * Section B lifecycle visibility rules.
 *
 * @param {string} sheetType - The system sheet name (e.g., "Banners", "CP Due Date", "Unlock CP", "Raw Data")
 * @param {Object} monthParts - Date parts context object from promptForLockedYearReportMonth_
 * @param {Object} options - Configuration overrides (dataRows, headers, customName, isTemplate, timing)
 * @returns {GoogleAppsScript.Spreadsheet.Sheet} The created and governed sheet instance
 */
function createGovernedSheet_(sheetType, monthParts, options) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  options = options || {};

  const allowFallback = options.isTemplate === true || options.isSystemSetup === true;
  const dashboard = (typeof loadDashboardConfig_ === "function")
    ? loadDashboardConfig_(allowFallback)
    : getFallbackDashboardConfig_();

  // 1. Resolve Creation Rule with Key Normalization Fallbacks
  let rule = dashboard.creationRules && dashboard.creationRules[sheetType];
  if (!rule && dashboard.creationRules) {
    // Map common key aliases if exact match fails
    const aliasMap = {
      "Unlock CP": "Unlocked CP",
      "Unlocked CP": "Unlock CP",
      "CP Due Date": "CP Due",
      "CP Due": "CP Due Date",
      "Refined Data": "Demo P",
      "Demo P": "Refined Data"
    };
    const mappedKey = aliasMap[sheetType];
    if (mappedKey && dashboard.creationRules[mappedKey]) {
      rule = dashboard.creationRules[mappedKey];
    }
  }

  // Fallback Rule if not defined in dashboard
  rule = rule || {
    namingPattern: sheetType + " mm.yy",
    group: "Other", templateRank: 800, activeRank: 999,
    visibility: "VISIBLE", collisionPolicy: "OVERWRITE",
    trimmingPolicy: "TRIM_TO_DATA", indexRegistration: true, special: ""
  };

  const isTemplateBuild = options.isTemplate === true;
  const templateSpec = (dashboard.sheetDefinitions && dashboard.sheetDefinitions[sheetType]) || {};

  // 2. Resolve Target Output Sheet Name
  let targetName = "";
  if (isTemplateBuild) {
    targetName = templateSpec.templateName || (SYSTEM_SHEETS.TEMPLATE_PREFIX + sheetType);
  } else if (monthParts) {
    targetName = buildMonthlySheetName_(rule.namingPattern, monthParts.firstDay, monthParts.lastDay);
  } else {
    targetName = options.customName || sheetType;
  }

  markFrameworkStep_(options.timing, "Factory - Resolve output name", targetName);

  // 3. Collision Management (Overwrite Policy)
  const existing = ss.getSheetByName(targetName);
  if (existing) {
    if (rule.collisionPolicy === "OVERWRITE" || options.overwrite !== false) {
      markFrameworkStep_(options.timing, "Factory - Remove output collision", targetName);
      deleteSheetSafely_(ss, existing, "Section B Collision Cleanup for " + targetName);
      SpreadsheetApp.flush();
    } else if (rule.collisionPolicy === "FAIL") {
      throw new Error(`Sheet creation halted: "${targetName}" already exists.`);
    }
  }

  // 4. Clone Template Mold or Base Template
  let sheet = null;
  if (!isTemplateBuild) {
    const templateName = templateSpec.templateName || (SYSTEM_SHEETS.TEMPLATE_PREFIX + sheetType);
    let template = ss.getSheetByName(templateName);
    
    // Fallback template lookup for alias variations
    if (!template) {
      const altName = templateName.indexOf("Unlock CP") !== -1 
        ? SYSTEM_SHEETS.TEMPLATE_PREFIX + "Unlocked CP"
        : (templateName.indexOf("CP Due Date") !== -1 ? SYSTEM_SHEETS.TEMPLATE_PREFIX + "CP Due" : null);
      if (altName) template = ss.getSheetByName(altName);
    }

    if (!template) throw new Error(`Template mold "${templateName}" not found. Build templates first.`);
    
    markFrameworkStep_(options.timing, "Factory - Copy template", template.getName());
    sheet = template.copyTo(ss);
  } else {
    const base = ss.getSheetByName(SYSTEM_SHEETS.BASE_TEMPLATE);
    sheet = base ? base.copyTo(ss) : ss.insertSheet();
  }

  sheet.setName(targetName);
  SpreadsheetApp.flush();
  markFrameworkStep_(options.timing, "Factory - Name and flush output", targetName);

  // 5. Position Tab according to Section B/F Rank Rules
  const targetRank = isTemplateBuild ? rule.templateRank : rule.activeRank;
  if (typeof positionSheetBySectionFRank_ === "function") {
    positionSheetBySectionFRank_(sheet, targetRank, ss);
    markFrameworkStep_(options.timing, "Factory - Apply tab rank", "Rank " + targetRank);
  }

  // 6. Inject Data Matrix & Apply Column Date/Number Formatting
  if (options.dataRows && options.dataRows.length && options.headers) {
    markFrameworkStep_(options.timing, "Factory - Write data matrix", options.dataRows.length + " row(s) x " + options.headers.length + " column(s)");
    sheet.getRange(DATA_START_ROW, 1, options.dataRows.length, options.headers.length).setValues(options.dataRows);
    
    if (typeof applyGovernedDateFormatsFromDashboard_ === "function") {
      markFrameworkStep_(options.timing, "Factory - Apply date formats", "Reading governed Section G formats");
      applyGovernedDateFormatsFromDashboard_(sheet, dashboard, options.headers, options.dataRows.length);
    }
  }

  // 7. Grid Trimming Policy
  if (rule.trimmingPolicy === "TRIM_TO_DATA" && typeof trimCreatedSheetToData_ === "function") {
    trimCreatedSheetToData_(sheet, DATA_START_ROW, (options.headers ? options.headers.length : sheet.getLastColumn()));
    markFrameworkStep_(options.timing, "Factory - Trim output grid", "Content width plus one-column buffer");
  }

  // 8. Strict Visibility Enforcement (Section B Lifecycle Governance)
  let targetVisibility = rule.visibility;
  
  // Secondary fallback lookup against output governance
  if (!targetVisibility && dashboard.outputGovernance) {
    const govKey = Object.keys(dashboard.outputGovernance).find(k => k.toLowerCase() === String(sheetType).toLowerCase());
    if (govKey && dashboard.outputGovernance[govKey].visibility) {
      targetVisibility = dashboard.outputGovernance[govKey].visibility;
    }
  }

  const finalVisibility = isTemplateBuild ? "HIDDEN" : String(targetVisibility || "VISIBLE").toUpperCase();

  if (finalVisibility === "HIDDEN" || finalVisibility === "HIDE") {
    hideSheetIfNeeded_(sheet, options.timing, "Hide per Section B rule: " + targetName);
  } else {
    showSheetIfNeeded_(sheet, options.timing, "Show per Section B rule: " + targetName);
  }

  // 9. Register with Central Index
  if (rule.indexRegistration && !isTemplateBuild) {
    try { 
      if (typeof populateActiveIndex === "function") populateActiveIndex(); 
    } catch (err) {
      logBestEffortWarning_("Index registration skipped in factory: " + err.message);
    }
  }

  return sheet;
}



// ============================================================================
// 4. DASHBOARD CONFIG GATEWAY & STRICT LOADER
// ============================================================================

function getFallbackDashboardConfig_() {
  const fallback = {
    globals: Object.assign({}, MASTER_FORMAT_DEFAULTS.globals),
    creationRules: {}, titleRows: [], subheaderRows: [],
    sheetDefinitions: [], columnDefinitions: {}, sheetHeaders: {}
  };

  MASTER_FORMAT_DEFAULTS.creationRules.forEach(row => {
    const sysName = row[0];
    fallback.creationRules[sysName] = {
      systemSheetName: sysName,
      namingPattern: row[1],
      templateRank: row[2],
      activeRank: row[3],
      group: row[4],
      visibility: row[5],
      collisionPolicy: row[6],
      trimmingPolicy: row[7],
      indexRegistration: row[8] !== "false",
      special: row[9]
    };
  });
  return fallback;
}

function loadDashboardConfig_(isSystemSetup) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD) || ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT);

  if (!sheet) {
    if (isSystemSetup) return getFallbackDashboardConfig_();
    throw new Error("Format Dashboard is missing or unconfigured. Run Setup / Refresh Dashboard first.");
  }

  const values = sheet.getDataRange().getValues();
  const config = {
    globals: Object.assign({}, MASTER_FORMAT_DEFAULTS.globals),
    creationRules: {}, titleRows: [], subheaderRows: [],
    sheetDefinitions: [], outputGovernance: {}, columnDefinitions: {}, sheetHeaders: {}
  };

  const dashIndex = buildDashboardSectionIndex_(sheet);

  function parseSectionRows_(secKey) {
    let matchedKey = null;
    Object.keys(dashIndex).forEach(k => { if (k.toLowerCase().indexOf(secKey.toLowerCase()) !== -1) matchedKey = k; });
    if (!matchedKey) return [];

    const secInfo = dashIndex[matchedKey];
    let hdrRow = secInfo.startRow - 1;
    while (hdrRow <= secInfo.endRow) {
      if (values[hdrRow] && values[hdrRow].some(x => String(x || "").trim() !== "")) {
        const rowStr = values[hdrRow].join(" ").toLowerCase();
        if (rowStr.indexOf("sheet type") !== -1 || rowStr.indexOf("setting") !== -1 || rowStr.indexOf("header") !== -1 || rowStr.indexOf("system sheet name") !== -1) break;
      }
      hdrRow++;
    }
    if (hdrRow > secInfo.endRow) return [];

    const headers = values[hdrRow].map(x => String(x || "").trim().toLowerCase());
    const colMap = {};
    headers.forEach((h, idx) => { if (h) colMap[h] = idx; });

    const rows = [];
    for (let r = hdrRow + 1; r <= secInfo.endRow; r++) {
      const rowVal = values[r];
      if (!rowVal || !rowVal.some(x => String(x || "").trim() !== "")) continue;
      const firstCell = String(rowVal[0] || "").trim();
      if (firstCell.indexOf("SECTION ") === 0) break;

      const obj = {};
      Object.keys(colMap).forEach(key => {
        const cIdx = colMap[key];
        obj[key] = (cIdx < rowVal.length) ? rowVal[cIdx] : "";
      });
      rows.push(obj);
    }
    return rows;
  }

  const secA = dashIndex["SECTION A - GLOBAL SETTINGS"];
  if (secA) {
    for (let r = secA.startRow; r <= secA.endRow; r++) {
      const key = String(values[r][0] || "").trim();
      if (key) config.globals[key] = values[r][1];
    }
  }

const bParsed = parseSectionRows_("SECTION B - SHEET CREATION & LIFECYCLE GOVERNANCE");
  bParsed.forEach(row => {
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.creationRules[sysName] = {
        systemSheetName: sysName,
        namingPattern: String(row["output naming pattern"] || sysName).trim(),
        templateRank: Number(row["template tab rank"]) || 800,
        activeRank: Number(row["active tab rank"]) || 999,
        group: String(row["group"] || "Other").trim(),
        visibility: String(row["visibility"] || "VISIBLE").trim().toUpperCase(),
        collisionPolicy: String(row["collision policy"] || "OVERWRITE").trim().toUpperCase(),
        trimmingPolicy: String(row["data row trimming"] || "TRIM_TO_DATA").trim().toUpperCase(),
        indexRegistration: row["index reg."] !== false && String(row["index reg."]).toUpperCase() !== "FALSE",
        special: String(row["notes"] || row["special"] || "").trim()
      };
    }
  });

  const cParsed = parseSectionRows_("SECTION C - TEMPLATE STRUCTURAL SPECS");
  cParsed.forEach(row => {
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.sheetDefinitions.push({
        systemSheetName: sysName,
        templateName: SYSTEM_SHEETS.TEMPLATE_PREFIX + sysName,
        group: String(row["group"] || "Template").trim(),
        reportTitle: String(row["report title"] || sysName).trim(),
        titleDateFormat: String(row["title date format"] || "").trim(),
        baseColor: String(row["base color"] || "#79B5D2").trim(),
        columnCount: Number(row["column count"]) || 10,
        columnWidths: String(row["default column widths"] || "105").trim(),
        usesAlternatingColors: row["uses alternating colors"] !== false,
        usesSubheaders: row["uses subheaders"] === true || String(row["uses subheaders"]).toUpperCase() === "TRUE"
      });
    }
  });

  const dParsed = parseSectionRows_("SECTION D - ACTIVE OUTPUT GOVERNANCE");
  dParsed.forEach(row => {
    const sysName = String(row["system sheet name"] || "").trim();
    if (sysName) {
      config.outputGovernance[sysName] = {
        namingPattern: String(row["output naming pattern"] || sysName).trim(),
        group: String(row["group"] || "Other").trim(),
        endDateSource: String(row["end date source"] || "").trim()
      };
    }
  });

  const eParsed = parseSectionRows_("SECTION E - TITLE ROWS");
  eParsed.forEach(row => {
    config.titleRows.push({
      sheetType: String(row["sheet type"] || "GLOBAL").trim(),
      row: Number(row["row"]) || 1,
      purpose: String(row["purpose"] || "").trim(),
      valueSource: String(row["value source"] || "").trim(),
      label: String(row["label"] || "").trim(),
      targetCell: String(row["target cell"] || "A1").trim(),
      height: Number(row["height"]) || 25,
      fontSize: Number(row["font size"]) || 10,
      fontWeight: String(row["font weight"] || "Normal").trim(),
      fillLevel: String(row["fill level"] || "Level 3").trim(),
      alignment: String(row["alignment"] || "Left").trim(),
      wrap: String(row["wrap"] || "CLIP").trim()
    });
  });

  const fParsed = parseSectionRows_("SECTION F - SUBHEADER ROWS");
  fParsed.forEach(row => {
    config.subheaderRows.push({
      sheetType: String(row["sheet type"] || "GLOBAL").trim(),
      row: Number(row["row"]) || 1,
      purpose: String(row["purpose"] || "").trim(),
      targetCell: String(row["target cell"] || "").trim(),
      height: Number(row["height"]) || 25,
      fontSize: Number(row["font size"]) || 10,
      fontWeight: String(row["font weight"] || "Normal").trim(),
      fillLevel: String(row["fill level"] || "None").trim(),
      alignment: String(row["alignment"] || "Left").trim(),
      wrap: String(row["wrap"] || "CLIP").trim()
    });
  });

  const gParsed = parseSectionRows_("SECTION G - COLUMN DEFINITIONS");
  gParsed.forEach(row => {
    const header = String(row["header"] || "").trim();
    if (header) {
      const colData = {
        width: Number(row["width"]) || 105,
        fontSize: Number(row["header font size"]) || 10,
        dateColumn: row["date column"] === true || String(row["date column"]).toUpperCase() === "TRUE",
        hideColumn: row["hide column"] === true || String(row["hide column"]).toUpperCase() === "TRUE",
        wrap: String(row["data wrap"] || "CLIP").trim().toUpperCase(),
        align: String(row["horizontal alignment"] || "left").trim().toLowerCase(),
        vAlign: String(row["vertical alignment"] || "middle").trim().toLowerCase(),
        format: String(row["number format"] || "").trim()
      };
      config.columnDefinitions[header] = colData;
      config.columnDefinitions[header.toLowerCase()] = colData;
    }
  });

  const hParsed = parseSectionRows_("SECTION H - SHEET HEADERS") || parseSectionRows_("SECTION G - SHEET HEADERS");
  hParsed.forEach(row => {
    const sheetType = String(row["sheet type"] || "").trim();
    const header = String(row["header"] || "").trim();
    if (sheetType && header) {
      if (!config.sheetHeaders[sheetType]) config.sheetHeaders[sheetType] = [];
      config.sheetHeaders[sheetType].push(header);
    }
  });

  return config;
}

function buildDashboardSectionIndex_(dashboardSheet) {
  const values = dashboardSheet.getDataRange().getValues();
  const index = {};
  let currentSection = null;
  for (let r = 0; r < values.length; r++) {
    const val = String(values[r][0] || "").trim();
    if (val.indexOf("SECTION ") === 0) {
      if (currentSection) index[currentSection].endRow = r - 1;
      currentSection = val;
      index[currentSection] = { startRow: r + 2, endRow: values.length - 1 };
    }
  }
  if (currentSection) index[currentSection].endRow = values.length - 1;
  return index;
}

function getHeadersForSheetType_(dashboardConfig, sheetType) {
  if (dashboardConfig && dashboardConfig.sheetHeaders) {
    if (dashboardConfig.sheetHeaders[sheetType] && dashboardConfig.sheetHeaders[sheetType].length) {
      return dashboardConfig.sheetHeaders[sheetType];
    }
    const normKey = Object.keys(dashboardConfig.sheetHeaders).find(k => k.toLowerCase() === String(sheetType).toLowerCase());
    if (normKey && dashboardConfig.sheetHeaders[normKey].length) {
      return dashboardConfig.sheetHeaders[normKey];
    }
  }
  return [];
}

