/**
 * Strips out any completely blank rows from a 2D array.
 * Fixes the issue where Row 5-24 are left empty due to blank rows in raw source exports.
 */
function hideHistoricalDisenrollmentRows_(sheet, rows, dateIndex, monthParts) {
  if (!sheet || dateIndex < 0 || !rows.length) return 0;
  const cutoff = new Date(monthParts.lastDay);
  cutoff.setDate(cutoff.getDate() - 365);
  const rowNumbers = [];
  rows.forEach(function(row, index) {
    const date = new Date(row[dateIndex]);
    if (!isNaN(date.getTime()) && date < cutoff) rowNumbers.push(DATA_START_ROW + index);
  });
  if (!rowNumbers.length) return 0;
  let start = rowNumbers[0]; let previous = rowNumbers[0];
  for (let index = 1; index <= rowNumbers.length; index++) {
    const current = rowNumbers[index];
    if (current === previous + 1) { previous = current; continue; }
    sheet.hideRows(start, previous - start + 1);
    start = current; previous = current;
  }
  return rowNumbers.length;
}

function filterBlankRows_(rows) {
  if (!rows || !rows.length) return [];
  return rows.filter(row => {
    // If every cell in the row is blank/empty, exclude it.
    return row.some(cell => String(cell || "").trim() !== "");
  });
}

/**
 * Explicitly sets the row height of every data row starting from DATA_START_ROW.
 * Ensures that pasted data or template mold glitches don't cause abnormal row heights.
 */
function enforceDataRowHeights_(sheet, dashboard, dataRowCount) {
  if (!sheet || dataRowCount < 1) return;

  // Read default data row height from Section A (Global Settings), fallback to 25px
  const defaultHeight = (dashboard && dashboard.globals)
    ? (Number(dashboard.globals["Default Data Row Height"]) || 25)
    : 25;

  try {
    // Use the hyper-efficient batch API method: setRowHeights(startRow, numRows, height)
    sheet.setRowHeights(DATA_START_ROW, dataRowCount, defaultHeight);
  } catch (err) {
    logBestEffortWarning_(`Row height enforcement failed on ${sheet.getName()}: ${err.message}`);
  }
}


