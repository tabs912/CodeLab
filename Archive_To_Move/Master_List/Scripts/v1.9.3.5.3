    ["Index", "Index", "Last Update", "#79B5D2", 10, "160, 185, 110, 75, 30, 100, 185, 110, 160, 75", "AUTO_EXPAND", "", "", "false", "false", ""]
  ];

  return baseSpecs.map(spec => {
    const sysName = spec[0];
    const reportTitle = spec[1];
    const titleDateFmt = spec[2];
    const baseColor = spec[3];
    const rest = spec.slice(4);

    const theme = calculateThemeLevels_(baseColor, hslPercents);
    const fontColor = (typeof GLOBAL_DEFAULTS !== "undefined" && GLOBAL_DEFAULTS.STANDARD_FONT_COLOR)
      ? GLOBAL_DEFAULTS.STANDARD_FONT_COLOR
      : "#000000";

    return [
      sysName, reportTitle, titleDateFmt, baseColor,
      theme.level1, theme.level2, theme.level3, theme.level4, theme.level5,
      fontColor, ...rest
    ];
  });
}


