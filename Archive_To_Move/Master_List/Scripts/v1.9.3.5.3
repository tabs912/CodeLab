function notifyArchiveMonthlySheetsResult_(title, monthLabel, result) {
  const msg = title + " complete for " + monthLabel + ".\nArchived: " + (result.archived ? result.archived.length : 0) +
              "\nSkipped: " + (result.skipped ? result.skipped.length : 0) +
              "\nFailed: " + (result.failed ? result.failed.length : 0);
  SpreadsheetApp.getActiveSpreadsheet().toast(msg, title, 5);
}

function copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing) {
  const archiveResult = archiveRawSourceSheet_(sheet, sheetName, timing, "Archive monthly sheet", archiveSs);
  activateVisibleSheetBeforeHiding_(sheet);
  ss.deleteSheet(sheet);
  return { localAction: "Deleted local sheet " + sheetName, archiveName: archiveResult.archivedName };
}

function saveActiveLayoutAsRebuildDefault() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD);
  if (!sheet) throw new Error("Format Dashboard sheet is required before saving its rebuild default.");
  const range = sheet.getDataRange();
  const payload = {
    version: MASTER_LIST_MERGE_ML_VERSION,
    savedAt: new Date().toISOString(),
    values: range.getValues(),
    backgrounds: range.getBackgrounds()
  };
  const json = JSON.stringify(payload);
  const props = PropertiesService.getDocumentProperties();
  props.setProperty("RFF_FORMAT_DASHBOARD_DEFAULT_JSON", json);
  if (props.getProperty("RFF_FORMAT_DASHBOARD_DEFAULT_JSON") !== json) {
    throw new Error("Format Dashboard backup verification failed.");
  }
  notify_("Format Dashboard rebuild default saved.");
  return payload;
}

function restoreFormatDashboardFromDefault() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD);
  if (!sheet) throw new Error("Format Dashboard sheet was not found.");
  const raw = PropertiesService.getDocumentProperties().getProperty("RFF_FORMAT_DASHBOARD_DEFAULT_JSON");
  if (!raw) throw new Error("No saved Format Dashboard rebuild default is available.");
  const payload = JSON.parse(raw);
  if (!payload || !Array.isArray(payload.values) || !payload.values.length || !Array.isArray(payload.values[0]) || !payload.values[0].length) {
    throw new Error("Saved Format Dashboard rebuild default is invalid.");
  }
  const width = payload.values[0].length;
  if (!payload.values.every(row => Array.isArray(row) && row.length === width)) throw new Error("Saved dashboard values are not rectangular.");
  resizeSheetGrid_(sheet, payload.values.length, width);
  sheet.clear();
  const target = sheet.getRange(1, 1, payload.values.length, width);
  target.setValues(payload.values);
  if (Array.isArray(payload.backgrounds) && payload.backgrounds.length === payload.values.length && payload.backgrounds.every(row => Array.isArray(row) && row.length === width)) {
    target.setBackgrounds(payload.backgrounds);
  }
  recalculateDashboardHexCodes_(sheet);
  notify_("Format Dashboard restored from the saved rebuild default.");
  return sheet;
}

