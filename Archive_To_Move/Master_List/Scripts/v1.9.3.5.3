function buildIndexTemplate_() {
  const config = getTemplateConfigFromDashboard_(SYSTEM_SHEETS.INDEX);

  if (!config.headers || config.headers.length === 0) {
    config.headers = [
      "Section/Month", "Sheet Tab Name", "Workspace Link", "Visibility",
      "", "Archive Month", "Archive Sheet Name", "Link to Sheet", "Restore Action", "Status"
    ];
    config.columnCount = 10;
  }

  const template = buildGeneralTemplate_(config);
  template.getRange("F1").setValue("Archive Index").setFontSize(14).setFontWeight("bold");
  template.getRange("F2").setValue("Archive File ID");
  if (config.theme.titleFontColor) template.getRange("F1").setFontColor(config.theme.titleFontColor);

  template.getRange(1, 5, template.getMaxRows(), 1).setBackground(config.theme.level1);

  const rules = template.getConditionalFormatRules();

  // Dynamically extract all unique groups from Section B creation rules
  const uniqueGroups = new Set(["Unformatted", "Templates"]);
  if (config.dashboard && config.dashboard.creationRules) {
    Object.keys(config.dashboard.creationRules).forEach(key => {
      const rule = config.dashboard.creationRules[key];
      if (rule && rule.group) {
        uniqueGroups.add(String(rule.group).trim());
      }
    });
  }

  // Build a REGEXMATCH formula dynamically containing all valid group names for the line dividers
  const groupArray = Array.from(uniqueGroups).map(g => g.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  const groupFormula = '=REGEXMATCH($A5, "^(' + groupArray.join("|") + ')$")';

  const rule1 = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(groupFormula)
    .setBackground(config.theme.level3).setBold(true).setRanges([template.getRange("A5:D1000")]).build();
  rules.push(rule1);

  const rule2 = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=REGEXMATCH($F5, "^(January|February|March|April|May|June|July|August|September|October|November|December)")')
    .setBackground(config.theme.level3).setBold(true).setRanges([template.getRange("F5:J1000")]).build();
  rules.push(rule2);

  template.setConditionalFormatRules(rules);
  return template;
}



function buildArchiveIndexTemplate_(archiveSs) {
  const ss = archiveSs || SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SYSTEM_SHEETS.INDEX);

  if (!sheet) {
    sheet = ss.insertSheet(SYSTEM_SHEETS.INDEX);
  }

  const theme = {
    level1: "#527fe0", level2: "#93afec", level3: "#becff3",
    level4: "#d4dff7", level5: "#f2f5fd", fontColor: "#000000", fontFamily: "Arial"
  };

  sheet.clear();
  sheet.clearConditionalFormatRules();
  sheet.setHiddenGridlines(false);

  const existingBandings = sheet.getBandings();
  existingBandings.forEach(b => b.remove());

  if (sheet.getMaxColumns() > 5) {
    sheet.deleteColumns(6, sheet.getMaxColumns() - 5);
  } else if (sheet.getMaxColumns() < 5) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), 5 - sheet.getMaxColumns());
  }

  if (sheet.getMaxRows() < 100) {
    sheet.insertRowsAfter(sheet.getMaxRows(), 100 - sheet.getMaxRows());
  }

  sheet.setFrozenRows(4);
  sheet.setFrozenColumns(1);

  const colWidths = [100, 185, 185, 110, 75];
  colWidths.forEach((width, index) => {
    sheet.setColumnWidth(index + 1, width);
  });

  sheet.setRowHeight(1, 28);
  sheet.setRowHeight(2, 22);
  sheet.setRowHeight(3, 8);
  sheet.setRowHeight(4, 26);

  const fullGrid = sheet.getRange(1, 1, sheet.getMaxRows(), 5);
  fullGrid.setFontFamily(theme.fontFamily)
          .setFontColor(theme.fontColor)
          .setVerticalAlignment("middle");

  sheet.getRange("A1").setValue("Archive Index")
    .setFontSize(14)
    .setFontWeight("bold")
    .setHorizontalAlignment("left")
    .setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);

  sheet.getRange("A2").setValue("Last Updated")
    .setFontSize(10)
    .setFontWeight("normal")
    .setHorizontalAlignment("left");

  sheet.getRange("B2").setValue(Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "MM/dd/yyyy HH:mm:ss"))
    .setFontSize(10)
    .setFontWeight("normal")
    .setHorizontalAlignment("left");

  sheet.getRange("A1:E2").setBackground(theme.level3);
  sheet.getRange("A3:E3").setBackground(theme.level1);

  const headers = [["Month", "Archive Type", "Sheet Name", "Link", "Visibility"]];
  const headerRange = sheet.getRange(4, 1, 1, 5);
  headerRange.setValues(headers)
    .setFontWeight("bold")
    .setFontSize(10)
    .setBackground(theme.level2)
    .setHorizontalAlignment("left")
    .setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);

  headerRange.setBorder(true, true, true, true, true, true, "#B7B7B7", SpreadsheetApp.BorderStyle.SOLID);

  const maxRows = sheet.getMaxRows();
  const dataRange = sheet.getRange(5, 1, maxRows - 4, 5);
  dataRange.setFontSize(10)
    .setFontWeight("normal")
    .setHorizontalAlignment("left")
    .setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP)
    .setNumberFormat("@");

// Applies a valid baseline enum, then overrides with custom theme colors
  dataRange.applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY)
    .setFirstRowColor(theme.level4)
    .setSecondRowColor(theme.level5);

  const rules = sheet.getConditionalFormatRules();
  const monthFormula = '=REGEXMATCH($A5, "^(January|February|March|April|May|June|July|August|September|October|November|December)")';
  const monthRule = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(monthFormula)
    .setBackground(theme.level3)
    .bold()
    .setRanges([sheet.getRange("A5:E" + maxRows)])
    .build();

  rules.push(monthRule);
  sheet.setConditionalFormatRules(rules);

  return sheet;
}

