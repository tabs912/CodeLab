function createOrRefreshBaseTemplate_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var baseSheet = ss.getSheetByName(SYSTEM_SHEETS.BASE_TEMPLATE);

  if (!baseSheet) {
    baseSheet = ss.insertSheet(SYSTEM_SHEETS.BASE_TEMPLATE);
    if (typeof positionSheetBySectionFRank_ === "function") positionSheetBySectionFRank_(baseSheet, 814);
  } else {
    baseSheet.clear();
    baseSheet.clearFormats();
  }

  var globals = typeof MASTER_FORMAT_DEFAULTS !== "undefined" ? MASTER_FORMAT_DEFAULTS.globals : GLOBAL_DEFAULTS;

  baseSheet.setFrozenRows(globals["Freeze Rows"] || 4);
  baseSheet.setFrozenColumns(globals["Freeze Columns"] || 2);

  var baseCols = 80;
  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(baseSheet, 100, baseCols + 1);

  var fullRange = baseSheet.getRange(1, 1, 100, baseCols + 1);
  fullRange.setFontFamily(globals["Standard Font"] || "Arial");
  fullRange.setFontSize(globals["Standard Font Size"] || 10);
  fullRange.setFontColor(globals["Standard Font Color"] || "#000000");
  fullRange.setHorizontalAlignment("left");
  fullRange.setVerticalAlignment("middle");
  fullRange.setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);
  fullRange.setNumberFormat(globals["Default Text Format"] || "@");
  fullRange.setBorder(true, true, true, true, true, true, globals["Global Border Color"] || "#CCCCCC", SpreadsheetApp.BorderStyle.SOLID);

  baseSheet.setRowHeight(1, globals["Row 1 (Title)Height"] || 25);
  baseSheet.setRowHeight(2, globals["Row 2 Height"] || 20);
  baseSheet.setRowHeight(3, globals["Row 3 Height"] || 10);

  var dataRowHeight = globals["Default Data Row Height"] || 25;
  for (var r = 4; r <= 100; r++) { baseSheet.setRowHeight(r, dataRowHeight); }

  var defaultWidth = globals["Default Column Width"] || 105;
  for (var c = 1; c <= baseCols + 1; c++) { baseSheet.setColumnWidth(c, defaultWidth); }

  var cellA1 = baseSheet.getRange("A1");
  cellA1.setFontSize(globals["A1 (Title) Font Size"] || 14);
  cellA1.setFontWeight(globals["A1 (Title) Font Style"] || "Bold");
  cellA1.setWrapStrategy(getWrapStrategyEnum_(globals["A1 (Title) Wrap "]) || SpreadsheetApp.WrapStrategy.OVERFLOW);

  var cellC1 = baseSheet.getRange("C1");
  cellC1.setFontSize(globals["C1 (Title) Font Size"] || 5);
  cellC1.setWrapStrategy(getWrapStrategyEnum_(globals["C1 (Title) Wrap"]) || SpreadsheetApp.WrapStrategy.WRAP);

  baseSheet.getRange(4, 1, 1, baseCols).setWrapStrategy(getWrapStrategyEnum_(globals["Row 4 (Header) Wrap"]) || SpreadsheetApp.WrapStrategy.WRAP);

  trimCreatedSheetToSize_(baseSheet, 100, baseCols);
  baseSheet.hideSheet();
  return baseSheet;
}

function createTemplateFromBase_(targetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const existing = ss.getSheetByName(targetName);
  if (existing) { ss.deleteSheet(existing); SpreadsheetApp.flush(); }

  const base = ss.getSheetByName(SYSTEM_SHEETS.BASE_TEMPLATE) || createOrRefreshBaseTemplate_();
  const newSheet = base.copyTo(ss);
  newSheet.setName(targetName);
  newSheet.showSheet();
  SpreadsheetApp.flush();
  return newSheet;
}

function buildGeneralTemplate_(config, timing) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sysName = config.systemSheetName;
  var templateName = config.templateName || (SYSTEM_SHEETS.TEMPLATE_PREFIX + sysName);

  markFrameworkStep_(timing, "Build General Template", "Creating template base for: " + templateName);
  var templateSheet = createTemplateFromBase_(templateName);

  if (typeof positionSheetBySectionFRank_ === "function") positionSheetBySectionFRank_(templateSheet, config.rank);

  var contentCols = Math.max(config.columnCount || 0, config.headers ? config.headers.length : 0, 1);
  var targetCols = contentCols + 1;
  var targetRows = config.minimumRows || 100;
  if (typeof resizeSheetGrid_ === "function") resizeSheetGrid_(templateSheet, targetRows, targetCols);

  var theme = config.theme || getTemplateTheme_(sysName);

  if (config.usesAlternatingColors !== false && sysName !== SYSTEM_SHEETS.DASHBOARD) {
    if (typeof applyNativeBandingSafe_ === "function") applyNativeBandingSafe_(templateSheet, 5, targetCols, targetRows, theme.level4, theme.level5);
  }

  markFrameworkStep_(timing, "Apply Titles: " + templateName, "Applying title rows");
  applyTitleRows_(templateSheet, config, theme);

  if (config.usesSubheaders && config.subheaders && config.subheaders.length > 0) {
    markFrameworkStep_(timing, "Apply Subheaders: " + templateName, "Applying subheader blocks");
    applySubheaderBlocks_(templateSheet, config.subheaders, theme, sysName, config.subheaderRowSpecs);
  }

  applyColumnWidthsEngine_(templateSheet, config);

  if (theme.level1) templateSheet.setTabColor(theme.level1);
  writeTemplateMetadata_(templateSheet, config, targetCols);
  trimCreatedSheetToSize_(templateSheet, targetRows, contentCols);

  templateSheet.hideSheet();
  return templateSheet;
}



function applyTitleRows_(sheet, config, theme) {
  var sysName = config.systemSheetName || "";
  var sheetType = config.sheetType || "DATA";
  var fullGridCols = sheet.getMaxColumns();

  // 1. Apply baseline title cell and backgrounds
  var titleCell = sheet.getRange("A1");
  titleCell.setValue(config.reportTitle || sysName);
  titleCell.setFontSize(14).setFontWeight("bold");

  if (theme.level3) sheet.getRange(1, 1, 2, fullGridCols).setBackground(theme.level3);
  if (theme.titleFontColor) titleCell.setFontColor(theme.titleFontColor);

  // 2. Baseline Date Titles. Section C values are applied again after
  // Section E formatting so dashboard labels cannot overwrite A2:D2.
  var titleDateFmt = String(config.titleDateFormat || "").trim();
  if (!titleDateFmt) {
    if (sysName === "Index" || sysName.toLowerCase() === "index") {
      sheet.getRange("A2").setValue("Last Update");
    } else if (sysName.indexOf("Timing") !== -1 || sysName.indexOf("Quality") !== -1) {
      sheet.getRange("A2").setValue("Date Created");
    } else if (sheetType === "DATA") {
      sheet.getRange("A2").setValue("Date:");
      sheet.getRange("C2").setValue("to");
    }
  }

  // 3. Row 3 Accent Separator & Row 4 Base Header Fill
  if (theme.level1) sheet.getRange(3, 1, 1, fullGridCols).setBackground(theme.level1);
  if (theme.level2) sheet.getRange(4, 1, 1, fullGridCols).setBackground(theme.level2);

  if (!config.usesSubheaders && config.headers && config.headers.length > 0) {
    var headerTextRange = sheet.getRange(4, 1, 1, config.headers.length);
    headerTextRange.setValues([config.headers]);
    headerTextRange.setFontWeight("bold").setFontSize(10);
  }

  // 4. Dynamic Dashboard Formatting Overrides (Smart Target Parsing)
  (config.titleRows || []).forEach(function(spec) {
    const rowNumber = Math.max(Number(spec.row) || 1, 1);
    if (rowNumber > sheet.getMaxRows()) return;

    const rowRange = sheet.getRange(rowNumber, 1, 1, fullGridCols);
    if (spec.height) sheet.setRowHeight(rowNumber, Number(spec.height));

    const fillKey = String(spec.fillLevel || "").toLowerCase().replace(/[^a-z0-9]/g, "");
    if (fillKey && theme[fillKey]) rowRange.setBackground(theme[fillKey]);
    else if (!fillKey || fillKey === "none") rowRange.setBackground(null);
    if (spec.fontSize) rowRange.setFontSize(Number(spec.fontSize));
    if (spec.fontWeight) {
      const rowWeight = String(spec.fontWeight).toLowerCase();
      rowRange.setFontWeight(rowWeight === "bold" ? "bold" : "normal");
      rowRange.setFontStyle(rowWeight === "italic" ? "italic" : "normal");
    }
    if (spec.alignment) rowRange.setHorizontalAlignment(String(spec.alignment).toLowerCase());
    if (spec.wrap) rowRange.setWrapStrategy(getWrapStrategyEnum_(spec.wrap));

    try {
      const targetStr = normalizeDashboardTargetA1_(spec.targetCell);
      let targetRange;

      if (!targetStr) {
        targetRange = sheet.getRange("A" + rowNumber);
      } else if (/^(Row\s*[0-9]*|[0-9]+)$/i.test(targetStr)) {
        // Matches "1", "2", "Row", or "Row 1" -> Returns the entire row
        targetRange = rowRange;
      } else if (/^[A-Za-z]+$/.test(targetStr)) {
        // Matches "A" or "C" -> Maps to current dynamic row (e.g. "A1")
        targetRange = sheet.getRange(targetStr + rowNumber);
      } else {
        // Matches standard ranges like "A1", "C2", or "A2:D2"
        targetRange = sheet.getRange(targetStr);
      }

      if (spec.fontSize) targetRange.setFontSize(Number(spec.fontSize));

      if (spec.fontWeight) {
        const weight = String(spec.fontWeight).toLowerCase();
        targetRange.setFontWeight(weight === "bold" ? "bold" : "normal");
        targetRange.setFontStyle(weight === "italic" ? "italic" : "normal");
      }

      if (spec.alignment) targetRange.setHorizontalAlignment(String(spec.alignment).toLowerCase());
      if (spec.wrap) targetRange.setWrapStrategy(getWrapStrategyEnum_(spec.wrap));

      if (spec.label && !(rowNumber === 2 && titleDateFmt)) {
        // getCell(1,1) guarantees the label text only writes to the first cell
        // in the range, preventing text duplication if the user targets a whole row.
        targetRange.getCell(1, 1).setValue(spec.label);
      }
    } catch (err) {
      if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Title Row target format skipped for " + spec.targetCell + ": " + err.message);
    }
  });

  applyTitleDateFormatFromSectionC_(sheet, titleDateFmt);
}

function applyTitleDateFormatFromSectionC_(sheet, titleDateFormat) {
  if (!sheet) return;
  const text = String(titleDateFormat || "").trim();
  if (!text) return;
  const values = new Array(4).fill("");
  if (text.indexOf("/") !== -1) {
    const parts = text.split("/");
    for (let index = 0; index < 4; index++) {
      values[index] = index < parts.length ? String(parts[index] || "").trim() : "";
    }
  } else {
    values[0] = text;
  }
  sheet.getRange(2, 1, 1, 4).setValues([values]);
}

function normalizeDashboardTargetA1_(targetCell) {
  const target = String(targetCell || "").trim();
  if (!target) return "";
  return target.replace(/\s+/g, "").replace(/-+/g, ":");
}

function applySubheaderBlocks_(sheet, subheaders, theme, sysName, subheaderRowSpecs) {
  var currentRow = 5;
  var maxCols = sheet.getMaxColumns();
  var b2Specs = subheaderRowSpecs || [];

  subheaders.forEach(function(block) {
    var steps = [1, 2, 3, 4, 5, 6];
    steps.forEach(function(stepNum) {
      var stepSpecs = b2Specs.filter(function(s) { return Number(s.row) === stepNum; });
      var primarySpec = stepSpecs.length > 0 ? stepSpecs[0] : null;

      currentRow++;
      var rHeight = (primarySpec && primarySpec.height && !isNaN(primarySpec.height)) ? Number(primarySpec.height) : 25;
      sheet.setRowHeight(currentRow, rHeight);

      var governedRowRange = sheet.getRange(currentRow, 1, 1, maxCols);
      if (primarySpec) {
        var fillLevelKey = String(primarySpec.fillLevel || "").toLowerCase().replace(/[^a-z0-9]/g, "");
        var bgColor = (fillLevelKey && fillLevelKey !== "none") ? theme[fillLevelKey] : null;
        governedRowRange.setBackground(bgColor || null);
        if (primarySpec.fontSize) governedRowRange.setFontSize(Number(primarySpec.fontSize));
        if (primarySpec.fontWeight) {
          var governedWeight = String(primarySpec.fontWeight).toLowerCase();
          governedRowRange.setFontWeight(governedWeight === "bold" ? "bold" : "normal");
          governedRowRange.setFontStyle(governedWeight === "italic" ? "italic" : "normal");
        }
        if (primarySpec.alignment) governedRowRange.setHorizontalAlignment(String(primarySpec.alignment).toLowerCase());
        if (primarySpec.wrap) governedRowRange.setWrapStrategy(getWrapStrategyEnum_(primarySpec.wrap));
      }

      // Spacers / Buffers (Row 1, 3, 5) - Formatting applied above; no text needed.
      if (stepNum === 1 || stepNum === 5 || stepNum === 3) return;

      // Section Titles & Timestamps (A2 / C2)
      if (stepNum === 2) {
        stepSpecs.forEach(function(spec) {
          var targetStr = normalizeDashboardTargetA1_(spec.targetCell);
          var isTimestamp = String(spec.purpose || "").toUpperCase().indexOf("TIMESTAMP") !== -1 || targetStr.toUpperCase() === "C2" || targetStr.toUpperCase() === "C" || targetStr.toUpperCase() === "COL C";

          let targetRange;
          if (!targetStr) {
            targetRange = sheet.getRange(currentRow, isTimestamp ? 3 : 1);
          } else if (/^(Row\s*[0-9]*|[0-9]+)$/i.test(targetStr)) {
            // Resolves "Row 2" to the entire row dynamically
            targetRange = sheet.getRange(currentRow, 1, 1, maxCols);
          } else {
            // Resolves "A2" or "C2" dynamically by stripping the numbers
            var colLetters = targetStr.replace(/[^A-Za-z]/g, "");
            if (colLetters) {
              targetRange = sheet.getRange(colLetters + currentRow);
            } else {
              targetRange = sheet.getRange(currentRow, isTimestamp ? 3 : 1);
            }
          }

          if (!isTimestamp) {
            targetRange.getCell(1, 1).setValue(block.title);
          } else {
            if (sysName.indexOf("Timing") !== -1 || sysName.indexOf("Quality") !== -1 || sysName.indexOf("Change") !== -1 || block.stampLastUpdated) {
              targetRange.getCell(1, 1).setValue("Last Updated");
            } else {
              return;
            }
          }

          if (spec.fontSize) targetRange.setFontSize(Number(spec.fontSize));
          if (spec.fontWeight) {
            const w = String(spec.fontWeight).toLowerCase();
            targetRange.setFontWeight(w === "bold" ? "bold" : "normal");
            targetRange.setFontStyle(w === "italic" ? "italic" : "normal");
          }
          if (spec.wrap) targetRange.setWrapStrategy(getWrapStrategyEnum_(spec.wrap));
          if (spec.alignment) targetRange.setHorizontalAlignment(spec.alignment.toLowerCase());
        });
        return;
      }

      // Governed Header Rows (Row 4)
      if (stepNum === 4) {
        var targetStr = normalizeDashboardTargetA1_(primarySpec && primarySpec.targetCell);
        var startCol = 1;

        // Dynamically shift start column if targeted as a specific letter (e.g. "B4")
        if (/^[A-Za-z]+[0-9]*$/.test(targetStr) && !/^(Row)/i.test(targetStr)) {
            var colLetters = targetStr.replace(/[^A-Za-z]/g, "").toUpperCase();
            var tempRange = sheet.getRange(colLetters + "1");
            startCol = tempRange.getColumn();
        }

        var wrapStrat = (primarySpec && primarySpec.wrap) ? getWrapStrategyEnum_(primarySpec.wrap) : SpreadsheetApp.WrapStrategy.WRAP;
        if (block.headers && block.headers.length > 0) {
          var headerTextRange = sheet.getRange(currentRow, startCol, 1, block.headers.length);
          headerTextRange.setValues([block.headers]);
          if (primarySpec && primarySpec.fontSize) headerTextRange.setFontSize(Number(primarySpec.fontSize));
          if (primarySpec && primarySpec.fontWeight) headerTextRange.setFontWeight(primarySpec.fontWeight.toLowerCase() === "bold" ? "bold" : "normal");
          if (primarySpec && primarySpec.alignment) headerTextRange.setHorizontalAlignment(primarySpec.alignment.toLowerCase());
          headerTextRange.setWrapStrategy(wrapStrat);
        }
        return;
      }

      // Data Anchor Placeholder (Row 6)
      if (stepNum === 6) {
        var targetStr6 = normalizeDashboardTargetA1_(primarySpec && primarySpec.targetCell);
        var startCol6 = 1;

        if (/^[A-Za-z]+[0-9]*$/.test(targetStr6) && !/^(Row)/i.test(targetStr6)) {
            var colLetters6 = targetStr6.replace(/[^A-Za-z]/g, "").toUpperCase();
            var tempRange6 = sheet.getRange(colLetters6 + "1");
            startCol6 = tempRange6.getColumn();
        }

        var wrapStrat6 = (primarySpec && primarySpec.wrap) ? getWrapStrategyEnum_(primarySpec.wrap) : SpreadsheetApp.WrapStrategy.CLIP;
        var placeholderCell = sheet.getRange(currentRow, startCol6);
        placeholderCell.setValue("Insert new data here");

        if (primarySpec && primarySpec.fontSize) placeholderCell.setFontSize(Number(primarySpec.fontSize));
        if (primarySpec && primarySpec.fontWeight) placeholderCell.setFontWeight(primarySpec.fontWeight.toLowerCase() === "bold" ? "bold" : "normal");
        if (primarySpec && primarySpec.alignment) placeholderCell.setHorizontalAlignment(primarySpec.alignment.toLowerCase());
        placeholderCell.setWrapStrategy(wrapStrat6);
        return;
      }
    });
  });
}



function getWrapStrategyEnum_(wrapStr) {
  var w = String(wrapStr || "").toUpperCase();
  if (w === "WRAP") return SpreadsheetApp.WrapStrategy.WRAP;
  if (w === "OVERFLOW") return SpreadsheetApp.WrapStrategy.OVERFLOW;
  return SpreadsheetApp.WrapStrategy.CLIP;
}

function applyColumnWidthsEngine_(sheet, config) {
  if (!sheet) return;
  var targetCols = sheet.getMaxColumns();
  var dashConfig = loadDashboardConfig_(true);
  var defaultColWidth = Number(dashConfig.globals["Default Column Width"]) || GLOBAL_DEFAULTS.DEFAULT_COL_WIDTH;
  var widthSpec = String(config.columnWidths || "").trim();

  if (widthSpec && widthSpec.toUpperCase() !== "FIT_TO_DATA") {
    var parsedWidths = widthSpec.split(",").map(item => parseInt(item.trim(), 10));
    if (parsedWidths.some(w => !isNaN(w) && w > 0)) {
      if (parsedWidths.length === 1 && !isNaN(parsedWidths[0]) && parsedWidths[0] > 0) {
        for (var col = 1; col <= targetCols; col++) { sheet.setColumnWidth(col, parsedWidths[0]); }
      } else {
        for (var i = 0; i < targetCols; i++) {
          var colWidth = (i < parsedWidths.length && !isNaN(parsedWidths[i]) && parsedWidths[i] > 0) ? parsedWidths[i] : defaultColWidth;
          sheet.setColumnWidth(i + 1, colWidth);
        }
      }
      return;
    }
  }
  for (var c = 1; c <= targetCols; c++) { sheet.setColumnWidth(c, defaultColWidth); }
}

// Audit Resolution (FIND-003): Restored getTemplateConfigFromDashboard_
function getTemplateConfigFromDashboard_(systemSheetName) {
  const dashboard = loadDashboardConfig_(true);
  const key = String(systemSheetName || "").trim().toLowerCase();

  const sheetDef = (dashboard.sheetDefinitions || []).find(item => String(item.systemSheetName || "").trim().toLowerCase() === key) || {};
  const creationRule = (dashboard.creationRules && dashboard.creationRules[systemSheetName]) || {};
  const headers = getHeadersForSheetType_(dashboard, systemSheetName);

  return {
    dashboard: dashboard,
    systemSheetName: systemSheetName,
    templateName: sheetDef.templateName || SYSTEM_SHEETS.TEMPLATE_PREFIX + systemSheetName,
    reportTitle: sheetDef.reportTitle || systemSheetName,
    titleDateFormat: sheetDef.titleDateFormat || "",
    sheetType: sheetDef.usesSubheaders ? "SYSTEM" : "DATA",
    headers: headers,
    columnCount: Math.max(Number(sheetDef.columnCount) || 0, headers.length, 1),
    minimumRows: Number(sheetDef.minimumRows) || 100,
    rank: Number(creationRule.templateRank) || 800,
    columnWidths: sheetDef.columnWidths || "105",
    usesSubheaders: sheetDef.usesSubheaders === true,
    usesAlternatingColors: sheetDef.usesAlternatingColors !== false,
    titleRows: getDashboardRowFormattingSpecs_(dashboard.titleRows, systemSheetName),
    subheaderRowSpecs: getDashboardRowFormattingSpecs_(dashboard.subheaderRows, systemSheetName),
    subheaders: getSubheadersFromDashboardConfig_(systemSheetName),
    theme: getTemplateTheme_(systemSheetName)
  };
}

function getDashboardRowFormattingSpecs_(rows, systemSheetName) {
  const target = String(systemSheetName || "").trim().toLowerCase();
  return (rows || []).filter(function(item) {
    const sheetType = String(item && item.sheetType || "GLOBAL").trim().toLowerCase();
    return sheetType === "global" || sheetType === target;
  });
}

// Audit Resolution (FIND-004): Restored getSubheadersFromDashboardConfig_
function getSubheadersFromDashboardConfig_(systemSheetName) {
  const nameLower = String(systemSheetName || "").toLowerCase();
  if (nameLower.indexOf("timing") !== -1) {
    return [
