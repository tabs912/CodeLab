function runDashboardQualityConfigVerificationSections_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD) || ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT);
  if (!dashboard) throw new Error("Format Dashboard is required for Dashboard Quality verification.");
  const values = dashboard.getDataRange().getValues();
  const sections = {};
  let currentSection = "";
  values.forEach(function(row, rowIndex) {
    const firstCell = String(row[0] || "").trim();
    if (firstCell.indexOf("SECTION ") === 0) {
      currentSection = firstCell;
      sections[currentSection] = { titleRow: rowIndex + 1, rows: [] };
    } else if (currentSection) {
      sections[currentSection].rows.push(row);
    }
  });

  const requiredPrefixes = ["SECTION B", "SECTION C", "SECTION D", "SECTION E", "SECTION F", "SECTION G", "SECTION H"];
  const results = requiredPrefixes.map(function(prefix) {
    const title = Object.keys(sections).find(function(name) { return name.indexOf(prefix) === 0; });
    if (!title) return [prefix, "FAIL", "Required section is missing."];
    const meaningfulRows = sections[title].rows.filter(function(row) {
      return row.some(function(value) { return String(value == null ? "" : value).trim() !== ""; });
    });
    return meaningfulRows.length ? [title, "PASS", meaningfulRows.length + " configured row(s) detected."] : [title, "WARNING", "Section exists but has no configured data rows."];
  });
  return results;
}

function writeDashboardQualitySection_(title, headers, rows) {
  const sheet = ensureDashboardQualityReport_();
  const width = Math.max(headers.length, 4);
  const normalizedRows = (rows || []).map(function(row) {
    const output = row.slice(0, width);
    while (output.length < width) output.push("");
    return output;
  });
  const appended = appendDataToSubheaderSection_(sheet, title, normalizedRows);
  if (!appended) return;
  const statusColumn = Math.max(headers.map(function(header) { return String(header).toLowerCase(); }).indexOf("status") + 1, 2);
  normalizedRows.forEach(function(row, index) {
    if (String(row[statusColumn - 1] || "").toUpperCase() === "FAIL") {
      sheet.getRange(appended.startRow + index, statusColumn).setBackground("#F4CCCC");
    }
  });
}

function ensureDashboardQualityReport_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SYSTEM_SHEETS.QUALITY);
  if (sheet) return sheet;
  if (!ss.getSheetByName(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY)) {
    if (!ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT) && !ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD)) {
      if (typeof buildFormatDashboardTemplate_ === "function") buildFormatDashboardTemplate_();
    }
    if (typeof buildGeneralTemplate_ === "function") buildGeneralTemplate_(getTemplateConfigFromDashboard_(SYSTEM_SHEETS.QUALITY));
  }
  sheet = createActiveSheetFromTemplate_(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.QUALITY);
  if (!sheet) throw new Error("Dashboard Quality Report could not be created from its governed template.");
  return sheet;
}

function runDashboardQualityStartUp() {
  return runFrameworkTimed_("Dashboard Quality Start Up", function(timing) {
    const results = runDashboardQualityConfigVerificationSections_();
    writeDashboardQualitySection_("SECTION A - FORMAT DASHBOARD VALIDATION", ["Section", "Status", "Details"], results);
    markFrameworkStep_(timing, "Format Dashboard Sections B-H audited", results.length + " sections");
    return results;
  });
}

function runDashboardQualityValidateTemplates() {
  return runFrameworkTimed_("Dashboard Quality Validate Templates", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const templateNames = [
      "Template -  Banners", "Template -  CP Due Date", "Template -  Unlock CP",
      "Template -  Raw Data", "Template -  Refined Data", "Template -  Disenrolled Exclusion",
      "Template -  Master List", "Template -  Monthly Change", "Template -  Archive - Refined Data",
      SYSTEM_SHEETS.BASE_TEMPLATE
    ];
    const rows = templateNames.map(function(templateName) {
      const exists = !!ss.getSheetByName(templateName);
      return [templateName, exists ? "PASS" : "FAIL", exists ? "Template found." : "Template is missing."];
    });
    writeDashboardQualitySection_("SECTION B - TEMPLATE VALIDATION", ["Template", "Status", "Details"], rows);
    markFrameworkStep_(timing, "Templates validated", rows.length + " templates");
    return rows;
  });
}

function runDashboardQualityWorkflow() {
  const configResults = runDashboardQualityStartUp();
  const templateResults = runDashboardQualityValidateTemplates();
  const processResults = runDashboardQualityProcessValidationSections_();
  const failed = configResults.concat(templateResults, processResults).filter(function(row) { return row[1] === "FAIL"; });
  if (failed.length) throw new Error("Dashboard Quality Workflow failed " + failed.length + " validation item(s).");
  notify_("Dashboard Quality Workflow complete.");
  return { configResults: configResults, templateResults: templateResults, processResults: processResults };
}

function runDashboardQualityProcessValidationSections_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashboard = loadDashboardConfig_();
  const validations = [
    ["SECTION C - RAW DATA VALIDATION", "Raw Data"],
    ["SECTION D - DEMO P QUALITY VALIDATION", "Refined Data"],
    ["SECTION E - DISENROLLED EXCLUSION VALIDATION", "Disenrolled Exclusion"],
    ["SECTION F - MONTHLY CHANGE VALIDATION", "Monthly Change"],
    ["SECTION G - MASTER LIST VALIDATION", "Master List"]
  ];
  const results = [];
  validations.forEach(function(item) {
    const title = item[0];
    const sheetType = item[1];
    const governedHeaders = getHeadersForSheetType_(dashboard, sheetType);
    const activeSheet = getLatestSheetByPrefix_(sheetType);
    let status = "PASS";
    let details = governedHeaders.length + " governed header(s); active sheet " + (activeSheet ? "found" : "not present (not yet built)") + ".";
    if (!governedHeaders.length) { status = "FAIL"; details = "No governed headers are configured."; } else if (!activeSheet) { status = "WARNING"; }
    const row = [sheetType, status, details];
    writeDashboardQualitySection_(title, ["Process", "Status", "Details"], [row]);
    results.push(row);
  });
  const failedCount = results.filter(function(row) { return row[1] === "FAIL"; }).length;
  const warningCount = results.filter(function(row) { return row[1] === "WARNING"; }).length;
  const summary = [["Dashboard Quality Workflow", failedCount ? "FAIL" : (warningCount ? "WARNING" : "PASS"), results.length + " process section(s); " + failedCount + " failed; " + warningCount + " warning(s)."]];
  writeDashboardQualitySection_("SECTION H - SUMMARY", ["Workflow", "Status", "Details"], summary);
  return results.concat(summary);
}

function runFrameworkSmokeValidation() {
  const requiredFunctions = [
    ["formatMonthlySheets", typeof formatMonthlySheets], ["runMonthlyUpdate", typeof runMonthlyUpdate],
    ["runMonthlyStart", typeof runMonthlyStart], ["updateRefinedDataMonthlySync", typeof updateRefinedDataMonthlySync],
    ["buildRefinedDataFromScratch", typeof buildRefinedDataFromScratch], ["createDisenrolledList", typeof createDisenrolledList],
    ["buildMonthlyChangeReport", typeof buildMonthlyChangeReport], ["createMasterList", typeof createMasterList],
    ["runDashboardQualityWorkflow", typeof runDashboardQualityWorkflow], ["createAllReportTemplates", typeof createAllReportTemplates],
    ["populateActiveIndex", typeof populateActiveIndex]
  ];
  const missingFunctions = requiredFunctions.filter(function(item) { return item[1] !== "function"; }).map(function(item) { return item[0]; });
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const requiredSheets = [SYSTEM_SHEETS.DASHBOARD, SYSTEM_SHEETS.QUALITY, SYSTEM_SHEETS.INDEX];
  const missingSheets = requiredSheets.filter(function(name) { return !ss.getSheetByName(name); });
  if (missingFunctions.length || missingSheets.length) throw new Error("Framework smoke validation failed. Missing functions: " + (missingFunctions.join(", ") || "None") + "; Missing sheets: " + (missingSheets.join(", ") || "None"));
  notify_("Framework smoke validation passed.");
  return { functionsChecked: requiredFunctions.length, sheetsChecked: requiredSheets.length };
}

function runFullQualityCheck() {
  const smoke = runFrameworkSmokeValidation();
  const quality = runDashboardQualityWorkflow();
  notify_("Full Quality Check complete.");
  return { smoke: smoke, quality: quality };
}

function runFormatDashboardUpdates() {
  const results = runDashboardQualityConfigVerificationSections_();
  writeDashboardQualitySection_("SECTION A - FORMAT DASHBOARD VALIDATION", ["Section", "Status", "Details"], results);
  const failed = results.filter(function(row) { return row[1] === "FAIL"; });
  if (failed.length) throw new Error("Format Dashboard Updates found " + failed.length + " missing required section(s).");
  notify_("Format Dashboard Updates validation complete.");
  return results;
}

