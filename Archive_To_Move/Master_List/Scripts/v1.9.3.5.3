function buildRefinedDataFromScratch() {
  const monthParts = promptForLockedYearReportMonth_("Build Refined Data from Scratch");
  if (!monthParts) return null;
  return processRefinedDataUpdate_("Build Refined Data", monthParts, true);
}

function updateRefinedDataMonthlySync() {
  const monthParts = promptForLockedYearReportMonth_("Update Refined Data (Monthly Sync)");
  if (!monthParts) return null;
  return processRefinedDataUpdate_("Sync Refined Data", monthParts, false);
}

/**
 * Unified engine for Refined Data.
 * Filters out all blank rows, merges data if syncing, and enforces row heights.
 */
function processRefinedDataUpdate_(processName, monthParts, isScratchBuild) {
  return runFrameworkTimed_(processName + " " + monthParts.monthLabel, function(timing) {
    const lock = LockService.getDocumentLock();
    if (!lock.tryLock(30000)) throw new Error("Refined Data process is currently locked by another operation.");

    try {
      const dashboard = loadDashboardConfig_();
      const sysName = "Refined Data";

      // 1. Locate Source Raw Data
      const rawDataSheet = getCurrentRawDataSheet_(monthParts);
      if (!rawDataSheet) {
        throw new Error("Could not find Raw Data for " + monthParts.monthLabel + ". Please run 'Format Monthly Sheets' first.");
      }

      markFrameworkStep_(timing, "Reading Source", "Extracting Raw Data...");
      const rawData = getDataValues_(rawDataSheet, HEADER_ROW, DATA_START_ROW);

      // STRICT FILTER: Remove any completely blank grid rows (fixes the 5-24 empty row bug)
      const validRawRows = filterBlankRows_(rawData.values);
      if (validRawRows.length === 0) throw new Error("Raw Data sheet contains no valid records.");

      // 2. Resolve Target Headers
      const targetHeaders = getHeadersForSheetType_(dashboard, sysName);
      if (!targetHeaders || targetHeaders.length === 0) throw new Error("Dashboard Section H is missing headers for " + sysName);

      let finalRows = [];

      // 3. Process Data (Scratch vs. Sync)
      if (isScratchBuild) {
        markFrameworkStep_(timing, "Mapping Data", "Building from scratch mapping...");
        finalRows = mapRowsToHeaders_(validRawRows, rawData.headers, targetHeaders);
      } else {
        markFrameworkStep_(timing, "Merging Data", "Syncing against existing Refined Data...");
        const existingRefinedSheet = getCurrentDemoPSheet_();
        if (!existingRefinedSheet) throw new Error("Existing Refined Data sheet not found for sync. Run 'Build from Scratch' instead.");

        const existingData = getDataValues_(existingRefinedSheet, HEADER_ROW, DATA_START_ROW);
        const validExistingRows = filterBlankRows_(existingData.values);

        finalRows = mergeRefinedData_(validExistingRows, existingData.headers, validRawRows, rawData.headers, targetHeaders);
      }

      // 4. Run the governed Refined Data processes in memory before the single sheet write.
      markFrameworkStep_(timing, "Refined Data - Begin transformations", finalRows.length + " mapped row(s)");
      finalRows = applyRefinedDataProcesses_(finalRows, targetHeaders, timing);

      // 5. Delegate to Universal Factory (Module 1)
      markFrameworkStep_(timing, "Refined Data - Instantiate output", "Writing clean Refined Data grid...");
      const finalSheet = createGovernedSheet_(sysName, null, {
        customName: "Refined Data", // Lock name strictly to Refined Data (no mm.yy)
        dataRows: finalRows,
        headers: targetHeaders,
        overwrite: true,
        timing: timing
      });

      // 6. Explicitly enforce row heights and verify the finalized grid.
      markFrameworkStep_(timing, "Refined Data - Enforce row heights", finalRows.length + " data row(s)");
      enforceDataRowHeights_(finalSheet, dashboard, finalRows.length);
      markFrameworkStep_(timing, "Refined Data - Process complete", "Refined Data updated successfully with " + finalRows.length + " participant row(s).");
      return { success: true, count: finalRows.length };

    } finally {
      lock.releaseLock();
    }
  });
}

/**
 * Merges new raw data into existing refined data, keyed by PMR.
 * New PMRs are appended. Existing PMRs are updated only with specified overwrite fields.
 */
function mergeRefinedData_(existingRows, existingHeaders, newRows, newHeaders, targetHeaders) {
  const existingMap = buildHeaderIndexMap_(existingHeaders);
  const newMap = buildHeaderIndexMap_(newHeaders);

  const existingPmrIdx = getPMRIndex_(existingMap);
  const newPmrIdx = getPMRIndex_(newMap);

  if (existingPmrIdx < 0 || newPmrIdx < 0) {
    throw new Error("Could not identify PMR column in headers for merge.");
  }

  const recordMap = new Map();

  // Load existing records natively mapped to target headers
  const mappedExisting = mapRowsToHeaders_(existingRows, existingHeaders, targetHeaders);
  const targetPmrIdx = getPMRIndex_(buildHeaderIndexMap_(targetHeaders));

  mappedExisting.forEach(row => {
    const pmr = String(row[targetPmrIdx] || "").trim();
    if (pmr) recordMap.set(pmr, row);
  });

  // Fields we always allow Raw Data to update in Refined Data
  const forceOverwriteFields = ["Address Line 1", "Address Line 2", "City", "State", "Zip"];
  const overwriteIndices = forceOverwriteFields.map(f => ({
    newIdx: newMap[f] !== undefined ? newMap[f] : newMap[f.toLowerCase()],
    targetIdx: targetHeaders.indexOf(f)
  })).filter(obj => obj.newIdx >= 0 && obj.targetIdx >= 0);

  // Process new incoming raw rows
  newRows.forEach(newRow => {
    const pmr = String(newRow[newPmrIdx] || "").trim();
    if (!pmr) return;

    if (recordMap.has(pmr)) {
      // Update existing record
      const existingRecord = recordMap.get(pmr);
      overwriteIndices.forEach(obj => {
        const incomingValue = String(newRow[obj.newIdx] || "").trim();
        if (incomingValue !== "") {
          existingRecord[obj.targetIdx] = newRow[obj.newIdx];
        }
      });
      recordMap.set(pmr, existingRecord);
    } else {
      // Append entirely new record
      const mappedNewRecord = targetHeaders.map(targetHeader => {
        const idx = findHeaderIndex_(newMap, [targetHeader]);
        return idx >= 0 && idx < newRow.length ? newRow[idx] : "";
      });
      recordMap.set(pmr, mappedNewRecord);
    }
  });

  return Array.from(recordMap.values());
}

