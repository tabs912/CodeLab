  const nextValue = enabled ? "false" : "true";
  PropertiesService.getDocumentProperties().setProperty("RFF_TIMING_ENABLED", nextValue);
  SpreadsheetApp.getActiveSpreadsheet().toast("Timing Engine: " + (nextValue === "true" ? "ON" : "OFF"), "Timing Engine", 3);
  return nextValue === "true";
}

function startRuntimeTiming_(processName, monthParts) {
  const now = new Date().getTime();
  return {
    processName: processName || "Workflow",
    monthParts: monthParts || null,
    startMs: now,
    lastMs: now,
    steps: [],
    warnings: []
  };
}

function markRuntimeStep_(timing, label, details) {
  if (!timing) return;
  if (!Array.isArray(timing.steps)) timing.steps = [];
  if (!Array.isArray(timing.warnings)) timing.warnings = [];
  if (!timing.startMs) timing.startMs = new Date().getTime();
  if (!timing.lastMs) timing.lastMs = timing.startMs;
  if (!timing.processName) timing.processName = "Workflow";

  const now = new Date().getTime();
  const stepSeconds = (now - timing.lastMs) / 1000;
  const totalSeconds = (now - timing.startMs) / 1000;
  const cleanLabel = String(label || "Step");
  const severity = /^ERROR\b/i.test(cleanLabel) ? "CRITICAL" : getRuntimeTimingSeverity_(stepSeconds);
  const cleanDetails = details === undefined || details === null ? "" : String(details);

  timing.steps.push({
    timestamp: new Date(),
    processName: timing.processName,
    stepName: cleanLabel,
    stepNumber: timing.steps.length + 1,
    stepSeconds: stepSeconds,
    totalSeconds: totalSeconds,
    severity: severity,
    details: cleanDetails
  });

  if (severity !== "OK") {
    timing.warnings.push(cleanLabel + " - " + severity + " - " + formatSeconds_(stepSeconds));
  }

  timing.lastMs = now;
  logRuntimeTiming_(timing.processName, cleanLabel, stepSeconds, totalSeconds, severity, cleanDetails);
}

function logRuntimeWarning_(processName, message, details) {
  const suffix = details === undefined || details === null || details === "" ? "" : " | " + details;
  if (typeof Logger !== "undefined") {
    Logger.log("[WARNING] " + String(processName || "System") + " | " + String(message || "") + suffix);
  }
}

function logBestEffortWarning_(msg) {
  if (typeof Logger !== "undefined") Logger.log("WARNING: " + msg);
  // Route legacy warnings safely without breaking execution
  if (typeof logRuntimeWarning_ === "function") {
    logRuntimeWarning_("Best Effort", msg, "");
  }
}


// Fallback to prevent any missed calls from crashing the script
function logFrameworkTiming_(process, step, severity, details) {
  if (typeof Logger !== "undefined") {
    Logger.log("[TIMING-LEGACY] " + String(process) + " | " + String(step) + " | " + String(severity) + " | " + String(details));
  }
}

function logRuntimeTiming_(processName, stepName, stepSeconds, totalSeconds, severity, details) {
  const detailText = details ? " | " + details : "";
  if (typeof Logger !== "undefined") {
    Logger.log("[TIMING] " + String(processName) + " | " + String(stepName) + " | step " + formatSeconds_(stepSeconds) + " | total " + formatSeconds_(totalSeconds) + " | " + String(severity) + detailText);
  }
}


function getRuntimeTimingSeverity_(seconds) {
  const value = Number(seconds || 0);
  if (value >= 60) return "CRITICAL";
  if (value >= 30) return "BOTTLENECK";
  if (value >= 10) return "SLOW";
  return "OK";
}

function formatSeconds_(seconds) {
  const value = Number(seconds || 0);
  if (value < 60) return value.toFixed(2) + " sec";
  const minutes = Math.floor(value / 60);
  const remaining = value - (minutes * 60);
  return minutes + " min " + remaining.toFixed(1) + " sec";
}

function writeRuntimeTimingReport_(timing) {
  if (!timing || !timing.steps || timing.steps.length === 0) return false;
  try {
    const sheet = ensureFrameworkTimingReport_();

    const rows = timing.steps.map(function(step) {
      return [
        step.timestamp || new Date(),
        step.processName || "",
        step.stepName || "",
        Number(step.stepSeconds || 0),
        Number(step.totalSeconds || 0),
        step.severity || "OK",
        "Step " + (step.stepNumber || "") + (step.details ? " | " + step.details : "")
      ];
    });

    appendDataToSubheaderSection_(sheet, "SECTION D - DETAILED TIMING LOG", rows);
    refreshFrameworkTimingSummarySections_(sheet);
    return true;
  } catch (err) {
    logBestEffortWarning_("[WARNING] Framework Timing Report append skipped | " + err.message);
    return false;
  }
}

// ----------------------------------------------------------------------------
// COMPATIBILITY ALIASES (Ensures v1.9.3.5.3 pipelines don't break)
// ----------------------------------------------------------------------------

function runFrameworkTimed_(processName, func) {
  if (!isFrameworkTimingEnabled_()) {
    return func(null);
  }
  const timing = startRuntimeTiming_(processName);
  markRuntimeStep_(timing, "Start Process", processName);
  try {
    const res = func(timing);
    markRuntimeStep_(timing, "End Process", processName + " completed");
    writeRuntimeTimingReport_(timing);
    return res;
  } catch (err) {
    markRuntimeStep_(timing, "Error", err.message);
    writeRuntimeTimingReport_(timing);
    throw err;
  }
}

function markFrameworkStep_(timing, stepName, details) {
  // Map legacy layout logs to the new streamlined runtime step engine
  if (typeof markRuntimeStep_ === "function") {
    markRuntimeStep_(timing, stepName, details || "");
  }
}


// ============================================================================
// EXTRACTED SUBHEADER APPENDER (Required for Monthly Change / Quality Reports)
// ============================================================================

function appendDataToSubheaderSection_(sheet, sectionTitle, rows) {
  if (!sheet || !rows || !rows.length) return null;
  const bounds = getSubheaderSectionBounds_(sheet, sectionTitle);
  if (!bounds) throw new Error('Template subheader section "' + sectionTitle + '" is missing.');

  const firstDataRow = bounds.titleRow + 4;
  const formatSourceRow = bounds.titleRow + 3;
  let appendRow = firstDataRow;
  let nextSectionRow = bounds.nextSectionRow;
  let nextSectionBufferRow = nextSectionRow > 0 ? nextSectionRow - 1 : 0;
  const marker = String(sheet.getRange(firstDataRow, 1).getValue() || "").trim().toLowerCase();
  if (marker === "insert new data here" || marker.indexOf("enter data here") === 0) sheet.getRange(firstDataRow, 1).clearContent();

  while ((!nextSectionBufferRow || appendRow < nextSectionBufferRow) && String(sheet.getRange(appendRow, 1).getValue() || "").trim() !== "") appendRow++;
  if (nextSectionBufferRow && appendRow + rows.length > nextSectionBufferRow) {
    const rowsNeeded = appendRow + rows.length - nextSectionBufferRow;
    sheet.insertRowsBefore(nextSectionBufferRow, rowsNeeded);
    nextSectionBufferRow += rowsNeeded;
    nextSectionRow += rowsNeeded;
  } else if (!nextSectionRow) {
    resizeSheetGrid_(sheet, appendRow + rows.length - 1, sheet.getMaxColumns());
  }

  applySubheaderDataRowFormatting_(sheet, formatSourceRow, appendRow, rows.length);
  sheet.getRange(appendRow, 1, rows.length, rows[0].length).setValues(rows);
  return { startRow: appendRow, rowCount: rows.length };
}

function applySubheaderDataRowFormatting_(sheet, formatSourceRow, startRow, rowCount) {
  if (!sheet || rowCount < 1) return;
  const fullWidth = sheet.getMaxColumns();
  const source = sheet.getRange(formatSourceRow, 1, 1, fullWidth);
  const target = sheet.getRange(startRow, 1, rowCount, fullWidth);
  source.copyTo(target, SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
  sheet.setRowHeights(startRow, rowCount, sheet.getRowHeight(formatSourceRow));
}

function findSubheaderDataAnchorRow_(sheet, titleRow, nextSectionRow) {
  const endRow = nextSectionRow > 0 ? nextSectionRow - 1 : Math.min(sheet.getMaxRows(), titleRow + 12);
  const rowCount = Math.max(endRow - titleRow, 1);
  const values = sheet.getRange(titleRow + 1, 1, rowCount, 1).getDisplayValues();
  for (let index = 0; index < values.length; index++) {
    const value = String(values[index][0] || "").trim().toLowerCase();
    if (value === "insert new data here" || value === "enter data here") {
      return titleRow + index + 1;
    }
  }
  return titleRow + 4;
}

function resetSubheaderSectionData_(sheet, sectionTitle) {
  const bounds = getSubheaderSectionBounds_(sheet, sectionTitle);
  if (!bounds) return false;
  const endRow = bounds.nextSectionRow > 0 ? bounds.nextSectionRow - 1 : sheet.getLastRow();
  const rowCount = Math.max(endRow - bounds.dataRow + 1, 1);
  sheet.getRange(bounds.dataRow, 1, rowCount, sheet.getLastColumn()).clearContent();
  sheet.getRange(bounds.dataRow, 1).setValue("Insert new data here");
  return true;
}

function getSubheaderSectionBounds_(sheet, sectionTitle) {
  if (!sheet) return null;
  const values = sheet.getRange(1, 1, Math.max(sheet.getLastRow(), 1), 1).getDisplayValues();
  let titleRow = 0;
  let nextSectionRow = 0;
  for (let index = 0; index < values.length; index++) {
    const value = String(values[index][0] || "").trim();
    if (value === sectionTitle) {
      titleRow = index + 1;
      continue;
    }
    if (titleRow && value.indexOf("SECTION ") === 0) {
      nextSectionRow = index + 1;
      break;
    }
  }
  if (!titleRow) return null;
  return {
    titleRow: titleRow,
    nextSectionRow: nextSectionRow,
    dataRow: findSubheaderDataAnchorRow_(sheet, titleRow, nextSectionRow)
  };
}

function getFrameworkTimingSectionRegistry_() {
  return [
    { id: "A", title: "SECTION A - PROCESS SUMMARY", headers: ["Process", "Runtime (Sec)", "Status", "Benchmark", "Variance", "Notes"] },
    { id: "B", title: "SECTION B - PERFORMANCE ISSUES", headers: ["Priority", "Process", "Runtime (Sec)", "Threshold", "Issue", "Recommendation"] },
    { id: "C", title: "SECTION C - OPTIMIZATION RECOMMENDATIONS", headers: ["Process", "Finding", "Impact", "Recommendation", "Priority", "Status"] },
    { id: "D", title: "SECTION D - DETAILED TIMING LOG", headers: ["Timestamp", "Process", "Step", "Step Seconds", "Total Seconds", "Severity", "Details"] }
  ];
}

function ensureFrameworkTimingReport_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SYSTEM_SHEETS.TIMING);
  if (sheet && hasFrameworkTimingSections_(sheet)) return sheet;
  let template = ss.getSheetByName(SYSTEM_SHEETS.TEMPLATE_PREFIX + SYSTEM_SHEETS.TIMING);
  if (!template || !hasFrameworkTimingSections_(template)) template = buildFrameworkTimingTemplate_();
  sheet = createActiveSheetFromTemplate_(template.getName(), SYSTEM_SHEETS.TIMING);
  if (!sheet) throw new Error("Framework Timing Report could not be created from its governed template.");
  return sheet;
}

function hasFrameworkTimingSections_(sheet) {
  if (!sheet) return false;
  const values = sheet.getRange(1, 1, Math.max(sheet.getLastRow(), 1), 1).getDisplayValues();
  const titles = new Set(values.map(function(row) { return String(row[0] || "").trim(); }));
  return getFrameworkTimingSectionRegistry_().every(function(section) {
    return titles.has(section.title);
  });
}

function getFrameworkTimingDetailRows_(sheet) {
  const bounds = getSubheaderSectionBounds_(sheet, "SECTION D - DETAILED TIMING LOG");
  if (!bounds) return [];
  const endRow = sheet.getLastRow();
  if (endRow < bounds.dataRow) return [];
  return sheet.getRange(bounds.dataRow, 1, endRow - bounds.dataRow + 1, 7).getValues().filter(function(row) {
    const first = String(row[0] || "").trim().toLowerCase();
    return first && first !== "insert new data here" && first !== "enter data here";
  });
}

function replaceSubheaderSectionData_(sheet, sectionTitle, rows) {
  const bounds = getSubheaderSectionBounds_(sheet, sectionTitle);
  if (!bounds) throw new Error('Framework Timing section is missing: "' + sectionTitle + '".');
  const normalized = rows && rows.length ? rows : [["Insert new data here"]];
  const width = Math.max(normalized.reduce(function(maximum, row) { return Math.max(maximum, row.length); }, 1), 1);
  const output = normalized.map(function(row) { const copy = row.slice(); while (copy.length < width) copy.push(""); return copy; });
  const dataRow = bounds.titleRow + 4;
  const formatSourceRow = bounds.titleRow + 3;
  const nextBufferRow = bounds.nextSectionRow > 0 ? bounds.nextSectionRow - 1 : 0;
  const existingEnd = nextBufferRow > 0 ? nextBufferRow - 1 : sheet.getLastRow();
  const existingRows = Math.max(existingEnd - dataRow + 1, 1);
  if (nextBufferRow > 0 && output.length > existingRows) sheet.insertRowsBefore(nextBufferRow, output.length - existingRows);
  else if (!nextBufferRow) resizeSheetGrid_(sheet, dataRow + output.length - 1, sheet.getMaxColumns());
  sheet.getRange(dataRow, 1, Math.max(existingRows, output.length), sheet.getLastColumn()).clearContent();
  applySubheaderDataRowFormatting_(sheet, formatSourceRow, dataRow, output.length);
  sheet.getRange(dataRow, 1, output.length, width).setValues(output);
}

function refreshFrameworkTimingSummarySections_(sheet) {
  const detailRows = getFrameworkTimingDetailRows_(sheet).slice(-RFF_TIMING_MAX_ROWS);
  const runs = [];
  const currentByProcess = {};
  detailRows.forEach(function(row) {
    const process = String(row[1] || "Workflow");
    const stepName = String(row[2] || "Step");
    if (/^Start Process$/i.test(stepName) || !currentByProcess[process]) {
      const run = { process: process, runtime: 0, worst: "OK", slowSteps: 0, error: false, steps: 0 };
      runs.push(run);
      currentByProcess[process] = run;
    }
    const run = currentByProcess[process];
    const seconds = Number(row[3]) || 0;
    const severity = String(row[5] || "OK").toUpperCase();
    run.runtime += seconds;
    run.steps++;
    run.worst = worseRuntimeTimingSeverity_(run.worst, severity);
    if (severity !== "OK") run.slowSteps++;
    if (/^Error$/i.test(stepName) || severity === "CRITICAL") run.error = run.error || /^Error$/i.test(stepName);
  });
  const summaryRows = runs.slice(-100).map(function(run) {
    const status = run.error ? "CRITICAL" : run.worst;
    return [run.process, Number(run.runtime.toFixed(3)), status === "OK" ? "PASS" : status, "", "", run.steps + " detailed step(s); " + run.slowSteps + " slow step(s)"];
  });
  const issueRows = detailRows.filter(function(row) {
    return ["SLOW", "BOTTLENECK", "CRITICAL"].indexOf(String(row[5] || "").toUpperCase()) !== -1;
  }).slice(-200).map(function(row) {
    const severity = String(row[5] || "").toUpperCase();
    return [severity, row[1], row[3], getRuntimeTimingThreshold_(severity), row[2], getRuntimeTimingRecommendation_(row[1], row[2], severity)];
  });
  const recommendationRows = issueRows.map(function(row) {
    return [row[1], row[4], row[0], row[5], row[0], "Open"];
  });
  replaceSubheaderSectionData_(sheet, "SECTION A - PROCESS SUMMARY", summaryRows);
  replaceSubheaderSectionData_(sheet, "SECTION B - PERFORMANCE ISSUES", issueRows);
  replaceSubheaderSectionData_(sheet, "SECTION C - OPTIMIZATION RECOMMENDATIONS", recommendationRows);
}

function worseRuntimeTimingSeverity_(current, next) {
  const rank = { OK: 0, SLOW: 1, BOTTLENECK: 2, CRITICAL: 3 };
  return (rank[next] || 0) > (rank[current] || 0) ? next : current;
}

function getRuntimeTimingThreshold_(severity) {
  if (severity === "CRITICAL") return ">= 60 sec";
  if (severity === "BOTTLENECK") return ">= 30 sec";
  return ">= 10 sec";
}

function getRuntimeTimingRecommendation_(process, step, severity) {
  if (severity === "CRITICAL") return "Resolve the blocking or longest-running function step before the next production run.";
  if (severity === "BOTTLENECK") return "Review service calls and batch reads/writes in this function step.";
  return "Review this function step and confirm the work is required for the governed workflow.";
}


// ============================================================================
// 8. COLOR LOGIC & HSL HELPERS
// ============================================================================

function isValidHex_(hexStr) { return /^#[0-9A-F]{6}$/i.test(String(hexStr || "").trim()); }

function hexToHsl_(hex) {
  let c = String(hex || "").replace('#', '').trim();
  if (c.length === 3) c = c.split('').map(x => x + x).join('');
  if (c.length !== 6) return { h: 200, s: 50, l: 50 };
  const r = parseInt(c.substring(0, 2), 16) / 255, g = parseInt(c.substring(2, 4), 16) / 255, b = parseInt(c.substring(4, 6), 16) / 255;
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  let h = 0, s = 0, l = (max + min) / 2;
  if (max !== min) {
    const d = max - min; s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) { case r: h = (g - b) / d + (g < b ? 6 : 0); break; case g: h = (b - r) / d + 2; break; case b: h = (r - g) / d + 4; break; }
    h /= 6;
  }
  return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
}

function hslToHex_(h, s, l) {
  l /= 100; const a = (s * Math.min(l, 1 - l)) / 100;
  const f = n => { const k = (n + h / 30) % 12; const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1); return Math.round(255 * color).toString(16).padStart(2, '0'); };
  return `#${f(0)}${f(8)}${f(4)}`.toUpperCase();
}

function calculateThemeLevels_(baseHex, hslPercents) {
  const hsl = hexToHsl_(baseHex);
  return {
    base: baseHex,
    level1: hslToHex_(hsl.h, hsl.s, hslPercents.l1 || 60),
    level2: hslToHex_(hsl.h, hsl.s, hslPercents.l2 || 75),
    level3: hslToHex_(hsl.h, hsl.s, hslPercents.l3 || 85),
    level4: hslToHex_(hsl.h, hsl.s, hslPercents.l4 || 97),
    level5: hslToHex_(hsl.h, hsl.s, hslPercents.l5 || 99)
  };
}

function getHslPercentsFromDashboard_(dashSheet) {
  if (typeof GLOBAL_DEFAULTS !== "undefined" && GLOBAL_DEFAULTS.HSL_LEVELS) {
    return {
      l1: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level1) || 60,
      l2: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level2) || 75,
      l3: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level3) || 85,
      l4: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level4) || 97,
      l5: Number(GLOBAL_DEFAULTS.HSL_LEVELS.level5) || 99
    };
  }
  return { l1: 60, l2: 75, l3: 85, l4: 97, l5: 99 };
}

function getTemplateTheme_(systemSheetName) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var dashSheet = ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD) || ss.getSheetByName(SYSTEM_SHEETS.DASHBOARD_DEFAULT);
    if (!dashSheet) return getFallbackTheme_();
    var data = dashSheet.getDataRange().getValues();
    var hslPercents = getHslPercentsFromDashboard_(dashSheet);

    for (var i = 0; i < data.length; i++) {
      var sysKey = String(data[i][0] || "").trim();
      if (sysKey === systemSheetName || sysKey.toLowerCase() === String(systemSheetName || "").toLowerCase()) {

        // Look in Column D (Index 3) for the Base Color
        var rawBase = String(data[i][3] || "").trim();

        // FIX: Only apply and return if it is ACTUALLY a hex code.
        // This forces the script to ignore the tab ranks in Section B and keep
        // searching until it hits the actual color definitions in Section C.
        if (isValidHex_(rawBase)) {
          var computed = calculateThemeLevels_(rawBase, hslPercents);
          return {
            baseColor: rawBase,
            level1: computed.level1,
            level2: computed.level2,
            level3: computed.level3,
            level4: computed.level4,
            level5: computed.level5,
            titleFontColor: GLOBAL_DEFAULTS.STANDARD_FONT_COLOR
          };
        }
      }
    }
  } catch (e) { logBestEffortWarning_("Non-fatal operation failed: " + e.message); }

  return getFallbackTheme_();
}





function getFallbackTheme_() {
  return { baseColor: "#79B5D2", level1: "#79B5D2", level2: "#A5D0E3", level3: "#C4E2F0", level4: "#eff8cf", level5: "#f3fadd", titleFontColor: "#000000" };
}

function recalculateDashboardHexCodes_(dashboardSheet) {
  if (!dashboardSheet) return;
  const rawDashData = dashboardSheet.getDataRange().getValues();
  const hslPercents = getHslPercentsFromDashboard_(dashboardSheet);

  for (let r = 0; r < rawDashData.length; r++) {
    const firstCell = String(rawDashData[r][0] || "").trim();
    if (!firstCell || firstCell.indexOf("SECTION ") === 0 || firstCell === "System Sheet Name" || firstCell === "Sheet Type") continue;

    // FIX: Look for the Base Color at Index 3 (Column D)
    const potentialHex = String(rawDashData[r][3] || "").trim();

    if (isValidHex_(potentialHex)) {
      const theme = calculateThemeLevels_(potentialHex, hslPercents);

      // FIX: Level 1 through 5 output columns now start at Column 5 (Column E)
      const targetRange = dashboardSheet.getRange(r + 1, 5, 1, 5);
      targetRange.clearNote();
      targetRange.setValues([[theme.level1, theme.level2, theme.level3, theme.level4, theme.level5]]);
    }
  }
}



