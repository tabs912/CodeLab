function hideMonthlySheetsBySpecs_(processName, parsedMonth, specs) {
  return runFrameworkTimed_(processName + " " + parsedMonth.monthLabel + " & Prior", function(timing) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const result = { hidden: [], skipped: [] };

    specs.forEach(function(spec) {
      const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
      if (!sheets.length) {
        result.skipped.push(spec.label + " not found");
        return;
      }
      sheets.forEach(function(sheet) {
        try {
          if (!sheet.isSheetHidden()) {
            activateVisibleSheetBeforeHiding_(sheet);
            sheet.hideSheet();
          }
          result.hidden.push(sheet.getName());
        } catch (err) {
          result.skipped.push(sheet.getName() + ": " + err.message);
        }
      });
    });
    if (typeof notify_ === "function") notify_(processName + " complete for " + parsedMonth.monthLabel + " and prior. Hidden: " + result.hidden.length + "; Skipped: " + result.skipped.length + ".");
    return result;
  });
}

function archiveMonthlySheetsBySpecs_(parsedMonth, specs, timing) {
  const writeLock = LockService.getDocumentLock();
  if (!writeLock.tryLock(30000)) {
    throw new Error("Another write workflow is already running: archiveMonthlySheetsBySpecs.");
  }
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const archiveId = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_SPREADSHEET_ID");
    if (!archiveId) throw new Error("RFF_ARCHIVE_SPREADSHEET_ID is not configured.");

    const archiveSs = SpreadsheetApp.openById(archiveId);
    const result = { archived: [], skipped: [], failed: [] };
    if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archive workbook connection established for batch", "Archive ID: " + archiveId);

    specs.forEach(function(spec) {
      const sheets = findArchiveMonthlyCandidateSheetsUpToDate_(ss, spec.keywords, parsedMonth.reportDate);
      if (!sheets.length) {
        logBestEffortWarning_("No local sheet found for " + spec.label + " " + parsedMonth.monthLabel + " or prior");
        result.skipped.push(spec.label);
        return;
      }

      sheets.forEach(function(sheet) {
        const sheetName = sheet.getName();
        try {
          const archiveResult = copySheetToArchiveAndDeleteLocal_(ss, archiveSs, sheet, sheetName, timing);
          result.archived.push(sheetName);
          if (typeof markFrameworkStep_ === "function") markFrameworkStep_(timing, "Archived monthly sheet: " + sheetName, archiveResult.localAction);
        } catch (err) {
          logBestEffortWarning_("Archive monthly sheet failed: " + sheetName + " - " + err.message);
          result.failed.push(sheetName + ": " + err.message);
        }
      });
    });

    // --- NEW: Ping Archive Web App to instantly refresh its Index ---
    pingArchiveIndexUpdate_();

    return result;

  } finally {
    writeLock.releaseLock();
  }
}

/**
 * Helper: Sends HTTP GET ping to the Archive Workbook Web App
 */
function pingArchiveIndexUpdate_() {
  try {
    const archiveWebAppUrl = PropertiesService.getDocumentProperties().getProperty("RFF_ARCHIVE_WEB_APP_URL");
    if (archiveWebAppUrl) {
      UrlFetchApp.fetch(archiveWebAppUrl, { muteHttpExceptions: true });
    }
  } catch (err) {
    logBestEffortWarning_("Failed to ping Archive Index Web App: " + err.message);
  }
}

function findArchiveMonthlyCandidateSheetsUpToDate_(ss, keywords, cutoffDate) {
  const keywordList = (keywords || []).map(function(keyword) {
    return String(keyword || "").trim().toLowerCase();
  }).filter(Boolean);

  const matches = [];
  const seen = new Set();
  const cutoffKey = cutoffDate ? Number(Utilities.formatDate(cutoffDate, Session.getScriptTimeZone(), "yyyyMM")) : 0;

  ss.getSheets().forEach(function(sheet) {
    const name = sheet.getName();
    const lowerName = name.toLowerCase();
    if (lowerName.indexOf("template") !== -1) return;

    const hasKeyword = keywordList.some(function(keyword) { return lowerName.indexOf(keyword) !== -1; });
    if (!hasKeyword) return;
    if (seen.has(name)) return;

    const sheetDate = extractFirstDateFromSheetName_(name);
    if (sheetDate) {
      const sheetKey = Number(Utilities.formatDate(sheetDate, Session.getScriptTimeZone(), "yyyyMM"));
      if (sheetKey <= cutoffKey) {
        seen.add(name);
        matches.push(sheet);
      }
    }
  });

  matches.sort(function(a, b) { return a.getName().localeCompare(b.getName()); });
  return matches;
}

// ============================================================================
// 5. SHEET TAB RANKING & ORGANIZATION ENGINE (SECTION B GOVERNED)
// ============================================================================

function organizeTabs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  const rules = typeof loadSectionFTabRules_ === "function" ? loadSectionFTabRules_() : [];

  const sheetData = sheets.map(sheet => {
    const name = sheet.getName();
    let match = { group: "Unformatted", rank: 999 };
    if (typeof matchSheetToSectionFRule_ === "function") {
      match = matchSheetToSectionFRule_(name, rules);
    }

    let dateVal = 0;
    const dateMatch = name.match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        dateVal = new Date(y, m - 1, 1).getTime();
    }

    return { sheet, name, rank: match.rank, dateVal };
  });

  sheetData.sort((a, b) => {
    if (a.rank !== b.rank) return a.rank - b.rank;
    if (a.dateVal !== b.dateVal) return b.dateVal - a.dateVal;
    return a.name.localeCompare(b.name);
  });

  for (let i = 0; i < sheetData.length; i++) {
    const currentSheet = sheetData[i].sheet;
    if (currentSheet.getIndex() !== (i + 1)) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(i + 1); // FIXED TYPO
    }
  }

  ss.toast("Sheet Tabs Re-organized according to Section B Governance!", "Tab Engine", 4);
}

function positionSheetBySectionFRank_(sheet, rank, spreadsheet) {
  if (!sheet) return;
  try {
    var ss = spreadsheet || SpreadsheetApp.getActiveSpreadsheet();
    var currentSheet = ss.getSheetByName(sheet.getName());
    if (!currentSheet) return;

    var rules = typeof loadSectionFTabRules_ === "function" ? loadSectionFTabRules_() : [];
    var targetRank = (rank !== undefined && rank !== null) ? rank : getTargetRankForSheet_(currentSheet.getName(), rules);

    var targetDateVal = 0;
    var dateMatch = currentSheet.getName().match(/(\d{2})[.\/-](\d{2,4})/);
    if (dateMatch) {
        let m = parseInt(dateMatch[1], 10);
        let y = parseInt(dateMatch[2], 10);
        if (y < 100) y += 2000;
        targetDateVal = new Date(y, m - 1, 1).getTime();
    }

    var sheets = ss.getSheets();
    var targetPos = 1;

    for (var i = 0; i < sheets.length; i++) {
      if (sheets[i].getName() === currentSheet.getName()) continue;

      var otherRank = getTargetRankForSheet_(sheets[i].getName(), rules);
      var otherDateVal = 0;
      var otherMatch = sheets[i].getName().match(/(\d{2})[.\/-](\d{2,4})/);
      if (otherMatch) {
        let m = parseInt(otherMatch[1], 10);
        let y = parseInt(otherMatch[2], 10);
        if (y < 100) y += 2000;
        otherDateVal = new Date(y, m - 1, 1).getTime();
      }

      var placeAfter = false;
      if (otherRank < targetRank) {
        placeAfter = true;
      } else if (otherRank === targetRank) {
        if (otherDateVal > targetDateVal) {
          placeAfter = true;
        } else if (otherDateVal === targetDateVal) {
          if (sheets[i].getName().localeCompare(currentSheet.getName()) < 0) {
            placeAfter = true;
          }
        }
      }

      if (placeAfter) {
        targetPos++;
      }
    }

    if (currentSheet.getIndex() !== targetPos) {
      ss.setActiveSheet(currentSheet);
      ss.moveActiveSheet(Math.min(Math.max(1, targetPos), sheets.length)); // FIXED TYPO
    }
  } catch (e) {
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Non-fatal tab position operation failed: " + e.message);
  }
}

function getTargetRankForSheet_(sheetName, preloadedRules) {
  const rules = preloadedRules || (typeof loadSectionFTabRules_ === "function" ? loadSectionFTabRules_() : []);
  const match = matchSheetToSectionFRule_(sheetName, rules);
  return match.rank;
}

function matchSheetToSectionFRule_(sheetName, rules) {
  const cleanName = String(sheetName || "").trim();
  const cleanLower = cleanName.toLowerCase().replace(/[^a-z0-9]/g, "");
  const isTemplate = cleanName.indexOf(SYSTEM_SHEETS.TEMPLATE_PREFIX) === 0 || cleanName === SYSTEM_SHEETS.BASE_TEMPLATE;

  for (let i = 0; i < rules.length; i++) {
    const rulePrefixClean = rules[i].prefix.toLowerCase().replace(/[^a-z0-9]/g, "");

    if (isTemplate) {
      const targetSubName = cleanName.replace(SYSTEM_SHEETS.TEMPLATE_PREFIX, "").toLowerCase().replace(/[^a-z0-9]/g, "");
      if (targetSubName === rulePrefixClean || targetSubName.indexOf(rulePrefixClean) === 0) {
        return { group: rules[i].group, rank: rules[i].templateRank };
      }
    } else {
      // FIX: Matches exact names or prefix starts (e.g. "Source - Raw Data 04.26" matches rule "Source - Raw Data")
      if (cleanLower === rulePrefixClean || cleanLower.indexOf(rulePrefixClean) === 0) {
        return { group: rules[i].group, rank: rules[i].activeRank };
      }
    }
  }

  if (isTemplate) return { group: "Template", rank: 800 };
  return { group: "Unformatted", rank: 999 };
}


function loadSectionFTabRules_() {
  try {
    const dashboard = loadDashboardConfig_();
    if (dashboard && dashboard.creationRules && Object.keys(dashboard.creationRules).length) {
      const rules = [];
      Object.keys(dashboard.creationRules).forEach(sysName => {
        const r = dashboard.creationRules[sysName];
        rules.push({
          prefix: r.systemSheetName,
          group: r.group,
          templateRank: r.templateRank,
          activeRank: r.activeRank
        });
      });
      return rules;
    }
  } catch (err) {
    if (typeof logBestEffortWarning_ === "function") logBestEffortWarning_("Section B rules dashboard lookup fallback: " + err.message);
  }

  return MASTER_FORMAT_DEFAULTS.creationRules.map(row => {
    return {
      prefix: row[0],
      group: row[2],
      templateRank: row[3],
      activeRank: row[4]
    };
  });
}



